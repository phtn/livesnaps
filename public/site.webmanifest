{
  "id": "/",
  "name": "LiveSnapsNow",
  "short_name": "LiveSnapsNow",
  "description": "LiveSnapsNow helps you verify your vehicle with a quick and easy to use photo-based workflow.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "portrait-primary",
  "background_color": "#0A0A0A",
  "theme_color": "#0A0A0A",
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/livesnaps-icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/livesnaps-icons/apple-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    },
  ]
}
