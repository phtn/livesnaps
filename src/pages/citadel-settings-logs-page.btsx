import { InnerContainer } from '@/components/admin'
import DataTable from '@/components/ui/table/DataTable.btsx'
import Loading from '@/components/loading.btsx'
import ErrorPage from '@/components/error.btsx'
import { EMPTY_VISION_LOGS, visionLogColumns } from '@/components/citadel/vision-log-columns'
import { useAdminList } from '@/hooks/use-admin-list'
import type { VisionLogDocument } from '../../convex/vision_logs/d'
import GenericFilterList from '@/components/ui/table/hyper/generic-filter-list.btsx'


setup
  const { items, error, isLoading, lastUpdatedAt, refresh } = useAdminList<VisionLogDocument>({
    path: '/api/gods/vision-logs',
    fallbackErrorMessage: 'Unable to load vision logs.',
  })

InnerContainer(className='p-1')
  if isLoading && items === undefined
    Loading
  elseif error && items === undefined
    ErrorPage(code={500} title='Unable to load vision logs' message={error} action={refresh} actionLabel='Retry')
  else
    fragment
      if error
        div(className='flex flex-wrap items-center justify-between gap-2 py-3 text-xs text-muted-foreground')
          p(role='alert' className='w-full text-destructive') #{error} Showing the last successful load.
      DataTable(
        ~ title='Vision logs'
        ~ data={items ?? EMPTY_VISION_LOGS}
        ~ columns={visionLogColumns}
        ~ getRowId={(row: VisionLogDocument) => row._id}
        ~ initialSorting={[{ id: 'createdAt', desc: true }]}
        ~ filterList={GenericFilterList}
        ~ initialPageSize={50}
        ~ pageSizes={[25, 50, 100, 250]}
        ~ urlKeyPrefix='logs_'
        ~ emptyTitle='No vision logs yet'
        ~ viewportClassName='h-[calc(100dvh-280px)] min-h-64 w-full md:h-[calc(100dvh-240px)]'
        ~ emptyDescription='Vision logs will appear here when captures are processed.'
        ~ )
