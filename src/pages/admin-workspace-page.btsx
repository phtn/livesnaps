import { SnapHandlerProvider } from '@/components/admin/snap-handler.btsx'
import { createElement, useCallback, useLinkedState, useMemo, useState } from 'octane'
import { useAdminSnaps } from '@/hooks/use-admin-snaps'
import { useSessionEmail } from '@/hooks/use-session-email'
import { useAdminVerificationEntries } from '@/hooks/use-admin-verification-entries'
import { accountEndpoint, useWorkspace } from '@/hooks/use-workspace'
import { useAdminPages } from '@/hooks/use-admin-pages'
import { DEFAULT_COLUMN_PINNING, DEFAULT_COLUMN_VISIBILITY, EMPTY_VERIFICATION_ENTRIES, PAGE_SIZES, VERIFICATION_ENTRY_LIST_LIMIT, verificationEntryColumns, type VerificationEntryRow } from '@/components/admin/verification-entry-columns'
import { SNAP_LIST_LIMIT } from '@/components/admin/snap-columns'
import CreateVerificationEntryDialog from '@/components/admin/new-verification-entry.btsx'
import SendVerificationEntryDialog from '@/components/admin/send-verification-entry.btsx'
import EditSnapDrawer from '@/components/admin/edit-snap.btsx'
import { VerificationRowActionsProvider } from '@/components/admin/verification-row-actions.btsx'
import DataTable from '@/components/ui/table/DataTable.btsx'
import VerificationEntryFilterList from '@/components/admin/VerificationEntryFilterList.btsx'
import ErrorPage from '@/components/error.btsx'
import { Icon } from '@/lib/icons'
import {cn} from '@/lib/utils'
import Container from "../components/admin/container.btsx";
import Loading from "../components/loading.btsx";
import { onError } from '@/lib/toast'
import VerificationPhotoViewer from '@/components/admin/verification-photo-viewer.btsx'
import { VerificationResultsContext } from '@/components/admin/verification-results-cell.btsx'
import PhotoViewer from '@/components/photo-viewer.btsx'
import { verifiedPhotoFileName, verifiedPhotoUrl } from '@/lib/verifications/photo-review'

props {}: {}
setup
  // Reads go through the Worker, which is protected by the admin session
  // cookie and re-mints an ID token for Convex server-side. The browser on the
  // admin origin has no Firebase client identity, so it cannot query Convex.
  const account = useWorkspace()
  const canWrite = account?.role !== 'viewer'
  const { items: entries, error, isLoading, lastUpdatedAt, refresh, loadMore, hasMore } = useAdminPages<VerificationEntryRow>(accountEndpoint('/api/admin/verification-entries', account?.id ?? ''))
  const rows = entries ?? EMPTY_VERIFICATION_ENTRIES
  // A poll failure keeps the last good rows, so the table stays up and the
  // error reads as "stale" rather than replacing everything.
  const hasRows = entries !== undefined
  const freshnessLabel = lastUpdatedAt ? `${new Date(lastUpdatedAt).toLocaleTimeString()}` : ''

  // The create dialog picks a snap to verify, so it needs the snaps list too.
  // Its own poll shares the same Worker route the snaps table uses.
  const { isLoading: isLoadingSnaps, refresh: refreshSnaps, snaps } = useAdminSnaps(SNAP_LIST_LIMIT)

  const sessionEmail = useSessionEmail()

  const [sendEntry, setSendEntry] = useState<VerificationEntryRow | null>(null)
  const closeSendDialog = useCallback((open: boolean) => {
    if (!open) setSendEntry(null)
  }, [])

  const [editSnap, setEditSnap] = useState<NonNullable<typeof snaps>[number] | null>(null)
  const openEditSnap = useCallback((entry: VerificationEntryRow) => {
    const snap = snaps?.find((item) => item.uploadId === entry.uploadId)
    if (!snap) {
      onError('The snap details are not available in the current workspace list.')
      return
    }
    setEditSnap(snap)
  }, [snaps])
  const closeEditSnap = useCallback((open: boolean) => {
    if (!open) setEditSnap(null)
  }, [])

  // Creates, sends, and snap edits can change either table, so both are
  // refetched rather than waiting out the next 30s poll.
  const handleWritten = useCallback(() => {
    refresh()
    refreshSnaps()
  }, [refresh, refreshSnaps])

  // Looked up from the live rows, so a poll that drops or re-verifies the entry updates the viewer.
  const [resultsEntryId, setResultsEntryId] = useLinkedState(account?.id, () => null as string | null)
  const resultsEntry = rows.find((entry) => entry._id === resultsEntryId)
  const resultPhotos = resultsEntry?.verifiedPhotos ?? []
  const resultsKey = resultPhotos.map((photo) => photo.photoKey).join('|')
  const resultViewerPhotos = useMemo(() => resultsEntry ? resultPhotos.map((photo) => ({
    alt: `${photo.label} stamped verification photo`,
    description: 'Verified · stamped with capture time and location',
    downloadName: verifiedPhotoFileName(photo),
    id: photo.photoKey,
    label: photo.label,
    src: verifiedPhotoUrl(resultsEntry._id, photo.photoKey),
    unoptimized: true
  })) : [], [resultsEntry?._id, resultsKey])
  const openResults = useCallback((entry: VerificationEntryRow) => setResultsEntryId(entry._id), [])
  const closeResults = useCallback((open: boolean) => {
    if (!open) setResultsEntryId(null)
  }, [])

  const [verifyEntry, setVerifyEntry] = useLinkedState(account?.id, () => null as VerificationEntryRow | null)

  // Sits in the table's toolbar row beside the filter control rather than in
  // the header, so creating an entry reads as one of the table's own controls.
  const createEntryButton = canWrite ? createElement(CreateVerificationEntryDialog, {
    emailFromAddress: sessionEmail,
    isLoadingSnaps,
    onCreated: handleWritten,
    snaps: snaps ?? []
  }) : null

Container(className='md:py-0')
  if isLoading && !hasRows
    Loading
  elseif error && !hasRows
    ErrorPage(code={500} title='Error' message={error} action={refresh} actionLabel='Retry')
  else
    SnapHandlerProvider(refresh={handleWritten})
      VerificationResultsContext.Provider(value={openResults})
        VerificationRowActionsProvider(onOpenEditDialog={openEditSnap} onOpenSendDialog={setSendEntry} onStartVerification={setVerifyEntry})
          DataTable(
            ~ title='Verification Entries'
            ~ data={rows}
            ~ columns={verificationEntryColumns}
            ~ filterList={VerificationEntryFilterList}
            ~ getRowId={(row) => row._id}
            ~ initialColumnPinning={DEFAULT_COLUMN_PINNING}
            ~ initialColumnVisibility={DEFAULT_COLUMN_VISIBILITY}
            ~ initialPageSize={50}
            ~ pageSizes={PAGE_SIZES}
            ~ emptyTitle='No verification entries'
            ~ emptyDescription='Entries appear here once a verification email is sent.'
            ~ toolbarActions={createEntryButton}
            ~ )
            fragment
              div(className='flex items-center gap-2 text-xs text-muted-foreground')
                if error
                  span(className='text-destructive') #{error} — showing the last successful load.
                else
                  div(className='flex items-center gap-1')
                    span(className='font-mono') #{freshnessLabel}
                button(type='button' className='group hover:bg-sidebar rounded-sm active:bg-sidebar-border transition-colors duration-200 ease-out' onClick={refresh})
                  Icon(name='refresh' size={14} className='-rotate-6 group-active:-rotate-90 transition-transform duration-200 ease-out')
                if hasMore
                  button(type='button' onClick={loadMore} disabled={isLoading} className='rounded border border-border px-3 py-1.5 text-xs disabled:opacity-50') #{isLoading ? 'Loading…' : 'Load more'}

  if resultsEntry && resultViewerPhotos.length > 0
    PhotoViewer(
      ~ open={true}
      ~ photos={resultViewerPhotos}
      ~ title={`${resultsEntry.plateNumber || resultsEntry.uploadId} · Verification results`}
      ~ onOpenChange={closeResults}
      ~ )
  SendVerificationEntryDialog(
    ~ entry={sendEntry}
    ~ open={sendEntry !== null}
    ~ onOpenChange={closeSendDialog}
    ~ onSent={handleWritten}
    ~ snaps={snaps ?? []}
    ~ )
  EditSnapDrawer(
    ~ snap={editSnap}
    ~ open={editSnap !== null}
    ~ onOpenChange={closeEditSnap}
    ~ onUpdated={handleWritten}
    ~ )

  if verifyEntry && canWrite
    VerificationPhotoViewer(key={verifyEntry._id} entryId={verifyEntry._id} onClose={() => setVerifyEntry(null)} onSaved={handleWritten})
