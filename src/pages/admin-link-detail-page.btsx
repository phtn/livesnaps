import { useEffect, useState } from 'octane'
import { useField, useForm, useSelector } from '@octanejs/tanstack-form'
import { Link, useParams } from '@octanejs/tanstack-router'
import type { FunctionReturnType } from 'convex/server'
import { api } from '../../convex/_generated/api'
import { accountEndpoint, useWorkspace } from '@/hooks/use-workspace'
import { submissionShareUrl, workspaceJson, writeWorkspaceJson } from '@/lib/accounts/link-client'
import { Button } from '@/components/ui'
import QRShareable from '@/components/qr-shareable.btsx'
import SubmissionLinkEmailDrawer from '@/components/admin/submission-link-email-drawer.btsx'
import SubmissionLinkColorPicker from '@/components/admin/submission-link-color-picker.btsx'
import { Icon } from '@/lib/icons'
import { submissionLinkColorHex, type SubmissionLinkColor } from '@/lib/accounts/submission-links'

module
  type LinkList = FunctionReturnType<typeof api.submissionLinks.q.list>
  type Analytics = FunctionReturnType<typeof api.submissionLinks.q.analytics>
  type LinkRecord = LinkList['links'][number]
  const cardClass = 'overflow-hidden rounded-lg border border-border/60 bg-surface shadow-[0_12px_40px_-32px_rgba(0,0,0,0.55)]'
  const utcDay = (timestamp: number) => new Date(timestamp).toISOString().slice(0, 10)
  const percentage = (completed: number, started: number) => started ? `${Math.round(completed / started * 100)}%` : '—'

component SharePanel
  props { accountId, accountName, linkId, label, url }: { accountId: string; accountName: string; linkId: LinkRecord['_id']; label: string; url: string }
  setup
    const [notice, setNotice] = useState('')
    const [emailOpen, setEmailOpen] = useState(false)
    const message = `Submit your LiveSnaps using ${label}: ${url}`
    const smsHref = `sms:?body=${encodeURIComponent(message)}`

    const copy = async () => {
      try { await navigator.clipboard.writeText(url); setNotice('Link copied.') }
      catch { setNotice('Copy the address shown above.') }
    }

  section(className={cardClass})
    header(className='border-b border-border/50 bg-sidebar/20 px-4 py-4')
      p(className='font-mono text-2xs uppercase tracking-[0.18em] text-muted-foreground') outgoing
      h2(className='mt-1 text-base font-medium') Share with ease

    div(className='flex min-w-0 items-center gap-2 border-b border-border/50 bg-sunken/50 p-1.5 pl-3')
      Icon(name='world' className='size-3.5 opacity-60')
      p(className='min-w-0 flex-1 truncate font-mono text-xs text-foreground/75') #{url}
      Button(className='rounded-sm' type='button' size='icon-lg' variant='secondary' icon='copy' aria-label='Copy submission link' onClick={copy})
    div(className='grid gap-4 p-2 md:grid-cols-2')
      div(className='min-w-0 grid place-items-center')
        div(className='mt-4 flex md:flex-col gap-4')
          Button(className='h-14' type='button' onClick={() => setEmailOpen(true)} variant='secondary' size='lg' icon='email-body' label='Send Email')
          Button(className='h-14' type='a' href={smsHref} variant='secondary' size='lg' icon='message' label='Send SMS')
        if notice
          p(role='status' className='mt-3 font-mono text-xs text-muted-foreground') #{notice}
      div(className='p-0')
        QRShareable(
          ~ content={url}
          ~ itemName={''}
          ~ itemTitle={''}
          ~ itemLabel={accountName}
          ~ brand='www.livesnapsnow.com'
          ~ filename={`${accountName}-${label}-submission-link-qr`}
          ~ )
    SubmissionLinkEmailDrawer(
      ~ open={emailOpen}
      ~ onOpenChange={setEmailOpen}
      ~ accountId={accountId}
      ~ accountName={accountName}
      ~ linkId={linkId}
      ~ linkLabel={label}
      ~ )

component ManageLink
  props { link, endpoint, onChanged }: { link: LinkRecord; endpoint: string; onChanged: () => void }
  setup
    const [notice, setNotice] = useState('')
    const [busy, setBusy] = useState(false)
    const form = useForm({
      defaultValues: { label: link.label, color: link.color as SubmissionLinkColor },
      onSubmit: async ({ value }) => {
        setBusy(true)
        try {
          await writeWorkspaceJson(endpoint, { action: 'update', linkId: link._id, label: value.label, color: value.color })
          setNotice('Link details saved.')
          onChanged()
        } catch (failure) { setNotice(failure instanceof Error ? failure.message : 'Unable to save label.') }
        finally { setBusy(false) }
      }
    })
    const label = useField({ form, name: 'label' })
    const color = useField({ form, name: 'color' })
    const submitting = useSelector(form.store, state => state.isSubmitting)
    const submit = (event: SubmitEvent) => { event.preventDefault(); void form.handleSubmit() }
    const toggle = async () => {
      setBusy(true)
      try {
        await writeWorkspaceJson(endpoint, { action: 'update', linkId: link._id, enabled: !link.enabled })
        setNotice(link.enabled ? 'Link disabled. Existing submissions are preserved.' : 'Link enabled.')
        onChanged()
      } catch (failure) { setNotice(failure instanceof Error ? failure.message : 'Unable to update link.') }
      finally { setBusy(false) }
    }

  section(className={cardClass})
    header(className='border-b border-border/50 bg-sidebar/20 px-4 py-4')
      p(className='font-mono text-2xs uppercase tracking-[0.18em] text-muted-foreground') Management
      h2(className='mt-1 text-base font-medium') Link settings
    div(className='space-y-4 p-4')
      form(className='space-y-4' onSubmit={submit})
        div(className='flex min-w-0 flex-wrap items-end gap-2')
          label(className='min-w-52 flex-1 space-y-1.5 text-sm')
            span(className='font-normal text-xs text-muted-foreground mb-0.5') Display label
            input(value={label.state.value} onInput={(event: Event) => label.handleChange((event.currentTarget as HTMLInputElement).value)} onBlur={label.handleBlur} required maxLength={100} className='h-9 w-full rounded-sm border border-border/60 bg-sunken/50 px-3 text-sm outline-none focus:border-active/50')
          Button(type='submit' variant='secondary' size='sm' label='Save' pending={submitting} pendingLabel='Saving…' disabled={busy || !label.state.value.trim()})
        SubmissionLinkColorPicker(value={color.state.value} onChange={color.handleChange} disabled={busy})
      div(className='flex flex-wrap items-center justify-between gap-3 border-t border-border/40 pt-4')
        div
          p(className='text-sm font-medium') Public availability
          p(className='mt-0.5 text-xs text-muted-foreground') Disabling stops new submissions without deleting prior records.
        Button(type='button' variant={link.enabled ? 'secondary' : 'dark'} size='sm' label={link.enabled ? 'Disable link' : 'Enable link'} pending={busy && !submitting} onClick={toggle})
      if notice
        p(role='status' className='font-mono text-xs text-muted-foreground') #{notice}

setup
  const params = useParams({ strict: false })
  const linkId = String(params.linkId)
  const account = useWorkspace()
  const [links, setLinks] = useState<LinkList | null>(null)
  const [analytics, setAnalytics] = useState<Analytics | null>(null)
  const [error, setError] = useState('')
  const [loading, setLoading] = useState(true)
  const [reloadToken, setReloadToken] = useState(0)
  const endpoint = accountEndpoint('/api/admin/submission-links', account?.id ?? '')
  const fromDay = utcDay(Date.now() - 29 * 86_400_000)
  const toDay = utcDay(Date.now())

  useEffect(() => {
    if (!account) return
    const controller = new AbortController()
    setLoading(true)
    const statsUrl = accountEndpoint(`/api/admin/submission-analytics?fromDay=${fromDay}&toDay=${toDay}`, account.id)
    Promise.all([
      workspaceJson<LinkList>(endpoint, { signal: controller.signal }),
      workspaceJson<Analytics>(statsUrl, { signal: controller.signal })
    ]).then(([nextLinks, nextAnalytics]) => {
      if (controller.signal.aborted) return
      setLinks(nextLinks)
      setAnalytics(nextAnalytics)
      setError('')
    }).catch((failure) => {
      if (!controller.signal.aborted) setError(failure instanceof Error ? failure.message : 'Unable to load this submission link.')
    }).finally(() => { if (!controller.signal.aborted) setLoading(false) })
    return () => controller.abort()
  }, [account?.id, endpoint, linkId, reloadToken])

  const link = links?.links.find(item => String(item._id) === linkId)
  const counts = analytics?.links.find(item => String(item.linkId) === linkId)
  const refresh = () => setReloadToken(token => token + 1)
  const shareUrl = account && link ? submissionShareUrl(account.slug, link.slug) : ''

section(className='h-[calc(100vh-96px)] overflow-y-auto p-4')
  Link(to='/admin-settings/links' className='inline-flex items-center gap-1.5 font-mono text-xs uppercase tracking-wide text-muted-foreground hover:text-foreground')
    Icon(name='arrow-left' className='size-3.5')
    span Submission links

  if loading && !links
    div(className='mt-6 flex items-center gap-2')
      Icon(name='spinner-ferris' className='size-4')
      p(className='text-sm text-muted-foreground') Loading link details…
  elseif error
    p(role='alert' className='mt-6 rounded-sm border border-destructive/40 bg-destructive/10 px-3 py-2 text-sm text-destructive') #{error}
  elseif !link || !account
    div(className='mt-6 rounded-sm border border-dashed border-border/60 px-4 py-10 text-center')
      p(className='text-sm text-muted-foreground') This submission link could not be found.
  else
    fragment
      header(className='mt-5 flex flex-wrap items-start justify-between gap-3')
        div(className='min-w-0')
          div(className='mt-1 flex items-center gap-2.5')
            span(className='size-3 rounded-full ring-2 ring-background shadow-[0_0_0_1px_rgba(0,0,0,0.12)]' style={{ backgroundColor: submissionLinkColorHex(link.color) }})
            h1(className='font-poly text-2xl font-medium tracking-tight capitalize') #{link.label}
          p(className='mt-1 max-w-2xl text-sm text-muted-foreground') Manage, share, and review the last 30 days for this intake link.
        span(className={`rounded-full border px-2.5 py-1 font-mono text-2xs uppercase tracking-wider ${link.enabled ? 'border-brand/25 bg-brand/8 text-brand' : 'border-border/60 bg-muted/50 text-muted-foreground'}`}) #{link.enabled ? 'Enabled' : 'Disabled'}

      div(className='mt-5 grid gap-4 xl:grid-cols-[minmax(0,1.25fr)_minmax(20rem,0.75fr)]')
        SharePanel(accountId={account.id} accountName={account.name} linkId={link._id} label={link.label} url={shareUrl})
        if links?.canManage
          ManageLink(link={link} endpoint={endpoint} onChanged={refresh})

      section(className={`${cardClass} mt-4`})
        header(className='flex flex-wrap items-end justify-between gap-3 border-b border-border/50 bg-sidebar/20 px-4 py-4')
          div
            p(className='font-mono text-2xs uppercase tracking-[0.18em] text-muted-foreground') Last 30 days
            h2(className='mt-1 text-base font-medium') Link performance
          Link(to='/admin-settings/links/activity' className='inline-flex items-center gap-1.5 text-xs font-medium hover:text-brand hover:underline hover:underline-offset-4')
            span Full activity
            Icon(name='chevron-right' className='size-3')
        div(className='grid grid-cols-2 gap-px bg-border/50 sm:grid-cols-4')
          each metric in [{ label: 'Started', value: counts?.started ?? 0 }, { label: 'Completed', value: counts?.completed ?? 0 }, { label: 'Abandoned', value: counts?.abandoned ?? 0 }, { label: 'Completion', value: percentage(counts?.completed ?? 0, counts?.started ?? 0) }] key metric.label
            div(className='bg-surface px-4 py-3')
              p(className='font-mono text-2xs uppercase tracking-wider text-muted-foreground') #{metric.label}
              p(className='mt-2 font-mono text-2xl tracking-tight') #{metric.value}
        div(className='border-t border-border/50 px-4 py-3')
          Link(to='/admin-snaps' search={{ sourceLinkId: link._id }} className='inline-flex items-center gap-1.5 text-xs font-medium text-active hover:underline hover:underline-offset-4')
            span View submissions from this link
            Icon(name='arrow-right' className='size-3')
