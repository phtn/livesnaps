import { useEffect, useState } from 'octane'
import { useForm, useStore } from '@octanejs/tanstack-form'
import { useConvexQuery } from '@/hooks/use-convex-query'
import { api } from '../../convex/_generated/api'
import { REPORT_FIELD_GROUPS } from '@/lib/snaps/report-settings'
import { updateReportField } from '@/lib/snaps/report-settings-client'
import { Icon } from '@/lib/icons'
import { cn } from '@/lib/utils'

module
  const groupDescriptions: Partial<Record<string, string>> = {
    attributes: 'Includes all custom attribute paths, which vary between snaps.',
    'evidence-item': 'These choices apply to every photo in the evidence manifest.',
    location: 'Address components include provider-specific fields. Optional fields appear only when recorded.'
  }

component ReportField
  props { fieldKey, label, included }: { fieldKey: string; label: string; included: boolean }
  setup
    const [error, setError] = useState<string | null>(null)
    const [saved, setSaved] = useState(false)
    const form = useForm({
      defaultValues: { included },
      onSubmit: async ({ value }) => {
        setError(null)
        setSaved(false)
        try {
          await updateReportField(fieldKey, value.included)
          setSaved(true)
        } catch (failure) {
          form.setFieldValue('included', !value.included)
          setError(failure instanceof Error ? failure.message : 'Could not save this change.')
        }
      }
    })
    const checked = useStore(form.store, state => state.values.included)
    const saving = useStore(form.store, state => state.isSubmitting)
    useEffect(() => { form.setFieldValue('included', included) }, [included])
    const change = (event: Event) => {
      form.setFieldValue('included', (event.currentTarget as HTMLInputElement).checked)
      void form.handleSubmit()
    }
  div(className='relative')
    label(className={cn('group/field flex min-h-12 cursor-pointer items-center gap-3 rounded-xl px-3 py-2 text-sm outline-none hover:bg-muted/65 focus-within:bg-muted/65', saving && 'cursor-wait', error && 'bg-destructive/5')})
      input(type='checkbox' checked={checked} disabled={saving} onChange={change} aria-describedby={error ? `${fieldKey}-error` : undefined} className='peer sr-only')
      span(
        ~ aria-hidden={true}
        ~ className={cn(
        ~   'relative z-10 grid size-5 shrink-0 place-items-center rounded-full border-2 border-dashed bg-background',
        ~   checked ? 'border-positive bg-positive text-white' : 'border-chart-warn text-chart-warn',
        ~   saving && 'border-muted-foreground bg-background',
        ~   error && 'border-destructive bg-background text-destructive',
        ~   'peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-ring'
        ~ )}
        ~ )
        if checked
          Icon(name='check' size={13} className='stroke-3')
      span(className={cn('min-w-0 flex-1 leading-5', !checked && 'text-foreground/80')}) #{label}
      span(className='min-w-12 text-right font-mono text-2xs uppercase tracking-[0.12em] text-muted-foreground' role='status') #{saving ? 'Saving' : saved ? 'Saved' : ''}
    if error
      p(id={`${fieldKey}-error`} className='ml-11 pr-3 pb-2 text-xs leading-5 text-destructive' role='alert') #{error}

component ReportSettings
  setup
    const settings = useConvexQuery(api.snapSettings.q.getReport, {})
  if !settings
    div(className='mt-10 flex items-center gap-3 text-sm text-muted-foreground' role='status')
      span(aria-hidden={true} className='size-5 rounded-full border-2 border-dashed border-muted-foreground/60')
      span Loading report settings…
  else
    div(className='mt-10 space-y-12')
      each group in REPORT_FIELD_GROUPS key group.id
        section(className='min-w-0' role='group' aria-labelledby={`${group.id}-checklist-heading`})
          div(className='flex items-baseline justify-between gap-4 px-1')
            h3(id={`${group.id}-checklist-heading`} className='font-poly text-lg font-medium leading-6 sm:text-xl') #{group.title}
            span(className='shrink-0 font-mono text-sm tabular-nums text-muted-foreground' aria-label={`${group.fields.filter(field => !settings.excludedFields.includes(field.key)).length} of ${group.fields.length} fields included`}) #{group.fields.filter(field => !settings.excludedFields.includes(field.key)).length}/#{group.fields.length}
          if groupDescriptions[group.id]
            p(className='mt-1 max-w-2xl px-1 text-xs leading-5 text-muted-foreground') #{groupDescriptions[group.id]}
          div(className='relative mt-4 space-y-1 pl-5 before:absolute before:inset-y-2 before:left-1 before:w-px before:bg-border/45')
            each field in group.fields key field.key
              ReportField(fieldKey={field.key} label={field.label} included={!settings.excludedFields.includes(field.key)})

main(className='mx-auto w-full max-w-4xl px-4 py-8 sm:px-6 sm:py-10')
  section(className='rounded-2xl border border-border/35 bg-card/35 px-4 py-6 shadow-[0_18px_50px_-40px_rgba(0,0,0,0.45)] sm:px-8 sm:py-8')
    div(className='flex items-start justify-between gap-6 border-b border-border/30 pb-6')
      div
        p(className='font-mono text-2xs uppercase tracking-[0.18em] text-muted-foreground') Snap full report
        h2(className='mt-2 font-poly text-2xl font-medium tracking-tight sm:text-3xl') Report checklist
      span(className='mt-5 shrink-0 font-mono text-sm text-muted-foreground') Auto-saved
    p(className='mt-6 max-w-2xl text-sm leading-6 text-muted-foreground') Choose the information included in every account report. Fields follow the PDF order and save as soon as you change them.
    p(className='mt-1 max-w-2xl text-xs leading-5 text-muted-foreground') Empty sections are omitted. Existing downloaded files stay unchanged.
    try
      ReportSettings
    catch error, reset
      div(className='mt-8 rounded-xl bg-destructive/5 px-4 py-3 text-sm text-destructive' role='alert')
        p Could not load report settings.
        button(type='button' onClick={() => reset()} className='mt-2 underline underline-offset-4') Retry
