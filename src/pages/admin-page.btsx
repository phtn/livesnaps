import { useEffect, useState } from 'octane'
import { Icon } from '@/lib/icons'
import { cn } from '@/lib/utils'
import ThemeToggle from '../components/theme-toggle.btsx'
import { Link, Outlet } from '@octanejs/tanstack-router'
import { Group, Panel, Separator } from '@octanejs/resizable-panels'
import { Drawer } from '@octanejs/vaul'
import '@octanejs/vaul/style.css'
import { useMobile } from '@/hooks/use-mobile'
import {Link} from '@octanejs/tanstack-router'

module
  type NavItem = {
    icon: string
    label: string
    path: '/' | '/admin-snaps' | '/admin-snaps-lab' | '/admin-workspace' | '/admin-settings'
  }
  const navs: NavItem[] = [
    { icon: 'grid', label: 'Overview', path: '/' },
    { icon: 'snap', label: 'Snaps', path: '/admin-snaps' },
    { icon: 'table', label: 'Snaps Lab', path: '/admin-snaps-lab' },
    { icon: 'timeline', label: 'Workspace', path: '/admin-workspace' },
    { icon: 'settings', label: 'Settings', path: '/admin-settings' },
  ]

component AdminNavigation
  props { compact = false, onNavigate }: { compact?: boolean; onNavigate?: () => void }
  nav(className='flex-1 w-full')
    ul(className='flex flex-col space-y-2 py-2')
      each item in navs key item.path
        li(className='w-full hover:text-foreground hover:bg-foreground/4')
          Link(to={item.path} onClick={onNavigate} aria-label={item.label} title={compact ? item.label : undefined} className={cn('relative flex h-14 items-center text-foreground/70', compact ? 'justify-center px-0' : 'gap-3 px-6')})
            Icon(name={item.icon} className='size-5')
            if !compact
              span #{item.label}

setup
  const [email, setEmail] = useState<string | null>(null)
  const [isNavigationCompact, setIsNavigationCompact] = useState(false)
  const [isMobileNavOpen, setIsMobileNavOpen] = useState(false)
  const [status, setStatus] = useState<'loading' | 'ready' | 'unauthorized' | 'error'>('loading')
  const isMobile = useMobile()
  useEffect(() => {
    let cancelled = false

    const loadSession = async () => {
      try {
        const response = await fetch('/api/admin/session', { credentials: 'same-origin' })

        if (!response.ok) {
          if (!cancelled) setStatus('unauthorized')
          return
        }

        const payload: unknown = await response.json()
        const nextEmail =
          typeof payload === 'object' && payload !== null && typeof (payload as { email?: unknown }).email === 'string'
            ? (payload as { email: string }).email
            : null

        if (!cancelled) {
          setEmail(nextEmail)
          setStatus('ready')
        }
      } catch {
        if (!cancelled) setStatus('error')
      }
    }

    void loadSession()
    return () => {
      cancelled = true
    }
  }, [])

if isMobile
  div(className='min-h-screen bg-background')
    Drawer.Root(open={isMobileNavOpen} onOpenChange={setIsMobileNavOpen} direction='left')
      Drawer.Trigger(type='button' aria-label='Open admin navigation' className='fixed left-4 top-4 z-40 inline-flex size-10 items-center justify-center rounded-lg border border-border bg-background text-foreground shadow-sm')
        Icon(name='grid' className='size-5')
      Drawer.Portal
        Drawer.Overlay(className='fixed inset-0 z-40 bg-black/40 backdrop-blur-[1px]')
        Drawer.Content(className='fixed inset-y-0 left-0 z-50 flex w-72 flex-col bg-background shadow-2xl outline-none')
          Drawer.Title(className='sr-only') Admin navigation
          Drawer.Handle(className='mx-auto mt-3 h-1.5 w-12 rounded-full bg-border')
          div(className='flex h-16 items-center border-b border-border px-6')
            Link(className='inline-flex items-center gap-2 text-[clamp(1.2rem,3vw,1.6rem)] font-poly font-medium text-foreground/90 tracking-tight' to='/' aria-label='App home')
              h1(className='')
                span(className='uppercase text-beach dark:text-foreground') Live
                span(className='uppercase dark:text-lime-200') Snaps
                span(className='text-sand dark:text-foreground') Now
          AdminNavigation(onNavigate={() => setIsMobileNavOpen(false)})
          div(className='flex h-16 items-center border-t border-border px-6')
            ThemeToggle
    main(className='min-h-screen bg-background pt-16')
      if status === 'loading'
        div(className='grid min-h-[calc(100vh-4rem)] place-items-center px-6 text-center')
          p(className='text-sm text-muted-foreground') Verifying your administrator session…
      elseif status === 'ready'
        Outlet
      elseif status === 'unauthorized'
        div(className='grid min-h-[calc(100vh-4rem)] place-items-center px-6 text-center')
          div(className='max-w-md')
            p(className='text-sm text-muted-foreground') You do not have an active administrator session.
            a(href='https://livesnapsnow.com/' className='mt-6 inline-flex h-10 items-center rounded-full bg-foreground px-5 text-sm font-medium text-background') Return to Live Snaps Now
      else
        div(className='grid min-h-[calc(100vh-4rem)] place-items-center px-6 text-center')
          p(className='text-sm text-destructive') We could not verify your administrator session. Please try again.
else
  Group(className='min-h-screen h-dvh')
    Panel(id='navigation' defaultSize='216px' minSize='64px' maxSize='216px' groupResizeBehavior='preserve-pixel-size' onResize={(size) => setIsNavigationCompact(size.inPixels <= 80)})
      aside(className='flex h-full min-w-0 w-full flex-col bg-background border-r border-border')
        div(className={cn('flex h-16 items-center border-b border-border', isNavigationCompact ? 'justify-center px-0' : 'px-6')})

          Link(className='inline-flex items-center gap-2 text-[clamp(0.8rem,3vw,1rem)] font-poly font-medium text-foreground/90 tracking-tight' to='/' aria-label='App home')
            if isNavigationCompact
              Icon(name='livesnaps')
            else
              h1(className='')
                span(className='uppercase text-beach dark:text-foreground') Live
                span(className='uppercase dark:text-lime-200') Snaps
                span(className='text-sand dark:text-foreground') Now

        AdminNavigation(compact={isNavigationCompact})
        div(className={cn('flex h-16 items-center border-t border-border', isNavigationCompact ? 'justify-center px-0' : 'px-6')})
          ThemeToggle
    Separator(aria-label='Resize admin navigation' className='w-1 bg-transparent transition-colors duration-180 ease-out dark:hover:bg-lime-200 hover:bg-blue-500 focus-visible:bg-sand')
    Panel(id='content' minSize='40%')
      main(className='min-h-screen bg-background')
        if status === 'loading'
          div(className='flex items-center justify-center gap-2 min-h-screen')
            Icon(name='spinner-ferris')
            p(className='text-sm md:text-base text-muted-foreground') Verifying your administrator session
        elseif status === 'ready'
          Outlet
        elseif status === 'unauthorized'
          div(className='grid min-h-screen place-items-center px-6 text-center')
            div(className='max-w-md')
              p(className='text-sm text-muted-foreground') You do not have an active administrator session.
              a(href='https://livesnapsnow.com/' className='mt-6 inline-flex h-10 items-center rounded-full bg-foreground px-5 text-sm font-medium text-background') Return to Live Snaps Now
        else
          div(className='grid min-h-screen place-items-center px-6 text-center')
            p(className='text-sm text-destructive') We could not verify your administrator session. Please try again.
