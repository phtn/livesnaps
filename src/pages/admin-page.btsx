import { useEffect, useMemo, useState } from 'octane'
import { Icon } from '@/lib/icons'
import { cn } from '@/lib/utils'
import ThemeToggle from '../components/theme-toggle.btsx'
import { Link, Outlet } from '@octanejs/tanstack-router'
import { Group, Panel, Separator } from '@octanejs/resizable-panels'
import { Drawer } from '@octanejs/vaul'
import '@octanejs/vaul/style.css'
import { useMobile } from '@/hooks/use-mobile'
import { useFirebaseUser } from '@/lib/firebase/auth'
import { useConsoleFirebaseSession } from '@/lib/firebase/console-session'
import UserMenu from '../components/admin/user-menu.btsx'
import ThemeToggle from '@/components/theme-toggle.btsx'

module
  type NavItem = {
    icon: string
    label: string
    path: '/' | '/admin-snaps' | '/admin-snaps-lab' | '/admin-workspace' | '/admin-settings'
    /**
     * Index routes match by prefix like every other link, so `/` would stay lit
     * on every page in the app. Only those need an exact match.
     */
    exact?: boolean
  }
  const navs: NavItem[] = [
    { icon: 'overview', label: 'Overview', path: '/', exact: true },
    { icon: 'snap', label: 'Snaps', path: '/admin-snaps' },
    { icon: 'timeline', label: 'Workspace', path: '/admin-workspace' },
    { icon: 'settings', label: 'Settings', path: '/admin-settings' },
    { icon: 'play', label: 'Sandbox', path: '/admin-snaps-lab'}
  ]

  // The router sets `data-status="active"` on a matching Link, so the active
  // route is read off the link itself rather than by comparing paths here.
  const navLinkClassName =
    'relative flex h-14 items-center text-foreground/55 transition-colors data-[status=active]:rounded-e-lg data-[status=active]:bg-sidebar-border data-[status=active]:text-foreground dark:data-[status=active]:text-lime-200'

component AdminNavigation
  props { compact = false, onNavigate }: { compact?: boolean; onNavigate?: () => void }
  nav(className='flex-1 w-full')
    ul(className='flex flex-col')
      each item in navs key item.path
        li(className='font-sans w-full hover:text-foreground hover:bg-sidebar/60')
          Link(
            ~ to={item.path}
            ~ onClick={onNavigate}
            ~ aria-label={item.label}
            ~ title={compact ? item.label : undefined}
            ~ activeOptions={{ exact: item.exact ?? false, includeSearch: false }}
            ~ className={cn(navLinkClassName, compact ? 'justify-center px-0' : 'gap-3 px-6')}
            ~ )
            Icon(name={item.icon} className='size-5')
            if !compact
              span #{item.label}

setup
  const { hasGodAccess, user } = useFirebaseUser()
  const [email, setEmail] = useState<string | null>(null)
  const [isNavigationCompact, setIsNavigationCompact] = useState(false)
  const [isMobileNavOpen, setIsMobileNavOpen] = useState(false)
  const [status, setStatus] = useState<'loading' | 'ready' | 'unauthorized' | 'error'>('loading')
  const isMobile = useMobile()
  const inSession = useMemo(() => user !== null, [user])
  // Adopts the cookie'd session into the Firebase client on this origin, so the
  // menu can show a real name, photo, and god-only links.
  useConsoleFirebaseSession('admin', status === 'ready')

  useEffect(() => {
    let cancelled = false

    const loadSession = async () => {
      try {
        const response = await fetch('/api/admin/session', { credentials: 'same-origin' })

        if (!response.ok) {
          if (!cancelled) setStatus('unauthorized')
          return
        }

        const payload: unknown = await response.json()
        const nextEmail =
          typeof payload === 'object' && payload !== null && typeof (payload as { email?: unknown }).email === 'string'
            ? (payload as { email: string }).email
            : null

        if (!cancelled) {
          setEmail(nextEmail)
          setStatus('ready')
        }
      } catch {
        if (!cancelled) setStatus('error')
      }
    }

    void loadSession()
    return () => {
      cancelled = true
    }
  }, [])

if isMobile
  div(className='min-h-screen bg-sunken')
    Drawer.Root(open={isMobileNavOpen} onOpenChange={setIsMobileNavOpen} direction='left')
      div(className='fixed top-0 z-35 w-full bg-sunken flex items-center justify-between h-12 border-b border-sidebar-border px-2.5')
        Drawer.Trigger(type='button' aria-label='Open admin navigation' className='fixed h-7! left-2 top-2 z-20 gap-2 inline-flex items-center justify-center text-foreground')
          Icon(name='sidebar' className='size-6 text-foreground/70')
          h1(className='mt-0.75 inline-flex items-center gap-0 font-poly font-medium text-foreground/90 tracking-tight')
            span(className='uppercase text-beach dark:text-foreground') Live
            span(className='uppercase dark:text-lime-200') Snaps
            span(className='text-sand dark:text-foreground') Now
      Drawer.Portal
        Drawer.Overlay(className='fixed inset-0 z-40 bg-black/40 backdrop-blur-[1px]')
        Drawer.Content(className='fixed inset-y-0 left-0 z-50 flex w-72 flex-col bg-sunken! shadow-2xl outline-none')
          Drawer.Title(className='sr-only') Admin navigation
          div(className='flex h-16 items-center border-b border-border/70 px-6')
            Link(className='inline-flex items-center gap-2 text-[clamp(1.2rem,3vw,1.6rem)] font-poly font-medium text-foreground/90 tracking-tight' to='/' aria-label='App home')
              h1(className='')
                span(className='uppercase text-beach dark:text-foreground') Live
                span(className='uppercase dark:text-lime-200') Snaps
                span(className='text-sand dark:text-foreground') Now
          AdminNavigation(onNavigate={() => setIsMobileNavOpen(false)})

          div(className='flex items-center justify-start h-16 px-5')
            ThemeToggle
          div(className='border-t border-border px-3 py-3')
            UserMenu(
              ~ name={user?.displayName}
              ~ email={email ?? user?.email}
              ~ photoUrl={user?.photoURL}
              ~ hasGodAccess={hasGodAccess}
              ~ onSignOut={() => setIsMobileNavOpen(false)}
              ~ )
    main(className='min-h-screen bg-sunken pt-11')
      if status === 'loading'
        div(className='grid min-h-[calc(100vh-4rem)] place-items-center px-6 text-center')
          p(className='text-sm text-muted-foreground') Verifying your administrator session…
      elseif status === 'ready'
        Outlet
      elseif status === 'unauthorized'
        div(className='grid min-h-[calc(100vh-4rem)] place-items-center px-6 text-center')
          div(className='max-w-md')
            p(className='text-sm text-muted-foreground') You do not have an active administrator session.
            a(href='https://livesnapsnow.com/' className='mt-6 inline-flex h-10 items-center rounded-full bg-foreground px-5 text-sm font-medium text-background') Return to Live Snaps Now
      else
        div(className='grid min-h-[calc(100vh-4rem)] place-items-center px-6 text-center')
          p(className='text-sm text-destructive') We could not verify your administrator session. Please try again.
else
  Group(className='min-h-screen h-dvh')
    Panel(id='navigation' defaultSize='216px' minSize='64px' maxSize='216px' groupResizeBehavior='preserve-pixel-size' onResize={(size) => setIsNavigationCompact(size.inPixels <= 80)})
      aside(className='flex h-full min-w-0 w-full flex-col bg-sunken _border-r border-border/70')
        div(className={cn('flex h-16 items-center _border-b border-border/70', isNavigationCompact ? 'justify-center px-0' : 'px-6')})

          Link(className='inline-flex items-center gap-2 text-[clamp(0.8rem,3vw,1rem)] font-poly font-medium text-foreground/90 tracking-tight' to='/' aria-label='App home')
            if isNavigationCompact
              Icon(name='livesnaps')
            else
              h1(className='')
                span(className='uppercase text-beach dark:text-foreground') Live
                span(className='uppercase dark:text-lime-200') Snaps
                span(className='text-sand dark:text-foreground') Now

        AdminNavigation(compact={isNavigationCompact})
        // No `user !== null` gate here. Firebase auth state is per-origin and the
        // handoff only hands this origin a session cookie, so the client SDK never
        // has a user on the admin subdomain - the gate hid the menu on desktop for
        // every admin, while the mobile drawer below rendered it unconditionally.
        // The session email carries the identity; the theme toggle lives in the popup.

        div(className='flex items-center justify-start h-16 px-5')
          ThemeToggle
        div(className={cn('py-3', isNavigationCompact ? 'px-2' : 'px-3')})
          UserMenu(
            ~ compact={isNavigationCompact}
            ~ name={user?.displayName}
            ~ email={email ?? user?.email}
            ~ photoUrl={user?.photoURL}
            ~ hasGodAccess={hasGodAccess}
            ~ )
    Separator(aria-label='Resize admin navigation' className='group relative -ml-1.5 w-1.5 shrink-0')
      span(className='pointer-events-none absolute inset-y-0 -left-1.5 -right-1.5 -translate-x-1 transition-colors duration-180 ease-out group-hover:bg-blue-500 dark:group-hover:bg-lime-200 group-focus-visible:bg-sand')
    Panel(id='content' minSize='40%')
      main(className='min-h-[calc(100vh-160px)] bg-background')
        if status === 'loading'
          div(className='flex items-center justify-center gap-2 min-h-screen')
            Icon(name='spinner-ferris')
            p(className='text-sm md:text-base text-muted-foreground') Verifying your administrator session
        elseif status === 'ready'
          Outlet
        elseif status === 'unauthorized'
          div(className='grid min-h-screen place-items-center px-6 text-center')
            div(className='max-w-md')
              p(className='text-sm text-muted-foreground') You do not have an active administrator session.
              a(href='https://livesnapsnow.com/' className='mt-6 inline-flex h-10 items-center rounded-full bg-foreground px-5 text-sm font-medium text-background') Return to Live Snaps Now
        else
          div(className='grid min-h-screen place-items-center px-6 text-center')
            p(className='text-sm text-destructive') We could not verify your administrator session. Please try again.
