import { useEffect, useState } from 'octane'
import { Icon, type IconName } from '@/lib/icons'
import { cn } from '@/lib/utils'
import ThemeToggle from '../components/theme-toggle.btsx'
import { Link, useLocation } from '@octanejs/tanstack-router'
import { Group, Panel, Separator, usePanelRef } from '@octanejs/resizable-panels'
import { useMobile } from '@/hooks/use-mobile'
import { useFirebaseUser } from '@/lib/firebase/auth'
import { useConsoleFirebaseSession } from '@/lib/firebase/console-session'
import UserMenu from '../components/admin/user-menu.btsx'
import WorkspaceProvider from '@/components/admin/workspace-provider.btsx'
import SelectOctane from '@/components/ui/SelectOctane.btsx'
import { useWorkspaceAccounts } from '@/hooks/use-workspace-accounts'
import Sidebar from '@/components/ui/sidebar.btsx'
import type { ClassValue } from 'octane'
import Switcher from '@/components/ui/switcher.btsx'

module
  type NavItem = {
    icon: string
    label: string
    path: '/' | '/admin-overview' | '/admin-snaps' | '/admin-snaps-lab' | '/admin-workspace' | '/admin-settings'
    /**
     * Index routes match by prefix like every other link, so `/` would stay lit
     * on every page in the app. Only those need an exact match.
     */
    exact?: boolean
  }
  const navs: NavItem[] = [
    { icon: 'overview', label: 'Overview', path: '/admin-overview', exact: true },
    { icon: 'snap', label: 'Snaps', path: '/admin-snaps' },
    { icon: 'timeline', label: 'Workspace', path: '/admin-workspace' },
    { icon: 'settings', label: 'Settings', path: '/admin-settings' },
    // { icon: 'play', label: 'Sandbox', path: '/admin-snaps-lab'}
  ]

  // Persisted locally rather than in the URL: nav Links don't carry search params,
  // so a query-string flag reset to expanded on every navigation.
  const NAV_COMPACT_STORAGE_KEY = 'livesnaps:admin-nav-compact'

  const readNavCompactPreference = () => {
    if (typeof window === 'undefined') return false
    try {
      return window.localStorage.getItem(NAV_COMPACT_STORAGE_KEY) === 'true'
    } catch {
      return false
    }
  }

  const persistNavCompactPreference = (compact: boolean) => {
    try {
      window.localStorage.setItem(NAV_COMPACT_STORAGE_KEY, String(compact))
    } catch {
      // The state still applies for the current session when storage is unavailable.
    }
  }

  const resolveAdminNavLabel = (pathname: string) =>
    navs.find(item => item.exact ? pathname === item.path : pathname === item.path || pathname.startsWith(`${item.path}/`))?.label ?? 'Admin'

  // The router sets `data-status="active"` on a matching Link, so the active
  // route is read off the link itself rather than by comparing paths here.
  type AccountPickerProps = {
    compact?: boolean
    onChange: (value: string) => void
    options: readonly { label: string; value: string }[]
    value: string
  }

  const navLinkClassName =
    'relative flex h-14 items-center text-foreground/80 transition-colors rounded-lg hover:text-foreground hover:bg-foreground/5'
  const activeNavClassName = "bg-[linear-gradient(in_oklab_180deg,oklab(92.2%_0_0)_0%,oklab(91.3%_0_0)_100%)] hover:bg-[linear-gradient(in_oklab_180deg,oklab(95.2%_0_0)_0%,oklab(91.3%_0_0)_100%)] text-[#121212]! shadow-[inset_0_1px_0_#FFFFFF54,0_3px_4px_-1px_#00000026,0_0_0_1px_#D4D4D4]"

component AdminNavigation
  props { compact = false, onNavigate }: { compact?: boolean; onNavigate?: () => void }
  nav(className='flex-1 w-full')
    ul(className={cn('flex flex-col space-y-2', compact && 'space-y-2.5!')})
      each item in navs key item.path
        li(className='font-sans w-full')
          Link(
            ~ to={item.path}
            ~ onClick={onNavigate}
            ~ aria-label={item.label}
            ~ title={compact ? item.label : undefined}
            ~ activeOptions={{ exact: item.exact ?? false, includeSearch: false }}
            ~ activeProps={{ className: activeNavClassName }}
            ~ className={cn(navLinkClassName, compact ? 'justify-center h-12!' : 'gap-4 px-3')}
            ~ )
            Icon(name={item.icon as IconName} className='size-6')
            if !compact
              span #{item.label}

component AccountPicker
  props { compact = false, onChange, options, value }: AccountPickerProps
  // The compact rail is 64px wide, so the picker steps aside rather than
  // rendering a control too narrow to read an Account name in.
  if !compact
    div(className='px-4')
      label(className='mb-1.5 block font-mono text-2xs uppercase tracking-[0.14em] text-muted-foreground sr-only' htmlFor='admin-account-picker') Account
      SelectOctane(
        ~ inputId='admin-account-picker'
        ~ aria-label='Active Account'
        ~ className={cn('text-sm border-none ring-0 outline-none')}
        ~ controlClassName={cn({'w-full! transition-opacity! duration-200! ease-out! opacity-0!':options.length === 0})}
        ~ isDisabled={options.length === 0}
        ~ isSearchable={options.length > 6}
        ~ onChange={onChange}
        ~ options={options}
        ~ placeholder={options.length === 0 ? 'No Accounts' : 'Select an Account'}
        ~ value={value}
        ~ )

component PageTitle
  props {title, className}: {title: string, className?: ClassValue}
  div(className={className})
    span  #{title}

setup
  const { hasGodAccess, user } = useFirebaseUser()
  const [email, setEmail] = useState<string | null>(null)
  const [sessionUid, setSessionUid] = useState('')
  const [isNavigationCompact, setIsNavigationCompact] = useState(readNavCompactPreference)
  const navigationPanelRef = usePanelRef()
  const [isMobileNavOpen, setIsMobileNavOpen] = useState(false)
  const [status, setStatus] = useState<'loading' | 'ready' | 'unauthorized' | 'error'>('loading')
  const isMobile = useMobile()
  const location = useLocation()
  const activeNavLabel = resolveAdminNavLabel(location.pathname)
  const workspace = useWorkspaceAccounts(sessionUid)
  // Adopts the cookie'd session into the Firebase client on this origin, so the
  // menu can show a real name, photo, and god-only links.
  useConsoleFirebaseSession('admin', status === 'ready')

  useEffect(() => {
    const panel = navigationPanelRef.current
    if (!panel) return

    const targetSize = isNavigationCompact ? 64 : 216
    if (Math.abs(panel.getSize().inPixels - targetSize) > 1) {
      panel.resize(`${targetSize}px`)
    }
  }, [isNavigationCompact])

  const handleNavigationResize = (size: { inPixels: number }) => {
    const nextCompact = size.inPixels <= 80
    if (nextCompact === isNavigationCompact) return
    setIsNavigationCompact(nextCompact)
    persistNavCompactPreference(nextCompact)
  }

  useEffect(() => {
    let cancelled = false

    const loadSession = async () => {
      try {
        const response = await fetch('/api/admin/session', { credentials: 'same-origin' })

        if (!response.ok) {
          if (!cancelled) setStatus('unauthorized')
          return
        }

        const payload: unknown = await response.json()
        const nextEmail =
          typeof payload === 'object' && payload !== null && typeof (payload as { email?: unknown }).email === 'string'
            ? (payload as { email: string }).email
            : null

        if (!cancelled) {
          setEmail(nextEmail)
          setSessionUid(typeof payload === 'object' && payload !== null && typeof (payload as { uid?: unknown }).uid === 'string' ? (payload as { uid: string }).uid : '')
          setStatus('ready')
        }
      } catch {
        if (!cancelled) setStatus('error')
      }
    }

    void loadSession()
    return () => {
      cancelled = true
    }
  }, [])
if isMobile
  div(className='min-h-screen bg-sunken')
    Sidebar(open={isMobileNavOpen} onOpenChange={setIsMobileNavOpen} title='Admin navigation' brand='admin' triggerLabel={activeNavLabel} className='bg-sunken')
      div(className='flex min-h-0 flex-1 flex-col px-4.5')
        div(className='space-y-3')
          div(className='h-14 flex items-center')
            Switcher(
              ~ items={workspace.options.map(account => ({ id: account.value, label: account.label }))}
              ~ title='Accounts'
              ~ activeId={workspace.selectedId}
              ~ compact={false}
              ~ emptyLabel={workspace.error || 'Select account'}
              ~ busy={workspace.accounts === null && !workspace.error}
              ~ onSelect={(account) => workspace.selectAccount(account.id)}
              ~ )
          AdminNavigation(onNavigate={() => setIsMobileNavOpen(false)})

        div(className='mt-auto shrink-0 border-t border-sidebar-border/70 pb-[max(0.75rem,env(safe-area-inset-bottom))] pt-2')
          div(className='flex h-14 items-center px-4')
            ThemeToggle
          div(className='px-2 py-2')
            UserMenu(
              ~ name={user?.displayName}
              ~ email={email ?? user?.email}
              ~ photoUrl={user?.photoURL}
              ~ hasGodAccess={hasGodAccess}
              ~ onSignOut={() => setIsMobileNavOpen(false)}
              ~ )
    main(className='min-h-screen bg-sunken pt-11')
      if status === 'loading'
        div(className='grid min-h-[calc(100vh-4rem)] place-items-center px-6 text-center')
          p(className='text-sm text-muted-foreground') Verifying your Account session…
      elseif status === 'ready'
        WorkspaceProvider(key={sessionUid} uid={sessionUid} account={workspace.account} accounts={workspace.accounts} error={workspace.error} onSelect={workspace.selectAccount} onRetry={workspace.retry})
      elseif status === 'unauthorized'
        div(className='grid min-h-[calc(100vh-4rem)] place-items-center px-6 text-center')
          div(className='max-w-md')
            p(className='text-sm text-muted-foreground') You do not have an active Account session.
            a(href='https://livesnapsnow.com/' className='mt-6 inline-flex h-10 items-center rounded-full bg-foreground px-5 text-sm font-medium text-background') Return to Live Snaps Now
      else
        div(className='grid min-h-[calc(100vh-4rem)] place-items-center px-6 text-center')
          p(className='text-sm text-destructive') We could not verify your Account session. Please try again.
else
  Group(className='min-h-screen h-dvh')
    Panel(
      ~ id='navigation'
      ~ panelRef={navigationPanelRef}
      ~ defaultSize={isNavigationCompact ? '64px' : '216px'}
      ~ minSize='64px'
      ~ maxSize='216px'
      ~ groupResizeBehavior='preserve-pixel-size'
      ~ onResize={handleNavigationResize}
      ~ )
      aside(className={cn('flex h-full min-w-0 w-full flex-col px-4 bg-sunken dark:bg-sunken/40', isNavigationCompact && 'px-1.5!')})
        div(className={cn('hidden _flex h-28 items-center', isNavigationCompact ? 'justify-center px-2' : '')})
          Link(className='inline-flex items-center gap-2 text-[clamp(0.8rem,3vw,1.2rem)] font-poly font-medium text-foreground/90 tracking-tight' to='/' aria-label='App home')
            if isNavigationCompact
              Icon(name='livesnaps')
            else
              h1(className='')
                span(className='uppercase text-beach dark:text-foreground') Live
                span(className='uppercase dark:text-lime-200') Snaps
                span(className='text-sand dark:text-foreground') Now
        div(className='h-20 flex items-center')
          Switcher(
            ~ items={workspace.options.map(account => ({ id: account.value, label: account.label }))}
            ~ title='Accounts'
            ~ activeId={workspace.selectedId}
            ~ compact={isNavigationCompact}
            ~ emptyLabel={workspace.error || 'Select account'}
            ~ busy={workspace.accounts === null && !workspace.error}
            ~ onSelect={(account) => workspace.selectAccount(account.id)}
            ~ )
        AdminNavigation(compact={isNavigationCompact})
        // No `user !== null` gate here. Firebase auth state is per-origin and the
        // handoff only hands this origin a session cookie, so the client SDK never
        // has a user on the admin subdomain - the gate hid the menu on desktop for
        // every admin, while the mobile drawer below rendered it unconditionally.
        // The session email carries the identity; the theme toggle lives in the popup.

        div(className={cn('flex items-center justify-start h-16 px-3', isNavigationCompact && 'px-3!')})
          ThemeToggle
        div(className={cn('flex items-center justify-center py-4 py-1', isNavigationCompact && 'px-2')})
          UserMenu(
            ~ compact={isNavigationCompact}
            ~ name={user?.displayName}
            ~ email={email ?? user?.email}
            ~ photoUrl={user?.photoURL}
            ~ hasGodAccess={hasGodAccess}
            ~ )
    Separator(aria-label='Resize admin navigation' className='group relative -ml-1.5 w-1.5 shrink-0')
      span(className='pointer-events-none absolute inset-y-0 -left-1.5 -right-1.5 -translate-x-1 transition-colors duration-180 ease-out group-hover:bg-active dark:group-hover:bg-lime-200')
    Panel(id='content' minSize='40%')
      main(className='min-h-[calc(100vh-160px)] bg-background')
        if status === 'loading'
          div(className='flex items-center justify-center gap-2 min-h-screen')
            Icon(name='spinner-ferris')
            p(className='text-sm md:text-base text-muted-foreground') Verifying your Account session
        elseif status === 'ready'
          WorkspaceProvider(key={sessionUid} uid={sessionUid} account={workspace.account} accounts={workspace.accounts} error={workspace.error} onSelect={workspace.selectAccount} onRetry={workspace.retry})
        elseif status === 'unauthorized'
          div(className='grid min-h-screen place-items-center px-6 text-center')
            div(className='max-w-md')
              p(className='text-sm text-muted-foreground') You do not have an active Account session.
              a(href='https://livesnapsnow.com/' className='mt-6 inline-flex h-10 items-center rounded-full bg-foreground px-5 text-sm font-medium text-background') Return to Live Snaps Now
        else
          div(className='grid min-h-screen place-items-center px-6 text-center')
            p(className='text-sm text-destructive') We could not verify your Account session. Please try again.
