import { useForm, useSelector } from '@octanejs/tanstack-form'
import { useWorkspace, accountEndpoint } from '@/hooks/use-workspace'
import { useRecipientDefaults } from '@/hooks/use-recipient-defaults'
import { writeWorkspaceJson } from '@/lib/accounts/link-client'
import { parseRecipientDefaults } from '@/lib/verifications/recipient-defaults'
import { onSuccess } from '@/lib/toast'
import { Button } from '@/components/ui'
import { Icon } from '@/lib/icons'
import EmailRecipientsSkeleton from "../components/admin/email-recipients-skeleton.btsx";
import InnerContainer from "../components/admin/inner-container.btsx";

module
  const cardClassName = 'overflow-hidden rounded-lg border border-border/60 bg-surface shadow-[0_12px_40px_-32px_rgba(0,0,0,0.55)]'

component RecipientList
  props { emails }: { emails: string[] }
  if emails.length
    ul(className='mt-4 divide-y divide-border/50 rounded-sm border border-border/50 bg-background/40')
      each email, index in emails key email
        li(className='flex min-w-0 items-center gap-2.5 px-3 py-2.5')
          span(className='grid size-6 shrink-0 place-items-center rounded-full bg-active/8 font-mono text-2xs text-active') #{index + 1}
          span(className='min-w-0 flex-1 truncate font-mono text-sm') #{email}
          if index === 0
            span(className='shrink-0 rounded-full bg-brand/10 px-2 py-0.5 font-mono text-2xs uppercase tracking-wider text-brand') Default
  else
    div(className='mt-4 rounded-sm border border-dashed border-border/60 px-4 py-8 text-center')
      p(className='text-sm text-muted-foreground') No shared recipients yet.

component RecipientDefaultsForm
  props { accountId, scope, emails, onSaved }: { accountId: string; scope: 'account' | 'member'; emails: string[]; onSaved: () => void }
  setup
    const form = useForm({
      defaultValues: { emails: emails.join('\n') },
      validators: { onChange: ({ value }) => {
        try { parseRecipientDefaults(value.emails); return undefined }
        catch (error) { return error instanceof Error ? error.message : 'Invalid addresses.' }
      } },
      onSubmit: async ({ value, formApi }) => {
        try {
          await writeWorkspaceJson(accountEndpoint('/api/admin/recipient-defaults', accountId), { scope, emails: parseRecipientDefaults(value.emails) })
          onSuccess('Recipient defaults saved.')
          onSaved()
        } catch (error) {
          // `setErrorMap` takes `GlobalFormValidationError`, not a bare string:
          // `{ form?: ValidationError; fields: Partial<Record<DeepKeys<T>, …>> }`.
          // The form-level message is unwrapped back into `state.errors`, so the
          // string filter below still renders it.
          formApi.setErrorMap({
            onSubmit: { form: error instanceof Error ? error.message : 'Could not save recipient defaults.', fields: {} }
          })
        }
      }
    })
    const value = useSelector(form.store, state => state.values.emails)
    const pending = useSelector(form.store, state => state.isSubmitting)
    const errors = useSelector(form.store, state => state.errors)
    const canSubmit = useSelector(form.store, state => state.canSubmit)
    const recipientCount = value.split(/\r?\n/).map(email => email.trim()).filter(Boolean).length
  form(className='mt-5 grid gap-3' onSubmit={(event: SubmitEvent) => { event.preventDefault(); void form.handleSubmit() }})
    div(className='flex items-center justify-between gap-3')
      label(htmlFor={`${scope}-recipients`} className='text-sm font-medium') Recipient addresses
      span(className='font-mono text-2xs uppercase tracking-wider text-muted-foreground') #{recipientCount} / 50
    div(className='relative')
      textarea(id={`${scope}-recipients`} value={value} disabled={pending} onInput={(event: Event) => form.setFieldValue('emails', (event.currentTarget as HTMLTextAreaElement).value)} aria-describedby={`${scope}-help`} placeholder={'reports@example.com\nfinance@example.com'} className='min-h-44 w-full resize-y rounded-sm border border-border/60 bg-sunken/60 p-3 font-mono text-sm leading-7 outline-none transition-colors placeholder:text-muted-foreground/45 focus:border-active/50 focus:ring-2 focus:ring-active/10 disabled:opacity-60')
    p(id={`${scope}-help`} className='text-xs leading-5 text-muted-foreground') One address per line. The first becomes the default. Leave this empty to #{scope === 'member' ? 'inherit the shared account list' : 'start new messages without a preset recipient'}.
    if errors.length
      p(className='rounded-sm border border-destructive/35 bg-destructive/8 px-3 py-2 text-sm text-destructive' role='alert') #{errors.filter(error => typeof error === 'string').join(' ')}
    div(className='flex items-center justify-between gap-3 border-t border-border/40 pt-3')
      p(className='font-mono text-2xs uppercase tracking-wider text-muted-foreground') #{scope === 'member' ? 'Private to you' : 'Workspace-wide'}
      Button(type='submit' variant='dark' size='sm' icon='check' label='Save recipients' pending={pending} pendingLabel='Saving…' disabled={!canSubmit})

setup
  const account = useWorkspace()
  const { settings, error, refresh } = useRecipientDefaults(account?.id)

InnerContainer
  header(className='flex flex-wrap items-end justify-between gap-4')
    div(className='py-4')
      p(className='font-mono text-2xs uppercase tracking-[0.2em] text-muted-foreground') Delivery
      h1(className='mt-1 font-poly font-medium text-lg md:text-xl tracking-tight') Email Service
      p(className='mt-1 max-w-3xl text-sm leading-6 text-muted-foreground') Set your recipient lists used when #{account?.name ?? 'your account'} creates or sends a verification.
    div(className='hidden items-center gap-2 rounded-full border border-border/50 bg-sidebar/30 px-3 py-1.5 font-mono text-2xs uppercase tracking-wider text-muted-foreground sm:flex')
      Icon(name='email-body' className='size-3.5')
      span First address is default
  if !account
    p(className='mt-6 rounded-lg border border-dashed border-border/60 px-4 py-10 text-center text-sm text-muted-foreground') Select an account to configure recipients.
  elseif error
    div(className='mt-6 rounded-lg border border-destructive/40 bg-destructive/8 p-4' role='alert')
      p(className='text-sm text-destructive') #{error}
      button(type='button' onClick={refresh} className='mt-2 text-sm underline') Retry
  elseif !settings
    EmailRecipientsSkeleton(className={cardClassName})
  else
    div(className='mt-5 grid items-start gap-4 lg:grid-cols-2')
      section(className={cardClassName})
        header(className='flex items-center justify-between border-b border-brand/40 bg-brand/8 px-4 py-4')
          div(className='flex items-start justify-between')
            div
              p(className='font-mono text-2xs uppercase tracking-[0.18em] text-brand') Shared
              h2(className='mt-1 font-sans text-base font-medium') #{account?.name ?? ' Account'} List

          p(className='text-xs leading-5 text-muted-foreground') available to everyone
        div(className={account.role !== 'owner' ? 'p-0': 'p-4'})
          if settings.canManageAccount
            RecipientDefaultsForm(accountId={account.id} scope='account' emails={settings.accountEmails} onSaved={refresh})
          else
            fragment
              div(className='px-3 py-2 font-mono text-foreground/70 text-xs -tracking-[0.02em] leading-5') An account owner or administrator can update this list.
              div(className='p-4')
                RecipientList(emails={settings.accountEmails})
      section(className={cardClassName})
        header(className='border-b border-active/15 bg-active/5 px-4 py-4')
          div(className='flex items-start justify-between gap-3')
            div
              p(className='font-mono text-2xs uppercase tracking-[0.18em] text-active') Personal override
              h2(className='mt-1 font-sans text-base font-medium') My defaults
            p(className='mt-1 text-xs leading-5 text-muted-foreground') for your eyes only
        div(className='p-4')
          RecipientDefaultsForm(accountId={account.id} scope='member' emails={settings.memberEmails} onSaved={refresh})

      div(className='h-36 w-full')
