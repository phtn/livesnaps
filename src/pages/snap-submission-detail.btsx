import { useEffect, useState } from 'octane'
import type { FunctionReturnType } from 'convex/server'
import type { api } from '../../convex/_generated/api'
import Badge from '@/components/ui/badge.btsx'
import Topbar from '@/components/topbar.btsx'
import { Icon, type IconName } from '@/lib/icons'
import { getMySubmission } from '@/lib/convex-client'
import { getAuthStateReady, getCurrentUser, subscribeToAuthState } from '@/lib/firebase'
import { cn } from '@/lib/utils'

module
  type SnapSubmission = NonNullable<FunctionReturnType<typeof api.snaps.q.getMineByRouteId>>
  type SnapStatus = SnapSubmission['status']
  type SnapPhoto = SnapSubmission['photos'][number]

  interface PageProps { snapId: string }
  interface DetailItemProps { label: string; value: string }
  interface PhotoCardProps { photo: SnapPhoto }

  const dateFormatter = new Intl.DateTimeFormat('en-PH', {
    dateStyle: 'medium',
    timeStyle: 'short'
  })
  const numberFormatter = new Intl.NumberFormat('en-PH', { maximumFractionDigits: 1 })
  const statusPresentation: Record<SnapStatus, { badge: string; icon: IconName; label: string }> = {
    active: { badge: 'border-blue-500/25 bg-blue-500/8 text-blue-700 dark:text-blue-300', icon: 'sparkle', label: 'Active' },
    abandoned: { badge: 'border-zinc-500/20 bg-zinc-500/8 text-zinc-700 dark:text-zinc-300', icon: 'alert-diamond-fill', label: 'Abandoned' },
    cancelled: { badge: 'border-zinc-500/20 bg-zinc-500/8 text-zinc-700 dark:text-zinc-300', icon: 'cancel', label: 'Cancelled' },
    completed: { badge: 'border-blue-500/25 bg-blue-500/8 text-blue-700 dark:text-blue-300', icon: 'check-circle-fill', label: 'Submitted' },
    invalidated: { badge: 'border-red-500/25 bg-red-500/8 text-red-700 dark:text-red-300', icon: 'alert-octagon-fill', label: 'Invalidated' },
    pending: { badge: 'border-amber-500/25 bg-amber-500/8 text-amber-700 dark:text-amber-300', icon: 'spinner-ferris', label: 'Pending' }
  }
  const formatDate = (value: number | null) => value === null ? 'Not available' : dateFormatter.format(new Date(value))
  const formatVehicle = (submission: SnapSubmission) =>
    [submission.year, submission.make, submission.model].filter(Boolean).join(' ') || 'Vehicle details unavailable'
  const formatMileage = (value: number | null) =>
    value === null ? 'Not recorded' : `${numberFormatter.format(value)} km`
  const formatAccuracy = (value: number | null) =>
    value === null ? 'Not recorded' : `Within ${numberFormatter.format(value)} m`
  const formatPhotoSize = (bytes: number) =>
    bytes < 1024 * 1024
      ? `${numberFormatter.format(bytes / 1024)} KB`
      : `${numberFormatter.format(bytes / (1024 * 1024))} MB`

component DetailItem
  props { label, value }: DetailItemProps
  div(className='min-w-0 border-b border-border/40 p-4 last:border-b-0 sm:border-b-0 sm:border-r sm:px-5 sm:first:pl-0 sm:last:border-r-0 sm:last:pr-0')
    dt(className='font-mono text-[9px] uppercase tracking-[0.16em] text-muted-foreground') #{label}
    dd(className='mt-1.5 break-words text-sm text-foreground') #{value}

component PhotoCard
  props { photo }: PhotoCardProps
  setup const capturedAt = new Date(photo.capturedAt)
  li(className='group overflow-hidden rounded-2xl border border-border/30 bg-card/20 shadow-xs')
    div(className='grid aspect-[4/3] place-items-center bg-muted/70')
      div(className='grid size-14 place-items-center rounded-full border border-border/30 bg-background/75 text-muted-foreground transition-transform group-hover:scale-105')
        Icon(name='camera-enhance' className='size-7')
    div(className='flex items-start justify-between gap-3 px-4 py-3')
      div(className='min-w-0')
        p(className='truncate font-poly text-sm font-medium capitalize') #{photo.label || `Photo ${photo.slot}`}
        time(dateTime={capturedAt.toISOString()} className='mt-1 block text-xs text-muted-foreground') #{dateFormatter.format(capturedAt)}
      span(className='shrink-0 font-mono text-[9px] uppercase tracking-wide text-muted-foreground') #{formatPhotoSize(photo.size)}

component LoadingState
  div(className='grid min-h-[420px] place-items-center rounded-3xl border border-border/30 bg-card/20')
    div(className='flex items-center gap-3 text-sm text-muted-foreground')
      Icon(name='spinner-ferris' className='size-5 text-beach dark:text-lime-200')
      span Loading your snaps…

component MessageState
  props { icon, title, message }: { icon: IconName; title: string; message: string }
  div(className='grid min-h-[420px] place-items-center rounded-3xl border border-border/30 bg-card/20 px-6 text-center')
    div(className='max-w-md')
      span(className='mx-auto grid size-12 place-items-center rounded-full bg-muted text-muted-foreground')
        Icon(name={icon} className='size-6')
      h1(className='mt-5 font-poly text-2xl font-medium') #{title}
      p(className='mt-2 text-sm leading-6 text-muted-foreground') #{message}
      a(className='mt-6 inline-flex h-10 items-center gap-2 rounded-full bg-foreground px-5 text-sm font-medium text-background transition-opacity hover:opacity-85' href='/?#discover')
        Icon(name='arrow-left' className='size-4')
        span Back to My Snaps

props { snapId }: PageProps

setup
  const [user, setUser] = useState(getCurrentUser)
  const [isAuthReady, setIsAuthReady] = useState(getAuthStateReady)
  const [submission, setSubmission] = useState<SnapSubmission | null | undefined>(undefined)
  const [loadError, setLoadError] = useState<string | null>(null)

  useEffect(() => subscribeToAuthState(() => {
    setUser(getCurrentUser())
    setIsAuthReady(true)
  }), [])

  useEffect(() => {
    let cancelled = false

    if (!isAuthReady) return () => { cancelled = true }
    if (!user) {
      setSubmission(null)
      setLoadError(null)
      return () => { cancelled = true }
    }

    setSubmission(undefined)
    setLoadError(null)
    void getMySubmission(snapId)
      .then((nextSubmission) => {
        if (!cancelled) setSubmission(nextSubmission)
      })
      .catch((error) => {
        if (!cancelled) {
          setSubmission(null)
          setLoadError(error instanceof Error ? error.message : 'Unable to load this snap.')
        }
      })

    return () => { cancelled = true }
  }, [isAuthReady, snapId, user])

  useEffect(() => {
    const previousTitle = document.title
    document.title = submission
      ? `${submission.plateNumber.trim() || 'Snap'} — LiveSnapsNow`
      : 'Your snap — LiveSnapsNow'
    return () => { document.title = previousTitle }
  }, [submission])

  const presentation = submission ? statusPresentation[submission.status] : null

div(className='min-h-screen min-w-[320px] bg-background font-sans text-foreground antialiased')
  Topbar
  main(className='mx-auto w-full max-w-7xl px-4 pb-16 sm:px-8 sm:pb-24')
    if !isAuthReady || submission === undefined
      LoadingState
    elseif !user
      MessageState(icon='person' title='Sign in to view this snap' message='Use the account button above to sign in with the same Google account that created this submission.')
    elseif loadError
      MessageState(icon='alert-octagon-fill' title='We could not load this snap' message={loadError})
    elseif !submission || !presentation
      MessageState(icon='search' title='Snap not found' message='This submission does not exist, or it belongs to a different account.')
    else
      article

        section(className='overflow-hidden rounded-lg border border-border/30 bg-card/20 shadow-xs')
          div(className='relative overflow-hidden p-4')
            div(className='relative flex justify-between gap-6 flex-row items-start')
              div(className='min-w-0')
                p(className='font-mono text-[9px] uppercase tracking-[0.18em] text-muted-foreground') Snap submission
                h1(className='mt-2 truncate font-poly text-2xl font-medium uppercase tracking-tight sm:text-3xl') #{submission.plateNumber.trim() || 'No plate'}
                p(className='mt-2 text-sm text-muted-foreground') #{formatVehicle(submission)}
              Badge(variant='outline' className={cn('h-8 gap-1.5 pe-2.5', presentation.badge)})
                Icon(name={presentation.icon} className='size-3.5')
                span #{presentation.label}

          dl(className='border-t border-border/40 px-0 grid grid-cols-2 sm:grid-cols-4 sm:px-8')
            DetailItem(label='Started' value={formatDate(submission.startedAt)})
            DetailItem(label='Ended' value={formatDate(submission.endedAt)})
            DetailItem(label='Mileage' value={formatMileage(submission.mileage)})
            DetailItem(label='GPS accuracy' value={formatAccuracy(submission.bestAccuracyMeters)})

        if submission.invalidationReason
          section(role='status' className='mt-5 flex gap-3 rounded-lg border border-red-500/25 bg-red-500/5 px-4 py-4 text-sm text-red-800 dark:text-red-200')
            Icon(name='alert-octagon-fill' className='mt-0.5 size-5 shrink-0')
            div
              p(className='font-medium') Why this snap was invalidated
              p(className='mt-1 leading-6 opacity-80') #{submission.invalidationReason}

        section(className='mt-10' aria-labelledby='snap-location-heading')
          div(className='flex items-center gap-2')
            Icon(name='location' className='size-4 text-muted-foreground')
            h2(id='snap-location-heading' className='font-poly text-lg font-medium') Location
          div(className='mt-3 rounded-lg border border-border/30 bg-card/20 px-5 py-4 shadow-xs')
            p(className='text-sm leading-6') #{submission.address || 'No address was recorded.'}
            p(className='mt-2 font-mono text-[9px] uppercase tracking-[0.14em] text-muted-foreground')
              | IP country #{submission.countryCodeMatchesIpinfo === null ? 'not checked' : submission.countryCodeMatchesIpinfo ? 'matched' : 'did not match'}

        section(className='mt-10' aria-labelledby='snap-photos-heading')
          div(className='flex items-end justify-between gap-4')
            div
              p(className='font-mono text-[9px] uppercase tracking-[0.16em] text-muted-foreground') Evidence
              h2(id='snap-photos-heading' className='mt-1 font-poly text-lg font-medium') Submitted photos
            p(className='text-xs text-muted-foreground') #{submission.photoCount} of 5
          if submission.photos.length > 0
            ul(className='mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3')
              each photo in submission.photos key photo.slot
                PhotoCard(photo={photo})
          else
            div(className='mt-4 grid min-h-36 place-items-center rounded-2xl border border-dashed border-border/60 bg-muted/30 px-6 text-center text-sm text-muted-foreground') No photos were submitted.

        p(className='mt-10 text-center font-mono text-[9px] uppercase tracking-[0.14em] text-muted-foreground') Last updated #{formatDate(submission.updatedAt)}
