import { useCallback, useMemo, useState } from 'octane'
import { useAdminSnaps } from '@/hooks/use-admin-snaps'
import { buildSnapGallery, DEFAULT_COLUMN_PINNING, DEFAULT_COLUMN_VISIBILITY, EMPTY_SNAPS, PAGE_SIZES, SNAP_LIST_LIMIT, snapColumns, toViewerPhotos, type SnapRow } from '@/components/admin/snap-columns'
import { exportSnapReportById } from '@/components/admin/downloadSnapReport'
import DataTable from '@/components/ui/table/DataTable.btsx'
import { SnapRowActions } from '@/components/ui/table/row-actions.btsx'
import SnapFilterList from '@/components/admin/SnapFilterList.btsx'
import PhotoViewer from '@/components/photo-viewer.btsx'
import ErrorPage from '@/components/error.btsx'
import { Icon } from '@/lib/icons'
import Icon from "../lib/icons/icon.btsx";

props {}: {}
setup
  // Reads go through the Worker, which is protected by the admin session
  // cookie and re-mints an ID token for Convex server-side. The browser on the
  // admin origin has no Firebase client identity, so it cannot query Convex.
  const { error, isLoading, lastUpdatedAt, refresh, snaps } = useAdminSnaps(SNAP_LIST_LIMIT)
  const rows = snaps ?? EMPTY_SNAPS
  // A poll failure keeps the last good rows, so the table stays up and the
  // error reads as "stale" rather than replacing everything.
  const hasRows = snaps !== undefined
  const freshnessLabel = lastUpdatedAt ? `${new Date(lastUpdatedAt).toLocaleTimeString()}` : ''

  const [activePhotoSnapId, setActivePhotoSnapId] = useState<SnapRow['_id'] | null>(null)
  const gallery = buildSnapGallery(rows.find((snap) => snap._id === activePhotoSnapId))
  const viewerPhotos = useMemo(() => (gallery ? toViewerPhotos(gallery.photos) : []), [gallery?.uploadId])

  const closePhotoViewer = useCallback((open: boolean) => {
    if (!open) setActivePhotoSnapId(null)
  }, [])

  const [reportViewerSnapId, setReportViewerSnapId] = useState<SnapRow['_id'] | null>(null)
  const closeReportViewer = useCallback((open: boolean) => {
    if (!open) setReportViewerSnapId(null)
  }, [])

main
  div
    if isLoading && !hasRows
      ErrorPage(code={200} title='Fetching Data' message={'Loading Snaps'} actionLabel='')
    elseif error && !hasRows
      ErrorPage(code={500} title='Error' message={error} action={refresh} actionLabel='Retry')
    else
      SnapRowActions.Provider(
        ~ onExportReport={exportSnapReportById}
        ~ onOpenPhotoViewer={setActivePhotoSnapId}
        ~ onOpenReportViewer={setReportViewerSnapId}
        ~ )
        DataTable(
          ~ title='Snaps'
          ~ data={rows}
          ~ columns={snapColumns}
          ~ filterList={SnapFilterList}
          ~ getRowId={(row) => row._id}
          ~ initialColumnPinning={DEFAULT_COLUMN_PINNING}
          ~ initialColumnVisibility={DEFAULT_COLUMN_VISIBILITY}
          ~ initialPageSize={50}
          ~ pageSizes={PAGE_SIZES}
          ~ emptyTitle='No snaps'
          ~ emptyDescription='Snaps will appear here as they are captured.'
          ~ )
          fragment
            div(className='flex items-center gap-3 text-xs text-muted-foreground')
              if error
                span(className='text-destructive') #{error} — showing the last successful load.
              else
                div(className='flex items-center gap-1')
                  Icon(name='history' size='12')
                  span(className='font-mono') #{freshnessLabel}
              button(type='button' className='group hover:bg-sidebar rounded-sm active:bg-sidebar-border active:scale-97 transition-all duration-200 ease-out' onClick={refresh})
                Icon(name='refresh' size='12' className='group-active:rotate-180 transition-transform duration-200 ease-out')
  if gallery
    PhotoViewer(
      ~ open={true}
      ~ photos={viewerPhotos}
      ~ title={gallery.title}
      ~ onOpenChange={closePhotoViewer}
      ~ )
  SnapRowActions.ReportViewerDialog(
    ~ snapId={reportViewerSnapId}
    ~ open={reportViewerSnapId !== null}
    ~ onOpenChange={closeReportViewer}
    ~ )
