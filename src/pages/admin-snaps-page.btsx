import { SnapHandlerProvider } from '@/components/admin/snap-handler.btsx'
import { createElement, useCallback, useEffect, useMemo, useState } from 'octane'
import { accountEndpoint, useWorkspace } from '@/hooks/use-workspace'
import { useAdminPages } from '@/hooks/use-admin-pages'
import { workspaceJson } from '@/lib/accounts/link-client'
import type { AdminSnapListItem } from '@/lib/snaps/admin-photo-types'
import { useAdminSnaps } from '@/hooks/use-admin-snaps'
import { buildSnapGallery, DEFAULT_COLUMN_PINNING, DEFAULT_COLUMN_VISIBILITY, EMPTY_SNAPS, PAGE_SIZES, SNAP_LIST_LIMIT, snapColumns, toViewerPhotos, type SnapRow } from '@/components/admin/snap-columns'
import { exportSnapReportById } from '@/components/admin/downloadSnapReport'
import DataTable from '@/components/ui/table/DataTable.btsx'
import { SnapRowActions } from '@/components/ui/table/row-actions.btsx'
import SnapFilterList from '@/components/admin/SnapFilterList.btsx'
import PhotoViewer from '@/components/photo-viewer.btsx'
import ErrorPage from '@/components/error.btsx'
import { Icon } from '@/lib/icons'
import Icon from "../lib/icons/icon.btsx";
import {cn} from '@/lib/utils'
import Container from "../components/admin/container.btsx";
import Loading from "../components/loading.btsx";
import SelectOctane from '@/components/ui/SelectOctane.btsx'
import type { Option as SelectOption } from '@/components/ui/SelectOctane.btsx'
import { submissionLinkColorHex, type SubmissionLinkColor } from '@/lib/accounts/submission-links'

props {}: {}
setup
  // Reads go through the Worker, which is protected by the admin session
  // cookie and re-mints an ID token for Convex server-side. The browser on the
  // admin origin has no Firebase client identity, so it cannot query Convex.
  const account = useWorkspace()
  const [sourceLinkId, setSourceLinkId] = useState(() => new URLSearchParams(window.location.search).get('sourceLinkId') ?? '')
  const [sourceLinks, setSourceLinks] = useState<{ _id: string; label: string; color: SubmissionLinkColor }[]>([])
  useEffect(() => {
    const controller = new AbortController()
    void workspaceJson<{ links: { _id: string; label: string; color: SubmissionLinkColor }[] }>(accountEndpoint('/api/admin/submission-links', account?.id ?? ''), { signal: controller.signal })
      .then(result => { if (!controller.signal.aborted) setSourceLinks(result.links) }).catch(() => {})
    return () => controller.abort()
  }, [account?.id])
  const sourceLinkOptions = useMemo(
    () => [
      { value: '', label: 'All links' },
      ...sourceLinks.map((link) => ({ value: link._id, label: `#${link.label}`, color: submissionLinkColorHex(link.color) })),
    ],
    [sourceLinks],
  )
  const handleSourceLinkChange = useCallback((id: string) => {
    setSourceLinkId(id)
    const url = new URL(window.location.href)
    if (id) url.searchParams.set('sourceLinkId', id)
    else url.searchParams.delete('sourceLinkId')
    window.history.replaceState(null, '', url)
  }, [])
  const formatSourceLinkOption = (option: SelectOption) => createElement('span', {
    className: 'flex min-w-0 items-center gap-2',
    children: [
      option.color ? createElement('span', { className: 'size-2 shrink-0 rounded-full', style: { backgroundColor: option.color } }) : null,
      createElement('span', { className: 'truncate', children: option.label })
    ]
  })
  const sourceLinkSelect = createElement(SelectOctane, {
    'aria-label': 'Filter submissions by source link',
    className: 'w-36 sm:w-48',
    classNames: {
      control: () => 'h-8 min-h-8! px-1.5 bg-zinc-200/50! dark:bg-zinc-200/8! hover:bg-active/50! dark:hover:bg-mist-100/5! font-mono text-sm text-foreground/50! uppercase',
      option: () => 'text-xs',
      singleValue: () => 'text-xs',
    },
    isSearchable: sourceLinkOptions.length > 8,
    formatOptionLabel: formatSourceLinkOption,
    onChange: handleSourceLinkChange,
    options: sourceLinkOptions,
    value: sourceLinkId,
  })
  const path = accountEndpoint(`/api/admin/snaps${sourceLinkId ? `?sourceLinkId=${encodeURIComponent(sourceLinkId)}` : ''}`, account?.id ?? '')
  const { error, isLoading, lastUpdatedAt, refresh, items: snaps, loadMore, hasMore } = useAdminPages<AdminSnapListItem>(path)
  const rows = snaps ?? EMPTY_SNAPS
  // A poll failure keeps the last good rows, so the table stays up and the
  // error reads as "stale" rather than replacing everything.
  const hasRows = snaps !== undefined
  const freshnessLabel = lastUpdatedAt ? `${new Date(lastUpdatedAt).toLocaleTimeString()}` : ''

  const [activePhotoSnapId, setActivePhotoSnapId] = useState<SnapRow['_id'] | null>(null)
  const gallery = buildSnapGallery(rows.find((snap) => snap._id === activePhotoSnapId))
  const viewerPhotos = useMemo(() => (gallery ? toViewerPhotos(gallery.photos) : []), [gallery?.uploadId])

  const closePhotoViewer = useCallback((open: boolean) => {
    if (!open) setActivePhotoSnapId(null)
  }, [])

  const [reportViewerSnapId, setReportViewerSnapId] = useState<SnapRow['_id'] | null>(null)
  const closeReportViewer = useCallback((open: boolean) => {
    if (!open) setReportViewerSnapId(null)
  }, [])

Container(className='md:py-0')
  if isLoading && !hasRows
    Loading
  elseif error && !hasRows
    ErrorPage(code={500} title='Error' message={error} action={refresh} actionLabel='Retry')
  else
    SnapHandlerProvider(refresh={refresh})
      SnapRowActions.Provider(
        ~ onExportReport={exportSnapReportById}
        ~ onOpenPhotoViewer={setActivePhotoSnapId}
        ~ onOpenReportViewer={setReportViewerSnapId}
        ~ )
        DataTable(
          ~ title='Snaps'
          ~ data={rows}
          ~ columns={snapColumns}
          ~ filterList={SnapFilterList}
          ~ getRowId={(row) => row._id}
          ~ initialColumnPinning={DEFAULT_COLUMN_PINNING}
          ~ initialColumnVisibility={DEFAULT_COLUMN_VISIBILITY}
          ~ initialPageSize={50}
          ~ pageSizes={PAGE_SIZES}
          ~ titleActions={sourceLinkSelect}
          ~ emptyTitle='No snaps'
          ~ emptyDescription='Snaps will appear here as they are captured.'
          ~ )
          fragment
            div(className='flex items-center gap-3 text-xs text-muted-foreground')
              if error
                span(className='text-destructive') #{error} — showing the last successful load.
              else
                div(className='flex items-center gap-1')
                  span(className='font-mono') #{freshnessLabel}
              button(type='button' className='group hover:bg-sidebar rounded-sm active:bg-sidebar-border active:scale-97 transition-all duration-200 ease-out' onClick={refresh})
                Icon(name='refresh' size='12' className='group-active:rotate-180 transition-transform duration-200 ease-out')
              if hasMore
                button(type='button' onClick={loadMore} disabled={isLoading} className='rounded border border-border px-3 py-1.5 text-xs disabled:opacity-50') #{isLoading ? 'Loading…' : 'Load more'}
  if gallery
    PhotoViewer(
      ~ open={true}
      ~ photos={viewerPhotos}
      ~ title={gallery.title}
      ~ onOpenChange={closePhotoViewer}
      ~ )
  SnapRowActions.ReportViewerDialog(
    ~ snapId={reportViewerSnapId}
    ~ open={reportViewerSnapId !== null}
    ~ onOpenChange={closeReportViewer}
    ~ )
