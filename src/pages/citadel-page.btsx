import { useEffect, useState } from 'octane'
import { Icon } from '@/lib/icons'
import { cn } from '@/lib/utils'
import { useFirebaseUser } from '@/lib/firebase/auth'
import { useConsoleFirebaseSession } from '@/lib/firebase/console-session'
import { buildGodsHandoffUrl, isGodsSubdomainHostname } from '@/lib/routing/gods-subdomain'
import { useMobile } from '@/hooks/use-mobile'
import UserMenu from '../components/admin/user-menu.btsx'
import { Link, Outlet } from '@octanejs/tanstack-router'
import { Group, Panel, Separator } from '@octanejs/resizable-panels'
import ThemeToggle from '@/components/theme-toggle.btsx'
import Container from "../components/admin/container.btsx";
import Sidebar from '@/components/ui/sidebar.btsx'

module
  type NavItem = {
    icon: string
    label: string
    path: '/citadel' | '/citadel/accounts' | '/citadel/settings'
    /**
     * Index routes match by prefix like every other link, so `/citadel` would
     * stay lit on every page beneath it. Only those need an exact match.
     */
    exact?: boolean
  }
  const navs: NavItem[] = [
    { icon: 'folder', label: 'Overview', path: '/citadel', exact: true },
    { icon: 'account', label: 'Accounts', path: '/citadel/accounts' },
    { icon: 'settings', label: 'Settings', path: '/citadel/settings' },
  ]

  // The router sets `data-status="active"` on a matching Link, so the active
  // route is read off the link itself rather than by comparing paths here.
  const navLinkClassName =
    'relative flex h-14 items-center text-foreground/70 transition-colors md:data-[status=active]:rounded-e-lg data-[status=active]:bg-foreground/6 data-[status=active]:text-foreground dark:data-[status=active]:text-lime-200'

component Navigation
  props { compact = false, onNavigate }: { compact?: boolean; onNavigate?: () => void }
  nav(className='flex-1 w-full')
    ul(className='flex flex-col space-y-2 py-0')
      each item in navs key item.path
        li(className='w-full font-sans text-foreground/70 hover:text-foreground md:rounded-e-lg hover:bg-foreground/8 tracking-tight transition-colors duration-200 ease-out')
          Link(
            ~ to={item.path}
            ~ onClick={onNavigate}
            ~ aria-label={item.label}
            ~ title={compact ? item.label : undefined}
            ~ activeOptions={{ exact: item.exact ?? false, includeSearch: false }}
            ~ className={cn(navLinkClassName, compact ? 'justify-center px-0' : 'gap-3 px-6')}
            ~ )
            Icon(name={item.icon} className='size-6 md:size-5')
            if !compact
              span(className='font-sans') #{item.label}

setup
  const { hasGodAccess, user } = useFirebaseUser()
  // `useMobile` returns the boolean itself, not a wrapper object.
  const isMobile = useMobile()
  const isGodsHost = typeof window !== 'undefined' && isGodsSubdomainHostname(window.location.hostname)
  const [email, setEmail] = useState<string | null>(null)
  const [isNavigationCompact, setIsNavigationCompact] = useState(false)
  const [isMobileNavOpen, setIsMobileNavOpen] = useState(false)
  const [status, setStatus] = useState<'loading' | 'ready' | 'unauthorized' | 'error'>('loading')

  // Adopts the cookie'd session into the Firebase client on this origin, so the
  // menu can show a real name and photo instead of a bare fallback.
  useConsoleFirebaseSession('citadel', status === 'ready')

  useEffect(() => {
    let cancelled = false

    const setFailure = (nextStatus: 'unauthorized' | 'error') => {
      if (!cancelled) setStatus(nextStatus)
    }

    const openCitadel = async () => {
      if (!isGodsHost) {
        if (!user || !hasGodAccess) {
          setFailure('unauthorized')
          return
        }

        try {
          const idToken = await user.getIdToken(true)
          window.location.assign(buildGodsHandoffUrl(new URL(window.location.href), idToken).toString())
        } catch {
          setFailure('error')
        }
        return
      }

      const idToken = new URLSearchParams(window.location.hash.slice(1)).get('idToken')

      try {
        if (idToken) {
          const response = await fetch('/api/gods/session', {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ idToken })
          })

          if (!response.ok) {
            setFailure('unauthorized')
            return
          }

          window.history.replaceState(null, '', window.location.pathname)
        }

        const response = await fetch('/api/gods/session', { credentials: 'same-origin' })
        if (!response.ok) {
          setFailure('unauthorized')
          return
        }

        const payload: unknown = await response.json()
        const nextEmail =
          typeof payload === 'object' && payload !== null && typeof (payload as { email?: unknown }).email === 'string'
            ? (payload as { email: string }).email
            : null

        if (!cancelled) {
          setEmail(nextEmail)
          setStatus('ready')
        }
      } catch {
        setFailure('error')
      }
    }

    void openCitadel()
    return () => {
      cancelled = true
    }
  }, [hasGodAccess, isGodsHost, user])

if isMobile
  div(className='min-h-screen bg-background dark:bg-card/5')
    Sidebar(open={isMobileNavOpen} onOpenChange={setIsMobileNavOpen} title='Citadel navigation' brand='citadel')
      Navigation(onNavigate={() => setIsMobileNavOpen(false)})
      div(className='flex items-center justify-start h-16 px-5')
        ThemeToggle
      div(className='px-3 py-3')
        UserMenu(
          ~ scope='citadel'
          ~ name={user?.displayName}
          ~ email={email ?? user?.email}
          ~ photoUrl={user?.photoURL}
          ~ hasGodAccess={hasGodAccess}
          ~ user={user}
          ~ onSignOut={() => setIsMobileNavOpen(false)}
          ~ )
    main(className='min-h-screen bg-background dark:bg-card/1 pt-11')
      if status === 'loading'
        div(className='grid min-h-[calc(90vh)] place-items-center px-6 text-center')
          p(className='text-sm text-muted-foreground') Verifying your administrator session…
      elseif status === 'ready'
        Outlet
      elseif status === 'unauthorized'
        div(className='grid min-h-[calc(90vh)] place-items-center px-6 text-center')
          div(className='max-w-md')
            p(className='text-sm text-muted-foreground') You do not have an active administrator session.
            a(href='https://livesnapsnow.com/' className='mt-6 inline-flex h-10 items-center rounded-full bg-foreground px-5 text-sm font-medium text-background') Return to Live Snaps Now
      else
        div(className='grid min-h-[calc(100vh-4rem)] place-items-center px-6 text-center')
          p(className='text-sm text-destructive') We could not verify your administrator session. Please try again.
else
  Group(className='min-h-screen h-dvh')
    Panel(id='navigation' defaultSize='216px' minSize='64px' maxSize='216px' groupResizeBehavior='preserve-pixel-size' onResize={(size) => setIsNavigationCompact(size.inPixels <= 80)})
      aside(className='flex h-full min-w-0 w-full flex-col pe-6 dark:bg-[radial-gradient(circle_at_88%_10%,rgba(10,10,11,0.8),transparent_28rem),linear-gradient(145deg,#121213,#101011_64%)] bg-sunken')

        // div(className='absolute top-0 left-0 flex size-full min-h-0 flex-col dark:bg-[radial-gradient(circle_at_88%_10%,rgba(10,10,11,0.8),transparent_28rem),linear-gradient(145deg,#121213,#101011_64%)] p-4 text-[#f6f6f2] shadow-[0_22px_36px_rgba(15,16,14,0.18)]')
        div(className={cn('flex h-32 items-center', isNavigationCompact ? 'justify-center px-0' : 'px-6')})

          Link(className='inline-flex items-center gap-2 text-[clamp(1rem,3vw,1.2rem)] font-poly font-medium text-foreground/90 tracking-tight' to='/citadel' aria-label='Citadel home')
            if isNavigationCompact
              Icon(name='re-up.ph')
            else
              div(className='flex items-center gap-3')
                Icon(name='re-up.ph')
                h1(className='')
                  span(className='dark:text-lime-200') Citadel

        Navigation(compact={isNavigationCompact})
        div(className='flex items-center justify-start h-16 px-6')
          ThemeToggle
        div(className={cn('py-3', isNavigationCompact ? 'px-2' : 'px-3')})
          UserMenu(
            ~ scope='citadel'
            ~ compact={isNavigationCompact}
            ~ name={user?.displayName}
            ~ email={email ?? user?.email}
            ~ photoUrl={user?.photoURL}
            ~ hasGodAccess={hasGodAccess}
            ~ user={user}
            ~ )
    Separator(aria-label='Resize admin navigation' className='group relative -ml-1.5 w-1.5 shrink-0')
      span(className='pointer-events-none absolute inset-y-0 -left-1.5 -right-1.5 -translate-x-1 transition-colors duration-180 ease-out group-hover:bg-blue-500 dark:group-hover:bg-lime-200 group-focus-visible:bg-sand')
    Panel(id='content' minSize='40%')
      main(className='min-h-screen bg-sunken dark:bg-[radial-gradient(circle_at_88%_10%,rgba(10,10,11,0.8),transparent_28rem),linear-gradient(145deg,#121213,#101011_64%)]')
        if status === 'loading'
          div(className='flex items-center justify-center gap-2 h-[calc(90vh)]')
            Icon(name='spinner-ferris' className='size-8 opacity-60')
        elseif status === 'ready'
          Container
            Outlet
        elseif status === 'unauthorized'
          div(className='grid min-h-screen place-items-center px-6 text-center')
            div(className='max-w-md')
              p(className='text-sm text-muted-foreground') You do not have an active administrator session.
              a(href='https://livesnapsnow.com/' className='mt-6 inline-flex h-10 items-center rounded-full bg-foreground px-5 text-sm font-medium text-background') Return to Live Snaps Now
        else
          div(className='grid min-h-screen place-items-center px-6 text-center')
            p(className='text-sm text-destructive') We could not verify your administrator session. Please try again.
