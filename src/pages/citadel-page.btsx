import { useEffect, useState } from 'octane'
import { Icon, type IconName } from '@/lib/icons'
import { cn } from '@/lib/utils'
import { useFirebaseUser } from '@/lib/firebase/auth'
import { useConsoleFirebaseSession } from '@/lib/firebase/console-session'
import { buildGodsHandoffUrl, isGodsSubdomainHostname } from '@/lib/routing/gods-subdomain'
import { useMobile } from '@/hooks/use-mobile'
import UserMenu from '../components/admin/user-menu.btsx'
import { Link, Outlet } from '@octanejs/tanstack-router'
import { Group, Panel, Separator, usePanelRef } from '@octanejs/resizable-panels'
import { parseAsBoolean, useQueryState } from '@octanejs/nuqs'
import ThemeToggle from '@/components/theme-toggle.btsx'
import Container from '../components/admin/container.btsx'
import Sidebar from '@/components/ui/sidebar.btsx'

module
  type NavItem = {
    icon: IconName
    label: string
    path: '/citadel' | '/citadel/accounts' | '/citadel/vision' | '/citadel/settings'
    /**
     * Index routes match by prefix like every other link, so `/citadel` would
     * stay lit on every page beneath it. Only those need an exact match.
     */
    exact?: boolean
  }
  const navs: NavItem[] = [
    { icon: 'folder', label: 'Overview', path: '/citadel', exact: true },
    { icon: 'account', label: 'Accounts', path: '/citadel/accounts' },
    { icon: 'ocr', label: 'Vision', path: '/citadel/vision' },
    { icon: 'settings', label: 'Settings', path: '/citadel/settings' },
  ]

  // The router sets `data-status="active"` on a matching Link, so the active
  // route is read off the link itself rather than by comparing paths here.
  const navLinkClassName =
    'relative flex h-14 items-center text-foreground/80 transition-colors rounded-lg'
  const activeNavClassName =
    'bg-[linear-gradient(in_oklab_180deg,oklab(92.2%_0_0)_0%,oklab(91.3%_0_0)_100%)] hover:bg-[linear-gradient(in_oklab_180deg,oklab(95.2%_0_0)_0%,oklab(91.3%_0_0)_100%)] text-[#121212]! shadow-[inset_0_1px_0_#FFFFFF54,0_3px_4px_-1px_#00000026,0_0_0_1px_#D4D4D4]'

component Navigation
  props { compact = false, onNavigate }: { compact?: boolean; onNavigate?: () => void }
  nav(className='flex-1 w-full')
    ul(className={cn('flex flex-col space-y-1', compact && 'space-y-2.5!')})
      each item in navs key item.path
        li(className='font-sans w-full hover:text-foreground hover:bg-sidebar/60')
          Link(
            ~ to={item.path}
            ~ onClick={onNavigate}
            ~ aria-label={item.label}
            ~ title={compact ? item.label : undefined}
            ~ activeOptions={{ exact: item.exact ?? false, includeSearch: false }}
            ~ activeProps={{ className: activeNavClassName }}
            ~ className={cn(navLinkClassName, compact ? 'justify-center h-12!' : 'gap-4 px-3')}
            ~ )
            Icon(name={item.icon} className='size-6')
            if !compact
              span #{item.label}

setup
  const { hasGodAccess, isLoading: isAuthLoading, user } = useFirebaseUser()
  // `useMobile` returns the boolean itself, not a wrapper object.
  const isMobile = useMobile()
  const isGodsHost = typeof window !== 'undefined' && isGodsSubdomainHostname(window.location.hostname)
  const [email, setEmail] = useState<string | null>(null)
  const [isNavigationCompact, setIsNavigationCompact] = useQueryState(
    'compact',
    parseAsBoolean.withDefault(false).withOptions({ history: 'replace' })
  )
  const navigationPanelRef = usePanelRef()
  const [isMobileNavOpen, setIsMobileNavOpen] = useState(false)
  const [status, setStatus] = useState<'loading' | 'ready' | 'unauthorized' | 'error'>('loading')

  // Adopts the cookie'd session into the Firebase client on this origin, so the
  // menu can show a real name and photo instead of a bare fallback.
  useConsoleFirebaseSession('citadel', status === 'ready')

  useEffect(() => {
    const panel = navigationPanelRef.current
    if (!panel) return

    const targetSize = isNavigationCompact ? 64 : 216
    if (Math.abs(panel.getSize().inPixels - targetSize) > 1) {
      panel.resize(`${targetSize}px`)
    }
  }, [isNavigationCompact])

  const handleNavigationResize = (size: { inPixels: number }) => {
    const nextCompact = size.inPixels <= 80
    if (nextCompact !== isNavigationCompact) void setIsNavigationCompact(nextCompact)
  }

  useEffect(() => {
    let cancelled = false

    const setFailure = (nextStatus: 'unauthorized' | 'error') => {
      if (!cancelled) setStatus(nextStatus)
    }

    const openCitadel = async () => {
      if (!isGodsHost) {
        // Firebase restores the session and claims asynchronously; judging
        // before then flashes the unauthorized block for signed-in gods.
        if (isAuthLoading) return

        if (!user || !hasGodAccess) {
          setFailure('unauthorized')
          return
        }

        try {
          const idToken = await user.getIdToken(true)
          window.location.assign(buildGodsHandoffUrl(new URL(window.location.href), idToken).toString())
        } catch {
          setFailure('error')
        }
        return
      }

      const idToken = new URLSearchParams(window.location.hash.slice(1)).get('idToken')

      try {
        if (idToken) {
          const response = await fetch('/api/gods/session', {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ idToken })
          })

          if (!response.ok) {
            setFailure('unauthorized')
            return
          }

          window.history.replaceState(null, '', window.location.pathname)
        }

        const response = await fetch('/api/gods/session', { credentials: 'same-origin' })
        if (!response.ok) {
          setFailure('unauthorized')
          return
        }

        const payload: unknown = await response.json()
        const nextEmail =
          typeof payload === 'object' && payload !== null && typeof (payload as { email?: unknown }).email === 'string'
            ? (payload as { email: string }).email
            : null

        if (!cancelled) {
          setEmail(nextEmail)
          setStatus('ready')
        }
      } catch {
        setFailure('error')
      }
    }

    void openCitadel()
    return () => {
      cancelled = true
    }
  }, [hasGodAccess, isAuthLoading, isGodsHost, user])

if isMobile
  div(className='min-h-screen bg-sunken')
    Sidebar(open={isMobileNavOpen} onOpenChange={setIsMobileNavOpen} title='Citadel navigation' brand='citadel' className='bg-sunken')
      div(className='flex min-h-0 flex-1 flex-col px-4')
        Navigation(onNavigate={() => setIsMobileNavOpen(false)})
        div(className='mt-auto shrink-0 border-t border-sidebar-border/70 pb-[max(0.75rem,env(safe-area-inset-bottom))] pt-2')
          div(className='flex h-14 items-center px-4')
            ThemeToggle
          div(className='px-2 py-2')
            UserMenu(
              ~ scope='citadel'
              ~ name={user?.displayName}
              ~ email={email ?? user?.email}
              ~ photoUrl={user?.photoURL}
              ~ hasGodAccess={hasGodAccess}
              ~ user={user}
              ~ onSignOut={() => setIsMobileNavOpen(false)}
              ~ )
    main(className='min-h-screen bg-sunken pt-11')
      if status === 'loading'
        div(className='grid min-h-[calc(90vh)] place-items-center px-6 text-center')
          p(className='text-sm text-muted-foreground') Verifying your administrator session…
      elseif status === 'ready'
        Outlet
      elseif status === 'unauthorized'
        div(className='grid min-h-[calc(90vh)] place-items-center px-6 text-center')
          div(className='max-w-md')
            p(className='text-sm text-muted-foreground') You do not have an active administrator session.
            a(href='https://livesnapsnow.com/' className='mt-6 inline-flex h-10 items-center rounded-full bg-foreground px-5 text-sm font-medium text-background') Return to Live Snaps Now
      else
        div(className='grid min-h-[calc(100vh-4rem)] place-items-center px-6 text-center')
          p(className='text-sm text-destructive') We could not verify your administrator session. Please try again.
else
  Group(className='min-h-screen h-dvh')
    Panel(
      ~ id='navigation'
      ~ panelRef={navigationPanelRef}
      ~ defaultSize={isNavigationCompact ? '64px' : '216px'}
      ~ minSize='64px'
      ~ maxSize='216px'
      ~ groupResizeBehavior='preserve-pixel-size'
      ~ onResize={handleNavigationResize}
      ~ )
      aside(className={cn('flex h-full min-w-0 w-full flex-col px-4 bg-sunken dark:bg-sunken/40', isNavigationCompact && 'px-1.5!')})
        div(className={cn('flex h-20 items-center', isNavigationCompact ? 'justify-center px-2' : '')})
          Link(className='inline-flex items-center gap-2 text-[clamp(1rem,3vw,1.2rem)] font-poly font-medium text-foreground/90 tracking-tight' to='/citadel' aria-label='Citadel home')
            if isNavigationCompact
              Icon(name='re-up.ph')
            else
              div(className='flex items-center gap-3')
                Icon(name='re-up.ph')
                h1(className='')
                  span(className='dark:text-lime-200') Citadel
        Navigation(compact={isNavigationCompact})
        div(className={cn('flex items-center justify-start h-16 px-3', isNavigationCompact && 'px-3!')})
          ThemeToggle
        div(className={cn('flex items-center justify-center py-1', isNavigationCompact && 'px-2')})
          UserMenu(
            ~ scope='citadel'
            ~ compact={isNavigationCompact}
            ~ name={user?.displayName}
            ~ email={email ?? user?.email}
            ~ photoUrl={user?.photoURL}
            ~ hasGodAccess={hasGodAccess}
            ~ user={user}
            ~ )
    Separator(aria-label='Resize Citadel navigation' className='group relative -ml-1.5 w-1.5 shrink-0')
      span(className='pointer-events-none absolute inset-y-0 -left-1.5 -right-1.5 -translate-x-1 transition-colors duration-180 ease-out group-hover:bg-active dark:group-hover:bg-lime-200')
    Panel(id='content' minSize='40%')
      main(className='min-h-[calc(100vh-160px)] bg-background')
        if status === 'loading'
          div(className='flex items-center justify-center gap-2 min-h-screen')
            Icon(name='spinner-ferris')
            p(className='text-sm md:text-base text-muted-foreground') Verifying your administrator session
        elseif status === 'ready'
          Container
            Outlet
        elseif status === 'unauthorized'
          div(className='grid min-h-screen place-items-center px-6 text-center')
            div(className='max-w-md')
              p(className='text-sm text-muted-foreground') You do not have an active administrator session.
              a(href='https://livesnapsnow.com/' className='mt-6 inline-flex h-10 items-center rounded-full bg-foreground px-5 text-sm font-medium text-background') Return to Live Snaps Now
        else
          div(className='grid min-h-screen place-items-center px-6 text-center')
            p(className='text-sm text-destructive') We could not verify your administrator session. Please try again.
