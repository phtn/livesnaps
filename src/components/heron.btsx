section(id='discover' className='relative mx-[2vw] min-h-[620px] overflow-hidden rounded-[27px] border border-white/7 dark:bg-[#151515] bg-muted min-[700px]:mx-[34px] lg:grid lg:min-h-[min(680px,calc(100vh-148px))] lg:grid-cols-2 lg:rounded-[34px] lg:mx-[54px] min-[1360px]:mx-[70px]' aria-labelledby='hero-title')
  div(className='absolute inset-x-0 bottom-0 z-2 gap-10 px-6 pb-[25px] min-[700px]:px-[42px] min-[700px]:pb-10 lg:relative lg:inset-auto flex flex-col lg:justify-center lg:px-[6vw] lg:py-[58px] lg:pb-[52px] lg:pl-[42px]')
    div(className='mb-3 flex items-center gap-2.25 text-[0.88rem] tracking-[0.01em]')
      span(className='h-0.5 w-[17px] rounded-full bg-[#ff784b]')
      span Editors’ choice
    h1(id='hero-title' className='m-0 max-w-[720px] text-[clamp(2.35rem,11vw,4.25rem)] font-medium leading-[0.96] tracking-[-0.065em] lg:text-[clamp(3.5rem,5.6vw,6.4rem)]') Get Verified.
    p(className='my-[15px] mb-[18px] max-w-[560px] text-base leading-[1.42] text-muted-foreground lg:mt-5 lg:text-[1.08rem]') Step 1: Take 5 snaps of your vehicle.
    button(type='button' className='flex min-h-[54px] w-full cursor-pointer items-center justify-center rounded-full border-0 bg-foreground px-6 text-base text-background transition hover:bg-white active:scale-[0.97]') Get Started
    div(className='mb-[21px] mt-4 flex flex-wrap items-center justify-center gap-2.25 text-xs text-muted-foreground lg:mt-8')
      span Beast Studios
      span(className='size-[3px] rounded-full bg-[#62615f]')
      span 3 Expansion Packs
    div(className='mt-[52px] hidden gap-1.75' aria-label='Featured game 1 of 4')
      span(className='h-[3px] w-[50px] rounded-full bg-[#ff784b]')
      span(className='h-[3px] w-[22px] rounded-full bg-[#464646]')
      span(className='h-[3px] w-[22px] rounded-full bg-[#464646]')
      span(className='h-[3px] w-[22px] rounded-full bg-[#464646]')
  div(className='hidden absolute inset-x-0 top-0 h-[56%] lg:block lg:relative lg:inset-auto lg:h-auto lg:min-h-[600px]')
    img(className='size-full object-center aspect-video stroke-[#ccc]' src='/logo.svg' alt='snaps')
    div(className='absolute inset-0 dark:bg-[linear-gradient(180deg,rgba(0,0,0,0.06)_45%,#151515_100%)] bg-[linear-gradient(180deg,rgba(0,0,0,0.06)_45%,#ededed_100%)] lg:bg-[linear-gradient(90deg,rgba(0,0,0,0.06)_68%,#ebebeb_100%)] dark:lg:bg-[linear-gradient(90deg,transparent_68%,#151515_100%)]' aria-hidden={true})
