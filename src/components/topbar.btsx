import ThemeToggle from './theme-toggle.btsx'
import { Icon } from '@/lib/icons'
import { signInWithGoogle } from '@/lib/firebase'
import { useFirebaseUser } from '@/lib/firebase/auth'
import UserMenu from './user-menu.btsx'
import { useState } from 'octane'
import { Link } from '@octanejs/tanstack-router'
// import StoreMark from './store-mark.btsx'

setup
  const { hasAdminClaim, hasGodAccess, user } = useFirebaseUser()
  const [isSigningIn, setIsSigningIn] = useState(false)
  const [signInError, setSignInError] = useState<string | null>(null)
  const inSession = user !== null

  const handleSignIn = async () => {
    if (isSigningIn) return

    setSignInError(null)
    setIsSigningIn(true)
    try {
      await signInWithGoogle()
    } catch (error) {
      const message = error instanceof Error ? error.message : 'Unable to sign in right now.'
      setSignInError(message)
      console.error('Error signing in with Google:', error)
    } finally {
      setIsSigningIn(false)
    }
  }
header(className='relative z-40 mx-auto flex h-16 w-full max-w-[1520px] items-center justify-between px-[4vw] min-[700px]:h-[108px] min-[700px]:px-[34px] lg:px-[54px] min-[1360px]:px-[70px]')
  Link(className='inline-flex items-center gap-2 text-[clamp(1.2rem,3vw,1.6rem)] font-poly font-medium text-foreground/90 tracking-tight' to='/' aria-label='App home')
    // StoreMark(className='hidden md:flex')
    h1(className='')
      span(className='uppercase text-beach dark:text-foreground') Live
      span(className='uppercase dark:text-lime-200') Snaps
      span(className='text-sand dark:text-foreground') Now
  nav(className='hidden items-center gap-[clamp(22px,3vw,42px)] md:flex' aria-label='Primary navigation')
    Link(className='relative text-sm font-medium transition-colors after:absolute after:bottom-[-7px] after:left-0 after:h-px after:w-full after:origin-right after:scale-x-0 dark:after:bg-lime-200 after:bg-sand after:transition-transform hover:text-foreground hover:after:origin-left hover:after:scale-x-100' to='/snaps' hash='top') My Snaps

  div(className='flex items-center gap-4 md:gap-6')
    ThemeToggle
    if inSession
      UserMenu(user={user} hasAdminClaim={hasAdminClaim} hasGodAccess={hasGodAccess})
    else
      button(type='button' disabled={isSigningIn} onClick={handleSignIn} aria-busy={isSigningIn} aria-label='Sign in with Google' className='inline-flex size-9 items-center justify-center rounded-full text-foreground transition hover:bg-muted disabled:cursor-wait disabled:opacity-60')
        Icon(name='person')
  if signInError
    p(className='absolute right-4 top-full max-w-xs text-xs text-destructive') #{signInError}
