import type { ColumnFiltersState, Updater } from '@octanejs/tanstack-table'
import { useCallback, useId, useMemo, useState } from 'octane'
import type { JSX } from 'octane/jsx-runtime'
import { matchesExplorerColumnFilters, statuses } from '../../data'
import type { ExplorerColumnFilter, PerformanceRow } from '../../data'
import Button from '../ui/Button.btsx'
import Input from '../ui/Input.btsx'
import Faceted, {
  ~ FacetedBadgeList,
  ~ FacetedContent,
  ~ FacetedEmpty,
  ~ FacetedGroup,
  ~ FacetedItem,
  ~ FacetedList,
  ~ FacetedTrigger
  ~ } from '../ui/table/hyper/Faceted.btsx'
import Popover, { PopoverContent, PopoverTrigger } from '../ui/Popover.btsx'
import { cn } from '@/lib/utils'
import { Icon, type IconName } from '@/lib/icons'
import type { DateRange } from '@octanejs/day-picker'
import DateRangePicker from "./DateRangePicker.btsx";


module
  type ExplorerFilterId = 'health' | 'region' | 'revenue' | 'status' | 'updatedAt'
  type SvgProps = JSX.IntrinsicElements['svg']

  interface FilterDefinitionBase {
    id: ExplorerFilterId
    label: string
    icon?: IconName
  }

  interface FacetedFilterDefinition extends FilterDefinitionBase {
    id: 'region' | 'status'
    variant: 'faceted'
    values?: ReadonlyArray<string>
  }

  interface NumberRangeFilterDefinition extends FilterDefinitionBase {
    id: 'health' | 'revenue'
    variant: 'number-range'
    min?: number
    max?: number
    step?: number
  }

  interface DateRangeFilterDefinition extends FilterDefinitionBase {
    id: 'updatedAt'
    variant: 'date-range'
  }

  type FilterDefinition = FacetedFilterDefinition | NumberRangeFilterDefinition | DateRangeFilterDefinition

  interface Props {
    rows: ReadonlyArray<PerformanceRow>
    columnFilters: ColumnFiltersState
    onColumnFiltersChange: (updater: Updater<ColumnFiltersState>) => void
  }

  interface FilterFieldProps {
    definition: FilterDefinition
    fieldLabelId: string
    filters: ColumnFiltersState
    onValueChange: (id: ExplorerFilterId, value: unknown) => void
    rawFilterValue: unknown
    rows: ReadonlyArray<PerformanceRow>
  }

  interface FacetedOption {
    count: number
    label: string
    value: string
  }

  const explorerFilterDefinitions = [
    { id: 'region', label: 'Region', variant: 'faceted', icon: 'world' },
    { id: 'status', label: 'Status', variant: 'faceted', icon: 'world', values: statuses },
    { id: 'revenue', label: 'Revenue', variant: 'number-range', icon: 'world', min: 0, step: 1_000 },
    { id: 'health', label: 'Health', variant: 'number-range', icon: 'world', min: 0, max: 100, step: 1 },
    { id: 'updatedAt', label: 'Updated', variant: 'date-range', icon: 'world' }
  ] as const satisfies ReadonlyArray<FilterDefinition>

  const triggerClassName =
    'border-2 border-border/25 bg-background hover:bg-white hover:border-indigo-400 focus:outline-none focus:ring-1 focus:ring-indigo-400'

  const getRangeBounds = (value: unknown): readonly [unknown, unknown] =>
    Array.isArray(value) ? [value[0], value[1]] : [undefined, undefined]

  const getRangeInputValue = (value: unknown) =>
    value === undefined || value === null ? '' : String(value)

  const createRangeFilterValue = (minimum: string, maximum: string) =>
    minimum.length === 0 && maximum.length === 0 ? undefined : [minimum, maximum]

  const getFilterValue = (filters: ColumnFiltersState, id: ExplorerFilterId) =>
    filters.find((filter) => filter.id === id)?.value

  const replaceFilterValue = (filters: ColumnFiltersState, id: ExplorerFilterId, value: unknown) => {
    const nextFilters = filters.filter((filter) => filter.id !== id)
    const [minimum, maximum] = getRangeBounds(value)
    const isEmptyRange =
      Array.isArray(value) && getRangeInputValue(minimum).length === 0 && getRangeInputValue(maximum).length === 0
    const isEmptyFaceted = Array.isArray(value) && value.length === 0

    return value === undefined || isEmptyRange || isEmptyFaceted
      ? nextFilters
      : [...nextFilters, { id, value }]
  }

  const getActiveFilterCount = (filters: ColumnFiltersState) =>
    explorerFilterDefinitions.reduce((total, definition) => {
      const value = getFilterValue(filters, definition.id)
      if (definition.variant === 'faceted') {
        return total + (Array.isArray(value) ? value.length : value === undefined ? 0 : 1)
      }

      const [minimum, maximum] = getRangeBounds(value)
      return total + (getRangeInputValue(minimum).length > 0 || getRangeInputValue(maximum).length > 0 ? 1 : 0)
    }, 0)

  const formatFacetedValue = (value: string) =>
    value
      .replace(/[-_]/g, ' ')
      .replace(/\b\w/g, (character) => character.toUpperCase())

  const getFacetedOptions = (
    rows: ReadonlyArray<PerformanceRow>,
    definition: FacetedFilterDefinition,
    filters: ColumnFiltersState
  ): FacetedOption[] => {
    const otherFilters = filters.filter((filter) => filter.id !== definition.id) as ExplorerColumnFilter[]
    const counts = new Map<string, number>()

    for (const row of rows) {
      if (!matchesExplorerColumnFilters(row, otherFilters)) continue
      const value = String(row[definition.id])
      counts.set(value, (counts.get(value) ?? 0) + 1)
    }

    const rawSelectedValues = getFilterValue(filters, definition.id)
    const selectedValues = Array.isArray(rawSelectedValues) ? rawSelectedValues.map(String) : []
    const values = definition.values ?? [...new Set([...counts.keys(), ...selectedValues])]
      .sort((left, right) => left.localeCompare(right))

    return values.map((value) => ({
      count: counts.get(value) ?? 0,
      label: formatFacetedValue(value),
      value
    }))
  }

  const formatDateInputLabel = (value: string) =>
    new Intl.DateTimeFormat('en-US', { day: 'numeric', month: 'short', year: 'numeric' }).format(
      new Date(`${value}T00:00:00`)
    )

  const parseDateInput = (value: string) => {
    const [year, month, day] = value.split('-').map(Number)
    if (!year || !month || !day) return undefined

    const date = new Date(year, month - 1, day)
    return date.getFullYear() === year && date.getMonth() === month - 1 && date.getDate() === day
      ? date
      : undefined
  }

  const formatDateInput = (date: Date | undefined) => {
    if (!date) return ''

    return [
      date.getFullYear(),
      String(date.getMonth() + 1).padStart(2, '0'),
      String(date.getDate()).padStart(2, '0'),
    ].join('-')
  }

  const getDateRangeLabel = (from: string, to: string) => {
    if (!from) return to ? `Through ${formatDateInputLabel(to)}` : 'Any date'
    if (!to) return `From ${formatDateInputLabel(from)}`
    if (from === to) return formatDateInputLabel(from)
    return `${formatDateInputLabel(from)} – ${formatDateInputLabel(to)}`
  }

  const handleNestedPopoverPointerDown = (event: PointerEvent) => {
    const target = event.target
    if (!(target instanceof HTMLElement)) return
    if (target.hasPointerCapture(event.pointerId)) target.releasePointerCapture(event.pointerId)
    if (event.button === 0 && event.ctrlKey === false && event.pointerType === 'mouse') event.preventDefault()
  }

  export { explorerFilterDefinitions }

component FilterIcon
  props { className, ...svgProps }: SvgProps
  svg(
    ~ {...svgProps}
    ~ aria-hidden='true'
    ~ viewBox='0 0 24 24'
    ~ fill='none'
    ~ stroke='currentColor'
    ~ strokeWidth={2}
    ~ strokeLinecap='round'
    ~ strokeLinejoin='round'
    ~ className={className}
    ~ )
    path(d='M4 5h16M7 12h10M10 19h4')

component CalendarIcon
  props { className, ...svgProps }: SvgProps
  svg(
    ~ {...svgProps}
    ~ aria-hidden='true'
    ~ viewBox='0 0 24 24'
    ~ fill='none'
    ~ stroke='currentColor'
    ~ strokeWidth={2}
    ~ strokeLinecap='round'
    ~ strokeLinejoin='round'
    ~ className={className}
    ~ )
    path(d='M8 2v4M16 2v4M3 10h18')
    rect(width='18' height='18' x='3' y='4' rx='2')

component FacetedFilter
  props { definition, fieldLabelId, filters, onValueChange, rawFilterValue, rows }: FilterFieldProps & { definition: FacetedFilterDefinition }
  setup
    const selectedValues = Array.isArray(rawFilterValue) ? rawFilterValue.map(String) : []
    const options = useMemo(
      () => getFacetedOptions(rows, definition, filters),
      [rows, definition, filters]
    )

  Faceted(
    ~ multiple
    ~ value={selectedValues}
    ~ onValueChange={(value) => onValueChange(
    ~   definition.id,
    ~   Array.isArray(value) && value.length > 0 ? value : undefined
    ~ )}
    ~ )
    FacetedTrigger(
      ~ type='button'
      ~ aria-labelledby={fieldLabelId}
      ~ disabled={options.length === 0}
      ~ className={cn('flex h-8 min-w-0 w-full items-center justify-start rounded-sm px-1 text-left', triggerClassName)}
      ~ )
      FacetedBadgeList(
        ~ options={options}
        ~ max={1}
        ~ placeholder={options.length > 0 ? 'Any' : 'No values'}
        ~ className='min-w-0 flex-nowrap overflow-hidden'
        ~ badgeClassName='bg-indigo-500 text-white'
        ~ )
    FacetedContent(className='w-64 p-0')
      FacetedList
        FacetedEmpty No values found.
        FacetedGroup(className='p-0 overflow-hidden')
          each option in options key option.value
            FacetedItem(value={option.value} className='')
              div.flex.w-full.items-center.justify-between
                div(className='flex items-center justify-start')
                  span.truncate #{option.label}
              span(
                ~ className={cn(
                ~   'font-sans text-sm text-foreground/40',
                ~   option.count > 0 && 'text-indigo-400 dark:text-indigo-300'
                ~ )}
                ~ ) #{option.count.toLocaleString()}

component NumberRangeFilter
  props { definition, fieldLabelId, onValueChange, rawFilterValue }: FilterFieldProps & { definition: NumberRangeFilterDefinition }
  setup
    const [rawMinimum, rawMaximum] = getRangeBounds(rawFilterValue)
    const minimum =
      rawFilterValue === undefined && definition.min !== undefined
        ? String(definition.min)
        : getRangeInputValue(rawMinimum)
    const maximum = getRangeInputValue(rawMaximum)
    const minimumInputId = `${fieldLabelId}-minimum`
    const maximumInputId = `${fieldLabelId}-maximum`

  div(
    ~ aria-labelledby={fieldLabelId}
    ~ className='flex w-full h-7 items-center justify-between gap-1.5 rounded-sm! border-0 bg-background ps-2 overflow-hidden!'
    ~ )
    label(for={minimumInputId} className='font-mono text-muted-foreground text-xs tracking-wide opacity-70') MIN
    Input(
      ~ id={minimumInputId}
      ~ type='number'
      ~ inputMode='decimal'
      ~ min={definition.min}
      ~ max={definition.max}
      ~ step={definition.step ?? 'any'}
      ~ value={minimum}
      ~ placeholder='Min'
      ~ aria-label={`${definition.label} minimum`}
      ~ className='h-6 w-14 rounded-xs bg-white border-none px-0 font-sans text-sm text-center [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none outline-0!'
      ~ onInput={(event) => onValueChange(
      ~   definition.id,
      ~   createRangeFilterValue(event.currentTarget.value, maximum)
      ~ )}
      ~ )
    span(aria-hidden='true' className='text-xs text-muted-foreground') ·
    label(for={maximumInputId} className='font-mono text-muted-foreground text-xs tracking-widest opacity-70') MAX
    Input(
      ~ id={maximumInputId}
      ~ type='number'
      ~ inputMode='decimal'
      ~ min={definition.min}
      ~ max={definition.max}
      ~ step={definition.step ?? 'any'}
      ~ value={maximum}
      ~ aria-label={`${definition.label} maximum`}
      ~ className='h-6 w-14 rounded-sx bg-white border-none px-0 font-sans text-sm text-center [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none outline-0!'
      ~ onInput={(event) => onValueChange(
      ~   definition.id,
      ~   createRangeFilterValue(minimum, event.currentTarget.value)
      ~ )}
      ~ )

component DateRangeFilter
  props { definition, fieldLabelId, onValueChange, rawFilterValue }: FilterFieldProps & { definition: DateRangeFilterDefinition }
  setup
    const [rawFrom, rawTo] = getRangeBounds(rawFilterValue)
    const from = getRangeInputValue(rawFrom)
    const to = getRangeInputValue(rawTo)
    const triggerId = `${fieldLabelId}-trigger`
    const contentId = `${fieldLabelId}-content`
    const selectedRange = from || to
      ? { from: parseDateInput(from), to: parseDateInput(to) }
      : undefined
    const handleSelect = (range: DateRange | undefined) => {
      onValueChange(
        definition.id,
        range
          ? createRangeFilterValue(formatDateInput(range.from), formatDateInput(range.to))
          : undefined,
      )
    }

  Popover
    PopoverTrigger(
      ~ id={triggerId}
      ~ type='button'
      ~ aria-controls={contentId}
      ~ aria-labelledby={fieldLabelId}
      ~ className={cn(
      ~   'flex h-8 min-w-0 w-full items-center justify-start gap-2 overflow-hidden rounded-sm px-2 text-sm font-normal',
      ~   !from && !to && 'text-muted-foreground',
      ~   triggerClassName
      ~ )}
      ~ onPointerDown={handleNestedPopoverPointerDown}
      ~ )
      Icon(name='calendar' className='size-3.5 text-muted-foreground')
      span.truncate #{getDateRangeLabel(from, to)}
    PopoverContent(
      ~ id={contentId}
      ~ sideOffset={4}
      ~ align='start'
      ~ className='w-72 gap-3 rounded-lg border p-3 backdrop-blur-3xl'
      ~ onFocus={() => document.getElementById(triggerId)?.focus({ preventScroll: true })}
      ~ )
      DateRangePicker(
        ~ selectedRange={selectedRange}
        ~ handleSelect={handleSelect}
        ~ )

component FilterField
  props { definition, fieldLabelId, filters, onValueChange, rawFilterValue, rows }: FilterFieldProps
  div(className='grid grid-cols-[7.5rem_minmax(0,1fr)] items-center')
    span(id={fieldLabelId} className='truncate font-okx text-sm capitalize') #{definition.label}
    switch definition.variant
      case 'faceted'
        FacetedFilter(
          ~ definition={definition}
          ~ fieldLabelId={fieldLabelId}
          ~ filters={filters}
          ~ onValueChange={onValueChange}
          ~ rawFilterValue={rawFilterValue}
          ~ rows={rows}
          ~ )
      case 'number-range'
        NumberRangeFilter(
          ~ definition={definition}
          ~ fieldLabelId={fieldLabelId}
          ~ filters={filters}
          ~ onValueChange={onValueChange}
          ~ rawFilterValue={rawFilterValue}
          ~ rows={rows}
          ~ )
      case 'date-range'
        DateRangeFilter(
          ~ definition={definition}
          ~ fieldLabelId={fieldLabelId}
          ~ filters={filters}
          ~ onValueChange={onValueChange}
          ~ rawFilterValue={rawFilterValue}
          ~ rows={rows}
          ~ )

props { rows, columnFilters, onColumnFiltersChange }: Props
setup
  const [open, setOpen] = useState(false)
  const baseId = useId()
  const labelId = `${baseId}-label`
  const descriptionId = `${baseId}-description`
  const activeFilterCount = getActiveFilterCount(columnFilters)
  const handleFilterValueChange = useCallback(
    (id: ExplorerFilterId, value: unknown) => {
      onColumnFiltersChange((current) => replaceFilterValue(current, id, value))
    },
    [onColumnFiltersChange]
  )

Popover(open={open} onOpenChange={setOpen})
  PopoverTrigger(
    ~ type='button'
    ~ aria-label={activeFilterCount > 0 ? `${activeFilterCount} active filters` : 'Add filters'}
    ~ className={cn(
    ~  'relative flex h-9 py-2 items-center justify-center gap-1 rounded-sm px-2 text-sm select-none transition-colors duration-75 md:w-auto md:space-x-1 md:px-2.5',
    ~  'hover:border-indigo-200',
    ~  'data-popup-open:bg-zinc-200/50 hover:bg-indigo-200/20 active:bg-foreground/10 focus-visible:outline-1 focus-visible:-outline-offset-1 dark:data-popup-open:bg-zinc-800 dark:hover:bg-indigo-100/5 dark:active:bg-indigo-100/5',
    ~  activeFilterCount > 0 && 'gap-1 md:ps-2 md:pe-2.5'
    ~  )}
    ~ )
    if activeFilterCount > 0
      span(className='w-6 rounded-xs bg-indigo-500 font-sans font-semibold text-white dark:bg-indigo-300 dark:text-background')
        | #{activeFilterCount > 99 ? '99+' : activeFilterCount}
    else
      Icon(name='filter' className='size-5 opacity-80')
    span.hidden.opacity-80.md.inline Filter

  PopoverContent(
    ~ aria-describedby={descriptionId}
    ~ aria-labelledby={labelId}
    ~ align='start'
    ~ sideOffset={4}
    ~ className={cn('w-80 gap-2 rounded-md border border-border bg-zinc-200/80 px-4 p-4 backdrop-blur-3xl dark:bg-zinc-900/80', {'pb-0': activeFilterCount > 0})}
    ~ )
    div(className='flex flex-col')
      // h4(id={labelId} className='select-none font-okx text-sm text-muted-foreground') Add Filter
      p(id={descriptionId} className='sr-only') Filter the account explorer by field values and ranges.

    if open
      each definition in explorerFilterDefinitions key definition.id
        FilterField(
          ~ definition={definition}
          ~ fieldLabelId={`${baseId}-${definition.id}-label`}
          ~ filters={columnFilters}
          ~ onValueChange={handleFilterValueChange}
          ~ rawFilterValue={getFilterValue(columnFilters, definition.id)}
          ~ rows={rows}
          ~ )

    if activeFilterCount > 0
      div(className='flex items-center justify-end border-t border-border/60 border-dashed p-1')
        Button(
          ~ type='button'
          ~ variant='ghost'
          ~ className='inline-flex items-center gap-1'
          ~ onClick={() => onColumnFiltersChange([])}
          ~ )
          Icon(name='no-filter' className='size-5')
          span(className='text-sm') Reset Filters
