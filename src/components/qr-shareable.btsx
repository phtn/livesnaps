import QRExportSurface, { createQR } from "./qr-export-surface.btsx";
import { Button } from "@/components/ui";
import { Icon } from "@/lib/icons";
import { createPngFilename, downloadElementAsPng } from "@/lib/download-helper";
import { useCallback, useMemo, useRef, useState } from "octane";
module
  "use client";
  export interface QRShareableProps {
    brand?: string;
    content: string;
    filename?: string;
    itemLabel?: string;
    itemName: string;
    itemTitle: string;
    qrCodeImageUrl?: string;
  }
props { brand = "LiveSnapsNow", content, filename, itemLabel, itemName, itemTitle, qrCodeImageUrl }: QRShareableProps
setup
  const exportRef = useRef<HTMLDivElement | null>(null);
  const exportLockRef = useRef(false);
  const [downloadError, setDownloadError] = useState<string | null>(null);
  const [isDownloading, setIsDownloading] = useState(false);
  const qrCodeContent = content.trim();
  const qrSvg = useMemo(() => createQR(qrCodeContent), [qrCodeContent]);
  const downloadFilename = createPngFilename(filename ?? `${itemName}-${itemTitle}-qr`, "qr-code");

  const handleDownload = useCallback(async () => {
      if (!exportRef.current || exportLockRef.current || isDownloading) {
          return;
      }
      setDownloadError(null);
      exportLockRef.current = true;
      setIsDownloading(true);
      try {
          await downloadElementAsPng(exportRef.current, downloadFilename);
      }
      catch (error) {
          console.error("Unable to export the QR code.", error);
          setDownloadError("Unable to download this QR code. Please try again.");
      }
      finally {
          exportLockRef.current = false;
          setIsDownloading(false);
      }
  }, [downloadFilename, isDownloading]);

  const triggerDownload = () => {
    void handleDownload()
  }
div(className="mx-auto grid w-full max-w-sm gap-3")
  QRExportSurface(
    ~ ref={exportRef}
    ~ itemName={itemName}
    ~ itemTitle={itemTitle}
    ~ itemLabel={itemLabel}
    ~ brand={brand}
    ~ qrCodeImageUrl={qrCodeImageUrl}
    ~ qrSvg={qrSvg}
    ~ )
  Button(
    ~ type="button"
    ~ variant="ghost"
    ~ className="h-11 w-full justify-center"
    ~ disabled={isDownloading || (!qrSvg && !qrCodeImageUrl)}
    ~ onClick={triggerDownload}
    ~ )
    Icon(name={isDownloading ? "spinner-ring" : "download"} className="size-4")
    span
      if isDownloading
        | #{"Creating QR"}
      else
        | #{"Download"}
  if downloadError
    p(className="text-center text-sm text-destructive" role="alert") #{downloadError}
