import {Icon} from "@/lib/icons";
import {cn} from "@/lib/utils";
import { Link } from '@octanejs/tanstack-router'

props {scrollPct}: {scrollPct?: number}
footer(className={cn("border-t border-border/20 border-dashed w-full fixed bottom-0 opacity-0 transition-opacity duration-300 ease-out", {'opacity-100': (scrollPct ?? 0) >= 98 })})
  div(className="w-full px-6 py-6 flex items-center justify-between gap-4 font-mono text-muted-foreground text-[11px]")
    div(className="flex items-center gap-3")
      div
        div(className="font-sans text-xs text-muted-foreground") ©#{new Date().getFullYear()}
          span(className="pl-3 font-poly font-medium") LiveSnapsNow
    div(className="flex items-center gap-4 uppercase tracking-wide")
      Link(to='/legal/$slug' params={{ slug: 'privacy-policy' }} className="hover:text-foreground transition") Privacy
      Link(to='/legal/$slug' params={{ slug: 'terms-of-use' }} className="hover:text-foreground transition") Terms
      a(id='dev-team' href="https://beast-docs-adv.beastjs.workers.dev/" target="_blank" rel="noreferrer" className="inline-flex items-center gap-1.5 ml-0 border-l border-border/50 pl-4")
        Icon(name="re-up.ph" className="size-3 text-muted-foreground")
