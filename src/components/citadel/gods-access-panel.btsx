import { useEffect, useState } from 'octane'
import { Icon } from '@/lib/icons'
import Input from '@/components/ui/input.btsx'
import { cn, getInitials } from '@/lib/utils'
import { fetchGodUsers, getGodUserLabel, searchUsers, setGodClaim, type GodUser } from '@/lib/citadel/gods-users'

module
  type RosterStatus = 'loading' | 'ready' | 'error'
  type SearchStatus = 'idle' | 'searching' | 'ready' | 'error'

  const SEARCH_DEBOUNCE_MS = 300
  const MIN_SEARCH_LENGTH = 2

  const readErrorMessage = (error: unknown, fallback: string) =>
    error instanceof Error && error.message.length > 0 ? error.message : fallback

  // An aborted in-flight request is the expected outcome of typing another
  // character, not something to surface.
  const isAbortError = (error: unknown) => error instanceof DOMException && error.name === 'AbortError'

  const actionButtonClassName =
    'inline-flex h-8 shrink-0 items-center gap-1.5 rounded-sm border border-border/60 px-2.5 text-xs font-medium transition-colors hover:bg-accent hover:text-accent-foreground disabled:pointer-events-none disabled:opacity-50'

component UserIdentity
  props { user }: { user: GodUser }
  div(className='flex min-w-0 items-center gap-3')
    if user.photoUrl
      img(src={user.photoUrl} alt='' className='size-8 shrink-0 rounded-full object-cover')
    else
      span(className='grid size-8 shrink-0 place-items-center rounded-full bg-foreground/10 font-mono text-[10px] text-muted-foreground') #{getInitials(getGodUserLabel(user))}
    div(className='min-w-0')
      p(className='truncate text-sm text-foreground') #{getGodUserLabel(user)}
      p(className='truncate font-mono text-xs text-muted-foreground') #{user.email ?? user.uid}

component ClaimBadges
  props { user }: { user: GodUser }
  div(className='flex shrink-0 items-center gap-1')
    if user.topg
      span(className='rounded-xs bg-mist-500/5 px-1.5 py-0.5 font-mono text-2xs uppercase tracking-wider text-mist-500') topg
    if user.admin
      span(className='rounded-xs bg-taupe-500/5 px-1.5 py-0.5 font-mono text-2xs uppercase tracking-wider text-taupe-500') admin
    if !user.emailVerified
      span(className='rounded-xs bg-amber-500/15 px-1.5 py-0.5 font-mono text-2xs uppercase tracking-wider text-amber-500') unverified

setup
  const [roster, setRoster] = useState<GodUser[]>([])
  const [rosterStatus, setRosterStatus] = useState<RosterStatus>('loading')
  const [rosterError, setRosterError] = useState<string | null>(null)
  const [canManage, setCanManage] = useState(false)
  const [truncated, setTruncated] = useState(false)
  const [reloadToken, setReloadToken] = useState(0)

  const [query, setQuery] = useState('')
  const [results, setResults] = useState<GodUser[]>([])
  const [searchStatus, setSearchStatus] = useState<SearchStatus>('idle')
  const [searchError, setSearchError] = useState<string | null>(null)

  const [pendingUid, setPendingUid] = useState<string | null>(null)
  const [actionError, setActionError] = useState<string | null>(null)

  useEffect(() => {
    const controller = new AbortController()

    setRosterStatus('loading')
    fetchGodUsers(controller.signal)
      .then((response) => {
        setRoster(response.users)
        setCanManage(response.canManage)
        setTruncated(response.truncated)
        setRosterError(null)
        setRosterStatus('ready')
      })
      .catch((error: unknown) => {
        if (isAbortError(error)) return
        setRosterError(readErrorMessage(error, 'Could not load the god roster.'))
        setRosterStatus('error')
      })

    return () => controller.abort()
  }, [reloadToken])

  useEffect(() => {
    const trimmed = query.trim()

    if (trimmed.length < MIN_SEARCH_LENGTH) {
      setResults([])
      setSearchStatus('idle')
      setSearchError(null)
      return
    }

    const controller = new AbortController()
    setSearchStatus('searching')

    const timer = setTimeout(() => {
      searchUsers(trimmed, controller.signal)
        .then((response) => {
          setResults(response.users)
          setSearchError(null)
          setSearchStatus('ready')
        })
        .catch((error: unknown) => {
          if (isAbortError(error)) return
          setSearchError(readErrorMessage(error, 'Could not search the user directory.'))
          setSearchStatus('error')
        })
    }, SEARCH_DEBOUNCE_MS)

    return () => {
      clearTimeout(timer)
      controller.abort()
    }
  }, [query])

  const applyGodClaim = async (user: GodUser, enabled: boolean) => {
    setPendingUid(user.uid)
    setActionError(null)

    try {
      const updated = await setGodClaim(user.uid, enabled)
      // The roster is a directory scan, so re-read it rather than guessing how
      // the change reorders it.
      setReloadToken((token) => token + 1)
      setResults((current) => current.map((entry) => (entry.uid === updated.uid ? updated : entry)))
    } catch (error: unknown) {
      setActionError(readErrorMessage(error, 'Could not update this account’s access.'))
    } finally {
      setPendingUid(null)
    }
  }

  const rosterUidSet = new Set(roster.map((user) => user.uid))
  const showSearchEmpty = searchStatus === 'ready' && results.length === 0

section(className='p-5')
  header(className='flex items-baseline justify-between gap-3')
    div
      h2(className='font-poly text-2xl font-medium') Gods
      p(className='mt-1 flex items-center gap-1 text-sm text-foreground')
        | Accounts holding the
        code(className='rounded-xs bg-active/5 px-1 font-mono text-xs') god
        | custom claim.
    if rosterStatus === 'ready'
      span(className='shrink-0 font-mono text-xs text-muted-foreground') #{roster.length} #{roster.length === 1 ? 'account' : 'accounts'}

  if actionError
    p(className='mt-4 rounded-sm border border-destructive/40 bg-destructive/10 px-3 py-2 text-sm text-destructive') #{actionError}

  if canManage
    div(className='mt-6')
      label(htmlFor='god-user-search' className='font-mono text-xs uppercase tracking-[0.18em] text-muted-foreground') Grant access
      div(className='relative mt-2')
        Input(
          ~ id='god-user-search'
          ~ type='search'
          ~ value={query}
          ~ placeholder='Search by email, name, or uid'
          ~ autoComplete='off'
          ~ className='ps-3'
          ~ onInput={(event: Event) => setQuery((event.currentTarget as HTMLInputElement).value)}
          ~ )

      if searchStatus === 'searching'
        p(className='mt-2 text-xs text-muted-foreground') Searching the user directory…
      elseif searchStatus === 'error'
        p(className='mt-2 text-xs text-destructive') #{searchError}
      elseif showSearchEmpty
        p(className='mt-2 text-xs text-muted-foreground') No accounts match that search.

      if results.length > 0
        ul(className='mt-3 divide-y divide-border/60 rounded-sm border border-border/60')
          each user in results key user.uid
            li(className='flex items-center justify-between gap-3 px-3 py-2')
              UserIdentity(user={user})
              div(className='flex shrink-0 items-center gap-2')
                ClaimBadges(user={user})
                if rosterUidSet.has(user.uid) || user.god
                  span(className='font-mono text-xs text-muted-foreground') Already a god
                else
                  button(
                    ~ type='button'
                    ~ disabled={pendingUid !== null}
                    ~ className={cn(actionButtonClassName, 'hover:border-indigo-500')}
                    ~ onClick={() => void applyGodClaim(user, true)}
                    ~ )
                    Icon(name='check' className='size-3')
                    span #{pendingUid === user.uid ? 'Granting…' : 'Grant god'}

  div(className='mt-8')
    p(className='font-mono text-xs uppercase tracking-[0.18em] text-muted-foreground') Current gods

    if rosterStatus === 'loading'
      p(className='mt-3 text-sm text-muted-foreground') Loading the god roster…
    elseif rosterStatus === 'error'
      p(className='mt-3 text-sm text-destructive') #{rosterError}
    elseif roster.length === 0
      p(className='mt-3 text-sm text-muted-foreground') No accounts hold god access.
    else
      ul(className='mt-3 divide-y divide-border/60 rounded-sm')
        each user in roster key user.uid
          li(className='flex items-center justify-between gap-3 px-3 py-2')
            UserIdentity(user={user})
            div(className='flex shrink-0 items-center gap-2')
              ClaimBadges(user={user})
              if canManage
                button(
                  ~ type='button'
                  ~ disabled={pendingUid !== null}
                  ~ className={cn(actionButtonClassName, 'hover:border-destructive hover:text-destructive')}
                  ~ onClick={() => void applyGodClaim(user, false)}
                  ~ )
                  Icon(name='close' className='size-3')
                  span #{pendingUid === user.uid ? 'Revoking…' : 'Revoke'}

    if truncated
      p(className='mt-3 text-xs text-muted-foreground') The directory scan hit its page budget, so this list may be incomplete.

  if rosterStatus === 'ready' && !canManage
    p(className='mt-6 text-xs text-muted-foreground') Granting and revoking god access requires a top-god account.
