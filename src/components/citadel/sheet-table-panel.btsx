import { createElement, useMemo, useRef, useState } from 'octane'
import { sortFn_alphanumeric, type ColumnDef } from '@octanejs/tanstack-table'
import { parseAsString, useQueryStates } from '@octanejs/nuqs'
import DataTable from '@/components/ui/table/DataTable.btsx'
import FilterList from '@/components/ui/table/hyper/FilterList.btsx'
import type { FilterDefinition } from '@/components/ui/table/hyper/filter-list-config'
import type { DataTableFilterListProps } from '@/components/ui/table/types'
import type { snapsFeatures } from '@/components/admin/table-config'
import { Button } from '@/components/ui'
import { Icon, type IconName } from '@/lib/icons'
import { cn } from '@/lib/utils'
import { loadSheetFile, loadSheetsJsonp, type SheetTable } from '@/lib/tools/sheets'

module
  type SheetRow = string[]

  // Clear only this viewer's URL state when a new local dataset is accepted.
  const SHEET_QUERY_PARSERS = Object.fromEntries(
    ['q', 'page', 'size', 'sort', 'desc', 'filters', 'visibility', 'order']
      .map((key) => [`sheet-${key}`, parseAsString]),
  )

  const ACCEPT = '.csv,.tsv,.txt,.md,.markdown,.xls,.xlsx,.xlsm,.xlsb,.ods,.psv,.ssv,.list'
  const PAGE_SIZES = [50, 100, 250]

  const getSheetPresentation = (source: string): { title: string; icon: IconName } => {
    if (/^https?:\/\//i.test(source)) return { title: 'Google Sheets', icon: 'sheets' }
    const extension = source.match(/\.([^.]+)$/)?.[1]?.toLowerCase() ?? ''
    const icon = extension === 'csv' ? 'csv'
      : ['xls', 'xlsx', 'xlsm', 'xlsb', 'ods'].includes(extension) ? 'xlsx'
      : 'grid'
    const title = source.replace(/\.(csv|tsv|txt|md|markdown|xls|xlsx|xlsm|xlsb|ods|psv|ssv|list)$/i, '').trim()
    return { title: title || 'Untitled sheet', icon }
  }

  const inputClass = 'h-10 w-full rounded-sm border border-border/60 bg-background px-3 text-sm'
  const subtleButton = 'inline-flex h-8 shrink-0 items-center gap-1.5 rounded-full border border-border/80 px-1.5 md:px-3 font-mono text-2xs uppercase tracking-wider text-muted-foreground transition-colors hover:border-active/40 hover:bg-active/10 hover:text-active disabled:opacity-50'

  const buildColumns = (names: string[]): Array<ColumnDef<typeof snapsFeatures, SheetRow>> =>
    names.map((name, index) => ({
      id: `col-${index}`,
      header: name,
      accessorFn: (row) => row[index] ?? '',
      sortFn: sortFn_alphanumeric,
      filterFn: 'arrHas',
      size: 200,
      minSize: 80
    }))

component SheetFilters
  props { columns, columnFilters, onReset }: DataTableFilterListProps<SheetRow, typeof snapsFeatures>
  setup
    const filters = useMemo<FilterDefinition[]>(() => columns.map((column) => ({
      id: column.id,
      label: String(column.columnDef.header ?? column.id),
      variant: 'faceted',
    })), [columns])

  FilterList(columns={columns} columnFilters={columnFilters} onReset={onReset} filters={filters} description='Filter sheet columns by their values.')

setup
  const [sheet, setSheet] = useState<SheetTable | null>(null)
  const [sourceName, setSourceName] = useState('')
  const [error, setError] = useState<string | null>(null)
  const [loading, setLoading] = useState(false)
  const [dragActive, setDragActive] = useState(false)
  const [url, setUrl] = useState('')
  const [sheetVersion, setSheetVersion] = useState(0)
  const [, resetSheetQuery] = useQueryStates(SHEET_QUERY_PARSERS)
  const dragDepth = useRef(0)
  const fileInput = useRef<HTMLInputElement | null>(null)

  const columns = useMemo(() => buildColumns(sheet?.columns ?? []), [sheet])
  const data = useMemo(() => sheet?.rows ?? [], [sheet])
  const sheetPresentation = getSheetPresentation(sourceName)
  const sheetSummary = sheet ? createElement('p', {
    className: 'm-0 text-xs text-muted-foreground',
  }, `${sheet.columns.length} columns · ${sheet.totalRows} rows${sheet.truncated ? ` · showing first ${sheet.rows.length}` : ''}`) : null

  const acceptSheet = async (next: SheetTable, name: string) => {
    await resetSheetQuery(null)
    setSheet(next)
    setSheetVersion((version) => version + 1)
    setSourceName(name)
    setError(null)
  }

  const handleFile = async (file: File | undefined) => {
    if (!file) return
    setLoading(true)
    setError(null)
    try {
      await acceptSheet(await loadSheetFile(file), file.name)
    } catch (failure) {
      setError(failure instanceof Error ? failure.message : 'Could not read that file.')
    } finally {
      setLoading(false)
    }
  }

  const pickFile = () => fileInput.current?.click()
  const handleInputChange = (event: Event) => {
    const input = event.currentTarget as HTMLInputElement
    void handleFile(input.files?.[0])
    input.value = ''
  }
  const handleDragEnter = (event: Event) => {
    event.preventDefault()
    dragDepth.current += 1
    setDragActive(true)
  }
  const handleDragOver = (event: Event) => {
    event.preventDefault()
    const transfer = (event as DragEvent).dataTransfer
    if (transfer) transfer.dropEffect = 'copy'
  }
  const handleDragLeave = (event: Event) => {
    event.preventDefault()
    dragDepth.current = Math.max(0, dragDepth.current - 1)
    if (dragDepth.current === 0) setDragActive(false)
  }
  const handleDrop = (event: Event) => {
    event.preventDefault()
    dragDepth.current = 0
    setDragActive(false)
    const files = (event as DragEvent).dataTransfer?.files
    void handleFile(files?.[0])
  }
  const handleUrlSubmit = (event: Event) => {
    event.preventDefault()
    const trimmed = url.trim()
    if (!trimmed || loading) return
    setLoading(true)
    setError(null)
    void loadSheetsJsonp(trimmed)
      .then((next) => acceptSheet(next, trimmed))
      .catch((failure: unknown) => {
        setError(failure instanceof Error ? failure.message : 'Could not import that sheet.')
      })
      .finally(() => setLoading(false))
  }
  const handleClear = () => {
    setSheet(null)
    setSourceName('')
    setError(null)
    setUrl('')
  }

div(className='space-y-3')
  input(ref={fileInput} type='file' accept={ACCEPT} className='hidden' aria-hidden={true} tabIndex={-1} onChange={handleInputChange})
  if !sheet
    section(
      ~ aria-label='Sheet source'
      ~ onDragEnter={handleDragEnter}
      ~ onDragOver={handleDragOver}
      ~ onDragLeave={handleDragLeave}
      ~ onDrop={handleDrop}
      ~ className={cn('relative rounded-sm border border-dashed p-6 text-center transition-colors sm:p-8 h-75vh', dragActive ? 'border-active/60 bg-active/5' : 'border-border/60 bg-muted/20')}
      ~ )
      div(className='flex flex-col items-center gap-3 min-h-60vh')
        span(className='grid place-items-center text-muted')
          Icon(name='table' className='size-12')
        div(className='max-w-xl space-y-1')
          p(className='font-poly text-lg font-medium') Drop a sheet file here
          p(className='text-xs leading-5 text-muted-foreground') CSV, TSV, Excel (.xls, .xlsx, .ods), Markdown tables, or plain line lists. Parsed in your browser — nothing is uploaded.
        div(className='flex flex-wrap items-center justify-center gap-2')
          Button(type='button' variant='dark' size='sm' label={loading ? 'Reading…' : 'Browse files'} icon='add' onClick={pickFile} disabled={loading})
      form(onSubmit={handleUrlSubmit} className='mx-auto mt-5 flex max-w-xl gap-2')
        label(htmlFor='sheet-url' className='sr-only') Google Sheets link
        input(id='sheet-url' type='url' value={url} disabled={loading} onInput={(event: Event) => setUrl((event.currentTarget as HTMLInputElement).value)} placeholder='Or paste a Google Sheets link…' className={inputClass})
        Button(type='submit' variant='dark' size='sm' label='Import' icon='link' pending={loading} disabled={!url.trim() || loading})
  if error
    p(role='alert' className='rounded-sm bg-destructive/5 px-4 py-3 text-sm text-destructive') #{error}
  if loading && !sheet
    p(role='status' className='py-8 text-center text-sm text-muted-foreground') Reading sheet…
  if sheet
    section(aria-label='Sheet data' className='md:space-y-3 [&_thead_th_button:first-child]:pl-3 [&_thead_th]:capitalize')
      div(className='flex flex-wrap items-center justify-between gap-3')
        div(className='flex min-w-0 flex-1 items-center gap-2.5' title={sourceName})
          h2(className='min-w-0 truncate font-poly text-lg font-medium tracking-tight') #{sheetPresentation.title}
          span(aria-hidden={true} className='flex h-6.5 w-8 shrink-0 items-center justify-center rounded-md bg-muted/30 text-muted-foreground')
            Icon(name={sheetPresentation.icon} className='size-4.5')
        div(className='flex items-center gap-2')
          Button(type='button' variant='dark' size='sm' label={loading ? 'Reading…' : 'Replace sheet'} icon='add' onClick={pickFile} disabled={loading})
          button(type='button' onClick={handleClear} disabled={loading} className={subtleButton})
            Icon(name='close' className='size-3.5')
            span(className='hidden md:flex') Clear
      DataTable(
        ~ key={sheetVersion}
        ~ columns={columns}
        ~ data={data}
        ~ title={sheet.name}
        ~ showHeader={false}
        ~ filterList={SheetFilters}
        ~ titleActions={sheetSummary}
        ~ getRowId={(_row: SheetRow, index: number) => String(index)}
        ~ initialPageSize={100}
        ~ pageSizes={PAGE_SIZES}
        ~ urlKeyPrefix='sheet-'
        ~ rowClassName='normal-case'
        ~ viewportClassName='h-[calc(100dvh-240px)] min-h-64 w-full'
        ~ emptyTitle='No rows in this sheet'
        ~ emptyDescription='Choose another file or clear this sheet to import a Google Sheets link.'
        ~ )
