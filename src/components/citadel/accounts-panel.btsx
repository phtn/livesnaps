import { useEffect, useState } from 'octane'
import type { OctaneNode } from 'octane'
import { Icon } from '@/lib/icons'
import Input from '@/components/ui/input.btsx'
import { Badge } from '@/components/ui'
import { Link } from '@octanejs/tanstack-router'
import { cn } from '@/lib/utils'
import { getGodUserLabel, searchUsers, type GodUser } from '@/lib/citadel/gods-users'
import { ACCOUNT_PLAN_VALUES, toAccountSlug, type AccountPlan, type AccountStatus } from '@/lib/accounts/accounts'
import { ACCOUNT_PLAN_LABEL, ACCOUNT_STATUS_FILTER_LABEL, ACCOUNT_STATUS_FILTERS, ACCOUNT_STATUS_LABEL, ACCOUNT_STATUS_TONE, countAccountsByStatus, createAccount, fetchAccounts, formatAccountDate, getAccountInitials, matchesAccountQuery, type AccountRow, type AccountStatusFilter } from '@/lib/citadel/accounts'

module
  type RosterStatus = 'loading' | 'ready' | 'error'

  const readErrorMessage = (error: unknown, fallback: string) =>
    error instanceof Error && error.message.length > 0 ? error.message : fallback

  // An aborted in-flight request is the expected outcome of a remount, not
  // something to surface.
  const isAbortError = (error: unknown) => error instanceof DOMException && error.name === 'AbortError'

  const CONTACT_SEARCH_DEBOUNCE_MS = 300
  const MIN_CONTACT_SEARCH_LENGTH = 2

  const fieldLabelClassName = 'font-mono text-2xs uppercase tracking-[0.14em] text-muted-foreground'

  const chipClassName =
    'inline-flex h-7 shrink-0 items-center gap-1.5 rounded-full border px-2.5 font-mono text-2xs uppercase tracking-wider transition-colors'

  const addButtonClassName = 'size-5 aspect-square rounded-full bg-active text-white transition-colors duration-200 ease-out'
  const actionButtonClassName =
    'inline-flex h-7 shrink-0 items-center gap-1.5 rounded-full border border-border/80 px-2.5 font-mono text-2xs uppercase tracking-wider transition-colors'

component StatusBadge
  props { status }: { status: AccountStatus }
  Badge(variant='plain' className={cn('rounded-xs border font-mono text-2xs uppercase tracking-wider', ACCOUNT_STATUS_TONE[status])}) #{ACCOUNT_STATUS_LABEL[status]}

component Field
  props { label, children, className }: { label: string; children?: OctaneNode; className?: string }
  label(className={cn('flex flex-col gap-1.5', className)})
    span(className={fieldLabelClassName}) #{label}
    | #{children}

component AccountIdentity
  props { account }: { account: AccountRow }
  div(className='flex min-w-0 items-center gap-3')
    span(className='grid size-8 shrink-0 place-items-center rounded-full bg-foreground/10 font-mono text-[10px] text-muted-foreground') #{getAccountInitials(account)}
    div(className='min-w-0')
      p(className='truncate text-sm text-foreground') #{account.name}
    div(className='flex items-center gap-0 min-w-0')
      Icon(name='account' className='size-3.5 opacity-70')
      p(className='truncate font-mono text-xs text-muted-foreground') #{account.slug}

component CreateAccountForm
  props { onCreated, onCancel }: { onCreated: (accounts: AccountRow[], adminClaim: { granted: boolean; reason: string | null }) => void; onCancel: () => void }
  setup
    const [name, setName] = useState('')
    const [slug, setSlug] = useState('')
    const [plan, setPlan] = useState<AccountPlan>('trial')
    const [contactName, setContactName] = useState('')
    const [contactEmail, setContactEmail] = useState('')
    const [contactPhone, setContactPhone] = useState('')
    const [contactTitle, setContactTitle] = useState('')
    const [legalName, setLegalName] = useState('')
    const [website, setWebsite] = useState('')
    const [industry, setIndustry] = useState('')
    const [billingEmail, setBillingEmail] = useState('')
    const [notes, setNotes] = useState('')
    const [isPending, setIsPending] = useState(false)
    const [error, setError] = useState<string | null>(null)

    const [contactQuery, setContactQuery] = useState('')
    const [contactResults, setContactResults] = useState<GodUser[]>([])
    const [isSearching, setIsSearching] = useState(false)
    const [searchError, setSearchError] = useState<string | null>(null)
    const [linkedUser, setLinkedUser] = useState<GodUser | null>(null)

    useEffect(() => {
      const trimmedQuery = contactQuery.trim()

      if (trimmedQuery.length < MIN_CONTACT_SEARCH_LENGTH) {
        setContactResults([])
        setIsSearching(false)
        setSearchError(null)
        return
      }

      const controller = new AbortController()
      setIsSearching(true)

      const timer = setTimeout(() => {
        searchUsers(trimmedQuery, controller.signal)
          .then((response) => {
            setContactResults(response.users)
            setSearchError(null)
            setIsSearching(false)
          })
          .catch((searchFailure: unknown) => {
            if (isAbortError(searchFailure)) return
            setSearchError(readErrorMessage(searchFailure, 'Could not search the user directory.'))
            setIsSearching(false)
          })
      }, CONTACT_SEARCH_DEBOUNCE_MS)

      return () => {
        clearTimeout(timer)
        controller.abort()
      }
    }, [contactQuery])

    const linkUser = (user: GodUser) => {
      setLinkedUser(user)
      setContactName(getGodUserLabel(user))
      setContactEmail(user.email ?? '')
      setContactQuery('')
      setContactResults([])
    }

    // Rendered as a single line rather than an if/elseif chain: a chain whose
    // last branch is an `elseif` was observed emitting that branch outside the
    // conditional, so the search feedback is reduced to one value here.
    const contactSearchHint =
      searchError ??
      (isSearching
        ? 'Searching…'
        : contactResults.length === 0 && contactQuery.trim().length >= MIN_CONTACT_SEARCH_LENGTH
          ? 'No users match. Enter the contact details below instead.'
          : null)

    const unlinkUser = () => {
      setLinkedUser(null)
      setContactName('')
      setContactEmail('')
    }

    const trimmed = (value: string) => {
      const next = value.trim()
      return next.length > 0 ? next : undefined
    }

    const canSubmit =
      name.trim().length > 0 && contactName.trim().length > 0 && contactEmail.trim().length > 0 && !isPending

    const submit = async (event: SubmitEvent) => {
      event.preventDefault()
      if (!canSubmit) return

      setIsPending(true)
      setError(null)

      try {
        const response = await createAccount({
          name: name.trim(),
          slug: trimmed(slug),
          plan,
          organization: {
            legalName: trimmed(legalName),
            website: trimmed(website),
            industry: trimmed(industry)
          },
          primaryContact: {
            name: contactName.trim(),
            email: contactEmail.trim(),
            phone: trimmed(contactPhone),
            title: trimmed(contactTitle),
            firebaseUid: linkedUser?.uid
          },
          billingEmail: trimmed(billingEmail),
          notes: trimmed(notes)
        })

        onCreated(response.accounts, response.adminClaim)
      } catch (submitError: unknown) {
        setError(readErrorMessage(submitError, 'Could not create the account.'))
      } finally {
        setIsPending(false)
      }
    }

  form(className='mt-4 border-t border-border/50 border-dotted pt-4' onSubmit={submit})
    p(className='font-sans text-sm text-muted-foreground capitalize') New account

    if error
      p(className='mt-3 rounded-sm border border-destructive/40 bg-destructive/10 px-3 py-2 text-sm text-destructive') #{error}

    div(className='mt-4 grid gap-4 md:grid-cols-2')
      Field(label='Account name')
        Input(
          ~ value={name}
          ~ required={true}
          ~ autoComplete='off'
          ~ placeholder='Northwind Logistics'
          ~ onInput={(event: Event) => setName((event.currentTarget as HTMLInputElement).value)}
          ~ )
      Field(label='Slug')
        Input(
          ~ value={slug}
          ~ autoComplete='off'
          ~ placeholder={toAccountSlug(name) || 'auto-generated from the name'}
          ~ onInput={(event: Event) => setSlug((event.currentTarget as HTMLInputElement).value)}
          ~ )


    div(className='w-full mt-4 flex flex-col md:flex-row md:items-center md:justify-between gap-1.5 md:gap-6')

      div(className='flex flex-col gap-1.5 w-full')
        p(className='mt-5 font-mono text-2xs uppercase tracking-[0.18em] text-muted-foreground') Primary contact

        if linkedUser
          div(className='mt-2')
            div(className='flex flex-wrap items-center justify-between gap-3 rounded-sm border border-active/30 bg-active/5 px-3 py-2')
              div(className='min-w-0')
                p(className='truncate text-sm text-foreground') #{getGodUserLabel(linkedUser)}
                p(className='truncate font-mono text-xs text-muted-foreground') #{linkedUser.email ?? linkedUser.uid}
              div(className='flex shrink-0 items-center gap-2')
                if linkedUser.admin
                  span(className='rounded-xs bg-taupe-500/5 px-1.5 py-0.5 font-mono text-2xs uppercase tracking-wider text-taupe-500') admin
                if !linkedUser.admin && !linkedUser.emailVerified
                  span(className='rounded-xs bg-amber-500/15 px-1.5 py-0.5 font-mono text-2xs uppercase tracking-wider text-amber-500') unverified
                button(type='button' onClick={unlinkUser} className={actionButtonClassName}) Change
            p(className='mt-1.5 font-mono text-2xs text-muted-foreground') This user becomes the account owner and is granted admin access.
        else
          div(className='mt-2 w-full')
            Input(
              ~ type='search'
              ~ value={contactQuery}
              ~ autoComplete='off'
              ~ placeholder='Search existing users by name or email'
              ~ onInput={(event: Event) => setContactQuery((event.currentTarget as HTMLInputElement).value)}
              ~ className='w-full'
              ~ )
            if contactSearchHint
              p(className={cn('mt-1.5 font-mono text-xs', searchError ? 'text-destructive' : 'text-muted-foreground')}) #{contactSearchHint}
            if contactResults.length > 0
              ul(className='mt-1.5 divide-y divide-border/60 divide-dotted rounded-sm border border-border/60')
                each user in contactResults key user.uid
                  li
                    button(
                      ~ type='button'
                      ~ onClick={() => linkUser(user)}
                      ~ className='flex w-full items-center justify-between gap-3 px-3 py-2 text-left transition-colors hover:bg-accent'
                      ~ )
                      div(className='min-w-0')
                        p(className='truncate text-sm text-foreground') #{getGodUserLabel(user)}
                        p(className='truncate font-mono text-xs text-muted-foreground') #{user.email ?? user.uid}
                      if user.admin
                        span(className='shrink-0 font-mono text-2xs uppercase tracking-wider text-taupe-500') admin

      div(className='mt-4 flex flex-col gap-1.5')
        span(className={fieldLabelClassName}) Plan
        div(className='mt-3 flex gap-1.5')
          each option in ACCOUNT_PLAN_VALUES key option
            button(
              ~ type='button'
              ~ onClick={() => setPlan(option)}
              ~ className={cn(chipClassName, plan === option ? 'border-active/40 bg-active/10 text-active' : 'border-border/60 text-muted-foreground hover:bg-accent')}
              ~ )
              | #{ACCOUNT_PLAN_LABEL[option]}


    div(className='mt-3 grid gap-4 md:grid-cols-2')
      Field(label='Contact name')
        Input(
          ~ value={contactName}
          ~ required={true}
          ~ autoComplete='off'
          ~ placeholder='Ada Reyes'
          ~ onInput={(event: Event) => setContactName((event.currentTarget as HTMLInputElement).value)}
          ~ )
      Field(label='Contact email')
        Input(
          ~ type='email'
          ~ value={contactEmail}
          ~ required={true}
          ~ autoComplete='off'
          ~ placeholder='ada@northwind.com'
          ~ onInput={(event: Event) => setContactEmail((event.currentTarget as HTMLInputElement).value)}
          ~ )
      Field(label='Contact phone')
        Input(
          ~ value={contactPhone}
          ~ autoComplete='off'
          ~ placeholder='Optional'
          ~ onInput={(event: Event) => setContactPhone((event.currentTarget as HTMLInputElement).value)}
          ~ )
      Field(label='Contact title')
        Input(
          ~ value={contactTitle}
          ~ autoComplete='off'
          ~ placeholder='Optional'
          ~ onInput={(event: Event) => setContactTitle((event.currentTarget as HTMLInputElement).value)}
          ~ )

    p(className='mt-5 font-mono text-2xs uppercase tracking-[0.18em] text-muted-foreground') Organization

    div(className='mt-2 grid gap-4 md:grid-cols-2')
      Field(label='Legal name')
        Input(
          ~ value={legalName}
          ~ autoComplete='off'
          ~ placeholder='Optional'
          ~ onInput={(event: Event) => setLegalName((event.currentTarget as HTMLInputElement).value)}
          ~ )
      Field(label='Website')
        Input(
          ~ value={website}
          ~ autoComplete='off'
          ~ placeholder='https://northwind.com'
          ~ onInput={(event: Event) => setWebsite((event.currentTarget as HTMLInputElement).value)}
          ~ )
      Field(label='Industry')
        Input(
          ~ value={industry}
          ~ autoComplete='off'
          ~ placeholder='Optional'
          ~ onInput={(event: Event) => setIndustry((event.currentTarget as HTMLInputElement).value)}
          ~ )
      Field(label='Billing email')
        Input(
          ~ type='email'
          ~ value={billingEmail}
          ~ autoComplete='off'
          ~ placeholder='Defaults to the contact email'
          ~ onInput={(event: Event) => setBillingEmail((event.currentTarget as HTMLInputElement).value)}
          ~ )

    div(className='mt-4')
      Field(label='Notes')
        Input(
          ~ value={notes}
          ~ autoComplete='off'
          ~ placeholder='Optional'
          ~ onInput={(event: Event) => setNotes((event.currentTarget as HTMLInputElement).value)}
          ~ )

    div(className='mt-5 flex items-center justify-end gap-2')
      button(type='button' onClick={onCancel} disabled={isPending} className={actionButtonClassName}) Cancel
      button(
        ~ type='submit'
        ~ disabled={!canSubmit}
        ~ className={cn(actionButtonClassName, 'border-active/40 text-active hover:border-active')}
        ~ )
        Icon(name={isPending ? 'spinner-ring' : 'check'} className='size-3')
        span #{isPending ? 'Creating…' : 'Create account'}

setup
  const [accounts, setAccounts] = useState<AccountRow[]>([])
  const [rosterStatus, setRosterStatus] = useState<RosterStatus>('loading')
  const [rosterError, setRosterError] = useState<string | null>(null)
  const [reloadToken, setReloadToken] = useState(0)
  const [query, setQuery] = useState('')
  const [statusFilter, setStatusFilter] = useState<AccountStatusFilter>('all')
  const [isCreating, setIsCreating] = useState(false)
  const [notice, setNotice] = useState<string | null>(null)

  useEffect(() => {
    const controller = new AbortController()

    setRosterStatus('loading')
    fetchAccounts(controller.signal)
      .then((response) => {
        setAccounts(response.accounts)
        setRosterError(null)
        setRosterStatus('ready')
      })
      .catch((error: unknown) => {
        if (isAbortError(error)) return
        setRosterError(readErrorMessage(error, 'Could not load the account roster.'))
        setRosterStatus('error')
      })

    return () => controller.abort()
  }, [reloadToken])

  const counts = countAccountsByStatus(accounts)
  const visibleAccounts = accounts.filter(
    (account) => (statusFilter === 'all' || account.status === statusFilter) && matchesAccountQuery(account, query)
  )

  const onAccountCreated = (nextAccounts: AccountRow[], adminClaim: { granted: boolean; reason: string | null }) => {
    setAccounts(nextAccounts)
    setRosterStatus('ready')
    setRosterError(null)
    setIsCreating(false)
    setNotice(
      adminClaim.granted
        ? 'Account created. The contact was granted admin access.'
        : `Account created. Admin access was not granted: ${adminClaim.reason ?? 'unknown reason.'}`
    )
  }

section(className='p-5 h-[calc(100vh-64px)] overflow-y-auto')
  header(className='flex flex-wrap items-baseline justify-between gap-3')
    div
      div(className='flex items-center gap-3')
        h2(className='font-poly font-medium tracking-tight') Accounts
        button(
          ~ type='button'
          ~ onClick={() => setIsCreating((creating) => !creating)}
          ~ className={cn(addButtonClassName, { 'bg-[#1b1b1b]! dark:bg-[#f0f0f0]': isCreating })}
          ~ )
          Icon(name='add' className={cn('size-3.5 transition-transform duration-200 ease-out', {'rotate-68': isCreating})})
      p(className='mt-1 text-sm text-muted-foreground') Organizations using the platform, and where each one stands.
    div(className='flex items-center gap-3')
      if rosterStatus === 'ready'
        span(className='shrink-0 font-mono text-xs text-muted-foreground capitalize') #{`${accounts.length} ${accounts.length === 1 ? 'account' : 'accounts'}`}


  if notice
    div(className='mt-4 flex items-start justify-between gap-3 rounded-sm border border-border/60 bg-sidebar/40 px-3 py-2')
      p(className='text-sm text-muted-foreground') #{notice}
      button(type='button' onClick={() => setNotice(null)} aria-label='Dismiss' className='shrink-0 text-muted-foreground hover:text-foreground')
        Icon(name='close' className='size-3')

  if isCreating
    CreateAccountForm(onCreated={onAccountCreated} onCancel={() => setIsCreating(false)})

  // HIDDEN
  div(className='mt-6 hidden _flex flex-wrap items-center gap-2')
    each filter in ACCOUNT_STATUS_FILTERS key filter
      button(
        ~ type='button'
        ~ onClick={() => setStatusFilter(filter)}
        ~ className={cn(chipClassName, statusFilter === filter ? 'border-active/40 bg-active/10 text-active' : 'border-border/60 text-muted-foreground hover:bg-accent')}
        ~ )
        | #{ACCOUNT_STATUS_FILTER_LABEL[filter]}
        span(className='opacity-60') #{counts[filter]}

  div(className='relative mt-3')
    Input(
      ~ id='citadel-account-search'
      ~ type='search'
      ~ value={query}
      ~ placeholder='Search by name, slug, contact, or industry'
      ~ autoComplete='off'
      ~ onInput={(event: Event) => setQuery((event.currentTarget as HTMLInputElement).value)}
      ~ )

  if rosterError
    p(className='mt-4 rounded-sm border border-destructive/40 bg-destructive/10 px-3 py-2 text-sm text-destructive') #{rosterError}

  div(className='mt-4')
    if rosterStatus === 'loading'
      div(className='flex items-center gap-2 py-6')
        Icon(name='spinner-ferris' className='size-4')
        p(className='text-sm text-muted-foreground') Loading accounts…
    elseif rosterStatus === 'error'
      button(type='button' onClick={() => setReloadToken((token) => token + 1)} className={actionButtonClassName}) Try again
    elseif accounts.length === 0
      div(className='rounded-sm border border-dashed border-border/60 px-4 py-10 text-center')
        p(className='text-sm text-muted-foreground') No accounts yet.
        p(className='mt-1 text-xs text-muted-foreground') Create the first one to start onboarding an organization.
    elseif visibleAccounts.length === 0
      p(className='px-1 py-6 text-sm text-muted-foreground') No accounts match this filter.
    else
      ul(className='divide-y divide-border/60 divide-dotted rounded-sm')
        each account in visibleAccounts key account._id
          li
            Link(
              ~ to='/citadel/accounts/$accountSlug'
              ~ params={{ accountSlug: account.slug }}
              ~ className='flex flex-wrap items-center justify-between gap-3 px-3 py-2.5 transition-colors hover:bg-accent'
              ~ )
              AccountIdentity(account={account})
              div(className='flex min-w-0 flex-1 items-center justify-end gap-4')
                div(className='min-w-0 md:block')
                  p(className='truncate text-xs text-foreground/80') #{account.primaryContact.name}
                span(className='hidden truncate font-mono text-xs text-muted-foreground') #{account.primaryContact.email}
                span(className='hidden shrink-0 font-mono text-xs text-muted-foreground lg:inline') #{ACCOUNT_PLAN_LABEL[account.plan]}
                span(className='hidden shrink-0 font-mono text-xs text-muted-foreground lg:inline') #{formatAccountDate(account.createdAt)}
                StatusBadge(status={account.status})
                Icon(name='chevron-right' className='size-3 shrink-0 text-muted-foreground')
