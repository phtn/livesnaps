import { useEffect } from 'octane'
import { useForm, useSelector } from '@octanejs/tanstack-form'
import type { Id } from '../../../convex/_generated/dataModel'
import Drawer from '@/components/ui/drawer.btsx'
import { Button } from '@/components/ui'
import { useRecipientDefaults } from '@/hooks/use-recipient-defaults'
import { accountEndpoint } from '@/hooks/use-workspace'
import { writeWorkspaceJson } from '@/lib/accounts/link-client'
import { parseRecipientDefaults, recipientChoices } from '@/lib/verifications/recipient-defaults'
import { onError, onSuccess } from '@/lib/toast'

module
  export interface SubmissionLinkEmailDrawerProps {
    accountId: string
    accountName: string
    linkId: Id<'submissionLinks'>
    linkLabel: string
    onOpenChange: (open: boolean) => void
    open: boolean
  }

  const defaultMessage = (accountName: string, linkLabel: string) =>
    `Please use the secure link below to submit the requested photos and details to ${accountName}.\n\nSubmission: ${linkLabel}`

  const recipientError = (value: string) => {
    try {
      return parseRecipientDefaults(value).length > 0 ? undefined : 'Add at least one recipient email address.'
    } catch (error) {
      return error instanceof Error ? error.message : 'Enter valid recipient email addresses.'
    }
  }

props { accountId, accountName, linkId, linkLabel, onOpenChange, open }: SubmissionLinkEmailDrawerProps
setup
  const { settings, error: defaultsError } = useRecipientDefaults(accountId, open)
  const savedRecipients = recipientChoices(settings)
  const form = useForm({
    defaultValues: { recipients: '', message: defaultMessage(accountName, linkLabel) },
    validators: {
      onChange: ({ value }) => recipientError(value.recipients) ?? (value.message.trim() ? undefined : 'Enter a message for the recipient.')
    },
    onSubmit: async ({ value, formApi }) => {
      try {
        const recipients = parseRecipientDefaults(value.recipients)
        const result = await writeWorkspaceJson<{ sent: number }>(
          accountEndpoint('/api/admin/submission-links/email', accountId),
          { linkId, recipients, message: value.message.trim() }
        )
        onSuccess(`Submission link emailed to ${result.sent} recipient${result.sent === 1 ? '' : 's'}.`)
        onOpenChange(false)
      } catch (failure) {
        const message = failure instanceof Error ? failure.message : 'Unable to send the submission link email.'
        formApi.setErrorMap({ onSubmit: message })
        onError(message)
      }
    }
  })
  const recipients = useSelector(form.store, state => state.values.recipients)
  const message = useSelector(form.store, state => state.values.message)
  const pending = useSelector(form.store, state => state.isSubmitting)
  const formError = useSelector(form.store, state => state.errorMap.onSubmit)
  const recipientsValid = !recipientError(recipients)
  const messageValid = message.trim().length > 0 && message.trim().length <= 5000

  useEffect(() => {
    if (!open) return
    form.reset({ recipients: '', message: defaultMessage(accountName, linkLabel) })
  }, [open, linkId])

  const addSavedRecipient = (email: string) => {
    if (!email) return
    const current = recipients.split(/\n/).map(value => value.trim()).filter(Boolean)
    if (!current.some(value => value.toLowerCase() === email.toLowerCase())) {
      form.setFieldValue('recipients', [...current, email].join('\n'))
    }
  }

  const submit = (event: SubmitEvent) => {
    event.preventDefault()
    if (!recipientsValid || !messageValid) return
    void form.handleSubmit()
  }

  const handleOpenChange = (nextOpen: boolean) => {
    if (!pending) onOpenChange(nextOpen)
  }

Drawer(
  ~ open={open}
  ~ onOpenChange={handleOpenChange}
  ~ title='Email submission link'
  ~ description='Send this secure submission link to one or more recipients.'
  ~ side='right'
  ~ swipeToOpen={false}
  ~ showCloseButton={true}
  ~ className='w-[min(34rem,calc(100vw-1.5rem))]!'
  ~ )
  form(className='flex min-h-0 flex-1 flex-col' onSubmit={submit})
    header(className='shrink-0 border-b border-border/60 px-5 py-5 pr-14 sm:px-6')
      p(className='font-mono text-2xs uppercase tracking-[0.18em] text-muted-foreground') Share securely
      h2(className='mt-1 font-poly text-xl font-medium tracking-tight') Email submission link
      p(className='mt-2 text-sm leading-5 text-muted-foreground') Resend will deliver the #{linkLabel} link using the LiveSnapsNow email template.

    div(className='min-h-0 flex-1 space-y-5 overflow-y-auto px-5 py-5 sm:px-6')
      label(className='block space-y-1.5')
        span(className='text-sm font-medium') Recipient emails
        if savedRecipients.length > 0
          select(
            ~ aria-label='Add a saved recipient'
            ~ value=''
            ~ disabled={pending}
            ~ onChange={(event: Event) => addSavedRecipient((event.currentTarget as HTMLSelectElement).value)}
            ~ className='h-9 w-full rounded-sm border border-border/60 bg-sidebar/40 px-2.5 text-sm outline-none focus:border-active/50 disabled:opacity-60'
            ~ )
            option(value='') Add a saved recipient…
            each email in savedRecipients key email
              option(value={email}) #{email}
        textarea(
          ~ value={recipients}
          ~ disabled={pending}
          ~ onInput={(event: Event) => form.setFieldValue('recipients', (event.currentTarget as HTMLTextAreaElement).value)}
          ~ placeholder={'person@example.com\nteam@example.com'}
          ~ className='min-h-32 w-full resize-y rounded-sm border border-border/60 bg-sunken/50 p-3 font-mono text-sm leading-6 outline-none transition-colors placeholder:text-muted-foreground/45 focus:border-active/50 focus:ring-2 focus:ring-active/10 disabled:opacity-60'
          ~ )
        p(className={`text-xs ${recipients.trim() && !recipientsValid ? 'text-destructive' : 'text-muted-foreground'}`}) One email address per line, up to 50 recipients.
        if defaultsError
          p(className='text-xs text-muted-foreground') Saved recipients could not be loaded; you can still enter addresses manually.

      label(className='block space-y-1.5')
        span(className='text-sm font-medium') Message body
        textarea(
          ~ value={message}
          ~ disabled={pending}
          ~ maxLength={5000}
          ~ onInput={(event: Event) => form.setFieldValue('message', (event.currentTarget as HTMLTextAreaElement).value)}
          ~ className='min-h-52 w-full resize-y rounded-sm border border-border/60 bg-sunken/50 p-3 text-sm leading-6 outline-none transition-colors placeholder:text-muted-foreground/45 focus:border-active/50 focus:ring-2 focus:ring-active/10 disabled:opacity-60'
          ~ )
        div(className='flex justify-between gap-3 text-xs text-muted-foreground')
          span The secure link button is added automatically.
          span(className='font-mono tabular-nums') #{message.length}/5000

      div(className='rounded-sm border border-border/50 bg-sidebar/25 p-3')
        p(className='font-mono text-2xs uppercase tracking-wider text-muted-foreground') Email preview
        p(className='mt-2 text-sm font-medium') #{accountName} sent you a LiveSnapsNow submission link
        p(className='mt-1 text-xs leading-5 text-muted-foreground') Includes the LiveSnapsNow wordmark, your message, and an Open submission link button.

      if formError
        p(role='alert' className='rounded-sm border border-destructive/30 bg-destructive/8 px-3 py-2 text-sm text-destructive') #{String(formError)}

    footer(className='flex shrink-0 items-center justify-end gap-2 border-t border-border/60 px-5 py-4 sm:px-6')
      Button(type='button' variant='ghost' size='sm' label='Cancel' disabled={pending} onClick={() => onOpenChange(false)})
      Button(type='submit' variant='dark' size='sm' icon='send' label='Send email' pending={pending} pendingLabel='Sending…' disabled={!recipientsValid || !messageValid})
