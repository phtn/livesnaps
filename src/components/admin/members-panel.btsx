import { useWorkspace } from '@/hooks/use-workspace'
import { useEffect, useState } from 'octane'
import { Badge, Input } from '@/components/ui'
import { Icon } from '@/lib/icons'
import { cn } from '@/lib/utils'
import { isAbortError, readErrorMessage } from '@/lib/citadel/errors'
import { ACCOUNT_MEMBER_ROLE_LABEL, ACCOUNT_MEMBER_STATUS_LABEL, ACCOUNT_MEMBER_STATUS_TONE, countMembersByStatus, fetchAccountMembers, formatMemberDate, getMemberInitials, matchesMemberQuery, MEMBER_STATUS_FILTER_LABEL, MEMBER_STATUS_FILTERS, type MemberRow, type MemberWorkspace } from '@/lib/admin/account-members'
import InviteMemberPanel from '@/components/admin/invite-member-panel.btsx'

module
  type RosterStatus = 'loading' | 'ready' | 'error'

  const chipClassName =
    'inline-flex h-7 shrink-0 items-center gap-1.5 rounded-full border px-2.5 font-mono text-2xs uppercase tracking-wider transition-colors'

  const addButtonClassName =
    'flex size-6 aspect-square items-center justify-center rounded-full bg-active text-white transition-colors duration-200 ease-out'

  const actionButtonClassName =
    'inline-flex h-7 shrink-0 items-center gap-1.5 rounded-full border border-border/50 px-2.5 font-mono text-muted-foreground text-xs uppercase tracking-wide transition-colors hover:bg-accent'

component MemberIdentity
  props { member }: { member: MemberRow }
  div(className='flex min-w-0 items-center gap-3')
    span(className='grid size-8 shrink-0 place-items-center rounded-full bg-foreground/10 font-mono text-[10px] text-muted-foreground') #{getMemberInitials(member)}
    div(className='min-w-0')
      p(className='truncate text-sm text-foreground') #{member.name ?? member.email}
      p(className='truncate font-mono text-xs text-muted-foreground') #{member.email}

setup
  const account = useWorkspace()
  const [workspace, setWorkspace] = useState<MemberWorkspace | null>(null)
  const [rosterStatus, setRosterStatus] = useState<RosterStatus>('loading')
  const [rosterError, setRosterError] = useState<string | null>(null)
  const [localReloadToken, setLocalReloadToken] = useState(0)
  const [isInviteOpen, setIsInviteOpen] = useState(() => window.location.pathname.endsWith('/invite'))
  const [query, setQuery] = useState('')
  const [statusFilter, setStatusFilter] = useState<(typeof MEMBER_STATUS_FILTERS)[number]>('all')

  useEffect(() => {
    const controller = new AbortController()

    setRosterStatus('loading')
    fetchAccountMembers(controller.signal, account?.id)
      .then((response) => {
        setWorkspace(response)
        setRosterError(null)
        setRosterStatus('ready')
      })
      .catch((error: unknown) => {
        if (isAbortError(error)) return
        setRosterError(readErrorMessage(error, 'Could not load the account members.'))
        setRosterStatus('error')
      })

    return () => controller.abort()
  }, [account?.id, localReloadToken])

  const members = workspace?.members ?? []
  const counts = countMembersByStatus(members)
  const visibleMembers = members.filter(
    (member) => (statusFilter === 'all' || member.status === statusFilter) && matchesMemberQuery(member, query)
  )
  const handleInvited = () => {
    setIsInviteOpen(false)
    setLocalReloadToken((token) => token + 1)
  }

section(className='h-[calc(100vh-96px)] overflow-y-auto p-4')
  if workspace?.account === null && rosterStatus === 'ready'
    div(className='rounded-sm border border-dashed border-orange-400/60 px-4 py-10 text-center')
      p(className='text-sm text-muted-foreground') This administrator is not a member of any account.
      p(className='mt-1 text-xs text-muted-foreground') An account has to be provisioned by the systems admin before it has a roster.

  else
    fragment
      header(className='flex h-12 items-center justify-between')
        div(className='flex items-center gap-3')
          h2(className='font-poly font-medium tracking-tight') Staff
          span(className='font-poly size-7 aspect-square flex items-center justify-center rounded-full bg-table-head')
            if rosterStatus === 'ready'
              span(className='text-foreground') #{members.length}
            else
              Icon(name='spinner-ring' className='size-3')
          button(
            ~ type='button'
            ~ aria-label={isInviteOpen ? 'Close invitation form' : 'Invite staff member'}
            ~ aria-expanded={isInviteOpen}
            ~ onClick={() => setIsInviteOpen((open) => !open)}
            ~ className={cn(addButtonClassName, isInviteOpen && 'bg-foreground! text-background!')}
            ~ )
            Icon(name='add' className={cn('size-3.5 transition-transform duration-200 ease-out', isInviteOpen && 'rotate-45')})
        div(className='flex items-center gap-2')
          button(
            ~ type='button'
            ~ aria-label='Refresh members'
            ~ onClick={() => setLocalReloadToken((token) => token + 1)}
            ~ className='group rounded-sm p-1 text-muted-foreground transition-colors duration-200 ease-out hover:bg-sidebar hover:text-foreground'
            ~ )
            Icon(name='refresh' size='14' className='group-active:rotate-180 transition-transform duration-200 ease-out')

      if isInviteOpen
        InviteMemberPanel(onInvited={handleInvited} onCancel={() => setIsInviteOpen(false)})

      div(className='relative mt-3')
        Input(
          ~ id='admin-member-search'
          ~ type='search'
          ~ value={query}
          ~ autoComplete='off'
          ~ placeholder='Search by name, email, title, or role'
          ~ onInput={(event: Event) => setQuery((event.currentTarget as HTMLInputElement).value)}
          ~ )

      div(className='mt-3 flex flex-wrap gap-1.5')
        each option in MEMBER_STATUS_FILTERS key option
          button(
            ~ type='button'
            ~ onClick={() => setStatusFilter(option)}
            ~ aria-pressed={statusFilter === option}
            ~ className={cn(chipClassName, statusFilter === option ? 'border-active/40 bg-active/10 text-active' : 'border-border/60 text-muted-foreground hover:bg-accent')}
            ~ )
            span #{MEMBER_STATUS_FILTER_LABEL[option]}
            span(className='opacity-60') #{option === 'all' ? members.length : (counts[option] ?? 0)}

      if rosterError
        p(className='mt-4 rounded-sm border border-destructive/40 bg-destructive/10 px-3 py-2 text-sm text-destructive') #{rosterError}

      div(className='mt-4')
        if rosterStatus === 'loading'
          div(className='flex items-center gap-2 py-6')
            Icon(name='spinner-ferris' className='size-4')
            p(className='text-sm text-muted-foreground') Loading members…
        elseif rosterStatus === 'error'
          button(type='button' onClick={() => setLocalReloadToken((token) => token + 1)} className={actionButtonClassName}) Try again

        elseif members.length === 0
          div(className='rounded-sm border border-dashed border-border/60 px-4 py-10 text-center')
            p(className='text-sm text-muted-foreground') No members yet.
            p(className='mt-1 text-xs text-muted-foreground') Use the invitation form to add the first teammate.
        elseif visibleMembers.length === 0
          p(className='px-1 py-6 text-sm text-muted-foreground') No members match this filter.
        else
          ul(className='divide-y divide-sidebar-border divide-dashed overflow-hidden rounded-lg border border-sidebar-border')
            each member in visibleMembers key member._id
              li(className='flex flex-wrap items-center justify-between gap-3 bg-table-head/50 px-3 py-4 transition-colors hover:bg-accent')
                MemberIdentity(member={member})
                div(className='flex min-w-0 flex-1 items-center justify-end gap-4')
                  span(className='hidden min-w-0 truncate text-sm text-foreground/80 md:inline') #{member.title ?? ''}
                  span(className='shrink-0 font-mono text-xs text-muted-foreground') #{ACCOUNT_MEMBER_ROLE_LABEL[member.role]}
                  span(className='hidden shrink-0 font-mono text-xs text-muted-foreground lg:inline') #{formatMemberDate(member.joinedAt ?? member.invitedAt)}
                  Badge(variant='plain' className={cn('rounded-xs border font-mono text-2xs uppercase tracking-wider', ACCOUNT_MEMBER_STATUS_TONE[member.status])}) #{ACCOUNT_MEMBER_STATUS_LABEL[member.status]}
