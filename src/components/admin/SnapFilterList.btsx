import { Calendar } from '@/components/table/data/calendar'
import {Faceted, FacetedBadgeList,FacetedContent,FacetedEmpty,FacetedGroup,FacetedItem,FacetedList,FacetedTrigger } from '@/components/ui/table/hyper/Faceted.btsx'
import { Button as BaseButton } from '@base-ui/react'

import { multiSelectFilterFn, type ColumnConfig } from '@/components/table/create-column'
import { getFilterValueLabel, getFilterValueToken } from '@/components/table/filter-utils'
import { Input } from '@/components/ui/input'
import { Popover, PopoverContent, PopoverTrigger } from '@/components/ui/popover'

import { filterFn_inDateRange } from '@tanstack/react-table'
import { format } from 'date-fns'
import { useId, useMemo, useState, type PointerEvent as ReactPointerEvent } from 'react'

import { type DataTableFilterListProps } from '@/components/table'
import { Button } from '@/components/ui/button'
import { Label } from '@/components/ui/label'
import { Icon } from '@/lib/icons'
import type { AdminProofListItem } from '@/lib/proofs/admin-photo-types'
import { cn } from '@/lib/utils'
import { ClassName } from '@/types'
import {accuracyScoreRangeFilterFn,  createInclusiveDateRangeFilterValue,  createRangeFilterValue,  getRangeBounds,  getRangeDate,  getRangeInputValue,  isOpenRangeBound} from './proofs-filter-ranges'

module
  type ProofRow = AdminProofListItem

  const PROOF_STATUS_FILTERS: ProofRow['status'][] = [
    'pending',
    'active',
    'abandoned',
    'completed',
    'cancelled',
    'invalidated'
  ]

  type ProofFilterDefinitionBase = {
    id: Extract<keyof ProofRow, string>
    label: string
    filterFn: NonNullable<ColumnConfig<ProofRow>['filterFn']>
  }

  type ProofFacetedFilterDefinition = ProofFilterDefinitionBase & {
    variant: 'faceted'
    values?: readonly unknown[]
    getValueLabel?: (value: unknown) => string
  }

  type ProofNumberRangeFilterDefinition = ProofFilterDefinitionBase & {
    variant: 'number-range'
    min?: number
    max?: number
    step?: number
  }

  type ProofDateRangeFilterDefinition = ProofFilterDefinitionBase & {
    variant: 'date-range'
  }

  type ProofFilterDefinition =
    | ProofFacetedFilterDefinition
    | ProofNumberRangeFilterDefinition
    | ProofDateRangeFilterDefinition

  type ProofFilterOption = {
    count: number
    label: string
    value: string
  }

  const formatStatusFilterValue = (value: unknown) =>
    String(value)
      .replace(/[-_]/g, ' ')
      .replace(/\b\w/g, (character) => character.toUpperCase())

  const DEFAULT_FILTERABLE = [
    {
      id: 'status',
      label: 'Status',
      variant: 'faceted',
      filterFn: multiSelectFilterFn,
      values: PROOF_STATUS_FILTERS,
      getValueLabel: formatStatusFilterValue
    },
    { id: 'make', label: 'Make', variant: 'faceted', filterFn: multiSelectFilterFn },
    { id: 'model', label: 'Model', variant: 'faceted', filterFn: multiSelectFilterFn },
    {
      id: 'countryCodeMatchesIpinfo',
      label: 'IP country match',
      variant: 'faceted',
      filterFn: multiSelectFilterFn,
      values: [true, false],
      getValueLabel: (value: unknown) => (value === true ? 'Verified' : 'Mismatch')
    },
    {
      id: 'bestAccuracyMeters',
      label: 'Accuracy score',
      variant: 'number-range',
      filterFn: accuracyScoreRangeFilterFn,
      min: 0,
      step: 1.0
    },
    {
      id: 'createdAt',
      label: 'Created',
      variant: 'date-range',
      filterFn: filterFn_inDateRange
    }
  ] as const satisfies readonly ProofFilterDefinition[]

  type ProofFilterColumn = DataTableFilterListProps<ProofRow>['columns'][number]

  const getProofFilterOptions = (
    column: ProofFilterColumn,
    definition: ProofFacetedFilterDefinition,
    selectedValues: readonly unknown[]
  ): ProofFilterOption[] => {
    const countByValue = new Map<string, number>()
    const rawValueByToken = new Map<string, unknown>()

    for (const [rawValue, count] of column.getFacetedUniqueValues()) {
      const token = getFilterValueToken(rawValue)
      if (!token) continue

      countByValue.set(token, (countByValue.get(token) ?? 0) + count)
      if (!rawValueByToken.has(token)) {
        rawValueByToken.set(token, rawValue)
      }
    }

    for (const selectedValue of selectedValues) {
      const token = getFilterValueToken(selectedValue)
      if (token && !rawValueByToken.has(token)) {
        rawValueByToken.set(token, selectedValue)
      }
    }

    const optionSource = definition.values ?? Array.from(rawValueByToken.values())
    const options = new Map<string, ProofFilterOption>()

    for (const rawValue of optionSource) {
      const value = getFilterValueToken(rawValue)
      if (!value || options.has(value)) continue

      options.set(value, {
        count: countByValue.get(value) ?? 0,
        label: definition.getValueLabel?.(rawValue) ?? getFilterValueLabel(rawValue),
        value
      })
    }

    const resolvedOptions = Array.from(options.values())
    return definition.values
      ? resolvedOptions
      : resolvedOptions.sort((left, right) => left.label.localeCompare(right.label))
  }

  const DEFAULT_FILTERABLE_BY_ID: ReadonlyMap<string, ProofFilterDefinition> = new Map(
    DEFAULT_FILTERABLE.map((definition) => [definition.id, definition])
  )

  export const withDefaultFilterableColumns = (columns: ColumnConfig<ProofRow>[]): ColumnConfig<ProofRow>[] => {
    const columnIds = new Set(columns.map((column) => column.id))

    for (const definition of DEFAULT_FILTERABLE) {
      if (!columnIds.has(definition.id)) {
        throw new Error(`Default proof filter "${definition.id}" does not have a matching column.`)
      }
    }

    return columns.map((column) => {
      const definition = DEFAULT_FILTERABLE_BY_ID.get(column.id)
      const enableFiltering = Boolean(definition)

      return {
        ...column,
        enableFiltering,
        filterFn: definition ? (column.filterFn ?? definition.filterFn) : column.filterFn
      }
    })
  }

  const getDateRangeLabel = (from: Date | undefined, to: Date | undefined) => {
    if (!from) return to ? `Through ${format(to, 'MMM d, yyyy')}` : 'Any date'
    if (!to) return `From ${format(from, 'MMM d, yyyy')}`
    if (from.toDateString() === to.toDateString()) return format(from, 'MMM d, yyyy')
    if (from.getFullYear() === to.getFullYear()) {
      return `${format(from, 'MMM d')} – ${format(to, 'MMM d, yyyy')}`
    }
    return `${format(from, 'MMM d, yyyy')} – ${format(to, 'MMM d, yyyy')}`
  }

  const handleNestedPopoverPointerDown = (event: ReactPointerEvent<HTMLElement>) => {
    const target = event.target
    if (!(target instanceof HTMLElement)) return
    if (target.hasPointerCapture(event.pointerId)) {
      target.releasePointerCapture(event.pointerId)
    }

    if (event.button === 0 && event.ctrlKey === false && event.pointerType === 'mouse') {
      event.preventDefault()
    }
  }

  const triggerClassName: ClassName =
    ' bg-background hover:bg-indigo-600/5 dark:hover:bg-indigo-100/10 dark:hover:border-indigo-100/10 focus:outline-none focus:ring-1 focus:ring-indigo-400 dark:focus:ring-indigo-200/40 dark:focus:border-background border-2 border-border/25'
  const contentClassName: ClassName = 'dark:border-indigo-200/30 dark:bg-indigo-100/5 backdrop-blur-3xl'
  const getActiveFilterCount = (definition: ProofFilterDefinition, value: unknown) => {
    if (definition.variant === 'faceted') {
      return Array.isArray(value) ? value.length : value === undefined ? 0 : 1
    }

    const [min, max] = getRangeBounds(value)
    return isOpenRangeBound(min) && isOpenRangeBound(max) ? 0 : 1
  }
  type SnapFacetedFilterProps = {
    column: ProofFilterColumn
    definition: ProofFacetedFilterDefinition
    fieldLabelId: string
    rawFilterValue: unknown
  }

  type FacetedTriggerProps = {
    triggerClassName?: ClassValue
    fieldLabelId: string
    disabled?: boolean
    render?: OctaneNode
  }
  type SnapNumberRangeFilterProps = {
    column: ProofFilterColumn
    definition: ProofNumberRangeFilterDefinition
    fieldLabelId: string
    rawFilterValue: unknown
  }
  type SnapDateRangeFilterProps = {
    column: ProofFilterColumn
    fieldLabelId: string
    rawFilterValue: unknown
  }

component ProofFacetedFilter
  props {column, definition, fieldLabelId, rawFilterValue }: SnapFacetedFilterProps
  setup
    const selectedValues = Array.isArray(rawFilterValue)
      ? rawFilterValue
      : rawFilterValue === undefined
        ? []
        : [rawFilterValue]
    const selectedTokens = [...new Set(selectedValues.map(getFilterValueToken).filter(Boolean))]
    const options = getProofFilterOptions(column, definition, selectedValues)



  Faceted(
    ~ multiple={true}
    ~ value={selectedTokens}
    ~ onValueChange={(value) => column.setFilterValue(value?.length ? value : undefined)}
    ~ )
    FacetedTrigger(
      ~ aria-labelledby={fieldLabelId}
      ~ disabled={options.length === 0}
      ~ render={Button(aria-label={fieldLabelId} disabled={disabled} className={triggerClassName})})
      FacetedBadgeList(
        ~ options={options}
        ~ max={1}
        ~ placeholder={options.length > 0 ? 'Any' : 'No values'}
        ~ className='min-w-0 flex-nowrap overflow-hidden'
        ~ badgeClassName=''
        ~ )

    FacetedContent(className={cn('w-54')})
      FacetedList
        FacetedEmpty No values found.
          FacetedGroup
            each option in options key option.value
              FacetedItem(value={option.value} className='pe-0')
                div(className='flex w-full items-center justify-between')
                  span(className='truncate') #{option.label}
                  span(className={cn('font-mono text-base text-foreground/40', {
                    ~ 'text-indigo-400 dark:text-indigo-300': option.count > 0
                    ~ })})
                  |  #{option.count}

component SnapNumberRangeFilter
  props {column,definition,fieldLabelId,rawFilterValue }: SnapNumberRangeFilterProps
  setup
    const [rawMin, rawMax] = getRangeBounds(rawFilterValue)
    const min =
      rawFilterValue === undefined && definition.min !== undefined ? String(definition.min) : getRangeInputValue(rawMin)
    const max = getRangeInputValue(rawMax)
    const minInputId = `${fieldLabelId}-min`
    const maxInputId = `${fieldLabelId}-max`
    const handleMinChange = (event) => {
      const nextMin = event.currentTarget.value
      column.setFilterValue((currentValue: unknown) => {
        const [, currentMax] = getRangeBounds(currentValue)
        return createRangeFilterValue(nextMin, getRangeInputValue(currentMax))
      })
    }
    const handleMaxChange = (event) => {
      const nextMax = event.currentTarget.value
      column.setFilterValue((currentValue: unknown) => {
        const [currentMin] = getRangeBounds(currentValue)
        const currentMinValue =
          currentValue === undefined && definition.min !== undefined
            ? String(definition.min)
            : getRangeInputValue(currentMin)
        return createRangeFilterValue(currentMinValue, nextMax)
      })
    }

  div(aria-labelledby={fieldLabelId} className='flex items-center justify-between gap-1.5 focus:outline-none focus:ring-1 focus:ring-indigo-500 dark:focus-ring-indigo-400 bg-background hover:bg-indigo-600/5 rounded-md border w-full ps-2' )
    Label(htmlFor={minInputId} className='tracking-widest font-mono text-xs opacity-70') MIN
    Input(
      ~ id={minInputId}
      ~ type='number'
      ~ inputMode='decimal'
      ~ min={definition.min}
      ~ max={definition.max}
      ~ step={definition.step ?? 'any'}
      ~ value={min}
      ~ placeholder='Min'
      ~ aria-label={`${definition.label} minimum`}
      ~ className='h-7 bg-background rounded-sm w-10 font-okx text-xs text-center px-0 [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none'
      ~ onChange={handleMinChange})

      span(aria-hidden='true' className='text-xs text-muted-foreground') &middot;
      Label(htmlFor={maxInputId} className='tracking-widest font-mono text-xs opacity-70') MAX
      Input(
        ~ id={maxInputId}
        ~ type='number'
        ~ inputMode='decimal'
        ~ min={definition.min}
        ~ max={definition.max}
        ~ step={definition.step ?? 'any'}
        ~ value={max}
        ~ placeholder=''
        ~ aria-label={`${definition.label} maximum`}
        ~ className='h-7 bg-background rounded-sm w-10 font-okx text-xs px-0 text-center [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none'
        ~ onChange={handleMaxChange})

component SnapDateRangeFilter
  props {column, fieldLabelId, rawFilterValue}: SnapDateRangeFilterProps
  setup
    const [rawFrom, rawTo] = getRangeBounds(rawFilterValue)
    const from = getRangeDate(rawFrom)
    const to = getRangeDate(rawTo)
    const triggerId = `${fieldLabelId}-trigger`
    const calendarId = `${fieldLabelId}-calendar`

  Popover
    PopoverTrigger(render={Button(id={triggerId} type='button' variant='outline' size='sm' aria-controls={calendarId} aria-labelledby={fieldLabelId} className={cn('h-8 min-w-0 justify-start overflow-hidden rounded-md px-2 font-normal [&>svg]:size-3.5', !from && !to && 'text-muted-foreground text-sm', triggerClassName)} onPointerDown={handleNestedPopoverPointerDown})})
      Icon( name='calendar' className='')
      span(className='truncate') #{getDateRangeLabel(from, to)}
    PopoverContent(
      ~id={calendarId}
      ~sideOffset={6}
      ~align='start'
      ~className={cn('w-auto p-0 rounded-lg border', contentClassName)}
      ~onFocus={() => document.getElementById(triggerId)?.focus({ preventScroll: true })})
      Calendar(
        ~mode='range'
        ~aria-label='Select Created date range'
        ~selected={from || to ? { from, to } : undefined}
        ~defaultMonth={from ?? to}
        ~onSelect={(date) => column.setFilterValue(createInclusiveDateRangeFilterValue(date?.from, date?.to))}
        ~numberOfMonths={2}
        ~autoFocus)



component SnapFilterList
  props { columns, columnFilters, onReset }: DataTableFilterListProps<ProofRow>
  setup
    const [open, setOpen] = useState(false)
    const baseId = useId()
    const labelId = `${baseId}-label`
    const descriptionId = `${baseId}-description`
    const columnsById = useMemo(() => new Map(columns.map((column) => [column.id, column])), [columns])
    const filterValuesById = useMemo(
      () => new Map(columnFilters.map((filter) => [filter.id, filter.value] as const)),
      [columnFilters]
    )
    const activeFilterCount = DEFAULT_FILTERABLE.reduce((total, definition) => {
      const value = filterValuesById.get(definition.id)
      return total + getActiveFilterCount(definition, value)
    }, 0)

    const buttonClass = cn(
      'relative h-7.5 flex items-center justify-center gap-1',
      'rounded-xs text-sm select-none md:space-x-1 md:mx-1 md:w-auto px-2 md:px-2.5',
      'data-popup-open:bg-zinc-200/50 dark:data-popup-open:bg-zinc-800',
      'hover:bg-indigo-200/20 dark:hover:bg-mist-100/5 transition-colors duration-75',
      'active:bg-foreground/10 dark:active:bg-indigo-100/5',
      'focus-visible:bg-none focus-visible:outline-1 focus-visible:-outline-offset-1',
      { 'md:ps-2 md:pe:2.5 gap-0 ': activeFilterCount > 0 }
    )

  Popover( open={open} onOpenChange={setOpen})
    PopoverTrigger(render={BaseButton} className={buttonClass})
      if activeFilterCount > 0
        span(className='bg-indigo-500 font-okx md:-ml-0.5 w-6 rounded-xs font-semibold text-white dark:text-background dark:bg-indigo-300')
          if activeFilterCount > 99 ? '99+' : activeFilterCount}
            span 99+
          else
            activeFilterCount
      else
        Icon(name='filter' className='size-4 opacity-70')
        span(className='hidden opacity-80 md:inline') Filter

    PopoverContent(
        ~aria-describedby={descriptionId}
        ~aria-labelledby={labelId}
        ~align='start'
        ~sideOffset={3}
        ~className='w-80 gap-2 p-0 rounded-md border bg-zinc-200/80 backdrop-blur-3xl dark:bg-zinc-900/80')
        div(className='flex flex-col gap-1 border-b border-dashed py-2 px-3')
          h4(id={labelId} className='font-okx text-sm text-muted-foreground select-none') Add Filter
        if open
          div(className='space-y-2 p-3')
            each definition in DEFAULT_FILTERABLE.map((definition) => {
              const column = columnsById.get(definition.id)
              if (!column) return null

              const rawFilterValue = filterValuesById.get(definition.id)
              const fieldLabelId = `${baseId}-${definition.id}-label`

              return (
                <div key={definition.id} className='grid grid-cols-[7.5rem_minmax(0,1fr)] items-center gap-2'>
                  <span id={fieldLabelId} className='truncate font-okx text-sm capitalize'>
                    {definition.label}
                  </span>
                  {definition.variant === 'faceted' ? (
                    <ProofFacetedFilter
                      column={column}
                      definition={definition}
                      fieldLabelId={fieldLabelId}
                      rawFilterValue={rawFilterValue}
                    />
                  ) : definition.variant === 'number-range' ? (
                    <ProofNumberRangeFilter
                      column={column}
                      definition={definition}
                      fieldLabelId={fieldLabelId}
                      rawFilterValue={rawFilterValue}
                    />
                  ) : (
                    <ProofDateRangeFilter column={column} fieldLabelId={fieldLabelId} rawFilterValue={rawFilterValue} />
                  )}
                </div>
              )
            })}
          </div>
        ) : null}

        {activeFilterCount > 0 ? (
          <div className='flex justify-end border-t border-dashed p-1'>
            <Button type='button' variant='ghost' size='sm' onClick={onReset} className='rounded-md'>
              <Icon name='cancel' />
              <span>Reset Filters</span>
            </Button>
          </div>
        ) : null}
      </PopoverContent>
    </Popover>
  )
}
