import { useId, useMemo, useState } from 'octane'
import type { DateRange } from '@octanejs/day-picker'
import Faceted, { FacetedBadgeList, FacetedContent, FacetedEmpty, FacetedGroup, FacetedItem, FacetedList, FacetedTrigger } from '@/components/ui/table/hyper/Faceted.btsx'
import Popover, { PopoverContent, PopoverTrigger } from '@/components/ui/Popover.btsx'
import DateRangePicker from '@/components/ui/DateRangePicker.btsx'
import Input from '@/components/ui/input.btsx'
import { Button } from '@/components/ui'
import { getFilterValueLabel, getFilterValueToken } from '@/components/ui/table/hyper/filter-utils'
import type { DataTableFilterListProps } from '@/components/ui/table/types'
import { Icon } from '@/lib/icons'
import type { AdminSnapListItem } from '@/lib/snaps/admin-photo-types'
import { cn } from '@/lib/utils'
import type { ClassName } from '@/types'
import type { snapsFeatures } from './table-config'
import { IPC_MATCH_TOKENS } from './snap-columns'
import { createInclusiveDateRangeFilterValue, createRangeFilterValue, getRangeBounds, getRangeDate, getRangeInputValue, isOpenRangeBound } from './snaps-filter-ranges'

module
  type SnapRow = AdminSnapListItem

  // Matches the `status` union in `snapListItemSchema`; `pending` is the
  // fallback `listForAdmin` applies when a snap has no location session.
  const SNAP_STATUS_FILTERS: SnapRow['status'][] = [
    'pending',
    'active',
    'abandoned',
    'completed',
    'cancelled',
    'invalidated'
  ]

  type SnapFilterProps = DataTableFilterListProps<SnapRow, typeof snapsFeatures>
  type SnapFilterColumn = SnapFilterProps['columns'][number]

  type SnapFilterDefinitionBase = {
    id: string
    label: string
  }

  type SnapFacetedFilterDefinition = SnapFilterDefinitionBase & {
    variant: 'faceted'
    values?: readonly unknown[]
    getValueLabel?: (value: unknown) => string
  }

  type SnapNumberRangeFilterDefinition = SnapFilterDefinitionBase & {
    variant: 'number-range'
    min?: number
    max?: number
    step?: number
  }

  type SnapDateRangeFilterDefinition = SnapFilterDefinitionBase & {
    variant: 'date-range'
  }

  type SnapFilterDefinition = SnapFacetedFilterDefinition | SnapNumberRangeFilterDefinition | SnapDateRangeFilterDefinition

  type SnapFilterOption = {
    count: number
    label: string
    value: string
  }

  const titleCase = (value: unknown) =>
    String(value)
      .replace(/[-_]/g, ' ')
      .replace(/\b\w/g, (character) => character.toUpperCase())

  const IPC_MATCH_LABELS: Record<string, string> = {
    match: 'Verified',
    mismatch: 'Mismatch',
    unknown: 'Not measured'
  }

  // Every `id` here must name a real column, otherwise the filter silently
  // disappears. `snap-columns.ts` is the source of truth for that list.
  const DEFAULT_FILTERABLE = [
    { id: 'status', label: 'Status', variant: 'faceted', values: SNAP_STATUS_FILTERS, getValueLabel: titleCase },
    { id: 'make', label: 'Make', variant: 'faceted' },
    { id: 'model', label: 'Model', variant: 'faceted' },
    {
      id: 'countryCodeMatchesIpinfo',
      label: 'IPC match',
      variant: 'faceted',
      values: IPC_MATCH_TOKENS,
      getValueLabel: (value: unknown) => IPC_MATCH_LABELS[String(value)] ?? titleCase(value)
    },
    { id: 'bestAccuracyMeters', label: 'Accuracy', variant: 'number-range', min: 0, step: 1 },
    { id: 'createdAt', label: 'Created', variant: 'date-range' }
  ] as const satisfies readonly SnapFilterDefinition[]

  const getSnapFilterOptions = (
    column: SnapFilterColumn,
    definition: SnapFacetedFilterDefinition,
    selectedValues: readonly unknown[]
  ): SnapFilterOption[] => {
    const countByValue = new Map<string, number>()
    const rawValueByToken = new Map<string, unknown>()

    for (const [rawValue, count] of column.getFacetedUniqueValues()) {
      const token = getFilterValueToken(rawValue)
      if (!token) continue

      countByValue.set(token, (countByValue.get(token) ?? 0) + count)
      if (!rawValueByToken.has(token)) rawValueByToken.set(token, rawValue)
    }

    for (const selectedValue of selectedValues) {
      const token = getFilterValueToken(selectedValue)
      if (token && !rawValueByToken.has(token)) rawValueByToken.set(token, selectedValue)
    }

    const optionSource = definition.values ?? Array.from(rawValueByToken.values())
    const options = new Map<string, SnapFilterOption>()

    for (const rawValue of optionSource) {
      const value = getFilterValueToken(rawValue)
      if (!value || options.has(value)) continue

      options.set(value, {
        count: countByValue.get(value) ?? 0,
        label: definition.getValueLabel?.(rawValue) ?? getFilterValueLabel(rawValue),
        value
      })
    }

    const resolvedOptions = Array.from(options.values())
    // A declared value list is already in a meaningful order; a derived one is not.
    return definition.values ? resolvedOptions : resolvedOptions.sort((left, right) => left.label.localeCompare(right.label))
  }

  const triggerClassName: ClassName =
    'bg-background hover:border-indigo-500 hover:bg-indigo-600/5 dark:hover:bg-indigo-100/10 dark:hover:border-indigo-100/10 focus:outline-none focus:ring-1 focus:ring-indigo-400 dark:focus:ring-indigo-200/40 dark:focus:border-background border-2 border-border/25'
  const contentClassName: ClassName = 'dark:border-indigo-200/30 dark:bg-indigo-100/5 backdrop-blur-3xl'
  // A calendar grid sits over table rows, so it needs more cover than the
  // faceted lists do — those only ever overlap the filter panel itself.
  const calendarContentClassName: ClassName = 'dark:border-indigo-200/30 dark:bg-zinc-900/95 backdrop-blur-3xl'

  const getActiveFilterCount = (definition: SnapFilterDefinition, value: unknown) => {
    if (definition.variant === 'faceted') {
      return Array.isArray(value) ? (value.length > 0 ? 1 : 0) : value === undefined ? 0 : 1
    }

    const [min, max] = getRangeBounds(value)
    return isOpenRangeBound(min) && isOpenRangeBound(max) ? 0 : 1
  }

  type SnapFacetedFilterProps = {
    column: SnapFilterColumn
    definition: SnapFacetedFilterDefinition
    fieldLabelId: string
    rawFilterValue: unknown
  }

  type SnapNumberRangeFilterProps = {
    column: SnapFilterColumn
    definition: SnapNumberRangeFilterDefinition
    fieldLabelId: string
    rawFilterValue: unknown
  }

  type SnapDateRangeFilterProps = {
    column: SnapFilterColumn
    fieldLabelId: string
    rawFilterValue: unknown
  }

  type SnapFilterFieldProps = {
    baseId: string
    columnsById: Map<string, SnapFilterColumn>
    definition: SnapFilterDefinition
    rawFilterValue: unknown
  }

component SnapFacetedFilter
  props { column, definition, fieldLabelId, rawFilterValue }: SnapFacetedFilterProps
  setup
    const selectedValues = Array.isArray(rawFilterValue) ? rawFilterValue : rawFilterValue === undefined ? [] : [rawFilterValue]
    const selectedTokens = [...new Set(selectedValues.map(getFilterValueToken).filter(Boolean))]
    const options = getSnapFilterOptions(column, definition, selectedValues)

  Faceted(
    ~ multiple={true}
    ~ value={selectedTokens}
    ~ onValueChange={(value) => column.setFilterValue(value?.length ? value : undefined)}
    ~ )
    FacetedTrigger(aria-labelledby={fieldLabelId} disabled={options.length === 0} className={cn('h-8 w-full rounded-sm ps-1 pe-2', triggerClassName)})
      FacetedBadgeList(
        ~ options={options}
        ~ max={1}
        ~ placeholder={options.length > 0 ? 'Any' : 'No values'}
        ~ className='min-w-0 flex-nowrap overflow-hidden'
        ~ )
    FacetedContent(className={cn('w-54', contentClassName)})
      FacetedList
        FacetedEmpty No values found.
        FacetedGroup
          each option in options key option.value
            FacetedItem(value={option.value} className='pe-0')
              div(className='flex w-full items-center justify-between gap-2')
                span(className='truncate') #{option.label}
                span(className={cn('font-mono text-xs text-foreground/40', { 'text-indigo-400 dark:text-indigo-300': option.count > 0 })}) #{option.count}

component SnapNumberRangeFilter
  props { column, definition, fieldLabelId, rawFilterValue }: SnapNumberRangeFilterProps
  setup
    const [rawMin, rawMax] = getRangeBounds(rawFilterValue)
    const min = rawFilterValue === undefined && definition.min !== undefined ? String(definition.min) : getRangeInputValue(rawMin)
    const max = getRangeInputValue(rawMax)
    const minInputId = `${fieldLabelId}-min`
    const maxInputId = `${fieldLabelId}-max`
    const handleMinChange = (event: Event) => {
      const nextMin = (event.currentTarget as HTMLInputElement).value
      column.setFilterValue((currentValue: unknown) => {
        const [, currentMax] = getRangeBounds(currentValue)
        return createRangeFilterValue(nextMin, getRangeInputValue(currentMax))
      })
    }
    const handleMaxChange = (event: Event) => {
      const nextMax = (event.currentTarget as HTMLInputElement).value
      column.setFilterValue((currentValue: unknown) => {
        const [currentMin] = getRangeBounds(currentValue)
        const currentMinValue =
          currentValue === undefined && definition.min !== undefined ? String(definition.min) : getRangeInputValue(currentMin)
        return createRangeFilterValue(currentMinValue, nextMax)
      })
    }
    const numberInputClassName =
      'h-7! bg-background! border-none w-10 font-sans text-xs text-center px-0 [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none'

  div(aria-labelledby={fieldLabelId} className='flex h-8 items-center justify-between gap-1.5 rounded-sm border-2 border-border/25 bg-background ps-2 hover:bg-indigo-600/5')
    label(htmlFor={minInputId} className='font-mono text-xs tracking-widest opacity-70') MIN
    Input(
      ~ id={minInputId}
      ~ type='number'
      ~ inputMode='decimal'
      ~ min={definition.min}
      ~ max={definition.max}
      ~ step={definition.step ?? 'any'}
      ~ value={min}
      ~ aria-label={`${definition.label} minimum`}
      ~ className={numberInputClassName}
      ~ onChange={handleMinChange}
      ~ )
    label(htmlFor={maxInputId} className='font-mono text-xs tracking-widest opacity-70') MAX
    Input(
      ~ id={maxInputId}
      ~ type='number'
      ~ inputMode='decimal'
      ~ min={definition.min}
      ~ max={definition.max}
      ~ step={definition.step ?? 'any'}
      ~ value={max}
      ~ aria-label={`${definition.label} maximum`}
      ~ className={numberInputClassName}
      ~ onChange={handleMaxChange}
      ~ )

component SnapDateRangeFilter
  props { column, fieldLabelId, rawFilterValue }: SnapDateRangeFilterProps
  setup
    const [rawFrom, rawTo] = getRangeBounds(rawFilterValue)
    const from = getRangeDate(rawFrom)
    const to = getRangeDate(rawTo)
    const selectedRange = from || to ? { from, to } : undefined
    // The stored bounds stay whole-day inclusive ISO timestamps, so a day
    // picked in the calendar filters the same rows the date inputs used to.
    const handleValueChange = (range: DateRange | undefined) => {
      column.setFilterValue(createInclusiveDateRangeFilterValue(range?.from, range?.to))
    }

  DateRangePicker(
    ~ id={`${fieldLabelId}-picker`}
    ~ aria-labelledby={fieldLabelId}
    ~ value={selectedRange}
    ~ onValueChange={handleValueChange}
    ~ placeholder='Any date'
    ~ className={cn('font-okx text-xs', triggerClassName)}
    ~ contentClassName={calendarContentClassName}
    ~ numberOfMonths={2}
    ~ )

component SnapFilterField
  props { baseId, columnsById, definition, rawFilterValue }: SnapFilterFieldProps
  setup
    const column = columnsById.get(definition.id)
    const fieldLabelId = `${baseId}-${definition.id}-label`

  if column
    div(className='grid grid-cols-[6.5rem_minmax(0,1fr)] items-center gap-2')
      span(id={fieldLabelId} className='truncate font-okx text-sm') #{definition.label}
      if definition.variant === 'faceted'
        SnapFacetedFilter(column={column} definition={definition} fieldLabelId={fieldLabelId} rawFilterValue={rawFilterValue})
      elseif definition.variant === 'number-range'
        SnapNumberRangeFilter(column={column} definition={definition} fieldLabelId={fieldLabelId} rawFilterValue={rawFilterValue})
      else
        SnapDateRangeFilter(column={column} fieldLabelId={fieldLabelId} rawFilterValue={rawFilterValue})

props { columns, columnFilters, onReset }: SnapFilterProps
setup
  const [open, setOpen] = useState(false)
  const baseId = useId()
  const labelId = `${baseId}-label`
  const descriptionId = `${baseId}-description`
  const columnsById = useMemo(() => new Map(columns.map((column) => [column.id, column])), [columns])
  const filterValuesById = useMemo(() => new Map(columnFilters.map((filter) => [filter.id, filter.value] as const)), [columnFilters])
  const activeFilterCount = DEFAULT_FILTERABLE.reduce(
    (total, definition) => total + getActiveFilterCount(definition, filterValuesById.get(definition.id)),
    0
  )
  const activeFilterLabel = activeFilterCount > 99 ? '99+' : String(activeFilterCount)

  const buttonClass = useMemo(() => cn(
    'relative md:h-9 h-8.5 flex items-center justify-center gap-2',
    'rounded-[4px] text-sm select-none md:space-x-1 md:mx-1 md:w-auto px-2 md:px-2.5 w-9',
    'data-popup-open:bg-zinc-200/50 dark:data-popup-open:bg-zinc-800',
    'border border-transparent hover:border hover:border-indigo-500 hover:bg-indigo-200/20 dark:hover:bg-mist-100/5 transition-colors duration-75',
    'active:bg-foreground/10 dark:active:bg-indigo-100/5',
    'focus-visible:bg-none focus-visible:outline-1 focus-visible:-outline-offset-1',
    {'gap-0.5! md:ps-2 md:pe-2.5': activeFilterCount > 0},
  ), [activeFilterCount])

Popover(open={open} onOpenChange={setOpen})
  PopoverTrigger(type='button' aria-label='Filter' className={cn({'border-indigo-500!': activeFilterCount > 0},buttonClass)})
    if activeFilterCount > 0
      span(className='min-w-6 w-6 rounded-xs bg-indigo-500 px-1.5 font-okx font-semibold text-white dark:bg-indigo-300 dark:text-background') #{activeFilterLabel}
    else
      Icon(name='filter' className='size-4')
    span(className='hidden opacity-80 md:inline') Filter
  PopoverContent(
    ~ aria-describedby={descriptionId}
    ~ aria-labelledby={labelId}
    ~ align='start'
    ~ sideOffset={3}
    ~ className='w-80 gap-2 rounded-sm border border-border bg-zinc-200/20 dark:bg-zinc-900/50 backdrop-blur-3xl'
    ~ )
    div(className='flex flex-col gap-1 border-b border-dashed border-border px-3 py-2')
      h4(id={labelId} className='select-none font-okx text-sm text-muted-foreground') Add Filter
      p(id={descriptionId} className='sr-only') Filter the snaps table by status, vehicle, location match, accuracy, or creation date.
    div(className='space-y-2 _p-3')
      each definition in DEFAULT_FILTERABLE key definition.id
        SnapFilterField(baseId={baseId} columnsById={columnsById} definition={definition} rawFilterValue={filterValuesById.get(definition.id)})
    if activeFilterCount > 0
      div(className={cn('flex justify-end border-t border-dashed border-border pt-3', )})
        Button(type='button' variant='ghost' size='sm' onClick={onReset} className='rounded-md')
          Icon(name='no-filter' className='size-3.5')
          span Reset Filters
