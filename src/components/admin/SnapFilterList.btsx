import FilterList from '@/components/ui/table/hyper/FilterList.btsx'
import { titleCase } from '@/components/ui/table/hyper/filter-list-config'
import type { FilterDefinition } from '@/components/ui/table/hyper/filter-list-config'
import type { DataTableFilterListProps } from '@/components/ui/table/types'
import type { AdminSnapListItem } from '@/lib/snaps/admin-photo-types'
import type { snapsFeatures } from './table-config'
import { IPC_MATCH_TOKENS } from './snap-columns'

module
  type SnapRow = AdminSnapListItem
  type SnapFilterProps = DataTableFilterListProps<SnapRow, typeof snapsFeatures>

  // Matches the `status` union in `snapListItemSchema`; `pending` is the
  // fallback `listForAdmin` applies when a snap has no location session.
  const SNAP_STATUS_FILTERS: SnapRow['status'][] = [
    'pending',
    'active',
    'abandoned',
    'completed',
    'cancelled',
    'invalidated'
  ]

  const IPC_MATCH_LABELS: Record<string, string> = {
    match: 'Verified',
    mismatch: 'Mismatch',
    unknown: 'Not measured'
  }

  // Every `id` here must name a real column, otherwise the filter silently
  // disappears. `snap-columns.ts` is the source of truth for that list.
  const SNAP_FILTERS = [
    { id: 'status', label: 'Status', variant: 'faceted', values: SNAP_STATUS_FILTERS, getValueLabel: titleCase },
    { id: 'make', label: 'Make', variant: 'faceted' },
    { id: 'model', label: 'Model', variant: 'faceted' },
    {
      id: 'countryCodeMatchesIpinfo',
      label: 'IPC Match',
      variant: 'faceted',
      values: IPC_MATCH_TOKENS,
      getValueLabel: (value: unknown) => IPC_MATCH_LABELS[String(value)] ?? titleCase(value)
    },
    { id: 'bestAccuracyMeters', label: 'Accuracy', variant: 'number-range', min: 0, step: 1, unit: 'meters' },
    { id: 'createdAt', label: 'Created', variant: 'date-range' }
  ] as const satisfies readonly FilterDefinition[]

  const SNAP_FILTER_DESCRIPTION =
    'Filter the snaps table by status, vehicle, location match, accuracy, or creation date.'

props { columns, columnFilters, onReset }: SnapFilterProps

FilterList(
  ~ columns={columns}
  ~ columnFilters={columnFilters}
  ~ onReset={onReset}
  ~ filters={SNAP_FILTERS}
  ~ description={SNAP_FILTER_DESCRIPTION}
  ~ )
