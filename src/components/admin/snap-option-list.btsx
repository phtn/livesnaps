import SnapOptionItem from '@/components/admin/snap-option-item.btsx'
import type { AdminSnapListItem } from '@/lib/snaps/admin-photo-types'
import { cn } from '@/lib/utils'

module
  export interface SnapOptionListProps {
    snaps: readonly AdminSnapListItem[]
    onSelect: (id: string) => void
    selectedId?: string | null
    className?: string
  }

  // Rows fade in one after the next as a search narrows the list. The stagger
  // is capped so a full page of results still finishes in a blink rather than
  // trickling in for half a second.
  const ROW_STAGGER_MS = 18
  const ROW_STAGGER_MAX_MS = 180

  const rowDelay = (index: number) => `${Math.min(index * ROW_STAGGER_MS, ROW_STAGGER_MAX_MS)}ms`

// One selectable snap. The row is a button so the whole line is the hit target;
// the presentation itself is shared with the confirmed panel.
component SnapOptionRow
  props { snap, isSelected, onSelect, delay }: { snap: AdminSnapListItem; isSelected: boolean; onSelect: (id: string) => void; delay: string }
  li(className='animate-in fade-in-0 slide-in-from-top-1 fill-mode-backwards duration-200 ease-out motion-reduce:animate-none' style={{ animationDelay: delay }})
    button(
      ~ type='button'
      ~ onClick={() => onSelect(snap._id)}
      ~ aria-pressed={isSelected}
      ~ className={cn('flex w-full items-center px-3 py-2.5 transition-colors duration-200 ease-out hover:bg-accent/60 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-inset', isSelected && 'bg-accent/70')}
      ~ )
      SnapOptionItem(snap={snap} isSelected={isSelected})

props { snaps, onSelect, selectedId, className }: SnapOptionListProps

ul(role='list' className={cn('divide-y divide-border/40', className)})
  each snap, index in snaps key snap._id
    SnapOptionRow(snap={snap} isSelected={snap._id === selectedId} onSelect={onSelect} delay={rowDelay(index)})
