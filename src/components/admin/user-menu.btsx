import { createElement, useCallback, useEffect, useMemo, useRef, useState } from 'octane'
import { Icon, type IconName } from '@/lib/icons'
import { cn } from '@/lib/utils'
import { Avatar } from '@/components/ui'
import Menu, { type MenuItem } from '@/components/ui/Menu.btsx'
import { signOutUser } from '@/lib/firebase/auth'
import { buildAppUrl } from '@/lib/routing/app-url'
import { buildAdminHandoffUrl } from '@/lib/routing/admin-subdomain'
import { useConvexAuth } from '@/hooks/use-convex'
import { useConvexQuery } from '@/hooks/use-convex-query'
import { api } from '../../../convex/_generated/api'
import { canUseAccount } from '@/lib/accounts/accounts'
import type { User } from 'firebase/auth'

module
  export interface UserMenuAction {
    id: string
    label: string
    icon: string
    onSelect: () => void
  }

  interface AppLink {
    id: string
    label: string
    icon: IconName
    path: string
  }

  /** Which console the menu is mounted in - it owns that console's session. */
  export type UserMenuScope = 'admin' | 'citadel'

  const scopes = {
    admin: { sessionPath: '/api/admin/session', exitLabel: 'exit admin', leavingLabel: 'leaving admin…' },
    citadel: { sessionPath: '/api/gods/session', exitLabel: 'exit citadel', leavingLabel: 'leaving citadel…' }
  } as const

  /**
   * The admin app can live on its own subdomain, so the account pages are not in
   * this router. Every link resolves against the main app origin instead.
   */
  const appLinks: AppLink[] = [
    { id: 'account', label: 'account', icon: 'person', path: '/account' },
    { id: 'snaps', label: 'my snaps', icon: 'snap', path: '/snaps' }
  ]

  const godAppLinks: AppLink[] = [
    { id: 'citadel', label: 'citadel', icon: 're-up.ph', path: '/citadel' },
    { id: 'admin', label: 'admin', icon: 'admin', path: '/admin' },
  ]

  function toAppHref(path: string) {
    if (typeof window === 'undefined') return path
    return buildAppUrl(new URL(window.location.href), path).toString()
  }

  /**
   * Drops this console's session cookie so the browser leaves it signed out.
   * The timeout matters: leaving must not strand the operator on a console they
   * asked to exit just because the API is slow or down, so a hung request gives
   * up and the caller navigates away regardless.
   */
  async function endConsoleSession(scope: UserMenuScope) {
    try {
      await fetch(scopes[scope].sessionPath, {
        method: 'DELETE',
        credentials: 'same-origin',
        signal: AbortSignal.timeout(4000)
      })
    } catch (error) {
      console.error(`Failed to end the ${scope} session.`, error)
    }
  }

  export interface UserMenuProps {
    name?: string | null
    email?: string | null
    photoUrl?: string | null
    /** Credits consumed so far. Omitted hides the credits meter. */
    creditsUsed?: number
    creditsTotal?: number
    /** Online dot on the avatar - matches the presence badge in the design. */
    isOnline?: boolean
    /** Rail mode: only the avatar shows, the panel still pulls up beside it. */
    compact?: boolean
    /** Reveals the citadel link, mirroring the main app's user menu. */
    hasGodAccess?: boolean
    /** The console this menu signs out of. Defaults to the admin app. */
    scope?: UserMenuScope
    /** Firebase user used to hand Citadel members into their workspace. */
    user?: User | null
    actions?: UserMenuAction[]
    onSignOut?: () => void
    className?: string
  }

component CreditsMeter
  props { used, total }: { used: number; total: number }
  setup
    // A zero or negative allowance would divide by zero and paint a full bar,
    // so the meter clamps before it ever reaches the width calculation.
    const percent = total > 0 ? Math.min(100, Math.max(0, (used / total) * 100)) : 0

  div(className='rounded-2xl border border-border/70 bg-background px-4 py-3')
    div(className='flex items-baseline justify-between gap-3')
      span(className='text-sm text-muted-foreground') Credits used
      span(className='text-sm font-semibold tabular-nums text-foreground') #{`${used.toLocaleString()}/${total.toLocaleString()}`}
    div(className='mt-2.5 h-2 w-full overflow-hidden rounded-full bg-muted')
      div(className='h-full rounded-full bg-lime-500 transition-[width] duration-300 ease-out dark:bg-lime-400' style={{ width: `${percent}%` }})

props { name, email, photoUrl, creditsUsed, creditsTotal, isOnline = true, compact = false, hasGodAccess = false, scope = 'admin', user, actions, onSignOut, className }: UserMenuProps

setup
  const triggerRef = useRef<HTMLElement | null>(null)
  // Keep the menu portal inside a modal Base UI drawer when this menu is used in
  // mobile navigation. This preserves the drawer's focus boundary and prevents
  // the menu from being treated as outside content.
  // `undefined` (not `null`, which disables portalling) falls back to the body.
  const [portalContainer, setPortalContainer] = useState<HTMLElement | undefined>(undefined)
  const [isLeaving, setIsLeaving] = useState(false)
  const [isSigningOut, setIsSigningOut] = useState(false)
  const [isNavigatingToWorkspace, setIsNavigatingToWorkspace] = useState(false)
  const convexAuth = useConvexAuth()
  const accounts = useConvexQuery(
    api.accounts.q.listMine,
    scope === 'citadel' && convexAuth.isAuthenticated ? { limit: 250 } : 'skip',
    convexAuth.userId ?? ''
  )
  const displayName = useMemo(() => name?.trim() || email?.split('@')[0] || 'Account', [name, email])
  const showCredits = typeof creditsUsed === 'number' && typeof creditsTotal === 'number'
  const hasWorkspace = scope === 'citadel' && (accounts?.some(account => canUseAccount(account.status)) ?? false)
  // No self-link: citadel already shows the citadel pages around this menu.
  const links = useMemo(
    () => (hasGodAccess && scope !== 'citadel' ? [...appLinks, ...godAppLinks] : appLinks),
    [hasGodAccess, scope]
  )

  // Leaving a console keeps the Firebase session alive - only its cookie goes.
  const handleLeaveConsole = useCallback(async () => {
    if (isLeaving) return
    setIsLeaving(true)
    try {
      await endConsoleSession(scope)
      window.location.assign(toAppHref('/'))
    } catch {
      setIsLeaving(false)
    }
  }, [isLeaving, scope])

  useEffect(() => {
    setPortalContainer(triggerRef.current?.closest<HTMLElement>('[data-drawer-content]') ?? undefined)
  }, [])

  const handleSignOut = useCallback(async () => {
    if (isSigningOut) return
    setIsSigningOut(true)
    try {
      await endConsoleSession(scope)
      await signOutUser()
      onSignOut?.()
      // Firebase browser persistence is isolated by origin. Finish on the main
      // hostname so its independent Firebase session is signed out as well.
      window.location.replace(toAppHref('/logout'))
    } catch (error) {
      console.error('Unable to sign out right now.', error)
      setIsSigningOut(false)
    }
  }, [isSigningOut, onSignOut, scope])

  const handleWorkspaceNavigation = useCallback(async () => {
    if (!user || isNavigatingToWorkspace) return
    setIsNavigatingToWorkspace(true)
    try {
      const idToken = await user.getIdToken(true)
      window.location.assign(buildAdminHandoffUrl(new URL(window.location.href), idToken).toString())
    } catch (error) {
      console.error('Failed to navigate to the workspace.', error)
      setIsNavigatingToWorkspace(false)
    }
  }, [isNavigatingToWorkspace, user])

  const itemContent = (icon: IconName, label: string) => createElement(
    'div',
    { className: 'contents' },
    createElement(Icon, { name: icon, className: 'size-4' }),
    createElement('span', null, label)
  )

  const itemClassName = 'flex cursor-pointer items-center gap-3 rounded-sm px-3 py-2 text-sm text-foreground/80 outline-hidden select-none hover:bg-sidebar/60 data-highlighted:bg-muted data-highlighted:text-foreground'
  const linkItemClassName = 'flex cursor-pointer items-center gap-3 rounded-sm p-3.5 text-sm text-foreground/80 outline-hidden select-none hover:bg-sidebar/60 data-highlighted:bg-muted data-highlighted:text-foreground'
  const menuItems = useMemo<MenuItem[]>(() => [
    ...links.map((link, index) => ({
      id: link.id,
      label: link.label,
      href: toAppHref(link.path),
      className: cn(linkItemClassName, index === 0 && 'mt-1'),
      content: itemContent(link.icon, link.label)
    })),
    ...(hasWorkspace ? [{
      id: 'workspace',
      label: 'workspace',
      disabled: isNavigatingToWorkspace,
      onClick: () => void handleWorkspaceNavigation(),
      className: cn(linkItemClassName, 'data-disabled:cursor-wait data-disabled:opacity-60'),
      content: itemContent('admin', isNavigatingToWorkspace ? 'opening workspace…' : 'workspace')
    }] : []),
    ...(actions ?? []).map((action, index) => ({
      id: action.id,
      label: action.label,
      onClick: action.onSelect,
      className: cn(itemClassName, 'rounded-xl', index === 0 && 'mt-1'),
      content: itemContent(action.icon as IconName, action.label)
    })),
    {
      id: 'leave-console',
      label: scopes[scope].exitLabel,
      separatorBefore: true,
      closeOnClick: false,
      disabled: isLeaving,
      onClick: () => void handleLeaveConsole(),
      className: cn(itemClassName, 'data-disabled:cursor-wait data-disabled:opacity-60'),
      content: itemContent('logoff', isLeaving ? scopes[scope].leavingLabel : scopes[scope].exitLabel)
    },
    {
      id: 'sign-out',
      label: 'sign out',
      closeOnClick: false,
      disabled: isSigningOut,
      onClick: () => void handleSignOut(),
      className: cn(itemClassName, 'data-disabled:cursor-wait data-disabled:opacity-60'),
      content: itemContent('logout', isSigningOut ? 'signing out…' : 'sign out')
    }
  ], [actions, handleLeaveConsole, handleSignOut, handleWorkspaceNavigation, hasWorkspace, isLeaving, isNavigatingToWorkspace, isSigningOut, links, scope])

Menu(
  ~ items={menuItems}
  ~ beforeItems={showCredits ? createElement(CreditsMeter, { used: creditsUsed as number, total: creditsTotal as number }) : undefined}
  ~ portalContainer={portalContainer}
  ~ triggerRef={triggerRef}
  ~ triggerAriaLabel='Open account menu'
  ~ side='top'
  ~ align={compact ? 'start' : 'center'}
  ~ sideOffset={20}
  ~ triggerClassName={cn('group flex w-full cursor-pointer items-center rounded-xl border-0 text-left transition-colors select-none hover:bg-muted/60 data-popup-open:bg-muted/60 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-foreground/20', compact ? 'justify-center p-1' : 'gap-3 px-2 py-2', className)}
  ~ positionerClassName=''
  ~ popupClassName='z-50 w-64 overflow-hidden rounded-md border border-border/40 bg-surface dark:bg-card/35 p-1 pb-1 text-popover-foreground shadow-2xl outline-hidden md:w-48'
  ~ )
    div(className='relative shrink-0 overflow-hidden')
      Avatar(imageUrl={photoUrl} alt={displayName} size={'default'})
      if isOnline
        span(className='absolute -bottom-0.5 -right-0.5 size-3 rounded-full border-2 border-background bg-emerald-500')
    if !compact
      fragment
        div(className='min-w-0 flex-1')
          p(className='truncate text-xs font-medium text-foreground') #{displayName}
          if email
            p(className='truncate text-2xs text-foreground/60') #{email}
