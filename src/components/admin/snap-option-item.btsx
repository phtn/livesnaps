import { useState, createElement } from 'octane'
import { Icon } from '@/lib/icons'
import type { AdminSnapListItem } from '@/lib/snaps/admin-photo-types'
import { cn, formatName } from '@/lib/utils'
import StatusBadge from "./badges.btsx";
import { snapSessionStatus } from './data'


module
  export interface SnapOptionItemProps {
    snap: AdminSnapListItem
    /** Draws the check pip over the avatar. */
    isSelected?: boolean
    className?: string
  }

  // The picker is scanned by plate, so an avatar only has to separate one row
  // from the next. A snap without a user photo gets initials on a stable tone
  // rather than a shared grey block.
  const AVATAR_TONES = ['#8651F8', '#1BA4F3', '#FE5938', '#55B93E', '#AD9000'] as const

  const toneForId = (id: string) => {
    let sum = 0
    for (let index = 0; index < id.length; index += 1) sum += id.charCodeAt(index)
    return AVATAR_TONES[sum % AVATAR_TONES.length]
  }

  const initialsFor = (snap: AdminSnapListItem) => {
    const source = snap.fullName.trim() || snap.email.trim() || snap.plateNumber.trim()
    const parts = source.split(/[\s@._-]+/).filter(Boolean)
    const initials = parts.slice(0, 2).map((part) => part.charAt(0)).join('')
    return (initials || '?').toUpperCase()
  }

  const dateFormatter = new Intl.DateTimeFormat('en-PH', { dateStyle: 'medium', timeStyle: 'short' })

  const formatCreatedAt = (createdAt: number) =>
    Number.isFinite(createdAt) ? dateFormatter.format(new Date(createdAt)) : '—'

// The presentation of one snap: avatar, plate number, the applicant identity
// row, and the moment the snap landed. It carries no interaction of its own so
// the picker can wrap it in a button while the confirmed panel wraps it in a
// plain box, and both read identically.
props { snap, isSelected = false, className }: SnapOptionItemProps

setup
  const plateNumber = snap.plateNumber.trim() || 'No plate'
  const fullName = snap.fullName.trim()
  const email = snap.email.trim()
  const initials = initialsFor(snap)
  const tone = toneForId(snap._id)
  const createdAtIso = Number.isFinite(snap.createdAt) ? new Date(snap.createdAt).toISOString() : undefined
  // Provider-hosted photos go missing often enough that a failed load has to
  // fall back to the initials rather than leave a broken image in the row.
  const [hasFailedImage, setHasFailedImage] = useState(false)
  const showImage = Boolean(snap.imageUrl) && !hasFailedImage
  const Status = () => createElement(StatusBadge, { presentation: snapSessionStatus[snap.status], className: 'scale:70' })

div(className={cn('flex w-full min-w-0 items-center gap-3 text-left rounded-xs', className)})
  span(className='relative size-10 shrink-0')
    if showImage
      img(
        ~ src={snap.imageUrl}
        ~ alt=''
        ~ width={40}
        ~ height={40}
        ~ loading='lazy'
        ~ decoding='async'
        ~ referrerPolicy='no-referrer'
        ~ onError={() => setHasFailedImage(true)}
        ~ className='block size-10 rounded-full object-cover'
        ~ )
    else
      span(
        ~ aria-hidden={true}
        ~ style={{ backgroundColor: tone }}
        ~ className='grid size-10 place-items-center rounded-full font-sans text-xs font-semibold text-white'
        ~ )
        | #{initials}
    if isSelected
      span(className='absolute -right-0.5 -bottom-0.5 grid size-4 origin-center animate-in zoom-in duration-200 ease-out flex items-center justify-center rounded-full border-2 border-popover bg-[#01bf7c] text-white duration-200 ease-out zoom-in-50 motion-reduce:animate-none')
        Icon(name='check' size={11} className='mt-[0.5px] text-white')
  div(className='min-w-0 flex-1')
    p(className='flex items-center gap-3 text-foreground text-sm uppercase')
      span(className='font-poly font-medium text-lg truncate tracking-wide') #{plateNumber}
      Status
    div(className='mt-0.5 flex min-w-0 items-center gap-1.5 font-mono text-xs text-foreground/80')
      span(className='truncate whitespace-nowrap') #{formatName(fullName) || 'Unknown applicant'}
      if email
        span(className='flex min-w-0 items-center gap-1.5')
          span(className='shrink-0 text-muted-foreground/50') #{'·'}
          span(className='truncate') #{email}
          span(className='shrink-0 text-muted-foreground/50') #{'·'}
          time(dateTime={createdAtIso} className='block')
          | #{formatCreatedAt(snap.createdAt)}
