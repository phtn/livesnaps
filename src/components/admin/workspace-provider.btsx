import { Outlet } from '@octanejs/tanstack-router'
import { WorkspaceContext, type WorkspaceAccount } from '@/hooks/use-workspace'
import {Icon } from '@/lib/icons'

module
  /**
   * The Account list and the picker live in the shell's sidebar, so this only
   * publishes the chosen Account to the routes below it.
   */
  export interface WorkspaceProviderProps {
    account: WorkspaceAccount | null
    /** Null until the first read settles, so loading reads differently to empty. */
    accounts: WorkspaceAccount[] | null
    error: string
    onRetry: () => void
    uid: string
  }

props { account, accounts, error, onRetry, uid }: WorkspaceProviderProps

if error
  div(role='alert' className='p-6 text-sm text-destructive')
    p #{error}
    button(type='button' className='mt-3 underline' onClick={onRetry}) Retry
elseif accounts === null
  span(className='p-6')
    Icon(name='spinner-axial' className='opacity-70 p-6')
elseif accounts.length === 0
  p(className='p-6 text-sm text-muted-foreground') You have no active Account memberships. Accept your invitation or contact your Account administrator.
elseif account
  WorkspaceContext.Provider(value={account})
    div(key={`${uid}:${account.id}`})
      Outlet
else
  p(className='p-6 text-sm text-muted-foreground') Select the Account whose submissions you want to view.
