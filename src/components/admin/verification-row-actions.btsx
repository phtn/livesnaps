import { createContext, use } from 'octane'
import type { OctaneNode } from 'octane'
import { Icon } from '@/lib/icons'
import { cn } from '@/lib/utils'
import type { VerificationEntryRow } from './data'
import { useWorkspace } from '@/hooks/use-workspace'

module
  export type OpenVerificationSendDialog = (entry: VerificationEntryRow) => void
  export type OpenVerificationEditDialog = (entry: VerificationEntryRow) => void

  export const VerificationRowActionsContext = createContext<{
    openEditDialog: OpenVerificationEditDialog
    openSendDialog: OpenVerificationSendDialog
  } | null>(null)

  // Mirrors `ui/table/row-actions.btsx`: the source these tables were ported
  // from used a shadcn ghost Button, which this project does not have.
  const GHOST_BUTTON_CLASS =
    'inline-flex cursor-pointer items-center justify-center rounded-md outline-none transition-colors hover:bg-accent focus-visible:ring-2 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50'

  // `component` emits a plain, unexported function declaration, so the provider
  // is re-exported here. It must NOT be wrapped in a namespace object named
  // after this file: Beast names the default component from the filename, so
  // `export const VerificationRowActions` would collide with the generated
  // `export default function VerificationRowActions` and the bundle would fail
  // to parse with "Identifier has already been declared".
  //
  // The cell is the default export because `verification-entry-columns.ts` is
  // plain TypeScript, and `*.btsx` is declared in `env.d.ts` with a default
  // export only — a named import would not resolve there.
  export { VerificationRowActionsProvider }

component VerificationRowActionsProvider
  props { children, onOpenEditDialog, onOpenSendDialog }: { children?: OctaneNode; onOpenEditDialog: OpenVerificationEditDialog; onOpenSendDialog: OpenVerificationSendDialog }

  VerificationRowActionsContext.Provider(value={{ openEditDialog: onOpenEditDialog, openSendDialog: onOpenSendDialog }})
    fragment #{children}

props { entry }: { entry: VerificationEntryRow }
setup
  const account = useWorkspace()
  const actions = use(VerificationRowActionsContext)

  if (!actions) {
    throw new Error('The verification row actions cell must be rendered within VerificationRowActionsContext.')
  }

  // A submitted entry can still be sent again — a bounced or lost email is
  // exactly when an operator needs this — so the action stays enabled and only
  // its wording changes.
  const hasBeenSent = entry.status === 'submitted'

div(className='flex items-center gap-0.5')
  button(
    ~ disabled={account?.role === 'viewer'}
    ~ type='button'
    ~ title='Edit the snap details'
    ~ aria-label={`Edit snap for ${entry.plateNumber}`}
    ~ onClick={(event: MouseEvent) => { event.stopPropagation(); actions.openEditDialog(entry) }}
    ~ className={cn(GHOST_BUTTON_CLASS, '-ml-2.5 size-7 rounded-xs text-foreground/70 hover:text-blue-600 dark:hover:text-blue-400')}
    ~ )
    Icon(name='pencil-bold' className='size-4')
  button(
    ~ disabled={account?.role === 'viewer'}
    ~ type='button'
    ~ title={hasBeenSent ? 'Compose and send again' : 'Compose the verification email'}
    ~ aria-label={`${hasBeenSent ? 'Resend' : 'Send'} verification for ${entry.plateNumber}`}
    ~ onClick={(event: MouseEvent) => { event.stopPropagation(); actions.openSendDialog(entry) }}
    ~ className={cn(GHOST_BUTTON_CLASS, 'size-7 rounded-xs text-foreground/70 hover:text-blue-600 dark:hover:text-blue-400')}
    ~ )
    Icon(name={hasBeenSent ? 'refresh' : 'email-setting'} className='size-4.5')
