import { createContext, use } from 'octane'
import type { OctaneNode } from 'octane'
import DropdownMenu, { DropdownMenuContent, DropdownMenuGroup, DropdownMenuItem, DropdownMenuLabel, DropdownMenuSeparator, DropdownMenuTrigger } from '@/components/ui/dropdown-menu.btsx'
import { Icon } from '@/lib/icons'
import { cn } from '@/lib/utils'
import type { VerificationEntryRow } from './data'
import { useWorkspace } from '@/hooks/use-workspace'
import { canReviewPhotos } from '@/lib/verifications/photo-review'

module
  export type OpenVerificationSendDialog = (entry: VerificationEntryRow) => void
  export type OpenVerificationEditDialog = (entry: VerificationEntryRow) => void
  export type StartVerification = (entry: VerificationEntryRow) => void

  export const VerificationRowActionsContext = createContext<{
    openEditDialog: OpenVerificationEditDialog
    openSendDialog: OpenVerificationSendDialog
    startVerification: StartVerification
  } | null>(null)

  // Mirrors `ui/table/row-actions.btsx`: the source these tables were ported
  // from used a shadcn ghost Button, which this project does not have.
  const GHOST_BUTTON_CLASS =
    'inline-flex cursor-pointer items-center justify-center rounded-md outline-none transition-colors hover:bg-accent focus-visible:ring-2 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50'

  // `component` emits a plain, unexported function declaration, so the provider
  // is re-exported here. It must NOT be wrapped in a namespace object named
  // after this file: Beast names the default component from the filename, so
  // `export const VerificationRowActions` would collide with the generated
  // `export default function VerificationRowActions` and the bundle would fail
  // to parse with "Identifier has already been declared".
  //
  // The cell is the default export because `verification-entry-columns.ts` is
  // plain TypeScript, and `*.btsx` is declared in `env.d.ts` with a default
  // export only — a named import would not resolve there.
  export { VerificationRowActionsProvider }

component VerificationRowActionsProvider
  props { children, onOpenEditDialog, onOpenSendDialog, onStartVerification }: { children?: OctaneNode; onOpenEditDialog: OpenVerificationEditDialog; onOpenSendDialog: OpenVerificationSendDialog; onStartVerification: StartVerification }

  VerificationRowActionsContext.Provider(value={{ openEditDialog: onOpenEditDialog, openSendDialog: onOpenSendDialog, startVerification: onStartVerification }})
    fragment #{children}

props { entry }: { entry: VerificationEntryRow }
setup
  const account = useWorkspace()
  const actions = use(VerificationRowActionsContext)

  if (!actions) {
    throw new Error('The verification row actions cell must be rendered within VerificationRowActionsContext.')
  }

  // A submitted entry can still be sent again — a bounced or lost email is
  // exactly when an operator needs this — so the action stays enabled and only
  // its wording changes.
  const hasBeenSent = entry.status === 'submitted'

DropdownMenu
  DropdownMenuTrigger(
    ~ disabled={account?.role === 'viewer'}
    ~ title='Open verification actions'
    ~ aria-label={`Open verification actions for ${entry.plateNumber}`}
    ~ onClick={(event: MouseEvent) => event.stopPropagation()}
    ~ className={cn(GHOST_BUTTON_CLASS, 'size-10 rounded-xs text-foreground/70 hover:text-foreground data-popup-open:bg-mist-300/60 dark:data-popup-open:bg-mist-700/40')}
    ~ )
    Icon(name='more-v' className='size-5 rotate-45 opacity-80')

  DropdownMenuContent(
    ~ align='end'
    ~ sideOffset={4}
    ~ className='w-64 ring-0 rounded-md dark:bg-zinc-900/50 bg-zinc-200/20 border border-border shadow-sm backdrop-blur-3xl'
    ~ onClick={(event: MouseEvent) => event.stopPropagation()}
    ~ )
    DropdownMenuGroup
      DropdownMenuLabel(className='border-b border-dashed border-border/50') #{entry.plateNumber || 'Options'}
      DropdownMenuItem(
        ~ disabled={account?.role === 'viewer' || !canReviewPhotos(entry.status)}
        ~ onClick={() => actions.startVerification(entry)}
        ~ className='h-12 rounded-xs'
        ~ )
        Icon(name='safe-shield' className='size-4 opacity-80')
        span #{entry.status === 'verified' ? 'Review verified photos' : entry.photoReview ? 'Resume verification' : 'Start verification'}
      DropdownMenuSeparator
      DropdownMenuItem(
        ~ disabled={account?.role === 'viewer'}
        ~ onClick={() => actions.openEditDialog(entry)}
        ~ className='h-12 rounded-xs'
        ~ )
        Icon(name='edit' className='size-4 opacity-80')
        span Edit snap details
      DropdownMenuSeparator
      DropdownMenuItem(
        ~ disabled={account?.role === 'viewer'}
        ~ onClick={() => actions.openSendDialog(entry)}
        ~ className='h-12 rounded-xs'
        ~ )
        Icon(name={hasBeenSent ? 'refresh' : 'email-setting'} className='size-4 opacity-80')
        span #{hasBeenSent ? 'Resend verification' : 'Send verification'}
