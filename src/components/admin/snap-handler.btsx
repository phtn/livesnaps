import { useEffect, useState } from 'octane'
import type { OctaneNode } from 'octane'
import SelectOctane from '@/components/ui/SelectOctane.btsx'
import PersonCell from '@/components/ui/table/person-cell.btsx'
import { accountEndpoint, useWorkspace } from '@/hooks/use-workspace'
import { SnapHandlerContext, useSnapHandlerContext } from './snap-handler-context'
import type { HandlerOptions } from './snap-handler-context'
import {cn} from '@/lib/utils'

module
  export { SnapHandlerProvider }

component SnapHandlerProvider
  props { children, refresh }: { children?: OctaneNode; refresh: () => void }
  setup
    const account = useWorkspace()
    const [options, setOptions] = useState<HandlerOptions>({ canManage: false, members: [] })
    useEffect(() => {
      const controller = new AbortController()
      void fetch(accountEndpoint('/api/admin/snap-handlers', account?.id ?? ''), { credentials: 'same-origin', signal: controller.signal })
        .then(async response => { if (response.ok) setOptions(await response.json() as HandlerOptions) })
        .catch(() => {})
      return () => controller.abort()
    }, [account?.id])

  SnapHandlerContext.Provider(value={{ options, refresh }})
    fragment #{children}

props { uploadId, name, email, imageUrl }: { uploadId: string; name?: string; email?: string; imageUrl?: string }
setup
  const context = useSnapHandlerContext()
  const [busy, setBusy] = useState(false)
  const [error, setError] = useState('')
  const members = context?.options.members ?? []
  const currentMemberId = members.find((member) => member.email === email)?.id ?? ''
  const options = [
    ...members.map((member) => ({ value: member.id, label: member.name })),
    { value: 'clear', label: 'Clear handler' }
  ]
  const selectClassNames = {
    option: () => 'text-xs',
    singleValue: () => 'text-xs'
  }
  const menuPortalTarget = typeof document === 'undefined' ? undefined : document.body
  const changeHandler = async (memberId: string) => {
    if (!memberId || memberId === currentMemberId || busy) return
    setBusy(true)
    setError('')
    try {
      const response = await fetch('/api/admin/snap-handlers', {
        method: 'POST', credentials: 'same-origin', headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ uploadId, memberId: memberId === 'clear' ? null : memberId })
      })
      if (!response.ok) {
        const payload = await response.json() as { error?: string }
        throw new Error(payload.error || 'Unable to update handler.')
      }
      context?.refresh()
    } catch (error) {
      setError(error instanceof Error ? error.message : 'Unable to update handler.')
    } finally {
      setBusy(false)
    }
  }

div(className='flex flex-col gap-1' onClick={(event: MouseEvent) => event.stopPropagation()})
  if context?.options.canManage
    SelectOctane(
      ~ aria-label={`Change handler for ${uploadId}`}
      ~ className='max-w-48'
      ~ classNames={selectClassNames}
      ~ controlClassName={cn('h-8 min-h-8! border! border-mist-500/15! bg-mist-500/8! text-mist-600! dark:text-mist-400! px-1.5! text-xs! rounded-md transition-opacity duration-400 ease-out', {'opacity-0!': members.length === 0})}
      ~ isDisabled={busy}
      ~ isSearchable={members.length > 8}
      ~ menuPortalTarget={menuPortalTarget}
      ~ menuPosition='fixed'
      ~ onChange={changeHandler}
      ~ options={options}
      ~ placeholder={busy ? 'Saving…' : name || 'Unassigned'}
      ~ value={currentMemberId}
      ~ )
  else
    PersonCell(name={name || 'Unassigned'} imageUrl={imageUrl})
  if error
    span(role='alert' className='text-xs text-destructive') #{error}
