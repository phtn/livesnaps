import FilterList from '@/components/ui/table/hyper/FilterList.btsx'
import { titleCase } from '@/components/ui/table/hyper/filter-list-config'
import type { FilterDefinition } from '@/components/ui/table/hyper/filter-list-config'
import type { DataTableFilterListProps } from '@/components/ui/table/types'
import type { features } from './table-config'
import { verificationEntryStatus, type VerificationEntryRow } from './data'
import { VERIFICATION_ENTRY_STATUS_FILTERS } from './verification-entry-columns'

module
  type EntryFilterProps = DataTableFilterListProps<VerificationEntryRow, typeof features>

  const getStatusLabel = (value: unknown) =>
    verificationEntryStatus[value as VerificationEntryRow['status']]?.label ?? titleCase(value)

  // Entries carry no numeric measurements, so unlike the snaps list this one
  // needs only a faceted status and a created-date range. The declared status
  // list is already in lifecycle order, so it drives the option order too.
  const ENTRY_FILTERS = [
    {
      id: 'status',
      label: 'Status',
      variant: 'faceted',
      values: VERIFICATION_ENTRY_STATUS_FILTERS,
      getValueLabel: getStatusLabel
    },
    { id: 'createdAt', label: 'Created', variant: 'date-range' }
  ] as const satisfies readonly FilterDefinition[]

  const ENTRY_FILTER_DESCRIPTION =
    'Filter the verification entries table by status or the date an entry was created.'

props { columns, columnFilters, onReset }: EntryFilterProps

FilterList(
  ~ columns={columns}
  ~ columnFilters={columnFilters}
  ~ onReset={onReset}
  ~ filters={ENTRY_FILTERS}
  ~ description={ENTRY_FILTER_DESCRIPTION}
  ~ )
