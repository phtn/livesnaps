import { useWorkspace } from '@/hooks/use-workspace'
import { useRecipientDefaults } from '@/hooks/use-recipient-defaults'
import { recipientChoices } from '@/lib/verifications/recipient-defaults'
import { useEffect, useMemo, useState } from 'octane'
import { Drawer } from '@octanejs/vaul'
import '@octanejs/vaul/style.css'
import { useField, useSelector } from '@octanejs/tanstack-form'
import AttachmentRow from '@/components/admin/attachment-row.btsx'
import SnapOptionItem from '@/components/admin/snap-option-item.btsx'
import SnapOptionList from '@/components/admin/snap-option-list.btsx'
import {Badge, Button, Input, ScrollArea } from '@/components/ui'
import Step from '@/components/admin/verification-step.btsx'
import { useMobile } from '@/hooks/use-mobile'
import { Icon } from '@/lib/icons'
import type { AdminSnapListItem } from '@/lib/snaps/admin-photo-types'
import { onError, onSuccess } from '@/lib/toast'
import { cn } from '@/lib/utils'
import { attachmentSize, attachmentTotalLabel, CONTENT_BASE_CLASS, CONTENT_BOTTOM_CLASS, CONTENT_RIGHT_CLASS, ENTER_CLASS, errorTextClassName, fieldLabelClassName, ghostButtonClassName, readonlyFieldClassName, type StepState } from '@/lib/verifications/step-flow'
import { createVerificationEntry } from '@/lib/verifications/admin-writes'
import { DEFAULT_VERIFICATION_ATTACHMENTS, isVerificationEmailAddress, VERIFICATION_EMAIL_MAX_LENGTH } from '@/lib/verifications/entries'
import { readValidationMessage, toCreateVerificationEntryInput, useVerificationEntryForm, validateVerificationEntryForm, verificationEntryFormDefaults, type VerificationEntryEmailField, type VerificationEntryForm } from '@/lib/verifications/entry-form'
import IconButton from "../ui/icon-button.btsx";
import SelectOctane from '@/components/ui/SelectOctane.btsx'


module
  export interface CreateVerificationEntryDialogProps {
    /** The signed-in administrator's address, read from `/api/admin/session`. */
    emailFromAddress: string
    isLoadingSnaps?: boolean
    /** Called after a successful create so the table can pick the row up early. */
    onCreated?: () => void
    snaps: readonly AdminSnapListItem[]
  }

  // Long lists make the picker useless rather than more useful — the search box
  // is the way to reach a specific plate, so the list only ever previews.
  const VISIBLE_SNAP_LIMIT = 20

  const snapHaystack = (snap: AdminSnapListItem) =>
    [snap.plateNumber, snap.fullName, snap.email, snap.make, snap.model].filter(Boolean).join(' ').toLowerCase()

  const snapVehicle = (snap: AdminSnapListItem) => [snap.make, snap.model].filter(Boolean).join(' ')

// One email control bound to one form field. Value, blur, and the error message
// all come from the field's own state rather than from a second copy kept here.
component EmailField
  props { form, name, label, placeholder, required = false, options = [] }: { form: VerificationEntryForm; name: VerificationEntryEmailField; label: string; placeholder?: string; required?: boolean; options?: readonly string[] }
  setup
    const field = useField({ form, name })
    const controlId = `verification-${name}`
    const errorId = `${controlId}-error`
    const message = field.state.meta.isTouched ? readValidationMessage(field.state.meta.errors) : null
    const recipientOptions = options.map((email) => ({ value: email, label: email }))
    const savedRecipientValue = options.includes(field.state.value) ? field.state.value : ''
    const menuPortalTarget = typeof document === 'undefined' ? undefined : document.body
    const handleRecipientInputChange = (value: string, meta: { action: string }) => {
      if (meta.action === 'input-change') field.handleChange(value)
    }

  div(className='flex flex-col gap-1.5')
    label(className={fieldLabelClassName} htmlFor={controlId}) #{label}
    if name === 'emailToAddress'
      SelectOctane(
        ~ inputId={controlId}
        ~ aria-label={label}
        ~ aria-invalid={message !== null}
        ~ aria-describedby={message === null ? undefined : errorId}
        ~ aria-required={true}
        ~ className='w-full min-w-0'
        ~ controlClassName='h-9 min-h-9! rounded-xs border-sidebar-border bg-sidebar/50'
        ~ inputValue={field.state.value}
        ~ isSearchable={true}
        ~ menuPortalTarget={menuPortalTarget}
        ~ menuPosition='fixed'
        ~ noOptionsMessage={() => 'Type a recipient email'}
        ~ onBlur={field.handleBlur}
        ~ onChange={field.handleChange}
        ~ onInputChange={handleRecipientInputChange}
        ~ options={recipientOptions}
        ~ placeholder={placeholder}
        ~ value={savedRecipientValue}
        ~ )
    else
      Input(
        ~ id={controlId}
        ~ type='email'
        ~ autoComplete='email'
        ~ className='rounded-xs'
        ~ maxLength={VERIFICATION_EMAIL_MAX_LENGTH}
        ~ placeholder={placeholder}
        ~ required={required}
        ~ value={field.state.value}
        ~ aria-invalid={message !== null}
        ~ aria-describedby={message === null ? undefined : errorId}
        ~ onBlur={field.handleBlur}
        ~ onInput={(event: Event) => field.handleChange((event.currentTarget as HTMLInputElement).value)}
        ~ )
    if message
      p(id={errorId} className={errorTextClassName}) #{message}

props { emailFromAddress, isLoadingSnaps = false, onCreated, snaps }: CreateVerificationEntryDialogProps

setup
  const [isOpen, setIsOpen] = useState(false)
  const [searchQuery, setSearchQuery] = useState('')
  const account = useWorkspace()
  const { settings: recipientDefaults, error: recipientDefaultsError } = useRecipientDefaults(account?.id, isOpen)
  const options = recipientChoices(recipientDefaults)

  // Bottom on a phone, right on a desktop. Vaul reads the direction from its
  // own context, so flipping it on resize is enough to move the panel.
  const isMobile = useMobile()
  const direction = isMobile ? 'bottom' : 'right'

  const entryForm = useVerificationEntryForm({
    onSubmit: async (values) => {
      const snap = snaps.find((item) => item._id === values.snapId)
      if (!snap) throw new Error('Select a snap to create a verification.')

      const input = toCreateVerificationEntryInput(values, snap)
      await createVerificationEntry(input)

      setIsOpen(false)
      setSearchQuery('')
      entryForm.reset(verificationEntryFormDefaults())
      onCreated?.()
      onSuccess(`Verification created for ${input.applicant} · ${input.plateNumber}.`)
    },
    onFailure: onError
  })

  useEffect(() => {
    if (isOpen && options.length && !entryForm.state.values.emailToAddress && !entryForm.getFieldMeta('emailToAddress')?.isDirty)
      entryForm.setFieldValue('emailToAddress', options[0])
  }, [isOpen, recipientDefaults])

  useEffect(() => {
    setIsOpen(false)
    entryForm.reset(verificationEntryFormDefaults())
  }, [account?.id])

  const selectedSnapId = useSelector(entryForm.store, (state) => state.values.snapId)
  const emailToAddress = useSelector(entryForm.store, (state) => state.values.emailToAddress)
  const attachments = useSelector(entryForm.store, (state) => state.values.attachments)
  const isSubmitting = useSelector(entryForm.store, (state) => state.isSubmitting)
  const submitError = useSelector(entryForm.store, (state) =>
    typeof state.errorMap.onSubmit === 'string' ? state.errorMap.onSubmit : null
  )
  // `canSubmit` alone stays true on a pristine form, before any validator has
  // run, so the same whole-form check the validator uses is applied here.
  const isFormValid = useSelector(
    entryForm.store,
    (state) => state.canSubmit && validateVerificationEntryForm(state.values) === undefined
  )

  const selectedSnap = useMemo(
    () => snaps.find((snap) => snap._id === selectedSnapId) ?? null,
    [snaps, selectedSnapId]
  )

  // A snap that already has a handler or a verification status is spoken for:
  // `verificationEntries.m.create` refuses it, so it is not offered here either.
  const eligibleSnaps = useMemo(
    () => snaps.filter((snap) => snap.status === 'completed' && !snap.handler && !snap.verification_status),
    [snaps]
  )

  const filteredSnaps = useMemo(() => {
    const query = searchQuery.trim().toLowerCase()
    if (!query) return eligibleSnaps.slice(0, VISIBLE_SNAP_LIMIT)

    return eligibleSnaps.filter((snap) => snapHaystack(snap).includes(query)).slice(0, VISIBLE_SNAP_LIMIT)
  }, [eligibleSnaps, searchQuery])

  // Each row's size is read from the selected snap, so the two are computed
  // together and the template just indexes into them.
  const attachmentSizes = useMemo(
    () => DEFAULT_VERIFICATION_ATTACHMENTS.map((option) => attachmentSize(option, selectedSnap)),
    [selectedSnap]
  )

  const attachmentTotal = useMemo(
    () => attachmentTotalLabel(attachments, DEFAULT_VERIFICATION_ATTACHMENTS, selectedSnap),
    [attachments, selectedSnap]
  )

  const hasSender = emailFromAddress.trim().length > 0
  const isRecipientValid = isVerificationEmailAddress(emailToAddress.trim())
  const canSubmit = isFormValid && hasSender && !isSubmitting

  const snapState: StepState = selectedSnap ? 'done' : 'active'
  const applicantState: StepState = selectedSnap ? 'done' : 'idle'
  const recipientState: StepState = !selectedSnap ? 'idle' : isRecipientValid ? 'done' : 'active'
  const attachmentState: StepState = !selectedSnap ? 'idle' : attachments.length > 0 ? 'done' : 'active'
  const createState: StepState = canSubmit ? 'active' : 'idle'

  // The idle Create step shows how far the pipeline has come rather than an
  // inert bar, so the last step still moves while the earlier ones are settled.
  const completedSteps = [Boolean(selectedSnap), isRecipientValid, attachments.length > 0].filter(Boolean).length
  const progressWidth = `${Math.round((completedSteps / 3) * 100)}%`

  // Reduced to one value rather than an if/elseif chain in the template: a
  // chain whose last branch is an `elseif` was observed emitting that branch
  // outside the conditional.
  const statusLabel = isSubmitting
    ? 'Creating entry…'
    : !hasSender
      ? 'Session email missing'
      : !selectedSnap
        ? 'Needs a snap'
        : !isRecipientValid
          ? 'Needs a recipient'
          : attachments.length === 0
            ? 'Needs an attachment'
            : 'Ready to create'

  const statusToneClass = isSubmitting
    ? 'text-active'
    : canSubmit
      ? 'text-positive'
      : hasSender
        ? 'text-muted-foreground'
        : 'text-destructive'

  const selectSnap = (snap: AdminSnapListItem) => {
    entryForm.setFieldValue('snapId', snap._id)
    setSearchQuery('')
  }

  const selectSnapById = (id: string) => {
    const snap = filteredSnaps.find((item) => item._id === id)
    if (snap) selectSnap(snap)
  }

  const clearSnap = () => {
    entryForm.setFieldValue('snapId', '')
  }

  // Read through the store rather than the render snapshot: two toggles in the
  // same frame would otherwise both start from the same list and the first one
  // would be lost.
  const toggleAttachment = (value: string) => {
    const current = entryForm.state.values.attachments
    entryForm.setFieldValue(
      'attachments',
      current.includes(value) ? current.filter((item) => item !== value) : [...current, value]
    )
  }

  const handleOpenChange = (open: boolean) => {
    // Closing mid-flight would leave the submission writing into a torn-down
    // form, so the drawer stays put until the create settles either way.
    if (isSubmitting) return
    setIsOpen(open)
    if (!open) {
      setSearchQuery('')
      entryForm.reset(verificationEntryFormDefaults())
    }
  }

  const submit = (event: SubmitEvent) => {
    event.preventDefault()
    void entryForm.handleSubmit()
  }

fragment
  IconButton(
    ~ id='create-new-entry'
    ~ size='sm'
    ~ variant='dark'
    ~ icon='add'
    ~ label={isMobile ? undefined : 'New'}
    // ~ className='rounded-xs portrait:gap-0! flex portrait:justify-center portrait:size-6 portrait:aspect-square md:gap-2 portrait:px-0'
    ~ onClick={() => setIsOpen(true)}
    ~ )

  Drawer.Root(open={isOpen} onOpenChange={handleOpenChange} direction={direction})
    Drawer.Portal
      Drawer.Overlay(className='fixed inset-0 z-50 bg-black/45 backdrop-blur-[1px]')
      Drawer.Content(className={cn(CONTENT_BASE_CLASS, isMobile ? CONTENT_BOTTOM_CLASS : CONTENT_RIGHT_CLASS)})
        form(className='flex min-h-0 flex-1 flex-col' onSubmit={submit})

          div(className='shrink-0 px-4 pt-3 pb-3 sm:px-5')
            if isMobile
              Drawer.Handle(className='mb-4')
            div(className='flex items-center justify-between gap-3')
              Drawer.Title(className='font-poly text-lg leading-none tracking-tight') Create verification
              span(className='inline-flex shrink-0 items-center gap-1.5 rounded-full bg-border/20 border border-border/30 px-2.5 py-1 font-mono text-2xs text-muted-foreground')
                span(className='') #{eligibleSnaps.length}
                span(className='opacity-50') #{`/`}
                span(className='') eligible
            Drawer.Description(className='sr-only')
              | Select a completed snap, confirm the recipients, and create the verification entry.

          div(className='min-h-0 flex-1 overflow-y-auto px-2 pb-2 sm:px-3 sm:pb-3')
            div(className='rounded-2xl border border-border/0 bg-popover p-4 shadow-sm')

              Step(
                ~ icon='camera-enhance'
                ~ title='Snap'
                ~ state={snapState}
                ~ index={0}
                ~ meta={selectedSnap ? undefined : `${filteredSnaps.length} of ${eligibleSnaps.length}`}
                ~ )
                if selectedSnap
                  div(className={cn('relative flex items-center justify-between rounded-lg border border-border/50 bg-muted/30 p-3', ENTER_CLASS)})
                    SnapOptionItem(snap={selectedSnap} isSelected={true})
                    div(className='absolute top-0 right-0 border')
                      button(
                        ~ type='button'
                        ~ onClick={clearSnap}
                        ~ className={cn(ghostButtonClassName, 'absolute top-1 right-1 h-7 px-1 font-mono text-2xs uppercase tracking-wider hover:text-destructive')}
                        ~ )
                        Icon(name='circle-minus' className='size-3 opacity-80')
                        span Clear
                else
                  div(className={cn('grid gap-2', ENTER_CLASS)})
                    div(className='relative')
                      Input(
                        ~ id='verification-snap-search'
                        ~ type='search'
                        ~ autoComplete='off'
                        ~ className='rounded-xs pl-3'
                        ~ placeholder='Search plate, name, email, make, model…'
                        ~ value={searchQuery}
                        ~ onInput={(event: Event) => setSearchQuery((event.currentTarget as HTMLInputElement).value)}
                        ~ )
                    div(className='')
                      ScrollArea(className='h-48 rounded-lg overflow-hidden')
                        div(className='bg-table-head/20')
                          if isLoadingSnaps
                            div(className='grid place-items-center gap-2 px-3 py-10 text-sm text-muted-foreground')
                              Icon(name='spinner-ring' className='size-5 animate-spin')
                              span Loading snaps…
                          elseif filteredSnaps.length === 0
                            div(className='px-3 py-10 text-center')
                              p(className='text-sm font-medium text-muted-foreground') No eligible snaps match
                              p(className='mt-1 font-mono text-2xs text-muted-foreground') Try a different plate, name, email, make or model.
                          else
                            SnapOptionList(snaps={filteredSnaps} onSelect={selectSnapById} selectedId={selectedSnap?._id ?? null})

              Step(
                ~ icon='person'
                ~ title='Applicant'
                ~ state={applicantState}
                ~ index={1}
                ~ meta={selectedSnap ? snapVehicle(selectedSnap) || undefined : undefined}
                ~ )
                if selectedSnap
                  div(className={ENTER_CLASS})
                    p(className='font-mono text-xs text-muted-foreground')
                      span(className='text-foreground') #{selectedSnap.fullName || selectedSnap.email || 'Unknown applicant'}
                      span(className='px-1.5 text-muted-foreground/70') ⟶
                      span(className='uppercase tracking-wide text-foreground') #{selectedSnap.plateNumber || '—'}
                else
                  p(className={cn('font-mono text-xs text-muted-foreground/50', ENTER_CLASS)}) Derived from the selected snap

              Step(
                ~ icon='at'
                ~ title='Recipients'
                ~ state={recipientState}
                ~ index={2}
                ~ meta={hasSender ? undefined : 'no sender'}
                ~ )
                div(className='grid gap-3')
                  label(className='hidden md:flex flex-col gap-1.5' htmlFor='verification-email-from')
                    span(className={fieldLabelClassName}) From
                    div(id='verification-email-from' className={readonlyFieldClassName}) #{emailFromAddress || 'Signing in…'}
                  div(className='grid gap-3 sm:grid-cols-2')
                    EmailField(form={entryForm} name='emailToAddress' label='To' placeholder='recipient@example.com' required={true} options={options})
                    EmailField(form={entryForm} name='ccEmailAddress' label='CC' placeholder='Optional')
                  if recipientDefaultsError
                    p(className='text-xs text-destructive' role='alert') Saved recipients could not be loaded. You can still type an address.

              Step(
                ~ icon='attachment'
                ~ title='Attachments'
                ~ state={attachmentState}
                ~ index={3}
                ~ meta={attachmentTotal ? `${attachments.length} of ${DEFAULT_VERIFICATION_ATTACHMENTS.length} · ${attachmentTotal}` : `${attachments.length} of ${DEFAULT_VERIFICATION_ATTACHMENTS.length}`}
                ~ )
                div(className='grid')
                  each option, index in DEFAULT_VERIFICATION_ATTACHMENTS key option
                    AttachmentRow(
                      ~ index={index}
                      ~ label={option}
                      ~ included={attachments.includes(option)}
                      ~ size={attachmentSizes[index].label}
                      ~ isEstimate={attachmentSizes[index].isEstimate}
                      ~ onToggle={() => toggleAttachment(option)}
                      ~ )

              Step(icon='sparkle' title='Create' state={createState} index={4} isLast={true})
                if canSubmit
                  p(className={cn('font-mono text-xs text-muted-foreground', ENTER_CLASS)}) Queue the entry and hand it to the send dialog.
                else
                  div(className='h-2 w-full overflow-hidden rounded-full bg-muted/70')
                    div(className='h-full rounded-full bg-active/60 transition-[width] duration-500 ease-out' style={{ width: progressWidth }})

              if submitError
                p(className={cn('mt-4 rounded-lg border border-destructive/40 bg-destructive/10 px-3 py-2 text-sm text-destructive', ENTER_CLASS)} role='alert') #{submitError}

          div(className='flex shrink-0 items-center justify-between gap-3 border-t border-border/50 px-4 py-3 sm:px-5')
            div(className='flex min-w-0 items-center gap-2')
              span(className={cn('size-1.5 shrink-0 rounded-full bg-current', statusToneClass, isSubmitting && 'animate-pulse')})
              span(className={cn('truncate font-sans text-xs', statusToneClass)}) #{statusLabel}
            div(className='flex shrink-0 items-center gap-2')
              Button(
                ~ type='button'
                ~ size='sm'
                ~ variant='ghost'
                ~ label='Cancel'
                ~ disabled={isSubmitting}
                ~ onClick={() => handleOpenChange(false)}
                ~ )
              Button(
                ~ type='submit'
                ~ size='sm'
                ~ variant='dark'
                ~ icon='chevrons-right'
                ~ iconPosition='right'
                ~ label='Create entry'
                ~ pending={isSubmitting}
                ~ pendingLabel='Creating…'
                ~ disabled={!canSubmit}
                ~ )
