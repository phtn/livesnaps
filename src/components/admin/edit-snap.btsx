import { Drawer } from '@octanejs/vaul'
import '@octanejs/vaul/style.css'
import { useField, useSelector } from '@octanejs/tanstack-form'
import { Button, Input } from '@/components/ui'
import Step from '@/components/admin/verification-step.btsx'
import { useMobile } from '@/hooks/use-mobile'
import type { AdminSnapListItem } from '@/lib/snaps/admin-photo-types'
import { updateAdminSnap } from '@/lib/snaps/admin-writes'
import { type EditSnapFieldName, type EditSnapForm, editSnapFormDefaults, readEditSnapValidationMessage, toUpdateAdminSnapInput, useEditSnapForm, validateEditSnapForm } from '@/lib/snaps/edit-form'
import { onError, onSuccess } from '@/lib/toast'
import { CONTENT_BASE_CLASS, CONTENT_BOTTOM_CLASS, CONTENT_RIGHT_CLASS, ENTER_CLASS, errorTextClassName, fieldLabelClassName, type StepState } from '@/lib/verifications/step-flow'
import { cn } from '@/lib/utils'

module
  export interface EditSnapDrawerProps {
    onOpenChange: (open: boolean) => void
    onUpdated?: () => void
    open: boolean
    snap: AdminSnapListItem | null
  }

  interface EditSnapFieldProps {
    form: EditSnapForm
    label: string
    max?: number
    maxLength?: number
    min?: number
    name: EditSnapFieldName
    placeholder?: string
    step?: number | 'any'
    type?: 'text' | 'tel' | 'number'
  }

component EditSnapField
  props { form, label, max, maxLength, min, name, placeholder, step, type = 'text' }: EditSnapFieldProps
  setup
    const field = useField({ form, name })
    const controlId = `edit-snap-${name}`
    const errorId = `${controlId}-error`
    const message = field.state.meta.isTouched ? readEditSnapValidationMessage(field.state.meta.errors) : null

  label(className='flex flex-col gap-1.5' htmlFor={controlId})
    span(className={fieldLabelClassName}) #{label}
    Input(
      ~ id={controlId}
      ~ type={type}
      ~ autoComplete='off'
      ~ className='rounded-xs'
      ~ max={max}
      ~ maxLength={maxLength}
      ~ min={min}
      ~ placeholder={placeholder}
      ~ step={step}
      ~ value={field.state.value}
      ~ aria-invalid={message !== null}
      ~ aria-describedby={message === null ? undefined : errorId}
      ~ onBlur={field.handleBlur}
      ~ onInput={(event: Event) => field.handleChange((event.currentTarget as HTMLInputElement).value)}
      ~ )
    if message
      p(id={errorId} className={errorTextClassName}) #{message}

props { onOpenChange, onUpdated, open, snap }: EditSnapDrawerProps
setup
  const isMobile = useMobile()
  const direction = isMobile ? 'bottom' : 'right'
  const form = useEditSnapForm(snap, async (values) => {
    if (!snap) throw new Error('The snap could not be found.')
    await updateAdminSnap(toUpdateAdminSnapInput(snap, values))
    onSuccess(`Updated snap ${values.plateNumber.trim()}.`)
    onUpdated?.()
    onOpenChange(false)
  })

  const values = useSelector(form.store, (state) => state.values)
  const isSubmitting = useSelector(form.store, (state) => state.isSubmitting)
  const canSubmit = useSelector(
    form.store,
    (state) => state.canSubmit && validateEditSnapForm(state.values) === undefined
  )
  const submitError = useSelector(form.store, (state) => {
    const error = state.errorMap.onSubmit
    if (typeof error === 'string') return error
    if (error && typeof error === 'object' && 'form' in error && typeof error.form === 'string') return error.form
    return null
  })

  const validation = validateEditSnapForm(values)
  const fieldErrors = validation?.fields ?? {}
  const applicantIsValid = !fieldErrors.fullName && !fieldErrors.phone
  const vehicleIsValid = !fieldErrors.plateNumber && !fieldErrors.make && !fieldErrors.model && !fieldErrors.year
  const mileageIsValid = !fieldErrors.mileage
  const applicantState: StepState = applicantIsValid ? 'done' : 'active'
  const vehicleState: StepState = !applicantIsValid ? 'idle' : vehicleIsValid ? 'done' : 'active'
  const mileageState: StepState = !applicantIsValid || !vehicleIsValid ? 'idle' : mileageIsValid ? 'done' : 'active'
  const saveState: StepState = canSubmit ? 'active' : 'idle'
  const completedSteps = [applicantIsValid, vehicleIsValid, mileageIsValid].filter(Boolean).length
  const progressWidth = `${Math.round((completedSteps / 3) * 100)}%`
  const statusLabel = isSubmitting
    ? 'Saving changes…'
    : !snap
      ? 'Snap unavailable'
      : canSubmit
        ? 'Ready to save'
        : 'Check required details'
  const statusToneClass = isSubmitting
    ? 'text-active'
    : canSubmit
      ? 'text-positive'
      : snap
        ? 'text-muted-foreground'
        : 'text-destructive'

  const handleOpenChange = (nextOpen: boolean) => {
    if (isSubmitting) return
    onOpenChange(nextOpen)
    if (!nextOpen) form.reset(editSnapFormDefaults())
  }

  const submit = (event: SubmitEvent) => {
    event.preventDefault()
    void form.handleSubmit().catch((error: unknown) => onError(error instanceof Error ? error.message : 'Unable to update the snap.'))
  }

Drawer.Root(open={open} onOpenChange={handleOpenChange} direction={direction})
  Drawer.Portal
    Drawer.Overlay(className='fixed inset-0 z-50 bg-black/45 backdrop-blur-[1px]')
    Drawer.Content(className={cn(CONTENT_BASE_CLASS, isMobile ? CONTENT_BOTTOM_CLASS : CONTENT_RIGHT_CLASS)})
      form(className='flex min-h-0 flex-1 flex-col' onSubmit={submit})
        div(className='shrink-0 px-4 pt-3 pb-3 sm:px-5')
          if isMobile
            Drawer.Handle(className='mb-4')
          div(className='flex items-center justify-between gap-3')
            Drawer.Title(className='font-poly text-lg leading-none tracking-tight') Edit Applicant
            if snap
              span(className='inline-flex max-w-48 shrink-0 truncate rounded-full border border-border/20 bg-table-head/80 px-2.5 py-1 font-mono text-xs text-muted-foreground') #{snap.uploadId.split('-').pop()}
          Drawer.Description(className='sr-only')
            | Edit the applicant and vehicle details stored on this snap. The verification entry is not changed.

        div(className='min-h-0 flex-1 overflow-y-auto px-2 pb-2 sm:px-3 sm:pb-3')
          div(className='rounded-2xl border border-border/0 bg-popover p-4 shadow-sm')
            Step(icon='person' title='Applicant' state={applicantState} index={0})
              div(className={cn('grid gap-3 sm:grid-cols-2', ENTER_CLASS)})
                EditSnapField(form={form} name='fullName' label='Applicant name' maxLength={120} placeholder='Applicant name')
                EditSnapField(form={form} name='phone' label='Phone' type='tel' maxLength={32} placeholder='Phone number')

            Step(icon='car-front' title='Vehicle' state={vehicleState} index={1} meta={values.plateNumber.trim() || undefined})
              div(className={cn('grid gap-3', ENTER_CLASS)})
                EditSnapField(form={form} name='plateNumber' label='Plate number' maxLength={32} placeholder='Plate number')
                div(className='grid gap-3 sm:grid-cols-2')
                  EditSnapField(form={form} name='make' label='Make (optional)' maxLength={80} placeholder='Vehicle make')
                  EditSnapField(form={form} name='model' label='Model (optional)' maxLength={80} placeholder='Vehicle model')
                EditSnapField(form={form} name='year' label='Year (optional)' type='number' min={1886} max={new Date().getFullYear() + 1} step={1} placeholder='Model year')

            Step(icon='car-odo' title='Odometer' state={mileageState} index={2} meta={values.mileage.trim() ? `${values.mileage} km` : 'optional'})
              div(className={ENTER_CLASS})
                EditSnapField(form={form} name='mileage' label='Mileage (km)' type='number' min={0} max={9999999.9} step='any' placeholder='Optional')

            Step(icon='sparkle' title='Save' state={saveState} index={3} isLast={true})
              if canSubmit
                p(className={cn('font-mono text-xs text-muted-foreground', ENTER_CLASS)}) Update this snap with the details above.
              else
                div(className='h-2 w-full overflow-hidden rounded-full bg-muted/70')
                  div(className='h-full rounded-full bg-active/60 transition-[width] duration-500 ease-out' style={{ width: progressWidth }})

            if submitError
              p(className={cn('mt-4 rounded-lg border border-destructive/40 bg-destructive/10 px-3 py-2 text-sm text-destructive', ENTER_CLASS)} role='alert') #{submitError}

        div(className='flex shrink-0 items-center justify-between gap-3 border-t border-border/50 px-4 py-3 sm:px-5')
          div(className='flex min-w-0 items-center gap-2')
            span(className={cn('size-1.5 shrink-0 rounded-full bg-current', statusToneClass, isSubmitting && 'animate-pulse')})
            span(className={cn('truncate font-sans text-xs', statusToneClass)}) #{statusLabel}
          div(className='flex shrink-0 items-center gap-2')
            Button(type='button' size='sm' variant='ghost' label='Cancel' disabled={isSubmitting} onClick={() => handleOpenChange(false)})
            Button(type='submit' size='sm' variant='dark' icon='check' label='Save changes' pending={isSubmitting} pendingLabel='Saving…' disabled={!canSubmit || !snap})
