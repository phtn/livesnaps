import { useForm, useSelector } from '@octanejs/tanstack-form'
import { useWorkspace } from '@/hooks/use-workspace'
import { useRecipientDefaults } from '@/hooks/use-recipient-defaults'
import { recipientChoices } from '@/lib/verifications/recipient-defaults'
import { useEffect, useLinkedState, useMemo, useRef, useState } from 'octane'
import { Drawer } from '@octanejs/vaul'
import '@octanejs/vaul/style.css'
import AttachmentRow from '@/components/admin/attachment-row.btsx'
import SnapOptionItem from '@/components/admin/snap-option-item.btsx'
import { Badge, Button, Input } from '@/components/ui'
import Step from '@/components/admin/verification-step.btsx'
import SelectOctane from '@/components/ui/SelectOctane.btsx'
import { useMobile } from '@/hooks/use-mobile'
import { Icon } from '@/lib/icons'
import type { AdminSnapListItem } from '@/lib/snaps/admin-photo-types'
import { onError, onSuccess } from '@/lib/toast'
import { cn } from '@/lib/utils'
import { activateVerificationEntry, removeVerificationAttachment, sendVerificationEmail, uploadVerificationAttachment } from '@/lib/verifications/admin-writes'
import { DEFAULT_VERIFICATION_ATTACHMENTS, isVerificationEmailAddress } from '@/lib/verifications/entries'
import { attachmentSize, attachmentTotalLabel, formatBytes, CONTENT_BASE_CLASS, CONTENT_BOTTOM_CLASS, CONTENT_RIGHT_CLASS, ENTER_CLASS, fieldLabelClassName, ghostButtonClassName, readonlyFieldClassName, type StepState } from '@/lib/verifications/step-flow'
import type { VerificationUpload } from '../../../convex/verificationEntries/d'
import type { VerificationEntryRow } from './data'

module
  export interface SendVerificationEntryDialogProps {
    entry: VerificationEntryRow | null
    onOpenChange: (open: boolean) => void
    /** Called after a successful send so the table can pick the status up early. */
    onSent?: () => void
    open: boolean
    /**
     * The snaps list the workspace already polls. The entry is keyed on an
     * upload id, so its snap is what carries the applicant's face and the
     * bytes behind each attachment.
     */
    snaps?: readonly AdminSnapListItem[]
  }

  const defaultAttachments = (entry: VerificationEntryRow): string[] =>
    entry.attachments ?? [...DEFAULT_VERIFICATION_ATTACHMENTS]

  const defaultSubject = (entry: VerificationEntryRow) => `Verification – ${entry.plateNumber} – ${entry.applicant}`

  const defaultBody = (entry: VerificationEntryRow) =>
    `Hello,\n\nVerification for ${entry.applicant}.\n\nPlease find attached: ${defaultAttachments(entry).join(', ')}.\n\nPlate: ${entry.plateNumber}\nUpload ID: ${entry.uploadId}\n\nRegards,\n${entry.senderName}`

  const errorMessage = (error: unknown, fallback: string) => (error instanceof Error ? error.message : fallback)


// A name the operator typed rather than one the server knows how to assemble.
// Only the label travels: the bytes come from R2 at send time.
component CustomAttachmentRow
  props { index, name, onRemove }: { index: number; name: string; onRemove: () => void }
  div(className='flex w-full items-center gap-3 rounded-lg px-1 py-1.5')
    span(className='grid size-5 shrink-0 place-items-center rounded-full border border-border/60 font-sans text-2xs leading-none text-muted-foreground')
      | #{index + 1}
    span(className='min-w-0 flex-1 truncate font-mono text-xs text-foreground') #{name}
    button(
      ~ type='button'
      ~ aria-label={`Remove ${name}`}
      ~ onClick={onRemove}
      ~ className={cn(ghostButtonClassName, 'size-6 shrink-0 text-muted-foreground')}
      ~ )
      Icon(name='close' className='size-3.5')

// One file that is actually in storage: its real name, its real weight, and a
// control to drop it again while the entry is still a draft.
component UploadedAttachmentRow
  props { index, upload, isBusy, onRemove }: { index: number; upload: VerificationUpload; isBusy: boolean; onRemove: () => void }
  div(className={cn('flex w-full items-center gap-3 rounded-lg px-1 py-1.5 transition-opacity duration-200', isBusy && 'opacity-50')})
    span(className='grid size-5 shrink-0 place-items-center rounded-full bg-[#01bf7c]/96 font-sans text-2xs leading-none text-white')
      | #{index + 1}
    span(className='min-w-0 flex-1 truncate font-mono text-foreground text-xs') #{upload.name}
    span(className='hidden h-1.5 w-44 shrink-0 overflow-hidden rounded-full bg-muted sm:block')
      span(className='block h-full w-full rounded-full bg-[#01bf7c]/96')
    span(className='w-20 shrink-0 text-right font-mono text-2xs text-[#01bf7c] tabular-nums') #{formatBytes(upload.size)}
    button(
      ~ type='button'
      ~ aria-label={`Remove ${upload.name}`}
      ~ disabled={isBusy}
      ~ onClick={onRemove}
      ~ className={cn(ghostButtonClassName, 'size-6 shrink-0 text-muted-foreground')}
      ~ )
      Icon(name='close' className='size-3.5')

props { entry, onOpenChange, onSent, open, snaps }: SendVerificationEntryDialogProps

setup
  // Bottom on a phone, right on a desktop — the same panel the create drawer
  // uses, so the two halves of the flow arrive from the same edge.
  const isMobile = useMobile()
  const direction = isMobile ? 'bottom' : 'right'

  // The dialog is mounted once per table and re-pointed at a row, so the draft
  // has to follow `entry` rather than being seeded on mount. `useLinkedState`
  // keeps an in-progress edit until the row underneath actually changes.
  const [subject, setSubject] = useLinkedState(entry?._id ?? '', () => (entry ? defaultSubject(entry) : ''))
  const [body, setBody] = useLinkedState(entry?._id ?? '', () => (entry ? defaultBody(entry) : ''))
  const [selectedAttachments, setSelectedAttachments] = useLinkedState(entry?._id ?? '', () =>
    entry ? defaultAttachments(entry) : []
  )
  const account = useWorkspace()
  const { settings: recipientDefaults } = useRecipientDefaults(account?.id, open)
  const recipientValues = recipientChoices(recipientDefaults)
  const recipientOptions = recipientValues.map((email) => ({ value: email, label: email }))
  const menuPortalTarget = typeof document === 'undefined' ? undefined : document.body
  const recipientForm = useForm({
    formId: entry ? `send-recipient-${entry._id}` : 'send-recipient-empty',
    defaultValues: { emailToAddress: entry?.emailToAddress ?? '' },
    validators: { onChange: ({ value }) => isVerificationEmailAddress(value.emailToAddress.trim()) ? undefined : 'Enter a valid recipient email.' },
    onSubmit: async ({ value, formApi }) => {
      if (!entry) return
      try {
        await sendVerificationEmail({
          id: entry._id,
          emailToAddress: value.emailToAddress.trim(),
          attachments: selectedAttachments,
          subject: subject.trim() || undefined,
          body: body.trim() || undefined
        })
        onSuccess(`Email sent to ${value.emailToAddress.trim()}.`)
        onSent?.()
        onOpenChange(false)
      } catch (error) {
        const message = errorMessage(error, 'Unable to send the verification email.')
        formApi.setErrorMap({ onSubmit: message })
        onError(message)
      }
    }
  })
  const emailToAddress = useSelector(recipientForm.store, state => state.values.emailToAddress)
  const isPending = useSelector(recipientForm.store, state => state.isSubmitting)
  const isRecipientValid = isVerificationEmailAddress(emailToAddress.trim())
  const savedRecipientValue = recipientValues.includes(emailToAddress) ? emailToAddress : ''
  const handleRecipientInputChange = (value: string, meta: { action: string }) => {
    if (meta.action === 'input-change') recipientForm.setFieldValue('emailToAddress', value)
  }
  const filterRecipientOption = (candidate: { label: string }, inputValue: string) =>
    recipientValues.includes(emailToAddress) || candidate.label.toLowerCase().includes(inputValue.trim().toLowerCase())

  useEffect(() => {
    if (!open || entry?.status !== 'draft') return

    let cancelled = false
    void activateVerificationEntry(entry._id)
      .then(() => {
        if (!cancelled) onSent?.()
      })
      .catch((error: unknown) => {
        if (!cancelled) onError(errorMessage(error, 'Unable to activate the verification entry.'))
      })

    return () => {
      cancelled = true
    }
  }, [open, entry?._id, entry?.status])

  // The entry keeps a copy of the applicant's face, but the snap is what holds
  // the plate, the address and the evidence the attachments are weighed from.
  const snap = useMemo(
    () => snaps?.find((item) => item.uploadId === entry?.uploadId) ?? null,
    [entry?.uploadId, snaps]
  )

  const toggleAttachment = (value: string) => {
    setSelectedAttachments((current) =>
      current.includes(value) ? current.filter((item) => item !== value) : [...current, value]
    )
  }

  const removeAttachment = (value: string) => {
    setSelectedAttachments((current) => current.filter((item) => item !== value))
  }

  // Uploads live on the entry rather than in this draft, so they are held
  // locally and re-seeded from whatever each write returns — the table row the
  // dialog was opened with does not refresh underneath it.
  const [uploads, setUploads] = useLinkedState<readonly VerificationUpload[]>(
    entry?._id ?? '',
    () => entry?.uploads ?? []
  )
  const [pendingUploadCount, setPendingUploadCount] = useState(0)
  const [busyStorageId, setBusyStorageId] = useState('')
  const fileInputRef = useRef<HTMLInputElement | null>(null)

  const uploadedBytes = uploads.reduce((total, upload) => total + upload.size, 0)

  const browseFiles = () => {
    fileInputRef.current?.click()
  }

  // Files go up one at a time: each is its own Convex upload URL and its own
  // patch, so a failure names the file that failed rather than voiding a batch.
  const handleFilesPicked = async (event: Event) => {
    const input = event.currentTarget as HTMLInputElement
    const picked = Array.from(input.files ?? [])
    // Clearing lets the same file be picked again after a removal.
    input.value = ''

    if (!entry || picked.length === 0) return

    setPendingUploadCount((current) => current + picked.length)

    for (const file of picked) {
      try {
        const updated = await uploadVerificationAttachment<VerificationEntryRow>(entry._id, file)
        setUploads(updated.uploads ?? [])
      } catch (error) {
        onError(errorMessage(error, `Unable to attach ${file.name}.`))
      } finally {
        setPendingUploadCount((current) => Math.max(0, current - 1))
      }
    }
  }

  const removeUpload = async (upload: VerificationUpload) => {
    if (!entry) return

    setBusyStorageId(upload.storageId)

    try {
      const updated = await removeVerificationAttachment<VerificationEntryRow>({
        id: entry._id,
        storageId: upload.storageId
      })
      setUploads(updated.uploads ?? [])
    } catch (error) {
      onError(errorMessage(error, `Unable to remove ${upload.name}.`))
    } finally {
      setBusyStorageId('')
    }
  }

  // Only the names travel: the bytes are assembled server-side from R2 and the
  // snap record, so a browsed file here is a label for something Convex
  // already has, not an upload.
  const customAttachments = selectedAttachments.filter(
    (value) => !([...DEFAULT_VERIFICATION_ATTACHMENTS] as readonly string[]).includes(value)
  )

  const attachmentSizes = useMemo(
    () => DEFAULT_VERIFICATION_ATTACHMENTS.map((option) => attachmentSize(option, snap)),
    [snap]
  )

  // The built-ins are weighed from the snap; the uploads weigh themselves.
  const attachmentTotal = useMemo(() => {
    const known = attachmentTotalLabel(selectedAttachments, DEFAULT_VERIFICATION_ATTACHMENTS, snap)
    if (uploadedBytes === 0) return known
    if (!known) return formatBytes(uploadedBytes)

    return `${known} + ${formatBytes(uploadedBytes)}`
  }, [selectedAttachments, snap, uploadedBytes])

  const hasMessage = subject.trim().length > 0 && body.trim().length > 0
  const hasAttachments = selectedAttachments.length > 0 || uploads.length > 0
  const canSend = isRecipientValid && hasAttachments && pendingUploadCount === 0 && !isPending

  const applicantState: StepState = 'done'
  const recipientState: StepState = isRecipientValid ? 'done' : 'active'
  const messageState: StepState = hasMessage ? 'done' : 'active'
  const attachmentState: StepState = hasAttachments ? 'done' : 'active'
  const sendState: StepState = canSend ? 'active' : 'idle'

  const completedSteps = [hasMessage, hasAttachments].filter(Boolean).length
  const progressWidth = `${Math.round((completedSteps / 2) * 100)}%`

  // Reduced to one value rather than an if/elseif chain in the template: a
  // chain whose last branch is an `elseif` was observed emitting that branch
  // outside the conditional.
  const statusLabel = isPending
    ? 'Sending email…'
    : pendingUploadCount > 0
      ? 'Uploading files…'
      : !isRecipientValid
        ? 'Needs a recipient'
        : !hasAttachments
        ? 'Needs an attachment'
        : !hasMessage
          ? 'Subject or message is empty'
          : 'Ready to send'

  const statusToneClass = isPending || pendingUploadCount > 0
    ? 'text-active'
    : canSend && hasMessage
      ? 'text-positive'
      : hasAttachments
        ? 'text-muted-foreground'
        : 'text-destructive'

  const handleOpenChange = (nextOpen: boolean) => {
    // Closing mid-flight would leave the send writing into a torn-down dialog,
    // so the drawer stays put until the request settles either way.
    if (isPending) return
    onOpenChange(nextOpen)
  }

  const submit = (event: SubmitEvent) => {
    event.preventDefault()
    if (!entry) return

    if (selectedAttachments.length === 0 && uploads.length === 0) {
      onError('Select or attach at least one file to send.')
      return
    }

    if (!isRecipientValid) { onError('Enter a valid recipient email.'); return }
    void recipientForm.handleSubmit()
  }

// Nothing to compose against until a row is picked; the dialog owns no state
// worth keeping mounted in that case.
if entry
  Drawer.Root(open={open} onOpenChange={handleOpenChange} direction={direction})
    Drawer.Portal
      Drawer.Overlay(className='fixed inset-0 z-50 bg-black/45 backdrop-blur-[1px]')
      Drawer.Content(className={cn(CONTENT_BASE_CLASS, isMobile ? CONTENT_BOTTOM_CLASS : CONTENT_RIGHT_CLASS)})
        form(className='flex min-h-0 flex-1 flex-col' onSubmit={submit})

          div(className='shrink-0 px-4 pt-3 pb-3 sm:px-5')
            if isMobile
              Drawer.Handle(className='mb-4')
            div(className='flex items-center justify-between gap-3')
              Drawer.Title(className='font-poly text-lg leading-none tracking-tight') Send verification
              span(className='inline-flex shrink-0 items-center gap-1.5 rounded-full border border-border/30 bg-border/20 px-2.5 py-1 font-mono text-2xs text-muted-foreground')
                span(className='capitalize') #{entry.status}
            Drawer.Description(className='sr-only')
              | Confirm the recipients, compose the message, choose the attachments, and send the verification email.

          div(className='min-h-0 flex-1 overflow-y-auto px-2 pb-2 sm:px-3 sm:pb-3')
            div(className='rounded-2xl border border-border/40 bg-popover p-4 shadow-sm')

              Step(
                ~ icon='person'
                ~ title='Applicant'
                ~ state={applicantState}
                ~ index={0}
                ~ meta={entry.plateNumber || undefined}
                ~ )
                if snap
                  div(className={cn('flex items-center gap-3 rounded-lg border border-border/50 bg-muted/30 p-3', ENTER_CLASS)})
                    SnapOptionItem(snap={snap} isSelected={true})
                else
                  div(className={cn('flex items-center gap-3 rounded-lg border border-border/50 bg-muted/30 p-3', ENTER_CLASS)})
                    if entry.applicantImageUrl
                      img(
                        ~ src={entry.applicantImageUrl}
                        ~ alt=''
                        ~ width={40}
                        ~ height={40}
                        ~ loading='lazy'
                        ~ decoding='async'
                        ~ referrerPolicy='no-referrer'
                        ~ className='block size-10 shrink-0 rounded-full object-cover'
                        ~ )
                    div(className='min-w-0 flex-1')
                      p(className='truncate font-poly font-medium text-foreground text-sm uppercase tracking-wide') #{entry.plateNumber || 'No plate'}
                      p(className='mt-0.5 truncate text-muted-foreground text-xs') #{entry.applicant}
                      p(className='mt-1 truncate font-mono text-2xs text-muted-foreground/70') #{entry.uploadId}

              Step(
                ~ icon='at'
                ~ title='Recipients'
                ~ state={recipientState}
                ~ index={1}
                ~ meta={entry.ccEmailAddress ? '+1 cc' : undefined}
                ~ )
                div(className='grid gap-3')
                  label(className='hidden flex-col gap-1.5' htmlFor='send-email-from')
                    span(className={fieldLabelClassName}) From
                    div(id='send-email-from' className={readonlyFieldClassName}) #{entry.emailFromAddress}
                  div(className='grid gap-3 sm:grid-cols-2')
                    div(className='flex flex-col gap-1.5')
                      label(className={fieldLabelClassName} htmlFor='send-email-to') To
                      SelectOctane(
                        ~ inputId='send-email-to'
                        ~ aria-label='To'
                        ~ aria-invalid={!isRecipientValid}
                        ~ className='w-full min-w-0'
                        ~ controlClassName='h-9 min-h-9! rounded-xs border-sidebar-border bg-sidebar/50'
                        ~ filterOption={filterRecipientOption}
                        ~ inputValue={emailToAddress}
                        ~ isDisabled={isPending}
                        ~ isSearchable={true}
                        ~ menuPortalTarget={menuPortalTarget}
                        ~ menuPosition='fixed'
                        ~ noOptionsMessage={() => 'Type a recipient email'}
                        ~ onChange={(value) => recipientForm.setFieldValue('emailToAddress', value)}
                        ~ onInputChange={handleRecipientInputChange}
                        ~ options={recipientOptions}
                        ~ placeholder='recipient@example.com'
                        ~ value={savedRecipientValue}
                        ~ )
                    label(className='flex flex-col gap-1.5' htmlFor='send-email-cc')
                      span(className={fieldLabelClassName}) CC
                      div(id='send-email-cc' className={readonlyFieldClassName}) #{entry.ccEmailAddress ?? '—'}
                  p(className='font-mono text-2xs text-muted-foreground/70')
                    | Sent from the LiveSnaps verified domain — the address above is the record of who composed it.

              Step(
                ~ icon='email-body'
                ~ title='Message'
                ~ state={messageState}
                ~ index={2}
                ~ meta={`${body.trim().length} chars`}
                ~ )
                div(className='grid gap-3')
                  label(className='flex flex-col gap-1.5' htmlFor='send-email-subject')
                    span(className={fieldLabelClassName}) Subject
                    Input(
                      ~ id='send-email-subject'
                      ~ className='rounded-xs'
                      ~ placeholder='Verification subject'
                      ~ value={subject}
                      ~ onInput={(event: Event) => setSubject((event.currentTarget as HTMLInputElement).value)}
                      ~ )
                  label(className='flex flex-col gap-1.5' htmlFor='send-email-body')
                    span(className={fieldLabelClassName}) Body
                    textarea(
                      ~ id='send-email-body'
                      ~ className='min-h-32 w-full rounded-xs border border-border/40 bg-muted/40 px-3 py-2 text-sm placeholder:text-muted-foreground/50 focus-visible:bg-background focus-visible:outline-active focus-visible:outline-[2px] focus-visible:outline-offset-0'
                      ~ placeholder='Compose your message…'
                      ~ value={body}
                      ~ onInput={(event: Event) => setBody((event.currentTarget as HTMLTextAreaElement).value)}
                      ~ )

              Step(
                ~ icon='attachment'
                ~ title='Attachments'
                ~ state={attachmentState}
                ~ index={3}
                ~ meta={attachmentTotal ? `${selectedAttachments.length + uploads.length} selected · ${attachmentTotal}` : `${selectedAttachments.length + uploads.length} selected`}
                ~ )
                div(className='grid')
                  each option, index in DEFAULT_VERIFICATION_ATTACHMENTS key option
                    AttachmentRow(
                      ~ index={index}
                      ~ label={option}
                      ~ included={selectedAttachments.includes(option)}
                      ~ size={attachmentSizes[index].label}
                      ~ isEstimate={attachmentSizes[index].isEstimate}
                      ~ onToggle={() => toggleAttachment(option)}
                      ~ )
                  each name, index in customAttachments key name
                    CustomAttachmentRow(
                      ~ index={DEFAULT_VERIFICATION_ATTACHMENTS.length + index}
                      ~ name={name}
                      ~ onRemove={() => removeAttachment(name)}
                      ~ )
                  each upload, index in uploads key upload.storageId
                    UploadedAttachmentRow(
                      ~ index={DEFAULT_VERIFICATION_ATTACHMENTS.length + customAttachments.length + index}
                      ~ upload={upload}
                      ~ isBusy={busyStorageId === upload.storageId}
                      ~ onRemove={() => void removeUpload(upload)}
                      ~ )
                  if pendingUploadCount > 0
                    div(className={cn('flex w-full items-center gap-3 rounded-lg px-1 py-1.5', ENTER_CLASS)})
                      Icon(name='spinner-ring' className='size-5 shrink-0 text-muted-foreground')
                      span(className='min-w-0 flex-1 truncate font-mono text-muted-foreground text-xs')
                        | Uploading #{pendingUploadCount} #{pendingUploadCount === 1 ? 'file' : 'files'}…
                div(className='mt-3 flex items-center gap-2')
                  Button(
                    ~ type='button'
                    ~ size='sm'
                    ~ variant='secondary'
                    ~ icon='new-folder'
                    ~ iconPosition='left'
                    ~ label='Browse files'
                    ~ className='shrink-0 rounded-xs'
                    ~ disabled={isPending}
                    ~ onClick={browseFiles}
                    ~ )
                  input(
                    ~ ref={fileInputRef}
                    ~ type='file'
                    ~ multiple={true}
                    ~ className='hidden'
                    ~ tabIndex={-1}
                    ~ aria-hidden={true}
                    ~ onChange={(event: Event) => void handleFilesPicked(event)}
                    ~ )
                p(className='mt-2 font-mono text-2xs text-muted-foreground/70')
                  | Photos are read from storage at send time. A browsed file is uploaded now and sent as itself.

              Step(icon='send' title='Send' state={sendState} index={4} isLast={true})
                if canSend
                  p(className={cn('font-mono text-xs text-muted-foreground', ENTER_CLASS)})
                    | Deliver the entry to #{emailToAddress}.
                else
                  div(className='h-2 w-full overflow-hidden rounded-full bg-muted/70')
                    div(className='h-full rounded-full bg-active/60 transition-[width] duration-500 ease-out' style={{ width: progressWidth }})

          div(className='flex shrink-0 items-center justify-between gap-3 border-t border-border/50 px-4 py-3 sm:px-5')
            div(className='flex min-w-0 items-center gap-2')
              span(className={cn('size-1.5 shrink-0 rounded-full bg-current', statusToneClass, (isPending || pendingUploadCount > 0) && 'animate-pulse')})
              span(className={cn('truncate font-mono text-xs', statusToneClass)}) #{statusLabel}
            div(className='flex shrink-0 items-center gap-2')
              Button(
                ~ type='button'
                ~ size='sm'
                ~ variant='ghost'
                ~ label='Cancel'
                ~ disabled={isPending}
                ~ onClick={() => handleOpenChange(false)}
                ~ )
              Button(
                ~ type='submit'
                ~ size='sm'
                ~ variant='dark'
                ~ icon='send'
                ~ iconPosition='right'
                ~ label='Send email'
                ~ pending={isPending}
                ~ pendingLabel='Sending…'
                ~ disabled={!canSend}
                ~ )
