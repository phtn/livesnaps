import { memo, useEffect, useRef, useState } from 'octane'
import { Link } from '@octanejs/tanstack-router'
import Badge from '@/components/ui/badge.btsx'
import { Icon } from '@/lib/icons'
import { getMySubmissions } from '@/lib/convex-client'
import { cn } from '@/lib/utils'
import type { FunctionReturnType } from 'convex/server'
import type { api } from '../../convex/_generated/api'
import { format } from 'date-fns'

module
  type SnapSubmission = FunctionReturnType<typeof api.snaps.q.listMine>[number]
  type SnapSubmissionStatus = SnapSubmission['status']
  type SubmissionRequest = {
    promise: Promise<SnapSubmission[]>
    userId: string
  }
  export interface SubmitListProps {
    authenticatedUserId: string | null
    className?: string
    eyebrow?: string
    heading?: string
    isAuthenticated: boolean
    isAuthLoading: boolean
  }
  const dateFormatter = new Intl.DateTimeFormat('en-PH', { dateStyle: 'medium', timeStyle: 'short' })
  const statusPresentation: Record<SnapSubmissionStatus, { badge: string; icon: string; iconFrame: string }> = {
    active: { badge: 'border-brand/25 bg-brand/8! text-brand! dark:bg-brand/10! dark:text-blue-400!', icon: 'sparkle', iconFrame: 'bg-blue-500/10 text-brand dark:text-blue-400' },
    abandoned: { badge: 'border-zinc-500/20 bg-zinc-500/8! text-zinc-700! dark:text-zinc-300!', icon: 'alert-diamond-fill', iconFrame: 'bg-zinc-500/10 text-zinc-600 dark:text-zinc-300' },
    cancelled: { badge: 'border-mauve-500/20 bg-mauve-500/10! text-mauve-700! dark:text-mauve-400!', icon: 'cancel', iconFrame: 'bg-mauve-500/10 text-mauve-600 dark:text-mauve-300' },
    completed: { badge: 'border-beach/25 bg-beach! text-white! dark:bg-beach/10! dark:text-beach!', icon: 'check-circle-fill', iconFrame: '[&>svg]:size-8 bg-beach/10 text-beach dark:text-beach' },
    invalidated: { badge: 'border-red-500/25 bg-red-500/8! text-red-700! dark:text-red-300!', icon: 'alert-octagon-fill', iconFrame: 'bg-red-500/10 text-red-600 dark:text-red-300' },
    pending: { badge: 'border-amber-500/25 bg-amber-500/8! text-amber-700! dark:text-amber-300!', icon: 'spinner-ferris', iconFrame: 'bg-amber-500/10 text-amber-600 dark:text-amber-300' }
  }
  const vehicleLabel = (submission: SnapSubmission) => [submission.year, submission.make, submission.model].filter(Boolean).join(' ') || 'Vehicle details: N/A'
  const sameRenderedSubmission = (
    previous: Readonly<{ submission: SnapSubmission }>,
    next: Readonly<{ submission: SnapSubmission }>
  ) => {
    const left = previous.submission
    const right = next.submission
    return left._id === right._id &&
      left.status === right.status &&
      left.startedAt === right.startedAt &&
      left.plateNumber === right.plateNumber &&
      left.year === right.year &&
      left.make === right.make &&
      left.model === right.model &&
      left.photoCount === right.photoCount
  }
  const StableSubmissionRow = memo(SubmissionRow, sameRenderedSubmission)

component SubmissionRow
  props { submission }: { submission: SnapSubmission }
  setup
    const formatDate = (timestamp: number) => format(new Date(timestamp), 'M/dd/yyyy hh:mm:ss a')
  li
    Link(to='/snaps/$snapId' params={{ snapId: String(submission._id) }} className='group/submission flex min-h-18 items-center gap-3 px-3 py-3 transition-colors hover:bg-muted/45 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-ring sm:px-4')
      span(className={cn('grid size-9 shrink-0 place-items-center rounded-full', statusPresentation[submission.status].iconFrame)})
        Icon(name={statusPresentation[submission.status].icon as any} className='size-5')
      div(className='min-w-0 flex-1')
        div(className='flex min-w-0 items-center gap-2')
          p(className='truncate font-poly text-sm font-medium uppercase tracking-tight') #{submission.plateNumber.trim() || 'No Plate'}
          Badge(variant='outline' className={cn('capitalize font-normal', statusPresentation[submission.status].badge)}) #{submission.status === 'completed' ? 'Submitted' : submission.status}
        p(className='mt-1 truncate text-xs text-muted-foreground') #{vehicleLabel(submission)} · #{submission.photoCount} of 5 photos
      time(dateTime={formatDate(submission.startedAt)} className='hidden shrink-0 text-right font-mono text-[10px] text-muted-foreground sm:block') #{formatDate(submission.startedAt)}
      Icon(name='down' className='size-3.5 -rotate-45 shrink-0 text-muted-foreground')

component EmptyState
  props { isAuthenticated }: { isAuthenticated: boolean }
  div(className='grid min-h-56 place-items-center px-6 py-10 text-center')
    div(className='max-w-sm')
      p(className='mt-4 font-poly text-lg font-medium') #{isAuthenticated ? 'No snaps yet.' : 'Sign in to view your snaps'}
      p(className='mt-2 text-sm leading-6 text-muted-foreground text-balance') #{isAuthenticated ? 'Completed and in-progress vehicle verifications will appear here.' : 'Use the account button above to continue with the Google account that owns your submissions.'}
props { authenticatedUserId, className, eyebrow = 'Activity', heading = 'Your snaps', isAuthenticated, isAuthLoading }: SubmitListProps

setup
  const [submissions, setSubmissions] = useState<SnapSubmission[] | undefined>(undefined)
  const [isLoading, setIsLoading] = useState(isAuthLoading || isAuthenticated)
  const requestRef = useRef<SubmissionRequest | null>(null)
  useEffect(() => {
    let cancelled = false

    if (isAuthLoading) {
      setIsLoading(true)
      return () => { cancelled = true }
    }

    if (!isAuthenticated || !authenticatedUserId) {
      requestRef.current = null
      setSubmissions([])
      setIsLoading(false)
      return () => { cancelled = true }
    }

    let request = requestRef.current
    if (!request || request.userId !== authenticatedUserId) {
      request = { promise: getMySubmissions(), userId: authenticatedUserId }
      requestRef.current = request
    }

    setIsLoading(true)
    void request.promise.then((next) => { if (!cancelled) { setSubmissions(next); setIsLoading(false) } }).catch(() => { if (!cancelled) { setSubmissions([]); setIsLoading(false) } })
    return () => { cancelled = true }
  }, [authenticatedUserId, isAuthenticated, isAuthLoading])

section(aria-labelledby='proof-submissions-title' className={cn('h-full pb-12 pt-4', className)})

  div(className='mb-3 flex items-end justify-between gap-4 px-1')
    div
      p(className='font-mono text-[9px] uppercase tracking-[0.16em] text-muted-foreground') #{eyebrow}
      h2(id='proof-submissions-title' className='mt-1 font-poly text-lg font-medium')
        div(className='flex items-center space-x-3')
          span #{heading}
          if isLoading
            Icon(name='velocity' className='-mt-0.5 size-6.5 opacity-50')
  div(className={cn('overflow-hidden rounded-lg bg-muted/30 shadow-xs', {' border-[0.5px] border-border/50': submissions && submissions.length > 0})})
    if isLoading
      div(className='relative h-16 animate-pulse bg-mist-100 dark:bg-mist-400/10')
    elseif submissions && submissions.length > 0
      ul(className='divide-y divide-border/60')
        each submission in submissions key submission._id
          StableSubmissionRow(submission={submission})
    else
      EmptyState(isAuthenticated={isAuthenticated})
