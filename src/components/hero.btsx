import { useState } from 'octane'
import { GoogleAuthProvider, signInWithRedirect } from 'firebase/auth'
import Button from '@/components/ui/button.btsx'
import { useMobile } from '@/hooks/use-mobile'
import { auth, signInWithGoogle } from '@/lib/firebase'
import { Icon } from '@/lib/icons'
import { onError } from '@/lib/toast'
import { cn } from '@/lib/utils'
import { useTheme } from './theme-provider.btsx'
import SubmitList from './submit-list.btsx'

module
  const HERO_ENTER_ANIMATION = 'animate-in duration-180 ease-out motion-reduce:animate-none'
  const LIST_ENTER_ANIMATION = 'animate-in duration-180 ease-out motion-reduce:animate-none'
  export interface HeroProps {
    authenticatedUserId: string | null
    error: string | null
    isAuthenticated: boolean
    isAuthLoading: boolean
    isDebugMode: boolean
    isStarting: boolean
    onGetStarted: () => void
  }
  const isPopupBlocked = (error: unknown) => {
    const caught = error as { code?: string; message?: string }
    return caught.code === 'auth/popup-blocked' || caught.code === 'auth/popup-closed-by-user' || caught.code === 'auth/cancelled-popup-request' || /popup/i.test(caught.message ?? '')
  }

props { authenticatedUserId, error, isAuthenticated, isAuthLoading, isDebugMode, isStarting, onGetStarted }: HeroProps

setup
  const [isSigningIn, setIsSigningIn] = useState(false)
  const [isInAppBrowser] = useState(() => typeof navigator !== 'undefined' && /FBAN|FBAV|FBAN\/Messenger|FB_IAB|FB4A|Instagram|Messenger/i.test(navigator.userAgent))
  const isMobile = useMobile()
  const { theme } = useTheme()
  const actionLabel = isAuthLoading ? 'Authenticating…' : isSigningIn ? 'Signing in…' : !isAuthenticated ? 'Sign in with Google' : isInAppBrowser ? 'Open in browser' : isStarting ? (isDebugMode ? 'Starting debug session…' : 'Acquiring GPS…') : isDebugMode ? 'Debug Mode' : 'Get Started'
  const isBusy = isStarting || isAuthLoading || isSigningIn
  const handleAction = async () => {
    if (!isAuthenticated) {
      if (isInAppBrowser) {
        if (/Android/i.test(navigator.userAgent)) window.location.href = `intent://${window.location.href.replace(/^https?:\/\//, '')}#Intent;scheme=https;end`
        else window.open(window.location.href, '_blank', 'noopener,noreferrer')
        return
      }
      if (isSigningIn || isAuthLoading) return
      setIsSigningIn(true)
      try {
        await signInWithGoogle()
      } catch (caught) {
        if (isPopupBlocked(caught) && auth) {
          try {
            const provider = new GoogleAuthProvider()
            provider.setCustomParameters({ prompt: 'select_account' })
            await signInWithRedirect(auth, provider)
            return
          } catch (redirectError) {
            onError(redirectError instanceof Error ? redirectError.message : 'Unable to sign in.')
          }
        } else {
          onError(caught instanceof Error ? caught.message : 'Unable to sign in.')
        }
      } finally {
        setIsSigningIn(false)
      }
      return
    }
    onGetStarted()
  }
  const actionIcon = isSigningIn || isStarting ? 'spinner-ferris' : !isAuthenticated ? 'goog' : !isAuthenticated && isInAppBrowser ? 'external' : isDebugMode ? 'camera-enhance' : undefined

div(className={cn('h-120 px-4 pt-6 md:h-140 md:px-20 lg:px-28 xl:px-32 2xl:px-36', isMobile && 'landscape:h-[calc(100dvh-64px)] landscape:overflow-hidden landscape:px-12')})
  div(className='grid h-full md:grid-cols-2 md:gap-20 lg:gap-28 xl:gap-32 2xl:gap-36')
    div(className='flex size-full flex-col items-center justify-start space-y-6 md:items-start md:justify-center')
      div(className={cn('flex h-24 items-center px-2 md:h-12', HERO_ENTER_ANIMATION, 'delay-50', isMobile && 'landscape:hidden landscape:h-4 landscape:scale-50')})
        div(className='flex w-fit items-center space-x-1.5 rounded-full border border-border/50 bg-slate-200/30 px-2 py-1 font-okx text-xs font-medium tracking-wide text-foreground/80 shadow-inner dark:bg-slate-200/20 md:text-sm')
          Icon(name='safe-shield' className='size-3 opacity-80')
          p(className='drop-shadow-xs text-xs') Verifiable Proofs
      div(className={cn('relative flex select-none items-start whitespace-nowrap text-4xl font-poly font-medium leading-6 dark:text-white md:mt-2 md:text-5xl md:font-semibold md:leading-10 md:tracking-normal', HERO_ENTER_ANIMATION, 'delay-50', isMobile && 'landscape:text-4xl landscape:leading-8')})
        span(className='uppercase tracking-tighter text-beach drop-shadow-xs dark:text-foreground') Live
        span(className='font-extrabold uppercase tracking-tighter dark:text-lime-200') Snaps
        span(className='relative -translate-y-3 px-3 text-2xl text-sand dark:text-foreground') now
        Icon(name='sparkle' className='absolute -top-0.75 right-7.25 size-5 rotate-5 text-beach dark:text-white/60')
      div(className={cn('mt-0 flex h-20 flex-col justify-center space-y-1 md:mt-6 md:h-24 md:space-y-2', HERO_ENTER_ANIMATION, 'delay-100', isMobile && 'landscape:mt-4 landscape:h-16')})
        div(className='flex items-center space-x-4')
          div(className='flex aspect-square size-5 items-center justify-center rounded-sm bg-sand/10 dark:bg-lime-100/10 md:size-6')
            Icon(name='check' className='size-4 stroke-2 drop-shadow-xs text-sand dark:text-lime-200 md:size-4')
          p(className='font-sans text-base') Take 5 clear photos.
        div(className='flex items-center space-x-4')
          div(className='flex aspect-square size-5 items-center justify-center rounded-sm bg-sand/1 dark:bg-lime-100/10 md:size-6')
            Icon(name='check' className='size-4 stroke-2 drop-shadow-xs text-sand dark:text-lime-200 md:size-4')
          p(className='font-sans text-base') Receive LiveSnap certificate.
      div(className={cn('mt-4', HERO_ENTER_ANIMATION, 'delay-150')})
        Button(onClick={handleAction} variant={theme === 'dark' ? 'default' : 'dark'} disabled={isBusy} size='lg' className='font-poly text-base font-medium w-64 md:w-72 md:px-6 md:text-lg')
          if actionIcon
            Icon(name={actionIcon} className='size-5')
          span #{actionLabel}
        div(className='flex max-w-72 items-center justify-center py-2 text-center font-okx text-xs leading-4 text-foreground/75 md:justify-start md:text-left')
          span(className={isDebugMode ? 'text-fuchsia-600 dark:text-fuchsia-300' : undefined}) #{isDebugMode ? 'Debug Mode' : isInAppBrowser ? 'In-app browsers not allowed.' : 'Requires Location Services enabled.'}
        if error
          div(role='alert' className='mt-2 flex max-w-80 items-center justify-center rounded-sm border bg-red-500/2 py-6 text-xs leading-4 text-destructive')
            p #{error}
    div(className={cn('relative hidden size-full p-16 md:flex', HERO_ENTER_ANIMATION, 'delay-175')})
      div(className='relative flex size-full items-center justify-center rounded-full')
        Icon(name='camera-enhance' className={cn('absolute z-1 h-full w-auto scale-80 rounded-xl text-foreground/10 dark:text-lime-200/40', isMobile && 'landscape:hidden')})
        Icon(name='camera-enhance' className={cn('z-2 h-full w-auto rounded-xl', isMobile && 'landscape:absolute landscape:-bottom-8 landscape:-right-6 landscape:-rotate-3 landscape:scale-160')})
        div(className={cn('absolute z-5 size-64 translate-y-6 rounded-full border bg-beach dark:bg-lime-200', isMobile && 'landscape:-right-2 landscape:size-58 landscape:translate-y-29')})
        div(className={cn('absolute z-5 size-56 translate-y-6 rounded-full border-4 border-dashed border-white dark:border-background', isMobile && 'landscape:right-0 landscape:size-52 landscape:translate-y-29')})
        Icon(name='sparkle' className={cn('absolute right-4 top-14 z-6 size-28 rotate-8 rounded-xl text-background', isMobile && 'landscape:-right-10 landscape:top-2 landscape:size-20')})
  SubmitList(authenticatedUserId={authenticatedUserId} className={cn(LIST_ENTER_ANIMATION, 'delay-200')} isAuthenticated={isAuthenticated} isAuthLoading={isAuthLoading})
