import { useState } from 'octane'
import type { Id } from '../../../convex/_generated/dataModel'
import { convexClient } from '@/lib/convex-client'
import { authenticatedFetch, getCurrentUser } from '@/lib/firebase'
import { acceptInviteMutation, useAccountInvitations } from '@/hooks/use-account-invitations'
import { Icon } from '@/lib/icons'
import { onSuccess } from '@/lib/toast'
import { cn } from '@/lib/utils'

module
  export interface AccountInvitationsProps {
    /** Invitations only resolve for a verified address, so the panel says so. */
    isEmailVerified: boolean
    className?: string
  }

  type AcceptState = { id: string; status: 'accepting' } | { id: string; status: 'error'; message: string } | null

  const invitedOn = new Intl.DateTimeFormat('en-PH', { day: 'numeric', month: 'short', year: 'numeric' })

props { isEmailVerified, className }: AccountInvitationsProps

setup
  const invitations = useAccountInvitations(isEmailVerified)
  const [acceptState, setAcceptState] = useState<AcceptState>(null)

  const accept = async (accountId: Id<'accounts'>, membershipId: string, accountName: string, adminConfirmation: boolean) => {
    if (!convexClient || acceptState?.status === 'accepting') return

    setAcceptState({ id: membershipId, status: 'accepting' })

    try {
      if (adminConfirmation) {
        const response = await authenticatedFetch('/api/account/confirm-admin', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ accountId })
        })
        const body = await response.json() as { error?: string }
        if (!response.ok) throw new Error(body.error ?? 'Could not confirm admin access.')
        await getCurrentUser()?.getIdToken(true)
      } else {
        await convexClient.mutation(acceptInviteMutation, { accountId })
      }
      setAcceptState(null)
      onSuccess(adminConfirmation ? `Admin access confirmed for ${accountName}.` : `You joined ${accountName}.`)
    } catch (error) {
      const message = error instanceof Error ? error.message : 'Could not accept this invitation.'
      // Convex wraps a thrown ConvexError in prose; the message we raised is
      // the readable half, so it is the half worth showing.
      const readable = /Uncaught ConvexError:\s*(.+?)(?:\n|$)/.exec(message)?.[1]?.trim()
      setAcceptState({ id: membershipId, status: 'error', message: readable ?? message })
    }
  }

div(className={cn('space-y-3', className)})
  if !isEmailVerified
    div(className='flex items-start gap-3 rounded-xl bg-muted/25 p-4')
      Icon(name='email-body' className='mt-0.5 size-4 shrink-0 text-muted-foreground')
      p(className='text-xs leading-5 text-muted-foreground')
        | Verify your email address to see account confirmations and invitations sent to it.
  elseif invitations === undefined
    div(className='flex items-center gap-2 rounded-xl bg-muted/25 p-4')
      Icon(name='spinner-ring' className='size-4 text-muted-foreground')
      p(className='text-xs text-muted-foreground') Checking for account confirmations and invitations…
  elseif invitations.length === 0
    div(className='flex items-start gap-3 rounded-xl bg-muted/25 p-4')
      Icon(name='check' className='mt-0.5 size-4 shrink-0 text-muted-foreground')
      p(className='text-xs leading-5 text-muted-foreground') No pending account confirmations or invitations.
  else
    each invitation in invitations key invitation._id
      div(className='flex flex-col gap-3 rounded-xl border border-border/70 p-4 sm:flex-row sm:items-center sm:justify-between')
        div(className='min-w-0')
          p(className='truncate text-sm font-medium') #{invitation.accountName}
          p(className='mt-1 text-xs text-muted-foreground')
            span(className='font-mono uppercase tracking-wide') #{invitation.role}
            span(className='ml-2') #{`· ${invitation.adminConfirmation ? 'created' : 'invited'} ${invitedOn.format(invitation.invitedAt)}`}
          if invitation.adminConfirmation
            p(className='mt-2 text-xs text-muted-foreground') Confirm to activate admin access and manage this account as its owner.
          if acceptState?.id === invitation._id && acceptState.status === 'error'
            p(className='mt-2 text-xs text-destructive' role='alert') #{acceptState.message}
        button(
          ~ type='button'
          ~ disabled={acceptState?.status === 'accepting'}
          ~ aria-busy={acceptState?.id === invitation._id && acceptState.status === 'accepting'}
          ~ onClick={() => { void accept(invitation.accountId, invitation._id, invitation.accountName, !!invitation.adminConfirmation) }}
          ~ className='inline-flex h-9 shrink-0 items-center justify-center gap-2 rounded-full bg-foreground px-4 text-sm font-semibold text-background transition hover:opacity-85 disabled:cursor-wait disabled:opacity-60'
          ~ )
          if acceptState?.id === invitation._id && acceptState.status === 'accepting'
            Icon(name='spinner-ring' className='size-4')
          else
            Icon(name='check' className='size-4')
          span #{acceptState?.id === invitation._id && acceptState.status === 'accepting' ? 'Confirming…' : invitation.adminConfirmation ? 'Confirm admin access' : 'Accept'}
