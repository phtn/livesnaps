import { Icon } from '@/lib/icons'
import { ODOMETER_DISTANCE_UNIT } from '@/lib/snaps/odometer'
import { CAPTURE_PLATE_NUMBER_INPUT_PATTERN, CAPTURE_PLATE_NUMBER_MAX_LENGTH, formatCapturePlateNumber, isCompleteCapturePlateNumber, type VehicleDetails } from '@/lib/snaps/vehicle-details'

module
  export type PlateConfirmationStage = 'confirm' | 'submitting' | 'complete'
  export interface PlateConfirmationDialogProps {
    error: string | null
    isDebugMode: boolean
    mileageKm: number | null
    onEnd: VoidFunction
    onPlateNumberChange: (plateNumber: string) => void
    onSubmit: (event: SubmitEvent) => void
    plateNumber: string
    stage: PlateConfirmationStage | null
    vehicle: VehicleDetails
  }

props { error, isDebugMode, mileageKm, onEnd, onPlateNumberChange, onSubmit, plateNumber, stage, vehicle }: PlateConfirmationDialogProps
setup
  const detectedVehicle = [vehicle.make, vehicle.model].filter(Boolean).join(' ')
  const hasCompletePlateNumber = isCompleteCapturePlateNumber(plateNumber)
  const isComplete = stage === 'complete'
  const isSubmitting = stage === 'submitting'
  const plateNumberDescribedBy = [
    'plate-confirmation-description',
    detectedVehicle || mileageKm !== null ? 'plate-number-details' : null,
    error ? 'plate-number-error' : null
  ].filter(Boolean).join(' ')

if stage !== null
  div(className='fixed inset-0 z-50 flex items-end justify-center bg-zinc-950/55 backdrop-blur-[3px] dark:bg-black/75 sm:items-center sm:p-6' role='presentation')
    section(className='relative max-h-[calc(100dvh-1rem)] w-full overflow-y-auto overscroll-contain rounded-t-3xl border border-b-0 border-border/60 bg-background text-foreground shadow-[0_-16px_60px_-24px_rgba(0,0,0,0.55)] sm:max-h-[calc(100dvh-3rem)] sm:max-w-md sm:rounded-3xl sm:border-b sm:shadow-[0_24px_80px_-24px_rgba(0,0,0,0.65)] dark:border-white/10' role='dialog' aria-modal='true' aria-labelledby='plate-confirmation-title' aria-describedby='plate-confirmation-description' aria-busy={isSubmitting})
      div(className='absolute left-1/2 top-2.5 h-1 w-10 -translate-x-1/2 rounded-full bg-foreground/15 sm:hidden' aria-hidden={true})
      if isComplete
        div(className='flex min-h-96 flex-col items-center justify-center px-6 pb-[max(1.5rem,env(safe-area-inset-bottom))] pt-12 text-center sm:min-h-0 sm:px-8 sm:py-10')
          div(className='relative mb-6 grid size-20 place-items-center rounded-full bg-beach/15 text-teal-700 ring-1 ring-beach/25 dark:bg-lime-200/10 dark:text-lime-200 dark:ring-lime-200/20')
            div(className='absolute inset-2 rounded-full border border-current/15' aria-hidden={true})
            Icon(name='checkmark-circle' className='relative size-10')
          p(className='mb-3 font-mono text-[11px] uppercase tracking-[0.22em] text-muted-foreground') Submission complete
          h2(id='plate-confirmation-title' className='font-poly text-2xl leading-tight tracking-tight sm:text-3xl') #{isDebugMode ? 'Debug run complete' : "You're all set!"}
          p(id='plate-confirmation-description' className='mt-3 max-w-xs text-balance text-sm leading-6 text-muted-foreground') #{isDebugMode ? 'Nothing was uploaded or written to Convex.' : 'Your vehicle proof has been submitted successfully.'}
          button(type='button' className='mt-8 inline-flex h-12 w-full cursor-pointer items-center justify-center rounded-xl bg-foreground px-5 font-sans text-sm font-medium text-background transition-[transform,opacity] hover:opacity-90 active:scale-[0.99] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background' onClick={onEnd}) #{isDebugMode ? 'Finish workflow' : 'View submissions'}
      else
        form(className='grid gap-5 px-5 pb-[max(1.25rem,env(safe-area-inset-bottom))] pt-10 sm:gap-6 sm:p-8' onSubmit={onSubmit})
          header(className='grid gap-2.5')
            p(className='font-mono text-[11px] uppercase tracking-[0.22em] text-muted-foreground') Final check
            h2(id='plate-confirmation-title' className='font-poly text-2xl leading-tight tracking-tight sm:text-[1.75rem]') #{hasCompletePlateNumber ? 'Is this plate number correct?' : 'Enter vehicle plate number'}
            p(id='plate-confirmation-description' className='max-w-sm text-pretty text-sm leading-5 text-muted-foreground') #{hasCompletePlateNumber ? 'We read this plate from the back photo. Correct it below if needed.' : 'We could not read the plate clearly. Enter it below to finish.'}
          div(className='grid gap-3 rounded-2xl border border-border/50 bg-muted/45 p-3.5 sm:p-4 dark:bg-white/[0.035]')
            label(htmlFor='confirmed-plate-number' className='font-mono text-[11px] uppercase tracking-[0.16em] text-muted-foreground') Plate number
            input(id='confirmed-plate-number' name='plateNumber' value={plateNumber} onInput={(event) => onPlateNumberChange(formatCapturePlateNumber(event.currentTarget.value))} aria-describedby={plateNumberDescribedBy} aria-invalid={Boolean(error)} autoCapitalize='characters' autoComplete='off' autoCorrect='off' enterKeyHint='done' inputMode='text' maxLength={CAPTURE_PLATE_NUMBER_MAX_LENGTH} pattern={CAPTURE_PLATE_NUMBER_INPUT_PATTERN} placeholder='SUV 9999' spellCheck={false} className='h-14 w-full rounded-xl border border-input bg-background px-3 text-center font-mono text-2xl uppercase tracking-[0.16em] text-foreground shadow-sm outline-none transition-[border-color,box-shadow] placeholder:text-muted-foreground/45 focus-visible:border-foreground/40 focus-visible:ring-2 focus-visible:ring-ring/60 disabled:cursor-wait disabled:opacity-60 sm:h-16 sm:text-[1.65rem]' disabled={isSubmitting} autoFocus required)
            if detectedVehicle || mileageKm !== null
              div(id='plate-number-details' className='grid gap-2 border-t border-border/40 pt-3 text-xs sm:grid-cols-2')
                if detectedVehicle
                  div(className='min-w-0')
                    p(className='text-[10px] uppercase tracking-wider text-muted-foreground') Vehicle
                    p(className='mt-0.5 truncate font-medium text-foreground/80') #{detectedVehicle}
                if mileageKm !== null
                  div(className='min-w-0')
                    p(className='text-[10px] uppercase tracking-wider text-muted-foreground') Odometer
                    p(className='mt-0.5 font-medium text-foreground/80') #{mileageKm.toLocaleString('en-PH', { maximumFractionDigits: 1 })} #{ODOMETER_DISTANCE_UNIT}
            if error
              p(id='plate-number-error' className='rounded-lg bg-destructive/10 px-3 py-2 text-xs leading-5 text-destructive dark:bg-destructive/15' role='alert') #{error}
          button(type='submit' className='inline-flex h-12 w-full cursor-pointer items-center justify-center gap-2 rounded-xl bg-foreground px-5 font-sans text-sm font-medium text-background shadow-sm transition-[transform,opacity] hover:opacity-90 active:scale-[0.99] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background disabled:cursor-not-allowed disabled:opacity-40 disabled:active:scale-100' disabled={isSubmitting || !hasCompletePlateNumber})
            if isSubmitting
              fragment
                Icon(name='spinner-ring' className='size-4 animate-spin')
                span Finishing…
            elseif hasCompletePlateNumber
              span Yes, that's correct
            else
              span Save and continue
