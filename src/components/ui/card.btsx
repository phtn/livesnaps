import { cn } from "@/lib/utils";
import type { ComponentProps } from "octane";
module
  export { CardHeader, CardFooter, CardTitle, CardAction, CardDescription, CardContent };
component CardRoot
  props { className, size = "default", ...props }: ComponentProps<"div"> & {
    ~ size?: "default" | "sm";
    ~ }
  div(
    ~ data-slot="card"
    ~ data-size={size}
    ~ className={cn("cn-card group/card flex flex-col", className)}
    ~ {...props}
    ~ )
component CardHeader
  props { className, ...props }: ComponentProps<"div">
  div(
    ~ data-slot="card-header"
    ~ className={cn("cn-card-header group/card-header @container/card-header grid auto-rows-min items-start has-data-[slot=card-action]:grid-cols-[1fr_auto] has-data-[slot=card-description]:grid-rows-[auto_auto]", className)}
    ~ {...props}
    ~ )
component CardTitle
  props { className, ...props }: ComponentProps<"div">
  div(data-slot="card-title" className={cn("cn-card-title cn-font-heading", className)} {...props})
component CardDescription
  props { className, ...props }: ComponentProps<"div">
  div(data-slot="card-description" className={cn("cn-card-description", className)} {...props})
component CardAction
  props { className, ...props }: ComponentProps<"div">
  div(
    ~ data-slot="card-action"
    ~ className={cn("cn-card-action col-start-2 row-span-2 row-start-1 self-start justify-self-end", className)}
    ~ {...props}
    ~ )
component CardContent
  props { className, ...props }: ComponentProps<"div">
  div(data-slot="card-content" className={cn("cn-card-content", className)} {...props})
component CardFooter
  props { className, ...props }: ComponentProps<"div">
  div(
    ~ data-slot="card-footer"
    ~ className={cn("cn-card-footer flex items-center", className)}
    ~ {...props}
    ~ )

props {...props}: ComponentProps<"div"> & {
  ~ size?: "default" | "sm";
  ~ }
CardRoot({...props})
