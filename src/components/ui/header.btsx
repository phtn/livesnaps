module
  type Props = {
    title: string
    eyebrow?: string
    description: string
    children?: unknown
  }
props {eyebrow, title, description, children}: Props
header(className='h-7 mt-1 flex items-center justify-between')
  div
    if eyebrow
      p(className='mb-1 text-2xs font-semibold uppercase tracking-widest text-soft') #{eyebrow}
    h2#explorer-heading(className='font-poly font-medium text-foreground/80 text-base tracking-tight leading-none') #{title}
    p(className='hidden mb-0 mt-1 max-w-[700px] text-sm leading-[1.55] text-muted-foreground') #{description}
  fragment #{children}
