module
  type Props = {
    eyebrow: string
    title: string
    description: string
    children?: unknown
  }
props {eyebrow, title, description, children}: Props
header(className='flex items-start justify-between gap-4 px-5 py-3')
  div(className='mt-2')
    p(className='mb-1 text-2xs font-semibold uppercase tracking-widest text-soft') #{eyebrow}
    h2#explorer-heading(className='font-medium text-[clamp(16px,3.5vw,20px)] -tracking-[0.025em] leading-none') #{title}
    p(className='hidden mb-0 mt-1 max-w-[700px] text-sm leading-[1.55] text-muted-foreground') #{description}
  fragment #{children}
