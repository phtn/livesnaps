module
  type Props = {
    title: string
    eyebrow?: string
    description: string
    children?: unknown
  }
props {eyebrow, title, description, children}: Props
header(className='flex items-start justify-between gap-4 p-2')
  div(className='mt-0')
    if eyebrow
      p(className='mb-1 text-2xs font-semibold uppercase tracking-widest text-soft') #{eyebrow}
    h2#explorer-heading(className='font-medium text-base -tracking-[0.025em] leading-none') #{title}
    p(className='hidden mb-0 mt-1 max-w-[700px] text-sm leading-[1.55] text-muted-foreground') #{description}
  fragment #{children}
