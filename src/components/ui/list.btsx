import { cn } from "@/lib/utils"
import type { Octane } from "octane/jsx-runtime"

module
  export interface ListProps {
    id?: string
    className?: string
    style?: Octane.JSX.IntrinsicElements["ul"]["style"]
    "aria-label"?: string
    "aria-labelledby"?: string
    children?: unknown
  }
  export type ListItemBadgeTone = "neutral" | "violet" | "amber" | "green" | "coral" | "blue"
  export type ListItemImageLoading = "eager" | "lazy"

  export interface ListItemProps {
    id?: string
    title?: string
    timestamp?: string
    dateTime?: string
    subtitle?: string
    description?: string
    imageSrc?: string
    imageAlt?: string
    imageLoading?: ListItemImageLoading
    media?: unknown
    badge?: unknown
    badgeIcon?: IconName
    badgeTone?: ListItemBadgeTone
    unread?: boolean
    highlighted?: boolean
    actions?: unknown
    className?: string
    mediaClassName?: string
    badgeClassName?: string
    contentClassName?: string
    style?: Octane.JSX.IntrinsicElements["li"]["style"]
    "aria-label"?: string
    children?: unknown
  }

  const LIST_ITEM_CLASS = "relative flex items-start border-t border-[#ECECEC] py-5 pl-5 pr-4 font-[Inter,system-ui,sans-serif] first:border-t-0 dark:border-border"
  const LIST_ITEM_MEDIA_CLASS = "relative size-12 shrink-0"
  const LIST_ITEM_IMAGE_CLASS = "block size-12 rounded-full object-cover"
  const LIST_ITEM_BADGE_CLASS = "absolute -bottom-1 -right-1 grid size-[22px] place-items-center rounded-full border-2 border-[#FCFCFC] text-white dark:border-card"
  const LIST_ITEM_CONTENT_CLASS = "flex min-h-12 min-w-0 flex-1 flex-col justify-center"
  const LIST_ITEM_HEADER_CLASS = "relative mb-2 flex min-w-0 items-baseline pr-4"
  const LIST_ITEM_TITLE_CLASS = "truncate text-[13px] font-semibold leading-4 tracking-[-0.13px] text-[#121212] dark:text-foreground"
  const LIST_ITEM_TIMESTAMP_CLASS = "ml-1 shrink-0 text-xs font-medium leading-4 tracking-[-0.12px] text-[#7B7B7B80] dark:text-muted-foreground/60"
  const LIST_ITEM_SUBTITLE_CLASS = "line-clamp-1 text-[13px] font-medium leading-4 tracking-[-0.13px] text-[#121212] dark:text-foreground"
  const LIST_ITEM_DESCRIPTION_CLASS = "mt-2 line-clamp-2 text-[13px] font-medium leading-[19.5px] tracking-[-0.13px] text-[#7B7B7BCC] dark:text-muted-foreground"
  const LIST_ITEM_ACTIONS_CLASS = "mt-4 flex flex-wrap gap-2"

  const LIST_ITEM_BADGE_TONE_CLASSES = {
    neutral: "bg-[#7B7B7B]",
    violet: "bg-[#8651F8]",
    amber: "bg-[#AD9000]",
    green: "bg-[#55B93E]",
    coral: "bg-[#FE5938]",
    blue: "bg-[#1BA4F3]",
  } as const satisfies Record<ListItemBadgeTone, string>

  export List = {
    ListItem,
  }

component ListItem
  props { id, title, timestamp, dateTime, subtitle, description, imageSrc, imageAlt = "", imageLoading = "lazy", media, badge, badgeIcon, badgeTone = "neutral", unread = false, highlighted = false, actions, className, mediaClassName, badgeClassName, contentClassName, style, "aria-label": ariaLabel, children }: ListItemProps

  setup
    const hasMedia = media !== undefined || imageSrc !== undefined
    const hasBadge = badge !== undefined || badgeIcon !== undefined
    const hasHeader = title !== undefined || timestamp !== undefined || unread
    const itemClassName = cn(LIST_ITEM_CLASS, highlighted && "bg-[#FCFCFC] dark:bg-muted/40", className)
    const resolvedBadgeClassName = cn(LIST_ITEM_BADGE_CLASS, LIST_ITEM_BADGE_TONE_CLASSES[badgeTone], badgeClassName)

  li(id={id} className={itemClassName} style={style} aria-label={ariaLabel})
    if hasMedia
      div(className={cn(LIST_ITEM_MEDIA_CLASS, mediaClassName)})
        if media !== undefined
          | #{media}
        elseif imageSrc
          img(src={imageSrc} alt={imageAlt} width={48} height={48} loading={imageLoading} decoding="async" className={LIST_ITEM_IMAGE_CLASS})
        if hasBadge
          span(className={resolvedBadgeClassName} aria-hidden={true})
            if badge !== undefined
              | #{badge}
            elseif badgeIcon
              Icon(name={badgeIcon} size={12} className="m-0 text-white")
    div(className={cn(LIST_ITEM_CONTENT_CLASS, hasMedia && "pl-4", contentClassName)})
      if hasHeader
        div(className={LIST_ITEM_HEADER_CLASS})
          if title !== undefined
            span(className={LIST_ITEM_TITLE_CLASS}) #{title}
          if timestamp !== undefined
            time(dateTime={dateTime} className={LIST_ITEM_TIMESTAMP_CLASS}) #{timestamp}
          if unread
            span(className="absolute right-0 top-1 size-2 rounded-full bg-[#55B93E]")
              span(className="sr-only") Unread
      if subtitle !== undefined
        div(className={LIST_ITEM_SUBTITLE_CLASS}) #{subtitle}
      if description !== undefined
        div(className={LIST_ITEM_DESCRIPTION_CLASS}) #{description}
      | #{children}
      if actions !== undefined
        div(className={LIST_ITEM_ACTIONS_CLASS}) #{actions}

  const LIST_CLASS = "m-0 w-full list-none overflow-hidden bg-white p-0 dark:bg-card"

props { id, className, style, "aria-label": ariaLabel, "aria-labelledby": ariaLabelledBy, children }: ListProps

ul(id={id} role="list" className={cn(LIST_CLASS, className)} style={style} aria-label={ariaLabel} aria-labelledby={ariaLabelledBy})
  | #{children}
