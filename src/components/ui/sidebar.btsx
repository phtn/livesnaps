import { createElement, type OctaneNode } from 'octane'
import { Link } from '@octanejs/tanstack-router'
import { Icon } from '@/lib/icons'
import Drawer, { DrawerClose, DrawerTrigger } from './drawer.btsx'

module
  export type MobileSidebarBrand = 'admin' | 'citadel'

  export interface SidebarProps {
    open: boolean
    onOpenChange: (open: boolean) => void
    children?: OctaneNode
    title: string
    brand?: MobileSidebarBrand
    className?: string
  }

component AppWordmark
  h1(className='inline-flex items-center gap-0 font-poly font-medium tracking-tight text-foreground/90')
    span(className='uppercase text-beach dark:text-foreground') Live
    span(className='uppercase dark:text-lime-200') Snaps
    span(className='text-sand dark:text-foreground') Now

component SidebarTrigger
  props { brand }: { brand: MobileSidebarBrand }
  header(className='fixed inset-x-0 top-0 z-35 flex h-14 dark:h-12 dark:md:h-14 items-center justify-between border-b border-sidebar-border bg-sunken px-3')
    if brand === 'citadel'
      Link(className='inline-flex items-center gap-2 font-poly font-medium tracking-tight text-foreground/90' to='/citadel' aria-label='Citadel home')
        Icon(name='re-up.ph' className='size-5')
        span(className='dark:text-lime-200') Citadel
    else
      Link(to='/' aria-label='App home')
        AppWordmark
    DrawerTrigger(type='button' aria-label='Open navigation' className='grid size-9 touch-manipulation place-items-center rounded-lg text-foreground/70 transition-colors hover:bg-sidebar hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring')
      Icon(name='sidebar' className='size-6')

component SidebarHeader
  props { brand }: { brand: MobileSidebarBrand }
  div(className='shrink-0 border-b border-border/70')
    div(className='flex h-16 items-center justify-between gap-3 px-5')
      if brand === 'citadel'
        Link(className='inline-flex items-center gap-3 font-poly text-xl font-medium tracking-tight text-foreground/90' to='/citadel' aria-label='Citadel home')
          Icon(name='re-up.ph' className='size-6')
          span(className='dark:text-lime-200') Citadel
      else
        Link(className='text-[clamp(1.1rem,5vw,1.4rem)]' to='/' aria-label='App home')
          AppWordmark
      DrawerClose(type='button' aria-label='Close navigation' className='grid size-9 touch-manipulation place-items-center rounded-lg text-2xl leading-none text-muted-foreground transition-colors hover:bg-muted hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring')
        Icon(name='sidebar' className='size-6')

props { children, open, onOpenChange, title, brand = 'admin', className }: SidebarProps
setup const trigger = createElement(SidebarTrigger, { brand })

Drawer(
  ~ open={open}
  ~ onOpenChange={onOpenChange}
  ~ side='right'
  ~ title={title}
  ~ description='Swipe right or use the close button to close navigation.'
  ~ trigger={trigger}
  ~ className={className}
  ~ )
  SidebarHeader(brand={brand})
  | #{children}
