import { cn } from '@/lib/utils'
import { Icon } from '@/lib/icons'
import type { OctaneNode } from 'octane'

module
  export interface DropdownMenuProps {
    children?: OctaneNode
    className?: string
  }
  export interface DropdownMenuItemProps {
    children?: OctaneNode
    className?: string
    inset?: boolean
    variant?: 'default' | 'destructive'
    disabled?: boolean
    onClick?: (event: MouseEvent) => void
  }
  export interface DropdownMenuLabelProps {
    children?: OctaneNode
    className?: string
    inset?: boolean
  }
  export interface DropdownMenuContentProps {
    children?: OctaneNode
    className?: string
    align?: 'start' | 'center' | 'end'
  }
  export interface DropdownMenuSubTriggerProps {
    children?: OctaneNode
    className?: string
    inset?: boolean
  }
  export interface DropdownMenuCheckboxItemProps extends DropdownMenuItemProps {
    checked?: boolean
    onCheckedChange?: (checked: boolean) => void
  }
  export interface DropdownMenuRadioItemProps extends DropdownMenuItemProps {
    checked?: boolean
    onCheckedChange?: (checked: boolean) => void
  }

  const ITEM_CLASS = 'group relative flex cursor-pointer select-none items-center gap-2.5 rounded-xl px-3 py-2 text-sm outline-none transition-colors hover:bg-accent hover:text-accent-foreground focus:bg-accent focus:text-accent-foreground disabled:pointer-events-none disabled:opacity-50 data-[inset=true]:pl-9.5 data-[variant=destructive]:text-destructive data-[variant=destructive]:hover:bg-destructive/10 data-[variant=destructive]:hover:text-destructive'
  const CHECK_ITEM_CLASS = 'relative flex cursor-pointer select-none items-center gap-2.5 rounded-xl py-2 pr-8 pl-3 text-sm outline-none transition-colors hover:bg-accent hover:text-accent-foreground focus:bg-accent focus:text-accent-foreground disabled:pointer-events-none disabled:opacity-50 data-[inset=true]:pl-9.5'
  const CONTENT_CLASS = 'z-50 min-w-48 overflow-x-hidden overflow-y-auto rounded-2xl bg-popover p-1 text-popover-foreground shadow-2xl ring-1 ring-foreground/5 outline-none'

component DropdownMenuPortal
  props { children }: { children?: OctaneNode }
  | #{children}

component DropdownMenuTrigger
  props { children, className }: { children?: OctaneNode; className?: string }
  summary(className={cn('cursor-pointer list-none rounded-xl outline-none focus-visible:ring-2 focus-visible:ring-ring [&::-webkit-details-marker]:hidden', className)} data-slot='dropdown-menu-trigger')
    | #{children}

component DropdownMenuContent
  props { children, className }: DropdownMenuContentProps
  div(className={cn(CONTENT_CLASS, 'mt-2 animate-in fade-in-0 zoom-in-95', className)} data-slot='dropdown-menu-content')
    | #{children}

component DropdownMenuGroup
  props { children }: { children?: OctaneNode }
  div(data-slot='dropdown-menu-group')
    | #{children}

component DropdownMenuLabel
  props { children, className, inset }: DropdownMenuLabelProps
  div(className={cn('px-3 py-2.5 text-xs text-muted-foreground', inset && 'pl-9.5', className)} data-slot='dropdown-menu-label')
    | #{children}

component DropdownMenuItem
  props { children, className, inset, variant = 'default', disabled, onClick }: DropdownMenuItemProps
  button(type='button' disabled={disabled} className={cn(ITEM_CLASS, className)} data-slot='dropdown-menu-item' data-inset={inset} data-variant={variant} onClick={onClick})
    | #{children}

component DropdownMenuSub
  props { children }: { children?: OctaneNode }
  details(className='relative' data-slot='dropdown-menu-sub')
    | #{children}

component DropdownMenuSubTrigger
  props { children, className, inset }: DropdownMenuSubTriggerProps
  summary(className={cn(ITEM_CLASS, inset && 'pl-9.5', className)} data-slot='dropdown-menu-sub-trigger')
    | #{children}
    Icon(name='arrow-right' size={16} className='ml-auto')

component DropdownMenuSubContent
  props { children, className }: DropdownMenuContentProps
  div(className={cn(CONTENT_CLASS, 'ml-4 mt-1 min-w-36', className)} data-slot='dropdown-menu-sub-content')
    | #{children}

component DropdownMenuCheckboxItem
  props { children, className, inset, checked = false, disabled, onCheckedChange }: DropdownMenuCheckboxItemProps
  button(type='button' disabled={disabled} className={cn(CHECK_ITEM_CLASS, className)} data-slot='dropdown-menu-checkbox-item' data-inset={inset} aria-checked={checked} role='menuitemcheckbox' onClick={() => onCheckedChange?.(!checked)})
    span(className='pointer-events-none absolute right-2 flex items-center justify-center' aria-hidden={true})
      if checked
        span(className='text-xs') ✓
    | #{children}

component DropdownMenuRadioGroup
  props { children }: { children?: OctaneNode }
  div(role='group' data-slot='dropdown-menu-radio-group')
    | #{children}

component DropdownMenuRadioItem
  props { children, className, inset, checked = false, disabled, onCheckedChange }: DropdownMenuRadioItemProps
  button(type='button' disabled={disabled} className={cn(CHECK_ITEM_CLASS, className)} data-slot='dropdown-menu-radio-item' data-inset={inset} aria-checked={checked} role='menuitemradio' onClick={() => onCheckedChange?.(true)})
    span(className='pointer-events-none absolute right-2 flex items-center justify-center' aria-hidden={true})
      if checked
        span(className='text-xs') ●
    | #{children}

component DropdownMenuSeparator
  props { className }: { className?: string }
  div(className={cn('-mx-1 my-1 h-px bg-border/50', className)} data-slot='dropdown-menu-separator' role='separator')

component DropdownMenuShortcut
  props { children, className }: { children?: OctaneNode; className?: string }
  span(className={cn('ml-auto text-xs tracking-widest text-muted-foreground group-focus:text-accent-foreground', className)} data-slot='dropdown-menu-shortcut')
    | #{children}

props { children, className }: DropdownMenuProps

details(className={cn('relative inline-block', className)} data-slot='dropdown-menu')
  DropdownMenuTrigger
    | Menu
  div(className='absolute left-0 top-full z-50')
    DropdownMenuContent
      | #{children}
