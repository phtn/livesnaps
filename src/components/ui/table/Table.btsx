import type { JSX } from 'octane/jsx-runtime'

module
  type NativeTableProps = JSX.IntrinsicElements['table']

  type Props = Omit<NativeTableProps, 'class' | 'className'> & {
    className?: NativeTableProps['className']
  }

  const baseClassName = 'w-full table-auto border-separate border-spacing-0 whitespace-nowrap'

props { children, className, ...tableProps }: Props

table(
  ~ {...tableProps}
  ~ className={[baseClassName, className]}
  ~ )
  | #{children}
