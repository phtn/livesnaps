import type { JSX } from 'octane/jsx-runtime'

module
  type NativeTableCellProps = JSX.IntrinsicElements['td']

  type Props = Omit<NativeTableCellProps, 'class' | 'className'> & {
    className?: NativeTableCellProps['className']
  }

  const baseClassName = 'h-[54px] overflow-hidden border-b border-sidebar px-4 py-2 text-xs text-ellipsis text-muted-foreground'

props { children, className, ...cellProps }: Props

td(
  ~ {...cellProps}
  ~ className={[baseClassName, className]}
  ~ )
  | #{children}
