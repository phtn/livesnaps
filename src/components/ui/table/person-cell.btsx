import Avatar from '@/components/ui/avatar.btsx'

module
  export interface PersonCellProps {
    name: string
    imageUrl?: string | null
  }

props { name, imageUrl }: PersonCellProps

if name
  div(className='flex min-w-0 items-center gap-2')
    Avatar(imageUrl={imageUrl} alt={name} size='sm' className='shrink-0')
    span(className='truncate') #{name}
