import { Command } from '@octanejs/cmdk'
import type { EmptyProps, GroupProps, InputProps, ItemProps, ListProps, SeparatorProps } from '@octanejs/cmdk'
import { createContext, useCallback, useContext, useMemo, useRef, useState } from 'octane'
import type { JSX } from 'octane/jsx-runtime'
import Popover, { PopoverContent, PopoverTrigger } from '../../Popover.btsx'
import type { PopoverContentProps, PopoverProps, PopoverTriggerProps } from '../../Popover.btsx'
import { cn } from '@/lib/utils'
import {Checkbox} from "@/components/ui";

module
  const FACETED_NAME = 'Faceted'
  const TRIGGER_NAME = 'FacetedTrigger'
  const BADGE_LIST_NAME = 'FacetedBadgeList'
  const CONTENT_NAME = 'FacetedContent'
  const ITEM_NAME = 'FacetedItem'

  const ERRORS = {
    [FACETED_NAME]: `\`${FACETED_NAME}\` must be used as root component`,
    [TRIGGER_NAME]: `\`${TRIGGER_NAME}\` must be within \`${FACETED_NAME}\``,
    [BADGE_LIST_NAME]: `\`${BADGE_LIST_NAME}\` must be within \`${FACETED_NAME}\``,
    [CONTENT_NAME]: `\`${CONTENT_NAME}\` must be within \`${FACETED_NAME}\``,
    [ITEM_NAME]: `\`${ITEM_NAME}\` must be within \`${FACETED_NAME}\``
  } as const

  type FacetedValue = string | Array<string>
  type RefObject<T> = { current: T | null }
  type DivProps = JSX.IntrinsicElements['div']
  type SvgProps = JSX.IntrinsicElements['svg']

  interface FacetedContextValue {
    triggerRef: RefObject<HTMLButtonElement>
    value?: FacetedValue
    onItemSelect?: (value: string) => void
    multiple: boolean
  }

  type FacetedProps = Omit<PopoverProps, 'children'> & {
    value?: FacetedValue
    onValueChange?: (value: FacetedValue | undefined) => void
    children?: unknown
    multiple?: boolean
  }

  interface FacetedBadgeListProps extends DivProps {
    options?: Array<{ label: string; value: string }>
    max?: number
    badgeClassName?: string
    placeholder?: string
  }

  type FacetedItemProps = Omit<ItemProps, 'value'> & { value: string }
  type EventHandler<EventType extends Event> = (event: EventType) => void

  const FacetedContext = createContext<FacetedContextValue | null>(null)

  function useFacetedContext(name: keyof typeof ERRORS) {
    const context = useContext(FacetedContext)
    if (!context) {
      throw new Error(ERRORS[name])
    }
    return context
  }

  function composeEventHandlers<EventType extends Event>(
    originalHandler: EventHandler<EventType> | undefined,
    handler: EventHandler<EventType>
  ): EventHandler<EventType> {
    return (event) => {
      originalHandler?.(event)
      if (!event.defaultPrevented) handler(event)
    }
  }

component ChevronDownIcon
  props { className, ...svgProps }: SvgProps
  svg(
    ~ {...svgProps}
    ~ aria-hidden='true'
    ~ viewBox='0 0 24 24'
    ~ fill='none'
    ~ stroke='currentColor'
    ~ strokeWidth={2}
    ~ strokeLinecap='round'
    ~ strokeLinejoin='round'
    ~ className={className}
    ~ )
    path(d='m6 9 6 6 6-6')

component SearchIcon
  props { className, ...svgProps }: SvgProps
  svg(
    ~ {...svgProps}
    ~ aria-hidden='true'
    ~ viewBox='0 0 24 24'
    ~ fill='none'
    ~ stroke='currentColor'
    ~ strokeWidth={2}
    ~ strokeLinecap='round'
    ~ strokeLinejoin='round'
    ~ className={className}
    ~ )
    circle(cx='11' cy='11' r='8')
    path(d='m21 21-4.3-4.3')

component SelectionIcon
  props { selected, className, ...svgProps }: SvgProps & { selected: boolean }
  svg(
    ~ {...svgProps}
    ~ aria-hidden='true'
    ~ viewBox='0 0 24 24'
    ~ fill='none'
    ~ stroke='currentColor'
    ~ strokeWidth={2}
    ~ strokeLinecap='round'
    ~ strokeLinejoin='round'
    ~ className={className}
    ~ )
    rect(width='18' height='18' x='3' y='3' rx='2')
    if selected
      path(d='m9 11 3 3L22 4')

component FacetedTrigger
  props { ref, className, children, onPointerDown: onPointerDownProp, ...triggerProps }: PopoverTriggerProps
  setup
    const context = useFacetedContext(TRIGGER_NAME)
    const composedRef = useMemo(() => [ref, context.triggerRef] as const, [ref, context.triggerRef])
    const onPointerDown = composeEventHandlers<PointerEvent>(onPointerDownProp, (event) => {
      const target = event.target
      if (!(target instanceof Element)) return

      if (target.hasPointerCapture(event.pointerId)) {
        target.releasePointerCapture(event.pointerId)
      }

      if (
        event.button === 0 &&
        event.ctrlKey === false &&
        event.pointerType === 'mouse' &&
        !(target instanceof HTMLInputElement)
      ) {
        event.preventDefault()
      }
    })

  PopoverTrigger(
    ~ data-slot='faceted-trigger'
    ~ {...triggerProps}
    ~ ref={composedRef}
    ~ className={cn(
    ~   'justify-between bg-background focus:outline-none focus:ring-2 focus:ring-indigo-500 hover:bg-indigo-200/5',
    ~   className
    ~ )}
    ~ onPointerDown={onPointerDown}
    ~ )
    | #{children}

component FacetedBadgeList
  props { ref, options = [], max = 2, placeholder = 'Select options...', className, badgeClassName, ...badgeListProps }: FacetedBadgeListProps
  setup
    const context = useFacetedContext(BADGE_LIST_NAME)
    const values = Array.isArray(context.value) ? context.value : context.value ? [context.value] : []
    const getLabel = useCallback(
      (value: string) => options.find((option) => option.value === value)?.label ?? value,
      [options]
    )

  if values.length === 0
    div(
      ~ data-slot='faceted-badge-list'
      ~ {...badgeListProps}
      ~ ref={ref}
      ~ className={cn('flex w-full items-center ps-1.5 text-sm text-foreground/50', className)}
      ~ )
      | #{placeholder}
      ChevronDownIcon(className='ml-auto size-3.5 opacity-80')
  else
    div(
      ~ data-slot='faceted-badge-list'
      ~ {...badgeListProps}
      ~ ref={ref}
      ~ className={cn('flex w-full items-center justify-between font-okx', className)}
      ~ )
      if values.length > max
        span(className={cn('inline-flex items-center rounded-sm bg-brand px-2 py-0.5 text-xs font-normal text-primary-foreground', badgeClassName)})
          | #{values.length} selected
      else
        each value in values key value
          span(className={cn('inline-flex min-w-0 items-center rounded-sm bg-indigo-400 px-2 py-0.5 text-xs font-normal text-primary-foreground', badgeClassName)})
            span.truncate #{getLabel(value)}
      ChevronDownIcon(className='ml-auto size-3.5 shrink-0 opacity-80')

component FacetedContent
  props { className, children, onFocus: onFocusProp, ...contentProps }: PopoverContentProps
  setup
    const context = useFacetedContext(CONTENT_NAME)
    const onFocus = composeEventHandlers<FocusEvent>(onFocusProp, () => {
      context.triggerRef.current?.focus({ preventScroll: true })
    })

  PopoverContent(
    ~ data-slot='faceted-content'
    ~ {...contentProps}
    ~ align='start'
    ~ sideOffset={8}
    ~ className={cn(
    ~   'w-64 origin-(--transform-origin) rounded-sm border border-border/60 bg-transparent p-0! ring-0 dark:border-indigo-200/30 overflow-hidden',
    ~   className
    ~ )}
    ~ onFocus={onFocus}
    ~ )
    Command(className='rounded-sm p-1 backdrop-blur-3xl dark:bg-indigo-100/5')
      | #{children}

component FacetedInput
  props { ref, className, ...inputProps }: InputProps
  div.flex.h-9.items-center.gap-2.border-b.px-3(data-slot='faceted-input-wrapper')
    SearchIcon(className='size-4 shrink-0 opacity-50')
    Command.Input(
      ~ data-slot='faceted-input'
      ~ {...inputProps}
      ~ ref={ref}
      ~ className={cn('h-9 w-full bg-transparent py-3 text-sm outline-hidden placeholder:text-muted-foreground disabled:cursor-not-allowed disabled:opacity-50', className)}
      ~ )

component FacetedList
  props { ref, className, children, ...listProps }: ListProps
  Command.List(
    ~ data-slot='faceted-list'
    ~ {...listProps}
    ~ ref={ref}
    ~ className={cn('max-h-75 overflow-x-hidden overflow-y-auto scroll-py-1 ', className)}
    ~ )
    | #{children}

component FacetedEmpty
  props { ref, className, children, ...emptyProps }: EmptyProps
  Command.Empty(
    ~ data-slot='faceted-empty'
    ~ {...emptyProps}
    ~ ref={ref}
    ~ className={cn('py-6 text-center text-sm', className)}
    ~ )
    | #{children}

component FacetedGroup
  props { ref, className, children, ...groupProps }: GroupProps
  Command.Group(
    ~ data-slot='faceted-group'
    ~ {...groupProps}
    ~ ref={ref}
    ~ className={cn('overflow-hidden text-foreground [&_[cmdk-group-heading]]:px-2 [&_[cmdk-group-heading]]:py-1.5 [&_[cmdk-group-heading]]:text-xs [&_[cmdk-group-heading]]:font-medium [&_[cmdk-group-heading]]:text-muted-foreground', className)}
    ~ )
    | #{children}

component FacetedSeparator
  props { ref, className, ...separatorProps }: SeparatorProps
  Command.Separator(
    ~ data-slot='faceted-separator'
    ~ {...separatorProps}
    ~ ref={ref}
    ~ className={cn('-mx-1 h-px bg-border', className)}
    ~ )

component FacetedItem
  props { className, children, value, onSelect, ...itemProps }: FacetedItemProps
  setup
    const context = useFacetedContext(ITEM_NAME)
    const isSelected = context.multiple
      ? Array.isArray(context.value) && context.value.includes(value)
      : context.value === value
    const onItemSelect = useCallback(
      () => {
        if (onSelect) {
          onSelect(value)
        } else {
          context.onItemSelect?.(value)
        }
      },
      [onSelect, context, value]
    )

  Command.Item(
    ~ data-slot='faceted-item'
    ~ {...itemProps}
    ~ value={value}
    ~ aria-selected={isSelected}
    ~ data-selected={isSelected}
    ~ className={cn('relative flex cursor-default select-none items-center gap-2 ps-2 pe-3 py-2 text-sm outline-hidden hover:bg-sidebar! data-[disabled=true]:pointer-events-none data-[selected=true]:bg-accent data-[selected=true]:text-accent-foreground data-[disabled=true]:opacity-50', className)}
    ~ onSelect={onItemSelect}
    ~ )
    Checkbox(checked={isSelected} onChange={onItemSelect})
    // SelectionIcon(
    //   ~ selected={isSelected}
    //   ~ className={cn('size-5 text-foreground/70', isSelected && 'text-indigo-500 dark:text-indigo-400')}
    //   ~ )
    | #{children}

module
  export {
    FacetedBadgeList,
    FacetedContent,
    FacetedEmpty,
    FacetedGroup,
    FacetedInput,
    FacetedItem,
    FacetedList,
    FacetedSeparator,
    FacetedTrigger
  }

props { value, onValueChange, children, multiple = false, ...facetedProps }: FacetedProps
setup
  const [open, setOpen] = useState(false)
  const triggerRef = useRef<HTMLButtonElement>(null)
  const onItemSelect = useCallback(
    (selectedValue: string) => {
      if (!onValueChange) return

      if (multiple) {
        const currentValue = Array.isArray(value) ? value : []
        const nextValue = currentValue.includes(selectedValue)
          ? currentValue.filter((current) => current !== selectedValue)
          : [...currentValue, selectedValue]
        onValueChange(nextValue)
      } else {
        onValueChange(value === selectedValue ? undefined : selectedValue)
        requestAnimationFrame(() => setOpen(false))
      }
    },
    [multiple, onValueChange, value]
  )
  const contextValue = useMemo<FacetedContextValue>(
    () => ({ value, onItemSelect, multiple, triggerRef }),
    [value, onItemSelect, multiple]
  )

FacetedContext.Provider(value={contextValue})
  Popover(open={open} onOpenChange={setOpen} {...facetedProps})
    | #{children}
