import {cn} from '@/lib/utils'
import { PopoverTrigger } from '@/components/ui/Popover.btsx'
import {useMemo} from 'octane'
import {Icon} from '@/lib/icons'

module
  interface FilterTriggerProps {
    activeFilterCount: number
    activeFilterLabel: string
  }
props {activeFilterCount, activeFilterLabel}: FilterTriggerProps
setup
  const buttonClass = useMemo(() => cn(
    'relative h-8 py-1 md:w-auto flex items-center justify-center rounded-[4px]',
    'select-none text-foreground text-sm md:space-x-1 md:px-2 gap-1 w-9',
    'border border-zinc-200/55 dark:border-zinc-200/2 hover:border-indigo-400',
    'bg-zinc-200/20 dark:bg-zinc-200/8 hover:bg-indigo-200/20 dark:hover:bg-mist-100/5',
    'data-pressed:bg-zinc-200/75 data-pressed:border-zinc-200 dark:data-pressed:bg-zinc-900/80 dark:data-pressed:border-zinc-200/10',
    'active:bg-zinc-300 dark:active:bg-zinc-700/40 transition-colors duration-100',
    'focus-visible:bg-none focus-visible:-outline-offset-1 focus-visible:outline-1',
    {'gap-0.5! md:ps-1.5 md:pe-2 md:border-indigo-200! dark:md:border-indigo-200/10! bg-indigo-100/5!': activeFilterCount > 0},
  ), [activeFilterCount])
PopoverTrigger(type='button' aria-label='Filter' className={cn(buttonClass)})
  if activeFilterCount > 0
    span(className='min-w-6 w-6 rounded-xs bg-indigo-500 px-1.5 font-sans font-semibold text-white dark:bg-indigo-500') #{activeFilterLabel}
  else
    Icon(name='filter' className='size-4 opacity-80')
  span(className='hidden font-mono text-xs opacity-70 md:inline uppercase') Filter
