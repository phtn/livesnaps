import { Button as BaseButton } from '@octanejs/base-ui/button'
import { Menu } from '@octanejs/base-ui/menu'
import type { Column, ColumnOrderState, ColumnVisibilityState, RowData, TableFeatures } from '@octanejs/tanstack-table'
import { createElement, useCallback, useMemo, useState } from 'octane'

import { Icon } from '@/lib/icons'
import { cn } from '@/lib/utils'
import { mergeColumnOrder } from './column-order'
import { getColumnHeaderText } from './filter-utils'
import Sortable, { SortableContent, SortableItem, SortableOverlay } from './sortable.btsx'
import { isColumnVisible } from './visibility'
import Checkbox from '@/components/ui/checkbox.btsx'


module
  interface Props<TFeatures extends TableFeatures, TData extends RowData> {
    cols: Column<TFeatures, TData, unknown>[]
    columnVisibility?: ColumnVisibilityState
    onColumnVisibilityChange?: (
      updater: ColumnVisibilityState | ((old: ColumnVisibilityState) => ColumnVisibilityState)
    ) => void
    columnOrder?: ColumnOrderState
    onColumnOrderChange?: (columnOrder: ColumnOrderState) => void
  }

  type ColumnViewTriggerProps = Parameters<typeof BaseButton>[0] & {
    invisibleCount: number
  }

  interface ColumnVisibilityItemProps {
    column: Column<any, any, unknown>
    isVisible: boolean
    onToggle: (columnId: string, nextVisible: boolean) => void
  }

  export type { Props as ColumnViewProps }

component ColumnViewTrigger
  props { invisibleCount, children, className, ...buttonProps }: ColumnViewTriggerProps

  BaseButton(
    ~ {...buttonProps}
    ~ className={cn(
    ~   'relative h-9 py-1 md:w-auto flex items-center justify-center rounded-[4px] portrait:aspect-square',
    ~   'select-none text-foreground text-sm mx-1 md:space-x-1 md:px-2.5 gap-1 w-8.5',
    ~   'data-pressed:bg-zinc-200/50 dark:data-pressed:bg-zinc-800',
    ~   'border border-transparent hover:border-orange-400',
    ~   'hover:bg-orange-200/20 dark:hover:bg-mist-100/5 transition-colors duration-75',
    ~   'active:bg-zinc-300 dark:active:bg-zinc-700/40',
    ~   'focus-visible:bg-none focus-visible:-outline-offset-1 focus-visible:outline-1',
    ~   {'gap-0.5! md:ps-2 md:pe-2.5 border-orange-400/60!': invisibleCount > 0},
    ~   className,
    ~ )}
    ~ )
    if invisibleCount > 0
      span(className='min-w-6 w-6 md:-ml-0.5 grow-0 rounded-xs bg-orange-400 font-okx font-semibold text-white dark:text-white dark:bg-sand')
        | #{invisibleCount > 99 ? '99+' : invisibleCount}
    else
      Icon(name='cols' className='size-5 dark:opacity-60 opacity-80')
    span(className='hidden font-okx text-sm opacity-80 md:flex') Columns
    | #{children}

component ColumnVisibilityItem
  props { column, isVisible, onToggle }: ColumnVisibilityItemProps

  Menu.CheckboxItem(
    ~ className={cn(
    ~   'group/view rounded-xs flex h-9 items-center justify-between opacity-80 dark:bg-zinc-300/5 px-3 py-1 text-sm text-foreground/80 hover:bg-sand/10 dark:hover:bg-orange-100/5 dark:hover:text-sand/95',
    ~   isVisible && 'bg-transparent not-italic opacity-100 dark:bg-transparent dark:text-white',
    ~ )}
    ~ checked={isVisible}
    ~ onCheckedChange={(value: boolean) => onToggle(column.id, value)}
    ~ )
    span #{getColumnHeaderText(column)}
    Checkbox(
      ~ checked={isVisible}
      ~ onCheckedChange={(value: boolean) => onToggle(column.id, value)}
      ~ )

props { cols, columnVisibility, onColumnVisibilityChange, columnOrder, onColumnOrderChange }: Props<any, any>
setup
  const [isPositioning, setIsPositioning] = useState(false)
  const viewState = useMemo(() => {
    const hideableColumns = cols.filter((column) => column.getCanHide())
    const reorderableColumnIds = hideableColumns
      .filter((column) => !column.getIsPinned())
      .map((column) => column.id)
    const visibilityByColumnId = new Map(
      hideableColumns.map((column) => [
        column.id,
        columnVisibility ? isColumnVisible(column.id, columnVisibility) : column.getIsVisible(),
      ] as const),
    )
    const invisibleCount = hideableColumns.reduce(
      (count, column) => count + (visibilityByColumnId.get(column.id) ? 0 : 1),
      0,
    )

    return { hideableColumns, invisibleCount, reorderableColumnIds, visibilityByColumnId }
  }, [cols, columnVisibility])
  const { hideableColumns, invisibleCount, reorderableColumnIds, visibilityByColumnId } = viewState
  const canPositionColumns = Boolean(onColumnOrderChange && reorderableColumnIds.length > 1)
  const positioningEnabled = isPositioning && canPositionColumns

  const handleToggle = useCallback(
    (columnId: string, nextVisible: boolean) => {
      if (onColumnVisibilityChange) {
        onColumnVisibilityChange((old: ColumnVisibilityState) => ({
          ...old,
          [columnId]: nextVisible,
        }))
        return
      }
      hideableColumns.find((column) => column.id === columnId)?.toggleVisibility(nextVisible)
    },
    [hideableColumns, onColumnVisibilityChange],
  )
  const handleColumnOrderChange = useCallback(
    (nextReorderableColumnIds: string[]) => {
      if (!onColumnOrderChange) return
      const currentOrder = columnOrder && columnOrder.length > 0
        ? columnOrder
        : cols.map((column) => column.id)

      onColumnOrderChange(
        mergeColumnOrder(currentOrder, nextReorderableColumnIds),
      )
    },
    [cols, columnOrder, onColumnOrderChange],
  )
  const renderColumnOverlay = useCallback(
    ({ value }: { value: string | number }) => {
      const column = cols.find((candidate) => candidate.id === String(value))
      return createElement(
        'div',
        {
          className: cn(
            'flex ml-1 h-8 w-[244px] items-center rounded-xs border border-input/70',
            'bg-background px-3 text-sm text-foreground shadow-md',
          ),
        },
        column ? getColumnHeaderText(column) : String(value),
      )
    },
    [cols],
  )

Sortable(value={reorderableColumnIds} onValueChange={handleColumnOrderChange})
  Menu.Root
    Menu.Trigger(render={createElement(ColumnViewTrigger, { invisibleCount })})
    Menu.Portal
      Menu.Positioner(align='start' className='isolate z-50 outline-none' sideOffset={3})
        Menu.Popup(className=' pt-1 select-none origin-(--transform-origin) w-64 rounded-sm border border-border bg-zinc-200/20 dark:bg-zinc-900/50 backdrop-blur-3xl text-origin shadow-none outline-gray-200 transition-[transform,scale,opacity] data-ending-style:scale-90 data-ending-style:opacity-0 data-starting-style:scale-90 data-starting-style:opacity-0 dark:bg-dark-table dark:text-zinc-200')
          div(className='flex items-center justify-between border-b border-dashed border-border px-4 py-1 font-sans text-sm')
            span(className='font-sans text-sm text-muted-foreground')
              | #{positioningEnabled ? 'Position Columns' : 'View Options'}
            BaseButton(
              ~ id='column-drag-toggle'
              ~ type='button'
              ~ aria-label={positioningEnabled ? 'Show column visibility controls' : 'Reorder columns'}
              ~ aria-pressed={positioningEnabled}
              ~ disabled={!canPositionColumns}
              ~ title={canPositionColumns
              ~   ? positioningEnabled
              ~     ? 'Show column visibility controls'
              ~     : 'Reorder columns'
              ~   : 'At least two unpinned columns are required to reorder'}
              ~ onClick={() => setIsPositioning((current) => !current)}
              ~ className='group/toggle flex size-7 items-center justify-center rounded-xs text-mist-600 transition-colors hover:bg-mist-300/50 dark:hover:bg-mist-300/10 focus-visible:outline-1 disabled:cursor-not-allowed disabled:opacity-40 -mr-1.5'
              ~ )
              Icon(
                ~ name='arrow-right-col'
                ~ className={cn(
                ~   'size-6 text-foreground/80 transition-colors drop-shadow-xs group-hover/toggle:text-foreground',
                ~   positioningEnabled && 'opacity-100 text-orange-400',
                ~ )}
                ~ )

          if positioningEnabled
            SortableContent(render={createElement('div', { className: 'space-y-0 p-0' })})
              each column in hideableColumns key column.id
                if Boolean(column.getIsPinned())
                  Menu.Item(
                    ~ disabled
                    ~ closeOnClick={false}
                    ~ title='Pinned columns keep their pinned position'
                    ~ className='flex h-8 items-center justify-between bg-zinc-200/20 ps-3 pe-2 text-sm text-foreground/80 opacity-60 dark:bg-zinc-300/5'
                    ~ )
                    span #{getColumnHeaderText(column)}
                    // Icon(name='' className='size-4')
                else
                  SortableItem(
                    ~ value={column.id}
                    ~ asHandle
                    ~ render={createElement(Menu.Item, {
                    ~   closeOnClick: false,
                    ~   title: `Drag ${getColumnHeaderText(column)} to reposition it`,
                    ~   className: 'group/drag flex h-8 items-center justify-between rounded-xs bg-transparent ps-3 pe-1 text-sm text-foreground opacity-100 hover:bg-sand/10 dark:text-white dark:hover:bg-sand/2 dark:hover:text-sand/95',
                    ~ })}
                    ~ )
                    span #{getColumnHeaderText(column)}
                    Icon(
                      ~ name='draggable'
                      ~ className='size-5 opacity-60 group-hover/drag:opacity-100 group-hover/drag:text-mist-700 dark:group-hover/drag:text-orange-200'
                      ~ )
          else
            div(className='space-y-0 p-0')
              each column in hideableColumns key column.id
                ColumnVisibilityItem(
                  ~ column={column}
                  ~ isVisible={visibilityByColumnId.get(column.id) ?? true}
                  ~ onToggle={handleToggle}
                  ~ )
  SortableOverlay(
    ~ className='pointer-events-none z-60'
    ~ dropAnimation={null}
    ~ children={renderColumnOverlay}
    ~ )
