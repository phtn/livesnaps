import type { ColumnPinningState, ColumnVisibilityState, OctaneTable, SortingState } from '@octanejs/tanstack-table'
import { useMemo } from 'octane'
import { cn } from '@/lib/utils'
import Checkbox from '../../Checkbox.btsx'
import { TableHead, TableHeader, TableRow } from '@/components/ui/table'
import ColumnSort from './ColumnSort.btsx'
import type { PinnedColumnLayout } from './column-pinning'
import { getColumnSize, getPinnedColumnLayouts, getPinnedColumnStyle, orderColumnsByPinning } from './column-pinning'
import { isColumnVisible } from './visibility'

module
  interface Props {
    children?: unknown
    columnPinning: ColumnPinningState
    columnVisibility: ColumnVisibilityState
    loading?: boolean
    onSelectAllChange?: (event: Event) => void
    selectAllChecked?: boolean
    selectColumnId?: string
    table: OctaneTable<any, any, any>
    title?: string
  }

  interface ColumnDefinitionProps {
    visible: boolean
    width: number
  }

  interface HeaderCellProps {
    columnVisibility: ColumnVisibilityState
    header: any
    onSelectAllChange?: (event: Event) => void
    pinnedColumnLayout?: PinnedColumnLayout
    selectAllChecked: boolean
    selectColumnId: string
    sorting: SortingState
  }

component ColumnDefinition
  props { visible, width }: ColumnDefinitionProps
  col(
    ~ data-column-visible={visible}
    ~ className='transition-[width] duration-200 ease-out motion-reduce:transition-none'
    ~ style={{ width }}
    ~ )

component HeaderCell
  props { columnVisibility, header, onSelectAllChange, pinnedColumnLayout, selectAllChecked, selectColumnId, sorting }: HeaderCellProps
  setup
    const visible = header.column
      .getLeafColumns()
      .some((column) => isColumnVisible(column.id, columnVisibility, column.getCanHide()))
    const sort = sorting.find((entry) => entry.id === header.column.id)
    const sorted = sort ? (sort.desc ? 'desc' : 'asc') : false
    const headerClassName = cn(
      'mx-2 h-9 overflow-hidden font-sans font-medium text-foreground text-sm md:h-10 tracking-tight',
      pinnedColumnLayout && 'sticky z-30 bg-sidebar transition-[inset-inline-start,inset-inline-end] duration-200 ease-out motion-reduce:transition-none dark:bg-[#1d2129]',
      pinnedColumnLayout?.isBoundary && pinnedColumnLayout.position === 'start' && 'shadow-[4px_0_6px_-4px_hsl(var(--foreground)/0.25)]',
      pinnedColumnLayout?.isBoundary && pinnedColumnLayout.position === 'end' && 'shadow-[-4px_0_6px_-4px_hsl(var(--foreground)/0.25)]',
      !visible && 'pointer-events-none',
    )
    const contentClassName = cn(
      'relative flex h-full min-w-0 items-center overflow-hidden px-0 transition-opacity duration-150 ease-out motion-reduce:transition-none',
      visible ? 'opacity-100 delay-75' : 'opacity-0 delay-0'
    )
  TableHead(
    ~ aria-hidden={visible ? undefined : true}
    ~ aria-sort={visible && header.column.getCanSort() ? (sorted === 'asc' ? 'ascending' : sorted === 'desc' ? 'descending' : 'none') : undefined}
    ~ colspan={header.colSpan}
    ~ data-column-pinned={pinnedColumnLayout?.position || undefined}
    ~ data-column-visible={visible}
    ~ inert={!visible}
    ~ scope='col'
    ~ style={{...getPinnedColumnStyle(pinnedColumnLayout), width: `${header.getSize()}px`}}
    ~ className={headerClassName}
    ~ )
    div(className={contentClassName})
      if header.column.id === selectColumnId && onSelectAllChange
        Checkbox(
          ~ aria-label='Select all rows on this page'
          ~ checked={selectAllChecked}
          ~ onChange={onSelectAllChange}
          ~ )
      else
        ColumnSort(header={header} sorted={sorted})
      if header.column.getCanResize()
        button(
          ~ type='button'
          ~ aria-label={`Resize ${header.column.id} column`}
          ~ className={`absolute right-0 top-0 z-100 h-full w-3 touch-none rounded-[2px] border-0 bg-transparent hover:bg-active/10 p-0 after:absolute after:right-0 after:top-0 after:h-[38px] after:w-1 after:rounded-[1px] after:bg-brand/5 after:content-[''] hover:after:w-1 hover:after:bg-active ${header.column.getIsResizing() ? 'cursor-col-resize after:w-1 after:bg-active' : ' '}`}
          ~ onMouseDown={header.getResizeHandler()}
          ~ onTouchStart={header.getResizeHandler()}
          ~ onDoubleClick={() => header.column.resetSize()}
          ~ )

component HiddenHeaderCell
  TableHead(
    ~ aria-hidden='true'
    ~ colSpan={1}
    ~ inert
    ~ className='h-8 pointer-events-none opacity-0 md:h-9'
    ~ )

props { children, columnPinning, columnVisibility, loading = false, onSelectAllChange, selectAllChecked = false, selectColumnId = 'select', table, title }: Props

setup
  const layout = useMemo(() => {
    const orderedLeafColumns = orderColumnsByPinning(table.getAllLeafColumns(), columnPinning)
    const pinnedColumnLayouts = getPinnedColumnLayouts(orderedLeafColumns, columnPinning, columnVisibility)
    const columnWidths = new Map(
      orderedLeafColumns.map((column) => {
        const visible = isColumnVisible(column.id, columnVisibility, column.getCanHide())
        return [column.id, { visible, width: visible ? getColumnSize(column) : 0 }] as const
      }),
    )
    const visibleTableSize = orderedLeafColumns.reduce(
      (total, column) => total + (columnWidths.get(column.id)?.width ?? 0),
      0,
    )
    const headersByColumnId = new Map(
      table.getHeaderGroups().flatMap((headerGroup) =>
        headerGroup.headers.map((header) => [header.column.id, header] as const),
      ),
    )

    return { columnWidths, headersByColumnId, orderedLeafColumns, pinnedColumnLayouts, visibleTableSize }
  }, [table, columnPinning, columnVisibility, table.state.columnSizing])

table(
  ~ data-slot='table'
  ~ aria-busy={loading}
  ~ aria-label={title ?? 'Data table'}
  ~ className='w-fit min-w-full table-fixed border-separate border-spacing-0 whitespace-nowrap caption-bottom text-sm transition-[width] duration-200 ease-out motion-reduce:transition-none md:min-w-4xl border-b border-sidebar-border border-dotted'
  ~ style={{ width: layout.visibleTableSize }}
  ~ )
  colgroup
    each column in layout.orderedLeafColumns key column.id
      ColumnDefinition(visible={layout.columnWidths.get(column.id)?.visible ?? false} width={layout.columnWidths.get(column.id)?.width ?? 0})
  TableHeader(className='w-full text-foreground')
    TableRow(className='sticky top-0 z-20 h-7 bg-slate-300/30 backdrop-blur-3xl md:h-8 dark:bg-slate-400/20')
      each column in layout.orderedLeafColumns key column.id
        if layout.headersByColumnId.has(column.id)
          HeaderCell(
            ~ header={layout.headersByColumnId.get(column.id)}
            ~ sorting={table.state.sorting}
            ~ columnVisibility={columnVisibility}
            ~ pinnedColumnLayout={layout.pinnedColumnLayouts.get(column.id)}
            ~ selectColumnId={selectColumnId}
            ~ selectAllChecked={selectAllChecked}
            ~ onSelectAllChange={onSelectAllChange}
            ~ )
        if !layout.headersByColumnId.has(column.id)
          HiddenHeaderCell
  | #{children}
