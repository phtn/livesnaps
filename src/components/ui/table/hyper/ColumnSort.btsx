import { flexRender } from '@octanejs/tanstack-table'
import { Icon } from '@/lib/icons'
import { cn } from '@/lib/utils'

module
  interface Props {
    header: any
    sorted: 'asc' | 'desc' | false
  }

props { header, sorted }: Props

setup
  const handleSort = () => {
    if (!header.column.getCanSort()) return
    header.column.toggleSorting(undefined, false)
  }
  const sortIconClassName = cn(
    'absolute right-0 size-5 rotate-0 text-sand transition-all duration-200 dark:opacity-90',
    sorted === 'asc' && '-rotate-90 text-beach dark:opacity-80',
    sorted !== 'desc' && sorted !== 'asc' && 'hidden'
  )

fragment
  if !header.isPlaceholder
    if header.column.getCanSort()
      button(
        ~ type='button'
        ~ className='relative flex h-full w-full cursor-pointer items-center gap-1.5 text-left select-none'
        ~ onClick={handleSort}
        ~ aria-label={`Sort by ${header.column.id}${sorted ? `, currently ${sorted === 'asc' ? 'ascending' : 'descending'}` : ''}`}
        ~ )
        span(className='min-w-0 truncate') #{flexRender(header.column.columnDef.header, header.getContext())}
        span(className={cn('font-sans text-2xs text-muted-foreground/45 line-through decoration-[1.5px] decoration-table-head dark:decoration-sunken translate-x-px', {'decoration-transparent! text-xs! text-muted-foreground! translate-x-0!': sorted })}) #{sorted === 'asc' ? '⯅' : sorted === 'desc' ? '⯆' : '♦'}


    else
      | #{flexRender(header.column.columnDef.header, header.getContext())}
