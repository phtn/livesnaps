import type { JSX } from 'octane/jsx-runtime'
import { Input as InputBase } from '@octanejs/base-ui/Input'


module
  type NativeInputProps = JSX.IntrinsicElements['input']

  type Props = Omit<NativeInputProps, 'class' | 'className' | 'type'> & {
    className?: NativeInputProps['className']
    type?: NativeInputProps['type']
  }
  const baseClassName = 'h-9 w-full rounded-xs border border-sidebar-border bg-sidebar/50 px-3 text-sm placeholder:text-border placeholder:select-none focus-visible:outline focus-visible:outline-[2px] hover:outline-[2px] focus-visible:outline-brand/50 focus-visible:outline-offset-0 disabled:cursor-not-allowed disabled:opacity-50'

props { className, type = 'text', ...inputProps }: Props

InputBase(
  ~ {...inputProps}
  ~ type={type}
  ~ className={[
  ~   baseClassName,
  ~   className,
  ~ ]}
  ~ )
