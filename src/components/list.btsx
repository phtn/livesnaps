import { Icon } from '@/lib/icons'
import { cn } from '@/lib/utils'
import type { CardListHeading, CardListItem, CardListLayout, CardListProps, CardTone } from '@/components/card-list'

module
  const coverClasses: Record<CardTone, string> = {
    crown: 'bg-[radial-gradient(circle_at_50%_29%,#e4c78f,transparent_18%),linear-gradient(145deg,#312719,#8a6a36_55%,#17120c)]',
    tide: 'bg-[radial-gradient(circle_at_50%_43%,#a9e4db,transparent_17%),linear-gradient(145deg,#112e3e,#287f8c_55%,#0b1b25)]',
    paper: 'bg-[radial-gradient(circle_at_75%_28%,#fff4cf,transparent_16%),linear-gradient(145deg,#6f3824,#d78a4f_57%,#3c1c14)]',
  }

  // The shelf keeps the two-column card it always had at `lg`. The picker never
  // switches: it is laid out against its container, not against the viewport,
  // so a viewport-width breakpoint would fire at the wrong moment inside a drawer.
  const CARD_CLASS = {
    carousel:
      'min-w-0 p-0 snap-start lg:grid lg:grid-cols-[minmax(130px,0.48fr)_1fr] lg:grid-rows-[auto_1fr] lg:items-end lg:gap-x-[22px] lg:rounded-[28px] lg:border lg:border-white/12 lg:bg-[#101010] lg:p-3.5',
    grid: 'min-w-0 rounded-[22px] p-1.5'
  } as const satisfies Record<CardListLayout, string>

  const COVER_CLASS = {
    carousel: 'rounded-[25%] lg:row-span-2 lg:rounded-[20px]',
    grid: 'rounded-[22%]'
  } as const satisfies Record<CardListLayout, string>

  const TITLE_CLASS = {
    carousel:
      'mx-1 mt-[13px] mb-1.5 text-base lg:mb-2 lg:mt-0 lg:self-end lg:text-[clamp(1rem,1.5vw,1.35rem)]',
    grid: 'mx-0.5 mt-2 mb-0.5 text-sm'
  } as const satisfies Record<CardListLayout, string>

  const FOOTER_CLASS = {
    carousel: 'flex items-center justify-between gap-2 mx-1 lg:mx-0 lg:flex-col lg:items-start lg:self-start lg:pb-2',
    // A picker card is far narrower than a shelf card, so the footer stacks:
    // the subtitle gets the full width rather than splitting it with the pill.
    grid: 'flex flex-col items-start gap-1 mx-0.5'
  } as const satisfies Record<CardListLayout, string>

  const LIST_CLASS = {
    carousel:
      'grid snap-x grid-flow-col auto-cols-[minmax(142px,43vw)] gap-[18px] overflow-x-auto px-5 pb-2.5 [scrollbar-width:none] min-[700px]:auto-cols-[210px] min-[700px]:gap-6 min-[700px]:px-[34px] lg:grid-flow-row lg:grid-cols-3 lg:gap-[clamp(24px,3vw,46px)] lg:overflow-visible lg:px-[54px] min-[1360px]:px-[70px]',
    grid: 'grid grid-cols-2 gap-1 min-[520px]:grid-cols-3'
  } as const satisfies Record<CardListLayout, string>

  const SECTION_CLASS = {
    carousel: 'my-[44vw] md:my-[24vw]',
    grid: ''
  } as const satisfies Record<CardListLayout, string>

// The whole card is the control, so the title and the footer select it too
// rather than only the cover. Nothing inside it is interactive on its own.
component ItemCard
  props { item, layout, isSelected, onSelect }: { item: CardListItem; layout: CardListLayout; isSelected: boolean; onSelect?: (id: string) => void }
  button(
    ~ type='button'
    ~ aria-label={`Open ${item.title}`}
    ~ aria-pressed={isSelected}
    ~ onClick={() => onSelect?.(item.id)}
    ~ className={cn('block cursor-pointer border-0 bg-transparent text-left text-inherit outline-none focus-visible:ring-2 focus-visible:ring-ring', CARD_CLASS[layout], isSelected && 'bg-accent ring-2 ring-active')}
    ~ )
    span(className={cn('group relative block aspect-square w-full overflow-hidden bg-muted shadow-[inset_0_0_0_1px_rgba(255,255,255,0.08)]', COVER_CLASS[layout])})
      span(className={cn('absolute inset-0 grid place-items-center overflow-hidden transition-transform duration-500 ease-[cubic-bezier(0.2,0.7,0.2,1)] group-hover:scale-[1.045]', coverClasses[item.tone])})
        span(className='absolute size-[63%] rotate-[24deg] rounded-[42%_58%_63%_37%/46%_34%_66%_54%] border border-white/28 shadow-[0_0_45px_rgba(255,255,255,0.1),inset_0_0_30px_rgba(255,255,255,0.05)]')
        span(className='absolute inset-0 bg-[linear-gradient(145deg,rgba(255,255,255,0.16),transparent_25%,transparent_66%,rgba(0,0,0,0.34))]')
        span(className='absolute h-[130%] w-[46%] -translate-x-[70%] -translate-y-1/5 rotate-[24deg] bg-white/18 blur-[28px]')
        span(className='relative z-2 font-[Georgia,serif] text-[clamp(1.55rem,7vw,3.8rem)] tracking-[-0.08em] text-white drop-shadow-[0_5px_18px_rgba(0,0,0,0.45)]') #{item.glyph}
      if item.badge
        span(className='absolute left-2.5 top-2.5 z-3 max-w-[calc(100%-1.25rem)] truncate rounded-full bg-black/75 px-2 py-1.5 font-mono text-[0.54rem] uppercase tracking-[0.05em] text-white backdrop-blur-[10px]') #{item.badge}
      if isSelected
        span(className='absolute bottom-2.5 right-2.5 z-3 grid size-[26px] place-items-center rounded-full bg-active text-white' aria-hidden={true})
          Icon(name='check' className='size-3.5')
      else
        span(className='absolute bottom-2.5 right-2.5 z-3 grid size-[30px] translate-y-[5px] place-items-center rounded-full border border-white/16 bg-black/35 text-white opacity-0 backdrop-blur-lg transition duration-180 group-hover:translate-y-0 group-hover:opacity-100' aria-hidden={true}) ↗
    span(className={cn('block overflow-hidden text-ellipsis whitespace-nowrap font-medium tracking-[-0.025em]', TITLE_CLASS[layout])}) #{item.title}
    span(className={cn('text-[0.66rem] text-[#85827e]', FOOTER_CLASS[layout])})
      span(className='max-w-full overflow-hidden text-ellipsis whitespace-nowrap') #{item.subtitle ?? ''}
      if item.trailing?.kind === 'score'
        span(className='flex shrink-0 items-center')
          span(className='relative z-1 text-[0.8rem] font-black text-[#efefef] drop-shadow-xs [-webkit-text-stroke:0.5px_#14141b90]') #{item.trailing.value}
          span(className='relative -ml-1.5 bg-linear-to-l from-yellow-200 via-yellow-300 via-20% to-transparent bg-clip-text text-base text-transparent') ★
      elseif item.trailing?.kind === 'badge'
        span(className='shrink-0 rounded-full border border-border/60 px-1.5 py-0.5 font-mono text-[0.58rem] uppercase tracking-wider text-muted-foreground') #{item.trailing.value}
      else
        span(className='hidden')

component SectionHeading
  props { heading }: { heading: CardListHeading }
  header(className='flex items-end justify-between px-5 pb-5 min-[700px]:px-[34px] lg:px-[54px] lg:pb-[30px]')
    div
      if heading.eyebrow
        p(className='mb-1.5 mt-0 text-[0.68rem] uppercase tracking-[0.14em] text-[#ffb49a] min-[700px]:block') #{heading.eyebrow}
      h2(className='m-0 text-[clamp(1.55rem,7vw,2.65rem)] font-medium tracking-[-0.055em]') #{heading.title}
    if heading.actionLabel
      button(type='button' onClick={heading.onAction} className='inline-flex cursor-pointer items-center gap-1 border-0 bg-transparent p-1')
        span(className='hidden min-[700px]:block') #{heading.actionLabel}
        Icon(name='arrow-right' size={18} className='m-0')

props { items, layout = 'carousel', heading, id, className, selectedId = null, onSelect }: CardListProps

section(id={id} className={cn(SECTION_CLASS[layout], className)})
  if heading
    SectionHeading(heading={heading})
  div(className={LIST_CLASS[layout]})
    each item in items key item.id
      ItemCard(item={item} layout={layout} isSelected={item.id === selectedId} onSelect={onSelect})
