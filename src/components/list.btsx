import {Icon} from "../lib/icons";

module
  export interface Game { title: string; genre: string; score: string; tone: string; glyph: string; badge?: string }
  const coverClasses: Record<string, string> = {
    crown: 'bg-[radial-gradient(circle_at_50%_29%,#e4c78f,transparent_18%),linear-gradient(145deg,#312719,#8a6a36_55%,#17120c)]',
    tide: 'bg-[radial-gradient(circle_at_50%_43%,#a9e4db,transparent_17%),linear-gradient(145deg,#112e3e,#287f8c_55%,#0b1b25)]',
    paper: 'bg-[radial-gradient(circle_at_75%_28%,#fff4cf,transparent_16%),linear-gradient(145deg,#6f3824,#d78a4f_57%,#3c1c14)]',
  }
component GameCard
    props { game }: { game: Game }
    article(className='min-w-0 snap-start lg:grid lg:grid-cols-[minmax(130px,0.48fr)_1fr] lg:grid-rows-[auto_1fr] lg:items-end lg:gap-x-[22px] lg:rounded-[28px] lg:border lg:border-white/12 lg:bg-[#101010] lg:p-3.5')
      button(type='button' className='group relative block aspect-square w-full overflow-hidden rounded-[25%] border-0 bg-[#181818] p-0 text-inherit shadow-[inset_0_0_0_1px_rgba(255,255,255,0.08)] lg:row-span-2 lg:rounded-[20px]' aria-label={'Open ' + game.title})
        span(className={'absolute inset-0 grid place-items-center overflow-hidden transition-transform duration-500 ease-[cubic-bezier(0.2,0.7,0.2,1)] group-hover:scale-[1.045] ' + coverClasses[game.tone]})
          span(className='absolute size-[63%] rotate-[24deg] rounded-[42%_58%_63%_37%/46%_34%_66%_54%] border border-white/28 shadow-[0_0_45px_rgba(255,255,255,0.1),inset_0_0_30px_rgba(255,255,255,0.05)]')
          span(className='absolute inset-0 bg-[linear-gradient(145deg,rgba(255,255,255,0.16),transparent_25%,transparent_66%,rgba(0,0,0,0.34))]')
          span(className='absolute h-[130%] w-[46%] -translate-x-[70%] -translate-y-1/5 rotate-[24deg] bg-white/18 blur-[28px]')
          span(className='relative z-2 font-[Georgia,serif] text-[clamp(1.55rem,7vw,3.8rem)] tracking-[-0.08em] drop-shadow-[0_5px_18px_rgba(0,0,0,0.45)]') #{game.glyph}
        if game.badge
          span(className='absolute left-2.5 top-2.5 z-3 rounded-full bg-black/75 px-2 py-1.5 text-[0.54rem] uppercase tracking-[0.05em] text-white backdrop-blur-[10px]') #{game.badge}
        span(className='absolute bottom-2.5 right-2.5 z-3 grid size-[30px] translate-y-[5px] place-items-center rounded-full border border-white/16 bg-black/35 opacity-0 backdrop-blur-lg transition duration-180 group-hover:translate-y-0 group-hover:opacity-100' aria-hidden={true}) ↗
      h3(className='mx-1 mt-[13px] mb-1.5 overflow-hidden text-ellipsis whitespace-nowrap text-base font-medium tracking-[-0.025em] lg:mb-2 lg:mt-0 lg:self-end lg:text-[clamp(1rem,1.5vw,1.35rem)]') #{game.title}
      div(className='mx-1 flex items-center justify-between gap-2 text-[0.66rem] text-[#85827e] lg:mx-0 lg:flex-col lg:items-start lg:self-start lg:pb-2')
        span(className='overflow-hidden text-ellipsis whitespace-nowrap') #{game.genre}
        span(className='flex shrink-0 items-center')
          span(className='relative z-1 text-[0.8rem] font-black text-[#efefef] drop-shadow-xs [-webkit-text-stroke:0.5px_#14141b90]') #{game.score}
          span(className='relative -ml-1.5 bg-linear-to-l from-yellow-200 via-yellow-300 via-20% to-transparent bg-clip-text text-base text-transparent') ★

component SectionHeading
  props { eyebrow, title }: { eyebrow?: string; title: string }
  header(className='flex items-end justify-between px-5 pb-5 min-[700px]:px-[34px] lg:px-[54px] lg:pb-[30px]')
    div
      if eyebrow
        p(className='mb-1.5 mt-0 hidden text-[0.68rem] uppercase tracking-[0.14em] text-[#ffb49a] min-[700px]:block') #{eyebrow}
      h2(className='m-0 text-[clamp(1.55rem,7vw,2.65rem)] font-medium tracking-[-0.055em]') #{title}
    button(type='button' className='inline-flex cursor-pointer items-center gap-1 border-0 bg-transparent p-1')
      span(className='hidden min-[700px]:block') See all
      Icon(name='arrow-right' size={18} className='m-0')

props { editorPicks }: { editorPicks: Game[] }
section(id='editors' className='mb-6 lg:mb-[110px]')
  SectionHeading(eyebrow='Handpicked for you' title='Worth your time')
  div(className='grid snap-x grid-flow-col auto-cols-[minmax(142px,43vw)] gap-[18px] overflow-x-auto px-5 pb-2.5 [scrollbar-width:none] min-[700px]:auto-cols-[210px] min-[700px]:gap-6 min-[700px]:px-[34px] lg:grid-flow-row lg:grid-cols-3 lg:gap-[clamp(24px,3vw,46px)] lg:overflow-visible lg:px-[54px] min-[1360px]:px-[70px]')
    each game in editorPicks key game.title
      GameCard(game={game})
