import { Icon } from "@/lib/icons";
import { qrCreate } from "./qr-create";
import type { Ref } from "octane";

module
  export const QR_SOURCE_SIZE = 512;
  export async function createQR(content: string){
    const normalizedContent = content?.trim() ?? "";

    if (!normalizedContent) {
      return null;
    };

    try {
      return qrCreate({
        content: normalizedContent,
        width: QR_SOURCE_SIZE,
        height: QR_SOURCE_SIZE,
        container: "svg-viewbox",
        join: true
      });
    }
    catch {
      return null;
    };
  }


module
  interface QRExportSurfaceProps {
    itemName: string;
    itemTitle: string;
    itemLabel: string;
    brand: string
    qrCodeImageUrl?: string | null;
    qrSvg: string | null;
    ref?: Ref<HTMLDivElement>;
  }

props { itemName, itemTitle, itemLabel, qrCodeImageUrl = null, qrSvg, ref }: QRExportSurfaceProps

div(className="overflow-hidden bg-white" ref={ref} data-ticket-export-root)
  div(className="flex min-w-0 flex-col items-center px-6 py-4 text-center sm:px-7 sm:py-7")
    div(className="my-2 min-w-0 max-w-full")
      p(className="wrap-break-word font-poly text-xs font-medium uppercase tracking-[0.24em] text-slate-600") #{itemName}
      p(className="mt-1 wrap-break-word font-ios text-xs uppercase tracking-[0.16em] text-zinc-600") #{itemTitle} · #{itemLabel}
    div(
      ~ className="my-2 flex aspect-square w-full max-w-72 items-center justify-center overflow-hidden rounded-4xl border-2 border-primary/33 bg-white p-3"
      ~ role="img"
      ~ aria-label={`QR code for ${itemName}`}
      ~ )
      if qrSvg
        div(className="size-full [&_svg]:size-full" dangerouslySetInnerHTML={{ __html: qrSvg }})
      elseif qrCodeImageUrl
        img(
          ~ src={qrCodeImageUrl}
          ~ alt={`${itemName}-qrcode`}
          ~ width={QR_SOURCE_SIZE}
          ~ height={QR_SOURCE_SIZE}
          ~ className="size-full object-contain"
          ~ )
      else
        div(className="flex flex-col items-center gap-2 text-slate-300")
          Icon(name="qrcode" className="size-12")
          span(className="font-ios text-[8px] uppercase tracking-[0.18em]") QR unavailable
    div(className="flex items-center")
      p(className="font-ios text-[8px] tracking-wide text-slate-500") #{brand}
