import { lazy, Suspense } from 'octane'
import type Game from './components/list.btsx'
import { Icon } from '@/lib/icons'


module
  interface Props { docsUrl: string }
  const LazyTop = lazy(() => import('./components/topbar.btsx'))
  const LazyHero = lazy(() => import('./components/hero.btsx'))
  const LazyFooter = lazy(() => import('./components/footer.btsx'))
  const LazyToast = lazy(() => import('./components/toasts.btsx'))
  const editorPicks: Game[] = [
    { title: 'Sable Crown', genre: 'Tactical RPG', score: '4.9', tone: 'crown', glyph: 'SC', badge: 'Choice' },
    { title: 'Morrow Tide', genre: 'Narrative adventure', score: '4.8', tone: 'tide', glyph: 'MT' },
    { title: 'Paper Kingdom', genre: 'Strategy', score: '4.7', tone: 'paper', glyph: 'PK' },
  ]


props { docsUrl }: Props

component Fallback
  div(className='flex items-center justify-center gap-x-6 h-100')
    Icon(name='spinner-ferris')
    span Loading...

div(className='min-h-screen min-w-[320px] overflow-hidden bg-background font-sans text-foreground antialiased')
  LazyTop
  main(id='top' className='mx-auto w-full max-w-[1520px] h-screen')
    Suspense(fallback={Fallback})
      LazyHero(error={null} isAuthenticated={false} isAuthLoading={false} isDebugMode={false} isStarting={false} onGetStarted={() => {}})
  LazyFooter
  LazyToast
