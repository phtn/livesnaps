import { createElement, useEffect, useState } from 'octane'
import Footer from './components/footer.btsx'
import List from './components/list.btsx'
import ThemeToggle from './components/theme-toggle.btsx'
import Toasts from './components/toasts.btsx'
import Topbar from './components/topbar.btsx'
import type Game from './components/list.btsx'

module
  interface Props { docsUrl: string }
  const editorPicks: Game[] = [
    { title: 'Sable Crown', genre: 'Tactical RPG', score: '4.9', tone: 'crown', glyph: 'SC', badge: 'Choice' },
    { title: 'Morrow Tide', genre: 'Narrative adventure', score: '4.8', tone: 'tide', glyph: 'MT' },
    { title: 'Paper Kingdom', genre: 'Strategy', score: '4.7', tone: 'paper', glyph: 'PK' },
  ]


props { docsUrl }: Props

setup
  const [heroComponent, setHeroComponent] = useState<any>(null)
  const heroNode = heroComponent ? createElement(heroComponent, { error: null, isAuthenticated: false, isAuthLoading: false, isDebugMode: false, isStarting: false, onGetStarted: () => {} }) : null
  useEffect(() => {
    void import('./components/hero.btsx').then(({ default: nextHero }) => setHeroComponent(() => nextHero))
  }, [])

div(className='min-h-screen min-w-[320px] overflow-hidden bg-background font-sans text-foreground antialiased')
  Topbar
  main(id='top' className='mx-auto w-full max-w-[1520px] h-screen')
    if heroComponent
      | #{heroNode}
    else
      div(className='h-114 px-4 pt-6 md:h-180 md:px-20 lg:px-28 xl:px-32 2xl:px-36')
    // nav(className='my-5 mb-[42px] hidden _flex items-center gap-2 overflow-x-auto px-4 [scrollbar-width:none] min-[700px]:mt-7 min-[700px]:px-[34px] lg:my-8 lg:mb-[74px] lg:justify-center lg:px-[54px]' aria-label='Store categories')
