    "clsx": "^2.1.1",
    "convex": "^1.45.0",
    "fflate": "^0.8.3",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "octane": "0.1.49",
    "react-hot-toast": "^2.6.0",
    "shadcn": "^4.19.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@octanejs/rspack-plugin": "0.1.44",
